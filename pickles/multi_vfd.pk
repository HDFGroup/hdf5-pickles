load "common.pk";
load "lookup3.pk";
load "ohdr_msgs.pk";

/*
 * Covers:
 *   - The HDF5 "multi" VFD (H5FD_MULTI): one logical HDF5 address space
 *     partitioned into up to six disjoint per-category virtual ranges
 *     (superblock/btree/rawdata/globalheap/localheap/objheader, per
 *     H5F_mem_t in H5Fpublic.h), each backed by its own physical file --
 *     often with huge (e.g. 1TB) gaps between category ranges.
 *
 *   Unlike "family" (see family_vfd.pk), a multi file's naming/address
 *   layout cannot be bootstrapped from a single member file: the driver
 *   info message that would describe the other members is itself an
 *   object header message (0x0014) allocated in the OHDR category, so
 *   locating it already requires knowing which physical file backs OHDR --
 *   circular unless that mapping is supplied up front. Real HDF5 doesn't
 *   solve this by reading the file either: H5Fopen() requires the caller
 *   to supply the same H5Pset_fapl_multi() member map/name/address
 *   configuration used at creation time; the on-disk driver info block is
 *   used to validate that configuration, not to discover it from nothing.
 *   assemble_multi() follows the same shape: the caller supplies each
 *   category's physical path and virtual start address directly (a flatter
 *   form of what H5Pset_fapl_multi's memb_name/memb_addr arrays carry).
 *   Only configurations where every category has its own distinct member
 *   file are supported (as produced by H5Pset_fapl_multi with a 1:1
 *   category->member mapping); categories sharing one physical file (e.g.
 *   the "split" driver's meta/raw split) are out of scope.
 *
 *   assemble_multi() copies five of the six members eagerly (superblock,
 *   btree, global heap, local heap, object header) via poke's
 *   ios_copy_bytes, each to its own virtual start address in one real
 *   output file -- relying on sparse-file support so the address gaps
 *   between categories cost near-zero real disk (confirmed empirically: a
 *   5.5TB logical span used ~36KB of actual disk). The sixth, raw data
 *   (H5FD_MEM_DRAW), is deliberately left unpopulated: this project's
 *   analyses are about HDF5 *metadata*, and dataset payload bytes are the
 *   one category that can be large enough to make eager copying wasteful.
 *   Its virtual range still counts toward the file's declared EOF (so
 *   addresses into it validate correctly), it's just not filled in until
 *   assemble_multi_fill_raw_data() is called explicitly.
 *
 *   A multi member's own superblock only declares its *local* extent as
 *   eof_addr -- not the true virtual EOF -- so after assembly eof_addr is
 *   patched to the true maximum across all six members (including the
 *   deferred raw-data one, whose range still needs to exist even
 *   unpopulated) and the superblock checksum is recomputed to match, using
 *   the existing lookup3.pk / common.pk facilities unchanged. This mirrors
 *   family_vfd.pk's approach, generalized to v2/v3's checksummed layout at
 *   whatever sizeof_offsets the file actually uses (not hardcoded to 8).
 *
 *   Only superblock versions 2/3 are supported for the EOF/checksum patch
 *   (the only versions exercised against real fixtures so far); v0/v1
 *   multi files are out of scope for now -- see multi_patch_eof()'s
 *   version-check comment below for why (it's not a discovery gap).
 *
 * Load order:
 *   (poke) .load pickles/multi_vfd.pk
 *   (poke) .load pickles/superblock.pk   <- and whatever else you need to
 *                                            explore the assembled file
 *                                            (ohdr_msgs.pk, stab.pk, ...)
 *
 * Quick start:
 *   Category order below matches H5F_mem_t (H5Fpublic.h) minus 1, i.e. the
 *   order H5Pset_fapl_multi's memb_map/memb_name/memb_addr arrays use:
 *   0=super, 1=btree, 2=draw (raw data), 3=gheap, 4=lheap, 5=ohdr.
 *
 *     var members = [
 *       multi_member { path = "mfile-s.h5", start_addr = 0UL },
 *       multi_member { path = "mfile-b.h5", start_addr = 1UL <<. 40 },
 *       multi_member { path = "mfile-r.h5", start_addr = 2UL <<. 40 },
 *       multi_member { path = "mfile-g.h5", start_addr = 3UL <<. 40 },
 *       multi_member { path = "mfile-l.h5", start_addr = 4UL <<. 40 },
 *       multi_member { path = "mfile-o.h5", start_addr = 5UL <<. 40 }];
 *
 *     var total = assemble_multi(members, "/tmp/assembled.h5");
 *     printf("copied %v bytes (metadata only; raw data deferred)\n", total);
 *
 *     var f = open("/tmp/assembled.h5");
 *     set_ios(f);
 *     var sb = superblock @ 0#B;
 *     printf("super_vers=%v\n", sb.super_vers);
 *     close(f);
 *
 *   To later fill in real dataset bytes:
 *     assemble_multi_fill_raw_data("/tmp/assembled.h5", members[2]);
 *
 * If you don't already know the layout (paths + addresses above came from
 * whatever called H5Pset_fapl_multi() to create the files -- typically
 * application code you don't have handy): check the superblock version
 * first (byte 8 of whichever file you believe holds it) -- it decides
 * which of two independent cases you're in, they don't chain into each
 * other:
 *
 *   - v0/v1: drv_info_addr_raw is a plain local offset in the *same*
 *     file, so drv_info.pk's file_drv_info @ off decodes directly -- no
 *     other member needed, and multi_discover() below isn't relevant here.
 *     This only gets you as far as *looking at* member_mapping /
 *     member_addrs / member_names_raw, though: assemble_multi() itself
 *     rejects v0/v1 superblocks outright (multi_patch_eof()'s version
 *     check), so there's no multi_member[6] / assemble_multi() call to
 *     make for a v0/v1 file today -- see the "Covers" note above.
 *
 *   - v2/v3: the driver info is a message (0x0014) inside the superblock
 *     extension's object header, which -- per this file's own "Covers"
 *     note above -- can live in a *different* physical member (whichever
 *     one the OHDR category routes to). multi_discover() automates
 *     locating and decoding it: hand it any candidate file you believe
 *     might hold that object header -- it tries that file for an "OHDR"
 *     signature at local offset 0 with drv_id == "NCSAmult", and on
 *     success returns a ready-to-use multi_member[6]. It doesn't matter
 *     how you arrived at the candidate path; libhdf5's own default naming
 *     templates just make "<base>-o.h5" a reasonable first guess
 *     (confirmed against a real fixture's own member_names_raw, which
 *     literally stores these template strings: "%s-s.h5", "%s-b.h5", ...,
 *     "%s-o.h5"). multi_discover() raises E_inval with a clear diagnostic
 *     if a candidate doesn't pan out, so trying another candidate is
 *     cheap:
 *
 *       var members = multi_discover("mfile-o.h5", "mfile");
 *       var total = assemble_multi(members, "/tmp/assembled.h5");
 */

/* One category's physical backing file and virtual start address. */
type multi_member = struct {
    string   path;
    uint<64> start_addr;
};

/* Index of the raw-data (H5FD_MEM_DRAW) category in a multi_member[6],
 * per H5F_mem_t's enum order (H5Fpublic.h): super=1 btree=2 draw=3
 * gheap=4 lheap=5 ohdr=6, so index = enum value - 1. */
var MULTI_DRAW_INDEX = 2;

fun multi_member_size = (string path) uint<64>:
{
    var ios = open(path, IOS_F_READ);
    var sz = iosize(ios) /#B;
    close(ios);
    return sz;
}

/* Copies one member's full bytes to its virtual offset in the open IOS
 * `out`. Returns the member's own byte count. */
fun multi_copy_member = (int out, multi_member m) uint<64>:
{
    var mf = open(m.path, IOS_F_READ);
    var sz = iosize(mf) /#B;
    if (sz > 0UL)
        ios_copy_bytes(mf, out, 0#B, m.start_addr#B, sz#B);
    close(mf);
    return sz;
}

fun multi_true_eof = (multi_member[6] members) uint<64>:
{
    var eof = 0UL;
    for (m in members) {
        var end = m.start_addr + multi_member_size(m.path);
        if (end > eof) eof = end;
    }
    return eof;
}

/* Little-endian encode of the low `n` bytes of `v` (n <= 8). */
fun multi_u64_le_bytes_n = (uint<64> v, int n) byte[]:
{
    var out = byte[n]();
    var i = 0;
    while (i < n) {
        out[i] = ((v .>> (i * 8)) & 0xffUL) as uint<8>;
        i = i + 1;
    }
    return out;
}

/* Patches a v2/v3 superblock's eof_addr field (and recomputes its
 * checksum) at offset 0 of `output_path` to declare true_eof. Field
 * offsets are computed from the superblock's own sizeof_offsets byte, not
 * hardcoded -- see the v2/v3 layout comment in superblock.pk. */
fun multi_patch_eof = (string output_path, uint<64> true_eof) void:
{
    var ios = open(output_path);
    set_ios(ios);

    var super_vers = byte @ 8#B;
    if (super_vers < 2UB) {
        /* Not a discovery limitation -- drv_info.pk's file_drv_info @ off
         * already decodes v0/v1 driver info directly (drv_info_addr_raw is
         * a plain local offset, no OHDR-member indirection to resolve).
         * This check is the actual blocker: v0/v1 needs genuinely
         * different field-offset arithmetic below, not just a relaxed
         * version guard -- no superblock-level checksum to recompute at
         * all, and a more variable set of fields (stab_leaf_k,
         * stab_internal_k, status_flags, an optional indexed_internal_k /
         * reserved pair only present when super_vers == 1) precede
         * eof_addr_raw instead of v2/v3's compact fixed layout. Combined
         * with no real v0/v1 multi fixture to verify against (every
         * fixture used to build/test this file is v2), that arithmetic
         * hasn't been written -- see the "Covers" note above. */
        printf("multi_patch_eof: superblock version %v not supported (need v2/v3)\n",
               super_vers);
        raise E_inval;
    }
    var sizeof_offsets = (byte @ 9#B) as int;

    /* v2/v3 layout after the 8-byte signature (superblock.pk):
     *   super_vers(1) sizeof_offsets(1) sizeof_lengths(1) status_flags(1)
     *   base_addr(sizeof_offsets) ext_addr(sizeof_offsets)
     *   eof_addr(sizeof_offsets) root_addr(sizeof_offsets) chksum(4) */
    var eof_off = 12 + 2 * sizeof_offsets;
    var chksum_off = 12 + 4 * sizeof_offsets;

    byte[sizeof_offsets] @ eof_off#B = multi_u64_le_bytes_n(true_eof, sizeof_offsets);

    var new_chksum = lookup3_hashlittle(byte[chksum_off] @ 0#B, 0U);
    byte[4] @ chksum_off#B = hdf5_u32_le_bytes(new_chksum);

    close(ios);
}

/* Assembles the five metadata-category members into one real file at
 * output_path (raw data deferred -- see file header), then patches its
 * superblock eof_addr/checksum to the true virtual EOF across all six
 * members. Returns the number of bytes actually copied (excludes the
 * deferred raw-data member). */
fun assemble_multi = (multi_member[6] members, string output_path) uint<64>:
{
    var out = open(output_path, IOS_F_CREATE | IOS_F_TRUNCATE | IOS_F_WRITE | IOS_F_READ);
    var total = 0UL;
    var i = 0;
    while (i < 6) {
        if (i != MULTI_DRAW_INDEX)
            total = total + multi_copy_member(out, members[i]);
        i = i + 1;
    }

    var true_eof = multi_true_eof(members);
    /* Extend the sparse file to the full declared EOF even when the
     * deferred raw-data category is the highest-addressed member, so the
     * real backing extent never falls short of what eof_addr declares. */
    if (iosize(out) /#B < true_eof)
        byte @ out : (true_eof - 1UL)#B = 0UB;
    close(out);

    multi_patch_eof(output_path, true_eof);
    return total;
}

/* Fills in the previously-deferred raw-data member's real bytes into an
 * already-assembled/patched output file. draw_member should be
 * members[MULTI_DRAW_INDEX] from the original assemble_multi() call. */
fun assemble_multi_fill_raw_data = (string output_path, multi_member draw_member) uint<64>:
{
    var out = open(output_path);
    var sz = multi_copy_member(out, draw_member);
    close(out);
    return sz;
}

/* Splits a padded/null-terminated member_names_raw blob (drv_info.pk /
 * ohdr_msgs.pk's oh_msg_drvinfo) into n separate %s-templated name
 * strings -- each entry still needs base_name substituted in via
 * multi_expand_name_template(). Each on-disk entry is a null-terminated
 * name padded to a multiple of 8 bytes, per drv_info.pk's own layout
 * comment. */
fun multi_split_names = (byte[] raw, int n) string[]:
{
    var names = string[n]();
    var pos = 0;
    var i = 0;
    while (i < n) {
        var start = pos;
        while (pos < raw'length && raw[pos] != 0UB)
            pos = pos + 1;
        var s = "";
        var j = start;
        while (j < pos) {
            s = s + (raw[j] as char as string);
            j = j + 1;
        }
        names[i] = s;
        pos = pos + 1;                 /* skip the null terminator */
        var entry_len = pos - start;   /* name bytes + null */
        var pad = (8 - (entry_len % 8)) % 8;
        pos = pos + pad;
        i = i + 1;
    }
    return names;
}

/* Substitutes base_name for the first "%s" in tmpl (the on-disk member
 * name templates, e.g. "%s-o.h5" -> "mfile-o.h5"). */
fun multi_expand_name_template = (string tmpl, string base_name) string:
{
    var pos = -1;
    var i = 0;
    while (i + 1 < tmpl'length) {
        if (tmpl[i] == '%' && tmpl[i + 1] == 's') {
            pos = i;
            break;
        }
        i = i + 1;
    }
    if (pos == -1) {
        printf("multi_expand_name_template: no '%%s' specifier in template: %s\n", tmpl);
        raise E_inval;
    }
    return tmpl[0:pos] + base_name + tmpl[pos + 2:tmpl'length];
}

/* Given a candidate physical file believed to hold the superblock
 * extension's object header (see the "If you don't already know the
 * layout" note above -- typically the "-o" member under the default
 * naming convention), locates and decodes the driver info message
 * (0x0014) at local offset 0 and reconstructs a ready-to-use
 * multi_member[6] array (same shape assemble_multi() takes), substituting
 * base_name into the on-disk %s-templated member names.
 *
 * Only meaningful for v2/v3 files: v0/v1's driver info is a direct
 * superblock field, always local to the "-s" member (see drv_info.pk's
 * own quick start) -- multi_discover() isn't needed there.
 *
 * Raises E_inval with a diagnostic printf if ohdr_candidate_path doesn't
 * hold the driver info message at offset 0, or isn't the multi driver --
 * try a different candidate file. */
fun multi_discover = (string ohdr_candidate_path, string base_name) multi_member[6]:
{
    var of = open(ohdr_candidate_path);
    set_ios(of);

    /* A candidate that isn't an object header at all (wrong file, or too
     * small) can make msg_payload_offset_in_ohdr's scan run past real EOF
     * while walking garbage as if it were a message list, raising a raw
     * EOF exception rather than returning SHARED_MSG_UNRESOLVED -- treat
     * both the same way, since both just mean "not it, try another". */
    var payload_off = SHARED_MSG_UNRESOLVED;
    try {
        payload_off = msg_payload_offset_in_ohdr(0#B, DRVINFO_ID as uint<8>, 0UH, 0);
    } catch (Exception e) {
        payload_off = SHARED_MSG_UNRESOLVED;
    }
    if (payload_off == SHARED_MSG_UNRESOLVED) {
        close(of);
        printf("multi_discover: no driver info message (0x0014) found at offset 0 of %s\n",
               ohdr_candidate_path);
        raise E_inval;
    }

    var dvi = oh_msg_drvinfo @ payload_off;
    if (file_drv_type(dvi.drv_id) != 1) {
        close(of);
        printf("multi_discover: %s's driver info is not the multi (\"NCSAmult\") driver\n",
               ohdr_candidate_path);
        raise E_inval;
    }

    var mapping = dvi.drv_info.multi.member_mapping;
    var n_unique = count_unique(mapping) as int;
    var addrs = dvi.drv_info.multi.member_addrs;
    var templates = multi_split_names(dvi.drv_info.multi.member_names_raw, n_unique);

    var result = multi_member[6]();
    var cat = 0;
    while (cat < 6) {
        var idx = (mapping[cat] as int) - 1;
        result[cat] = multi_member {
            path = multi_expand_name_template(templates[idx], base_name),
            start_addr = addrs[idx].start_addr
        };
        cat = cat + 1;
    }

    close(of);
    return result;
}
