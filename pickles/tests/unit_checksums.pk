/* Regression coverage for metadata checksum boundaries shared by the
 * array, SOHM, and free-space decoders. */
load "common.pk";
load "earray.pk";
load "farray.pk";
load "sohm.pk";
load "fsm.pk";

var failures = 0;
fun expect_checksum = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else {
        printf("FAIL %s\n", name);
        failures = failures + 1;
    }
}

fun seal = (byte[] prefix) byte[]:
{
    return prefix + hdf5_u32_le_bytes(lookup3_hashlittle(prefix, 0U));
}

set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);
var ios = open("*unit-checksums*");

/* EA header establishes the dimensions used by its subordinate blocks. */
var eahd = seal(['E', 'A', 'H', 'D', 0UB, 0UB, 4UB, 4UB,
                 1UB, 2UB, 2UB, 1UB]
                + byte[24]() + byte[4]());
byte[eahd'length] @ ios : 0#B = eahd;
var ea_header = ea_hdr @ ios : 0#B;
expect_checksum("ea_header_accepts_valid_checksum", ea_header.chksum != 0U);

var eaib = seal(['E', 'A', 'I', 'B', 0UB, 0UB]
                + byte[4]() + byte[4]() + byte[8]() + byte[8]());
byte[eaib'length] @ ios : 64#B = eaib;
var ea_index = ea_iblock @ ios : 64#B;
expect_checksum("ea_index_accepts_valid_checksum", ea_index.chksum != 0U);

set_ea_sblock_idx(0UL);
var easb = seal(['E', 'A', 'S', 'B', 0UB, 0UB]
                + byte[4]() + byte[1]() + byte[4]());
byte[easb'length] @ ios : 128#B = easb;
var ea_secondary = ea_sblock @ ios : 128#B;
expect_checksum("ea_secondary_accepts_valid_checksum", ea_secondary.chksum != 0U);

set_ea_dblock(1UL);
var eadb = seal(['E', 'A', 'D', 'B', 0UB, 0UB]
                + byte[4]() + byte[1]() + byte[4]());
byte[eadb'length] @ ios : 192#B = eadb;
var ea_data = eadb_nopaged @ ios : 192#B;
expect_checksum("ea_unpaged_data_accepts_valid_checksum", ea_data.chksum != 0U);

set_ea_dblock(4UL);
var eadb_paged_prefix = seal(['E', 'A', 'D', 'B', 0UB, 0UB]
                              + byte[4]() + byte[1]());
var ea_page = seal(byte[8]());
byte[eadb_paged_prefix'length] @ ios : 256#B = eadb_paged_prefix;
byte[ea_page'length] @ ios : 271#B = ea_page;
var ea_paged = eadb_paged @ ios : 256#B;
var ea_data_page = ea_dblk_page @ ios : 271#B;
expect_checksum("ea_paged_prefix_and_page_accept_valid_checksums",
                ea_paged.chksum != 0U && ea_data_page.chksum != 0U);

var fahd = seal(['F', 'A', 'H', 'D', 0UB, 0UB, 4UB, 1UB]
                + [2UB, 0UB, 0UB, 0UB] + byte[4]());
byte[fahd'length] @ ios : 320#B = fahd;
var fa_header = fa_hdr @ ios : 320#B;
expect_checksum("fa_header_accepts_valid_checksum", fa_header.chksum != 0U);

var fadb = seal(['F', 'A', 'D', 'B', 0UB, 0UB]
                + byte[4]() + byte[8]());
byte[fadb'length] @ ios : 384#B = fadb;
var fa_data = fadb_nopaged @ ios : 384#B;
expect_checksum("fa_unpaged_data_accepts_valid_checksum", fa_data.chksum != 0U);

set_fa_client_id(0UB);
set_fa_raw_elmt_size(4UB);
set_fa_max_dblk_page_nelmts_bits(1UB);
set_fa_nelmts(3UL);
var fadb_paged_prefix = seal(['F', 'A', 'D', 'B', 0UB, 0UB]
                              + byte[4]() + byte[1]());
var fa_page = seal(byte[8]());
byte[fadb_paged_prefix'length] @ ios : 448#B = fadb_paged_prefix;
byte[fa_page'length] @ ios : 463#B = fa_page;
var fa_paged = fadb_paged @ ios : 448#B;
var fa_data_page = fa_dblk_page @ ios : 463#B;
expect_checksum("fa_paged_prefix_and_page_accept_valid_checksums",
                fa_paged.chksum != 0U && fa_data_page.chksum != 0U);

set_sohm_num_indexes(0UL);
var smtb = seal(['S', 'M', 'T', 'B']);
byte[smtb'length] @ ios : 512#B = smtb;
var sohm_table = sohm_table_raw @ ios : 512#B;
set_sohm_list(0UL);
var smli = seal(['S', 'M', 'L', 'I']);
byte[smli'length] @ ios : 528#B = smli;
var sohm_list = sohm_list_raw @ ios : 528#B;
expect_checksum("sohm_table_and_list_accept_valid_checksums",
                sohm_table.chksum != 0U && sohm_list.chksum != 0U);

var fshd = seal(['F', 'S', 'H', 'D', 0UB, 0UB]
                + byte[16]() + byte[8]() + [1UB, 0UB, 0UB, 0UB]
                + byte[12]());
byte[fshd'length] @ ios : 576#B = fshd;
var fs_header = fs_hdr @ ios : 576#B;
expect_checksum("free_space_header_accepts_valid_checksum", fs_header.chksum != 0U);

/* Changing only the stored checksum must cause the map to fail. */
var corrupt_eahd = eahd[0:eahd'length - 4]
                   + hdf5_u32_le_bytes(ea_header.chksum ^ 1U);
byte[corrupt_eahd'length] @ ios : 640#B = corrupt_eahd;
var rejected = 0;
try {
    var ignored = ea_hdr @ ios : 640#B;
} catch (Exception e) {
    rejected = 1;
}
expect_checksum("checksum_mismatch_rejects_map", rejected);

close(ios);
if (failures != 0) {
    printf("UNIT CHECKSUMS: %i32d failure(s)\n", failures);
    exit(1);
}
printf("UNIT CHECKSUMS: all passed\n");
