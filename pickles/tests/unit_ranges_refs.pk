/* Cross-record address/range and reference-encoding regressions. */
load "common.pk";
load "ohdr_msgs.pk";
load "ref_enc.pk";

var failures = 0;
fun expect_range_ref = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else {
        printf("FAIL %s\n", name);
        failures = failures + 1;
    }
}

set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);
set_global_hdf5_base_addr([0UB, 0UB, 0UB, 0UB]);
set_global_hdf5_declared_eof([0UB, 2UB, 0UB, 0UB]); /* exclusive offset 512 */

var ios = open("*unit-ranges-refs*");

byte[8] @ ios : 0#B = [1UB, 0UB, 1UB, 'x', 100UB, 0UB, 0UB, 0UB];
var good_link = oh_msg_link @ ios : 0#B;
expect_range_ref("hard_link_target_within_declared_eof",
                 bytes_to_u64_le(good_link.ohdr_addr_raw) == 100UL);

byte[8] @ ios : 16#B = [1UB, 0UB, 1UB, 'x', 0UB, 2UB, 0UB, 0UB];
var bad_link_rejected = 0;
try {
    var bad_link = oh_msg_link @ ios : 16#B;
} catch (Exception e) {
    bad_link_rejected = 1;
}
expect_range_ref("hard_link_target_at_declared_eof_rejected", bad_link_rejected);

byte[8] @ ios : 32#B = [144UB, 1UB, 0UB, 0UB, 100UB, 0UB, 0UB, 0UB];
var good_cont = oh_msg_cont @ ios : 32#B;
expect_range_ref("continuation_range_within_declared_eof",
                 bytes_to_u64_le(good_cont.size_raw) == 100UL);

byte[8] @ ios : 48#B = [224UB, 1UB, 0UB, 0UB, 40UB, 0UB, 0UB, 0UB];
var bad_cont_rejected = 0;
try {
    var bad_cont = oh_msg_cont @ ios : 48#B;
} catch (Exception e) {
    bad_cont_rejected = 1;
}
expect_range_ref("continuation_range_past_declared_eof_rejected", bad_cont_rejected);

byte[9] @ ios : 64#B = [0UB, 144UB, 1UB, 0UB, 0UB, 100UB, 0UB, 0UB, 0UB];
var good_mdci = oh_msg_mdci @ ios : 64#B;
expect_range_ref("mdci_range_within_declared_eof",
                 bytes_to_u64_le(good_mdci.image_size) == 100UL);

byte[9] @ ios : 80#B = [0UB, 224UB, 1UB, 0UB, 0UB, 40UB, 0UB, 0UB, 0UB];
var bad_mdci_rejected = 0;
try {
    var bad_mdci = oh_msg_mdci @ ios : 80#B;
} catch (Exception e) {
    bad_mdci_rejected = 1;
}
expect_range_ref("mdci_range_past_declared_eof_rejected", bad_mdci_rejected);

byte[4] @ ios : 96#B = [100UB, 0UB, 0UB, 0UB];
var obj1 = ref_enc_obj1_block @ ios : 96#B;
expect_range_ref("object_reference_target_within_declared_eof",
                 bytes_to_u64_le(obj1.addr_raw) == 100UL);

byte[4] @ ios : 112#B = [0UB, 2UB, 0UB, 0UB];
var bad_obj1_rejected = 0;
try {
    var bad_obj1 = ref_enc_obj1_block @ ios : 112#B;
} catch (Exception e) {
    bad_obj1_rejected = 1;
}
expect_range_ref("object_reference_target_at_declared_eof_rejected", bad_obj1_rejected);

/* Revised internal object reference: type 2, no flags, 4-byte token. */
byte[7] @ ios : 128#B = [2UB, 0UB, 4UB, 100UB, 0UB, 0UB, 0UB];
var direct_ref = ref_enc_block @ ios : 128#B;
expect_range_ref("revised_direct_reference_accepts_valid_header",
                 direct_ref.hdr.ref_type == 2UB && direct_ref.token_size == 4UB);

byte[7] @ ios : 144#B = [1UB, 0UB, 4UB, 100UB, 0UB, 0UB, 0UB];
var bad_type_rejected = 0;
try {
    var bad_type = ref_enc_block @ ios : 144#B;
} catch (Exception e) {
    bad_type_rejected = 1;
}
expect_range_ref("revised_reference_invalid_type_rejected", bad_type_rejected);

/* Region references use the global-heap blob descriptor. */
byte[14] @ ios : 160#B = [3UB, 0UB, 8UB, 0UB, 0UB, 0UB,
                          100UB, 0UB, 0UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var blob_ref = ref_enc_block @ ios : 160#B;
expect_range_ref("revised_blob_reference_heap_within_declared_eof",
                 bytes_to_u64_le(blob_ref.heap_addr_raw) == 100UL);

byte[14] @ ios : 176#B = [3UB, 0UB, 8UB, 0UB, 0UB, 0UB,
                          0UB, 2UB, 0UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var bad_heap_rejected = 0;
try {
    var bad_heap = ref_enc_block @ ios : 176#B;
} catch (Exception e) {
    bad_heap_rejected = 1;
}
expect_range_ref("revised_blob_reference_heap_at_declared_eof_rejected", bad_heap_rejected);

byte[14] @ ios : 192#B = [0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
                          0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var null_ref = ref_enc_block @ ios : 192#B;
expect_range_ref("revised_null_reference_accepts_nil_descriptor",
                 null_ref.hdr.ref_type == 0UB);

close(ios);
if (failures != 0) {
    printf("UNIT RANGES/REFS: %i32d failure(s)\n", failures);
    exit(1);
}
printf("UNIT RANGES/REFS: all passed\n");
