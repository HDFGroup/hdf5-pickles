load "common.pk";
load "ohdr_msgs.pk";
load "superblock.pk";

var ohdr_msg_failures = 0;

fun expect_ohdr_msg = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else
        {
            printf("FAIL %s\n", name);
            ohdr_msg_failures = ohdr_msg_failures + 1;
        }
}

/* Keep the payloads compact while still exercising file-width handling. */
set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);

/* Hard links omit the link-type byte and end in an object-header address. */
var hard_blob = [1UB, 0UB, 1UB, 104UB,
                 120UB, 86UB, 52UB, 18UB];
var hard_ios = open("*unit-ohdr-link-hard*");
byte[hard_blob'length] @ hard_ios : 0#B = hard_blob;
var hard_link = oh_msg_link @ hard_ios : 0#B;
expect_ohdr_msg("link_hard_payload",
                hard_link'size/#B == hard_blob'length
                && hard_link.lnk_name'length == 1
                && hard_link.lnk_name[0] == 'h'
                && bytes_to_u64_le(hard_link.ohdr_addr_raw) == 0x12345678UL);
close(hard_ios);

/* Soft links carry a uint16 length and a non-null-terminated target. */
var soft_blob = [1UB, 8UB, 1UB, 1UB, 120UB,
                 3UB, 0UB, 97UB, 98UB, 99UB];
var soft_ios = open("*unit-ohdr-link-soft*");
byte[soft_blob'length] @ soft_ios : 0#B = soft_blob;
var soft_link = oh_msg_link @ soft_ios : 0#B;
expect_ohdr_msg("link_soft_payload",
                soft_link'size/#B == soft_blob'length
                && soft_link.lnk_type == LNK_TYPE_SOFT
                && soft_link.soft_len == 3UH
                && soft_link.soft_name'length == 3
                && soft_link.soft_name[0] == 'a'
                && soft_link.soft_name[2] == 'c');
close(soft_ios);

/* External links use link type 64 and store their encoded value in ud_data. */
var external_blob = [1UB, 8UB, 64UB, 1UB, 120UB,
                     4UB, 0UB, 0UB, 102UB, 0UB, 0UB];
var external_ios = open("*unit-ohdr-link-external*");
byte[external_blob'length] @ external_ios : 0#B = external_blob;
var external_link = oh_msg_link @ external_ios : 0#B;
expect_ohdr_msg("link_external_payload",
                external_link'size/#B == external_blob'length
                && external_link.lnk_type == LNK_TYPE_EXT
                && external_link.ud_len == 4UH
                && external_link.ud_data'length == 4
                && external_link.ud_data[1] == 'f');
close(external_ios);

/* Values above 64 are user-defined links and share the ud_data layout. */
var user_blob = [1UB, 8UB, 65UB, 1UB, 117UB,
                 2UB, 0UB, 65UB, 66UB];
var user_ios = open("*unit-ohdr-link-user-defined*");
byte[user_blob'length] @ user_ios : 0#B = user_blob;
var user_link = oh_msg_link @ user_ios : 0#B;
expect_ohdr_msg("link_user_defined_payload",
                user_link'size/#B == user_blob'length
                && user_link.lnk_type == 65UB
                && user_link.ud_len == 2UH
                && user_link.ud_data'length == 2
                && user_link.ud_data[0] == 'A'
                && user_link.ud_data[1] == 'B');
close(user_ios);

/* A v1 dataspace stores one maximum dimension per declared dimension. */
var dspace_max_blob =
    [1UB, 2UB, 1UB, 0UB, 0UB, 0UB, 0UB, 0UB,
     3UB, 0UB, 0UB, 0UB, 4UB, 0UB, 0UB, 0UB,
     5UB, 0UB, 0UB, 0UB, 6UB, 0UB, 0UB, 0UB];
var dspace_max_ios = open("*unit-ohdr-dspace-v1-max*");
byte[dspace_max_blob'length] @ dspace_max_ios : 0#B = dspace_max_blob;
var dspace_max = oh_msg_sdspace @ dspace_max_ios : 0#B;
expect_ohdr_msg("dataspace_v1_max_array",
                dspace_max'size/#B == dspace_max_blob'length
                && dspace_max.space.v1.ndims == 2UB
                && dspace_max.space.v1.dim_size'length == 2
                && bytes_to_u64_le(dspace_max.space.v1.dim_size[1]) == 4UL
                && dspace_max.space.v1.max'length == 2
                && bytes_to_u64_le(dspace_max.space.v1.max[0]) == 5UL
                && bytes_to_u64_le(dspace_max.space.v1.max[1]) == 6UL);
close(dspace_max_ios);

/* The deprecated permutation vector has the same ndims cardinality, even
   though current libhdf5 versions do not emit it. */
var dspace_perm_blob =
    [1UB, 2UB, 2UB, 0UB, 0UB, 0UB, 0UB, 0UB,
     3UB, 0UB, 0UB, 0UB, 4UB, 0UB, 0UB, 0UB,
     7UB, 0UB, 0UB, 0UB, 8UB, 0UB, 0UB, 0UB];
var dspace_perm_ios = open("*unit-ohdr-dspace-v1-perm*");
byte[dspace_perm_blob'length] @ dspace_perm_ios : 0#B = dspace_perm_blob;
var dspace_perm = oh_msg_sdspace @ dspace_perm_ios : 0#B;
expect_ohdr_msg("dataspace_v1_perm_array",
                dspace_perm'size/#B == dspace_perm_blob'length
                && dspace_perm.space.v1.ndims == 2UB
                && dspace_perm.space.v1.perm'length == 2
                && bytes_to_u64_le(dspace_perm.space.v1.perm[0]) == 7UL
                && bytes_to_u64_le(dspace_perm.space.v1.perm[1]) == 8UL);
close(dspace_perm_ios);

/* When both flags are set, max precedes perm and each vector has ndims
   entries.  Pinning the final values also pins the second vector's offset. */
var dspace_max_perm_blob =
    [1UB, 2UB, 3UB, 0UB, 0UB, 0UB, 0UB, 0UB,
     3UB, 0UB, 0UB, 0UB, 4UB, 0UB, 0UB, 0UB,
     5UB, 0UB, 0UB, 0UB, 6UB, 0UB, 0UB, 0UB,
     7UB, 0UB, 0UB, 0UB, 8UB, 0UB, 0UB, 0UB];
var dspace_max_perm_ios = open("*unit-ohdr-dspace-v1-max-perm*");
byte[dspace_max_perm_blob'length] @ dspace_max_perm_ios : 0#B =
    dspace_max_perm_blob;
var dspace_max_perm = oh_msg_sdspace @ dspace_max_perm_ios : 0#B;
expect_ohdr_msg("dataspace_v1_max_and_perm_arrays",
                dspace_max_perm'size/#B == dspace_max_perm_blob'length
                && dspace_max_perm.space.v1.max'length == 2
                && bytes_to_u64_le(dspace_max_perm.space.v1.max[1]) == 6UL
                && dspace_max_perm.space.v1.perm'length == 2
                && bytes_to_u64_le(dspace_max_perm.space.v1.perm[1]) == 8UL);
close(dspace_max_perm_ios);

/* Version 2 omits name-length and name fields for built-in filters.  Nonzero
   client data makes a stray name-length field shift the descriptor and expose
   the bug immediately: the shuffle element size would become cd_nelmts. */
var pline_v2_builtin_blob =
    [2UB, 2UB,
     2UB, 0UB, 0UB, 0UB, 1UB, 0UB, 8UB, 0UB, 0UB, 0UB,
     1UB, 0UB, 0UB, 0UB, 1UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var pline_v2_builtin_ios = open("*unit-ohdr-pline-v2-builtins*");
byte[pline_v2_builtin_blob'length] @ pline_v2_builtin_ios : 0#B =
    pline_v2_builtin_blob;
var pline_v2_builtin = oh_msg_pline @ pline_v2_builtin_ios : 0#B;
expect_ohdr_msg("pline_v2_builtin_names_omitted",
                pline_v2_builtin'size/#B == pline_v2_builtin_blob'length
                && pline_v2_builtin.pline.v2.filt_list'length == 2
                && pline_v2_builtin.pline.v2.filt_list[0].id == 2UH
                && pline_v2_builtin.pline.v2.filt_list[0].flags == 0UH
                && pline_v2_builtin.pline.v2.filt_list[0].cd_nelmts == 1UH
                && pline_v2_builtin.pline.v2.filt_list[0].cd_data[0] == 8U
                && pline_v2_builtin.pline.v2.filt_list[1].id == 1UH
                && pline_v2_builtin.pline.v2.filt_list[1].cd_data[0] == 1U);
close(pline_v2_builtin_ios);

/* User-defined filters retain the v2 name-length and name fields. */
var pline_v2_user_blob =
    [2UB, 1UB,
     0UB, 125UB, 4UB, 0UB, 1UB, 0UB, 1UB, 0UB,
     102UB, 111UB, 111UB, 0UB,
     42UB, 0UB, 0UB, 0UB];
var pline_v2_user_ios = open("*unit-ohdr-pline-v2-user*");
byte[pline_v2_user_blob'length] @ pline_v2_user_ios : 0#B =
    pline_v2_user_blob;
var pline_v2_user = oh_msg_pline @ pline_v2_user_ios : 0#B;
expect_ohdr_msg("pline_v2_user_name_retained",
                pline_v2_user'size/#B == pline_v2_user_blob'length
                && pline_v2_user.pline.v2.filt_list[0].id == 32000UH
                && pline_v2_user.pline.v2.filt_list[0].name_len == 4UH
                && pline_v2_user.pline.v2.filt_list[0].name[0] == 'f'
                && pline_v2_user.pline.v2.filt_list[0].name[2] == 'o'
                && pline_v2_user.pline.v2.filt_list[0].cd_nelmts == 1UH
                && pline_v2_user.pline.v2.filt_list[0].cd_data[0] == 42U);
close(pline_v2_user_ios);

/* Version 1 always carries name_len (unconditionally, unlike v2) and pads
   client data to an even element count.  Coverage gap: until now this file
   only exercised v2 -- add v1 so both arms of the #14/#15 guard have a
   real decode pinned, not just v2. */
var pline_v1_blob =
    [1UB, 1UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
     5UB, 0UB, 0UB, 0UB, 0UB, 0UB, 1UB, 0UB,
     7UB, 0UB, 0UB, 0UB,
     0UB, 0UB, 0UB, 0UB];
var pline_v1_ios = open("*unit-ohdr-pline-v1*");
byte[pline_v1_blob'length] @ pline_v1_ios : 0#B = pline_v1_blob;
var pline_v1 = oh_msg_pline @ pline_v1_ios : 0#B;
expect_ohdr_msg("pline_v1_odd_cd_nelmts_padded",
                pline_v1'size/#B == pline_v1_blob'length
                && pline_v1.pline.v1.filt_list[0].id == 5UH
                && pline_v1.pline.v1.filt_list[0].name_len == 0UH
                && pline_v1.pline.v1.filt_list[0].cd_nelmts == 1UH
                && pline_v1.pline.v1.filt_list[0].cd_data[0] == 7U);
close(pline_v1_ios);

/* A v4 chunked layout's final encoded dimension is the stored datatype size,
   not another chunk-shape dimension.  This mirrors the X_mm failure shape:
   chunk dimensions [1, 1280] followed by a stale four-byte element size. */
var layout_v4_element_blob =
    [4UB, 2UB, 0UB, 3UB, 2UB,
     1UB, 0UB, 0UB, 5UB, 4UB, 0UB,
     1UB,
     0xffUB, 0xffUB, 0xffUB, 0xffUB];
var layout_v4_element_ios = open("*unit-ohdr-layout-v4-element-size*");
byte[layout_v4_element_blob'length] @ layout_v4_element_ios : 0#B =
    layout_v4_element_blob;
var layout_v4_element = oh_msg_layout @ layout_v4_element_ios : 0#B;
expect_ohdr_msg("layout_v4_stored_element_size",
                layout_v4_element'size/#B == layout_v4_element_blob'length
                && oh_layout_has_stored_element_size(layout_v4_element)
                && oh_layout_stored_element_size(layout_v4_element) == 4UL);
close(layout_v4_element_ios);

/* Version 0 uses the legacy strategy byte and omits manager addresses unless
   the strategy is ALL_PERSIST (1). */
var fsinfo_v0_blob = [0UB, 2UB, 16UB, 0UB, 0UB, 0UB];
var fsinfo_v0_ios = open("*unit-ohdr-fsinfo-v0*");
byte[fsinfo_v0_blob'length] @ fsinfo_v0_ios : 0#B = fsinfo_v0_blob;
var fsinfo_v0 = oh_msg_fsinfo @ fsinfo_v0_ios : 0#B;
expect_ohdr_msg("fsinfo_v0_without_addresses",
                fsinfo_v0'size/#B == fsinfo_v0_blob'length
                && fsinfo_v0.info.v0.strategy == 2UB
                && bytes_to_u64_le(fsinfo_v0.info.v0.threshold) == 16UL);
close(fsinfo_v0_ios);

/* ALL_PERSIST version 0 messages carry one address for each of the six
   legacy allocation types, with no small/large split. */
var fsinfo_v0_persist_blob =
    [0UB, 1UB, 16UB, 0UB, 0UB, 0UB,
     1UB, 0UB, 0UB, 0UB, 2UB, 0UB, 0UB, 0UB,
     3UB, 0UB, 0UB, 0UB, 4UB, 0UB, 0UB, 0UB,
     5UB, 0UB, 0UB, 0UB, 6UB, 0UB, 0UB, 0UB];
var fsinfo_v0_persist_ios = open("*unit-ohdr-fsinfo-v0-persist*");
byte[fsinfo_v0_persist_blob'length] @ fsinfo_v0_persist_ios : 0#B =
    fsinfo_v0_persist_blob;
var fsinfo_v0_persist = oh_msg_fsinfo @ fsinfo_v0_persist_ios : 0#B;
expect_ohdr_msg("fsinfo_v0_with_addresses",
                fsinfo_v0_persist'size/#B == fsinfo_v0_persist_blob'length
                && fsinfo_v0_persist.info.v0.fs_addr'length == 6
                && bytes_to_u64_le(
                       fsinfo_v0_persist.info.v0.fs_addr[0]) == 1UL
                && bytes_to_u64_le(
                       fsinfo_v0_persist.info.v0.fs_addr[5]) == 6UL);
close(fsinfo_v0_persist_ios);

/* Version 1 always carries page/EOA fields but omits all twelve manager
   addresses when persistence is disabled. */
var fsinfo_v1_blob =
    [1UB, 1UB, 0UB,
     16UB, 0UB, 0UB, 0UB,
     0UB, 16UB, 0UB, 0UB,
     32UB, 0UB,
     52UB, 18UB, 0UB, 0UB];
var fsinfo_v1_ios = open("*unit-ohdr-fsinfo-v1*");
byte[fsinfo_v1_blob'length] @ fsinfo_v1_ios : 0#B = fsinfo_v1_blob;
var fsinfo_v1 = oh_msg_fsinfo @ fsinfo_v1_ios : 0#B;
expect_ohdr_msg("fsinfo_v1_without_addresses",
                fsinfo_v1'size/#B == fsinfo_v1_blob'length
                && fsinfo_v1.info.v1.strategy == 1UB
                && fsinfo_v1.info.v1.persist == 0UB
                && bytes_to_u64_le(fsinfo_v1.info.v1.page_size) == 4096UL
                && bytes_to_u64_le(fsinfo_v1.info.v1.eoa) == 0x1234UL);
close(fsinfo_v1_ios);

/* Persistent version 1 messages append six small-allocation and six
   large-allocation manager addresses. */
var fsinfo_v1_persist_blob =
    [1UB, 0UB, 1UB,
     16UB, 0UB, 0UB, 0UB,
     0UB, 16UB, 0UB, 0UB,
     32UB, 0UB,
     52UB, 18UB, 0UB, 0UB,
     1UB, 0UB, 0UB, 0UB, 2UB, 0UB, 0UB, 0UB,
     3UB, 0UB, 0UB, 0UB, 4UB, 0UB, 0UB, 0UB,
     5UB, 0UB, 0UB, 0UB, 6UB, 0UB, 0UB, 0UB,
     7UB, 0UB, 0UB, 0UB, 8UB, 0UB, 0UB, 0UB,
     9UB, 0UB, 0UB, 0UB, 10UB, 0UB, 0UB, 0UB,
     11UB, 0UB, 0UB, 0UB, 12UB, 0UB, 0UB, 0UB];
var fsinfo_v1_persist_ios = open("*unit-ohdr-fsinfo-v1-persist*");
byte[fsinfo_v1_persist_blob'length] @ fsinfo_v1_persist_ios : 0#B =
    fsinfo_v1_persist_blob;
var fsinfo_v1_persist = oh_msg_fsinfo @ fsinfo_v1_persist_ios : 0#B;
expect_ohdr_msg("fsinfo_v1_with_addresses",
                fsinfo_v1_persist'size/#B == fsinfo_v1_persist_blob'length
                && fsinfo_v1_persist.info.v1.small_fs_addr'length == 6
                && fsinfo_v1_persist.info.v1.large_fs_addr'length == 6
                && bytes_to_u64_le(
                       fsinfo_v1_persist.info.v1.small_fs_addr[5]) == 6UL
                && bytes_to_u64_le(
                       fsinfo_v1_persist.info.v1.large_fs_addr[0]) == 7UL
                && bytes_to_u64_le(
                       fsinfo_v1_persist.info.v1.large_fs_addr[5]) == 12UL);
close(fsinfo_v1_persist_ios);

/* Datatype message version 5 adds Complex class 11.  A homogeneous
   rectangular complex64 is an 8-byte outer type followed immediately by its
   4-byte IEEE floating-point base datatype. */
var f32le_blob =
    [0x11UB, 0x20UB, 0x1fUB, 0UB, 4UB, 0UB, 0UB, 0UB,
     0UB, 0UB, 32UB, 0UB, 23UB, 8UB, 0UB, 23UB,
     127UB, 0UB, 0UB, 0UB];
/* Class bits: bit 0 homogeneous, bits 1-2 form (0 = rectangular).  */
var complex_f32le_blob =
    [0x5bUB, 0x01UB, 0UB, 0UB, 8UB, 0UB, 0UB, 0UB] + f32le_blob;
var complex_f32le_ios = open("*unit-ohdr-dtype-v5-complex-f32le*");
byte[complex_f32le_blob'length] @ complex_f32le_ios : 0#B =
    complex_f32le_blob;
var complex_f32le = oh_msg_dtype @ complex_f32le_ios : 0#B;
expect_ohdr_msg("dtype_v5_complex_f32le",
                complex_f32le'size/#B == complex_f32le_blob'length
                && complex_f32le.hdr.get_version() == 5
                && complex_f32le.hdr.get_ctype() == 11
                && complex_f32le.hdr.elm_size == 8U
                && complex_f32le.types.complex.homogeneous() == 1
                && complex_f32le.types.complex.form() == 0
                && complex_f32le.types.complex.base_hdr.get_ctype() == 1
                && complex_f32le.types.complex.base_hdr.elm_size == 4U
                && complex_f32le.types.complex.base_props'length == 12);
close(complex_f32le_ios);

/* Only the homogeneous rectangular encoding has a defined property layout, so a
   complex whose class bit 0 is clear decodes as the header alone: no base type is
   invented, and dtype_props_size_at reports that it cannot size the properties
   (0) rather than the 20 bytes the homogeneous layout would have.  The same holds
   for a reserved form; here the bytes after the header are a valid float, which
   is exactly what makes a fabricated base type look plausible.  */
var complex_het_blob =                          /* homogeneous bit cleared */
    [0x5bUB, 0x00UB, 0UB, 0UB, 8UB, 0UB, 0UB, 0UB] + f32le_blob;
var complex_het_ios = open("*unit-ohdr-dtype-v5-complex-heterogeneous*");
byte[complex_het_blob'length] @ complex_het_ios : 0#B = complex_het_blob;
var complex_het = oh_msg_dtype @ complex_het_ios : 0#B;
expect_ohdr_msg("dtype_v5_complex_undefined_encoding",
                complex_het'size/#B == 8
                && complex_het.hdr.get_ctype() == 11
                && complex_het.hdr.complex_encoding_defined() == 0
                && complex_het.types.complex_undefined.homogeneous() == 0
                && dtype_props_size_at(0#B) == 0U);
close(complex_het_ios);

var complex_polar_blob =                        /* homogeneous, form = polar */
    [0x5bUB, 0x03UB, 0UB, 0UB, 8UB, 0UB, 0UB, 0UB] + f32le_blob;
var complex_polar_ios = open("*unit-ohdr-dtype-v5-complex-polar*");
byte[complex_polar_blob'length] @ complex_polar_ios : 0#B = complex_polar_blob;
var complex_polar = oh_msg_dtype @ complex_polar_ios : 0#B;
expect_ohdr_msg("dtype_v5_complex_polar_form_undefined",
                complex_polar'size/#B == 8
                && complex_polar.hdr.complex_encoding_defined() == 0
                && complex_polar.types.complex_undefined.homogeneous() == 1
                && complex_polar.types.complex_undefined.form() == 1
                && dtype_props_size_at(0#B) == 0U);
close(complex_polar_ios);

/* Composite parents inherit the highest nested datatype version.  Version-5
   arrays retain the compact version-3 dimension layout (no permutation
   vector), then embed the Complex datatype recursively. */
var array_complex_blob =
    [0x5aUB, 0UB, 0UB, 0UB, 0x20UB, 0x03UB, 0UB, 0UB,
     2UB, 10UB, 0UB, 0UB, 0UB, 10UB, 0UB, 0UB, 0UB]
    + complex_f32le_blob;
var array_complex_ios = open("*unit-ohdr-dtype-v5-array-complex*");
byte[array_complex_blob'length] @ array_complex_ios : 0#B =
    array_complex_blob;
var array_complex = oh_msg_dtype @ array_complex_ios : 0#B;
expect_ohdr_msg("dtype_v5_array_of_complex",
                array_complex'size/#B == array_complex_blob'length
                && array_complex.hdr.get_version() == 5
                && array_complex.hdr.get_ctype() == 10
                && array_complex.types.array.arr.v3.ndims == 2UB
                && array_complex.types.array.arr.v3.dim_size[0] == 10U
                && array_complex.types.array.arr.v3.dim_size[1] == 10U
                && array_complex.types.array.base_hdr.get_version() == 5
                && array_complex.types.array.base_hdr.get_ctype() == 11
                && array_complex.types.array.base_props'length == 20);
close(array_complex_ios);

/* Compound (class 6) has three property-layout versions (compound_props1/2/3,
   dispatched on the datatype header's version); until now this file didn't
   exercise any of them.  Each of the three is a real coverage gap on its own,
   and together they exercise the #14/#15 guard on oh_msg_dtype's compound
   membs union (see ohdr_msgs.pk) for all three of its arms, not just the one
   real files happen to use most.  Each member is a single fixed-point (class
   0) field, the cheapest properties layout to hand-encode. */
var compound_v1_blob =
    [0x16UB, 0x01UB, 0x00UB, 0x00UB,   /* flags: ctype=6 (compound), ver=1, nn=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* elm_size=4 */
     'a'as byte, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, /* memb_name "a", padded to 8 */
     0UB, 0UB, 0UB, 0UB,                             /* memb_off */
     0UB,                                            /* ndim = 0 (scalar) */
     0UB, 0UB, 0UB,                                  /* res1 */
     0UB, 0UB, 0UB, 0UB,                             /* perm */
     0UB, 0UB, 0UB, 0UB,                             /* res2 */
     0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, /* dim_sizes */
     0x10UB, 0x00UB, 0x00UB, 0x00UB,   /* memb_hdr.flags: ctype=0 (fixed-point), ver=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* memb_hdr.elm_size=4 */
     0x00UB, 0x00UB, 0x20UB, 0x00UB];  /* memb_props: bit_offset=0, bit_precision=32 */
var compound_v1_ios = open("*unit-ohdr-dtype-compound-v1*");
byte[compound_v1_blob'length] @ compound_v1_ios : 0#B = compound_v1_blob;
var compound_v1 = oh_msg_dtype @ compound_v1_ios : 0#B;
expect_ohdr_msg("dtype_compound_v1_single_member",
                compound_v1'size/#B == compound_v1_blob'length
                && compound_v1.hdr.get_ctype() == 6
                && compound_v1.hdr.get_version() == 1
                && compound_v1.types.compound.membs.v1'length == 1
                && compound_v1.types.compound.membs.v1[0].memb_name == "a"
                && compound_v1.types.compound.membs.v1[0].memb_hdr.get_ctype() == 0
                && compound_v1.types.compound.membs.v1[0].memb_hdr.elm_size == 4U
                && compound_v1.types.compound.membs.v1[0].memb_props'length == 4);
close(compound_v1_ios);

var compound_v2_blob =
    [0x26UB, 0x01UB, 0x00UB, 0x00UB,   /* flags: ctype=6, ver=2, nn=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* elm_size=4 */
     'b'as byte, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, /* memb_name "b", padded to 8 */
     0UB, 0UB, 0UB, 0UB,                             /* memb_off */
     0x10UB, 0x00UB, 0x00UB, 0x00UB,   /* memb_hdr.flags: ctype=0, ver=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* memb_hdr.elm_size=4 */
     0x00UB, 0x00UB, 0x18UB, 0x00UB];  /* memb_props: bit_offset=0, bit_precision=24 */
var compound_v2_ios = open("*unit-ohdr-dtype-compound-v2*");
byte[compound_v2_blob'length] @ compound_v2_ios : 0#B = compound_v2_blob;
var compound_v2 = oh_msg_dtype @ compound_v2_ios : 0#B;
expect_ohdr_msg("dtype_compound_v2_single_member",
                compound_v2'size/#B == compound_v2_blob'length
                && compound_v2.hdr.get_ctype() == 6
                && compound_v2.hdr.get_version() == 2
                && compound_v2.types.compound.membs.v2'length == 1
                && compound_v2.types.compound.membs.v2[0].memb_name == "b"
                && compound_v2.types.compound.membs.v2[0].memb_hdr.elm_size == 4U
                && compound_v2.types.compound.membs.v2[0].memb_props'length == 4);
close(compound_v2_ios);

var compound_v3_blob =
    [0x36UB, 0x01UB, 0x00UB, 0x00UB,   /* flags: ctype=6, ver=3, nn=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* elm_size=4 (record size -> memb_off width=1) */
     'c'as byte, 0UB,                  /* memb_name "c", NUL-terminated, unpadded */
     0UB,                              /* memb_off (1 byte, since elm_size<256) */
     0x10UB, 0x00UB, 0x00UB, 0x00UB,   /* memb_hdr.flags: ctype=0, ver=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* memb_hdr.elm_size=4 */
     0x00UB, 0x00UB, 0x10UB, 0x00UB];  /* memb_props: bit_offset=0, bit_precision=16 */
var compound_v3_ios = open("*unit-ohdr-dtype-compound-v3*");
byte[compound_v3_blob'length] @ compound_v3_ios : 0#B = compound_v3_blob;
var compound_v3 = oh_msg_dtype @ compound_v3_ios : 0#B;
expect_ohdr_msg("dtype_compound_v3_single_member",
                compound_v3'size/#B == compound_v3_blob'length
                && compound_v3.hdr.get_ctype() == 6
                && compound_v3.hdr.get_version() == 3
                && compound_v3.types.compound.membs.v3'length == 1
                && compound_v3.types.compound.membs.v3[0].memb_name == "c"
                && compound_v3.types.compound.membs.v3[0].memb_hdr.elm_size == 4U
                && compound_v3.types.compound.membs.v3[0].memb_props'length == 4);
close(compound_v3_ios);

/* The decode tests above only pin the *correct* arm's output -- they would
   still pass if compound_propsN's `_guard` field were deleted, since the
   guard changes only how much wasted work happens on a wrong-version
   attempt, never the final decoded value (see PR #90 review discussion on
   issue #15). Isolate the guard itself instead: map compound_propsN
   directly, with global_compound_ver deliberately mismatched, against an
   empty backing IOS. If the guard fires (as intended), mapping fails
   immediately with a constraint violation, before memb_name or any other
   field is read. If the guard were ever removed or its condition broken,
   mapping would instead proceed to read memb_name from the empty IOS and
   fail with EOF instead -- a different, distinguishable exception -- so
   this test regresses visibly rather than silently. */
var guard_empty_ios = open("*unit-ohdr-dtype-compound-guard-empty*");

global_compound_ver = 2;   /* compound_props1's guard requires == 1 */
var compound_v1_guard_code = 0;
try {
    var _unused_v1 = compound_props1 @ guard_empty_ios : 0#B;
} catch (Exception e) {
    compound_v1_guard_code = e.code;
}
expect_ohdr_msg("dtype_compound_v1_guard_rejects_before_mapping",
                compound_v1_guard_code == 10);

global_compound_ver = 1;   /* compound_props2's guard requires == 2 */
var compound_v2_guard_code = 0;
try {
    var _unused_v2 = compound_props2 @ guard_empty_ios : 0#B;
} catch (Exception e) {
    compound_v2_guard_code = e.code;
}
expect_ohdr_msg("dtype_compound_v2_guard_rejects_before_mapping",
                compound_v2_guard_code == 10);

global_compound_ver = 2;   /* compound_props3's guard requires >= 3 */
var compound_v3_guard_code = 0;
try {
    var _unused_v3 = compound_props3 @ guard_empty_ios : 0#B;
} catch (Exception e) {
    compound_v3_guard_code = e.code;
}
expect_ohdr_msg("dtype_compound_v3_guard_rejects_before_mapping",
                compound_v3_guard_code == 10);
close(guard_empty_ios);

/* Coverage gap: the outer oh_msg_dtype.types union (one arm per datatype
   class) had no test at all for enumeration or variable-length, and this
   is the union the PR #90 review found unaudited for #14/#15 -- the
   enumeration arm in particular can size a byte[nn*base_hdr.elm_size]
   read from bits that are unconstrained for any other class. These are
   valid-arm decoding tests like the ones above; they don't establish
   order-independence on their own (see the compound guard-isolation tests
   above for why that's structurally hard here -- these arms are anonymous,
   not standalone types), but they do close a real gap and would catch a
   broken guard *condition*. */
var enum_v1_blob =
    [0x18UB, 0x01UB, 0x00UB, 0x00UB,   /* flags: ctype=8, ver=1, nn=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* elm_size=4 */
     0x10UB, 0x00UB, 0x00UB, 0x00UB,   /* base_hdr.flags: ctype=0, ver=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* base_hdr.elm_size=4 */
     0x00UB, 0x00UB, 0x20UB, 0x00UB,   /* base_props: bit_offset=0, bit_precision=32 */
     'x'as byte, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, /* memb_names.v1_2[0].name "x", padded to 8 */
     7UB, 0UB, 0UB, 0UB];              /* memb_values: one int32 = 7 */
var enum_v1_ios = open("*unit-ohdr-dtype-enum-v1*");
byte[enum_v1_blob'length] @ enum_v1_ios : 0#B = enum_v1_blob;
var enum_v1 = oh_msg_dtype @ enum_v1_ios : 0#B;
expect_ohdr_msg("dtype_enumeration_v1_single_member",
                enum_v1'size/#B == enum_v1_blob'length
                && enum_v1.hdr.get_ctype() == 8
                && enum_v1.hdr.get_version() == 1
                && enum_v1.types.enumeration.base_hdr.get_ctype() == 0
                && enum_v1.types.enumeration.memb_names.v1_2[0].name == "x"
                && enum_v1.types.enumeration.memb_values'length == 4);
close(enum_v1_ios);

/* Coverage gap: no v3 enumeration test existed either. Also exercises
   enum_name_v3, the wrapper type added to guard memb_names' v3 alternative
   (poke's built-in `string` type can't carry a `_guard` field directly). */
var enum_v3_blob =
    [0x38UB, 0x01UB, 0x00UB, 0x00UB,   /* flags: ctype=8, ver=3, nn=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* elm_size=4 */
     0x10UB, 0x00UB, 0x00UB, 0x00UB,   /* base_hdr.flags: ctype=0, ver=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* base_hdr.elm_size=4 */
     0x00UB, 0x00UB, 0x20UB, 0x00UB,   /* base_props: bit_offset=0, bit_precision=32 */
     'y'as byte, 0UB,                  /* memb_names.v3[0].name "y", NUL-terminated, unpadded */
     7UB, 0UB, 0UB, 0UB];              /* memb_values: one int32 = 7 */
var enum_v3_ios = open("*unit-ohdr-dtype-enum-v3*");
byte[enum_v3_blob'length] @ enum_v3_ios : 0#B = enum_v3_blob;
var enum_v3 = oh_msg_dtype @ enum_v3_ios : 0#B;
expect_ohdr_msg("dtype_enumeration_v3_single_member",
                enum_v3'size/#B == enum_v3_blob'length
                && enum_v3.hdr.get_ctype() == 8
                && enum_v3.hdr.get_version() == 3
                && enum_v3.types.enumeration.memb_names.v3[0].name == "y"
                && enum_v3.types.enumeration.memb_values'length == 4);
close(enum_v3_ios);

/* Isolated guard test, same technique as the compound_propsN tests above
   (see PR #90 review discussion on issue #15): map enum_props/enum_name_v3
   directly, with global_enum_ver deliberately mismatched, against an empty
   IOS. A fired guard fails with a constraint violation before memb_names'
   name field is ever read; a missing/broken guard would instead reach for
   that field on the empty IOS and fail with EOF -- a different,
   distinguishable exception, so this regresses visibly. */
var enum_guard_empty_ios = open("*unit-ohdr-dtype-enum-guard-empty*");

global_enum_ver = 3;   /* enum_props' guard requires <= 2 */
var enum_v1_2_guard_code = 0;
try {
    var _unused_enum_v1_2 = enum_props @ enum_guard_empty_ios : 0#B;
} catch (Exception e) {
    enum_v1_2_guard_code = e.code;
}
expect_ohdr_msg("dtype_enumeration_v1_2_guard_rejects_before_mapping",
                enum_v1_2_guard_code == 10);

global_enum_ver = 1;   /* enum_name_v3's guard requires >= 3 */
var enum_v3_guard_code = 0;
try {
    var _unused_enum_v3 = enum_name_v3 @ enum_guard_empty_ios : 0#B;
} catch (Exception e) {
    enum_v3_guard_code = e.code;
}
expect_ohdr_msg("dtype_enumeration_v3_guard_rejects_before_mapping",
                enum_v3_guard_code == 10);
close(enum_guard_empty_ios);

var vlen_v1_blob =
    [0x19UB, 0x00UB, 0x00UB, 0x00UB,   /* flags: ctype=9, ver=1, vlen_type=0 (sequence) */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* elm_size=4 */
     0x10UB, 0x00UB, 0x00UB, 0x00UB,   /* base_hdr.flags: ctype=0, ver=1 */
     0x04UB, 0x00UB, 0x00UB, 0x00UB,   /* base_hdr.elm_size=4 */
     0x00UB, 0x00UB, 0x20UB, 0x00UB];  /* base_props: bit_offset=0, bit_precision=32 */
var vlen_v1_ios = open("*unit-ohdr-dtype-vlen-v1*");
byte[vlen_v1_blob'length] @ vlen_v1_ios : 0#B = vlen_v1_blob;
var vlen_v1 = oh_msg_dtype @ vlen_v1_ios : 0#B;
expect_ohdr_msg("dtype_variable_length_v1_sequence",
                vlen_v1'size/#B == vlen_v1_blob'length
                && vlen_v1.hdr.get_ctype() == 9
                && vlen_v1.hdr.get_version() == 1
                && vlen_v1.types.variable_length.base_hdr.get_ctype() == 0
                && vlen_v1.types.variable_length.base_props'length == 4);
close(vlen_v1_ios);

/* A version-3 fill value whose bytes leave the version-1/2 arm's
   fill_defined at zero. That arm's optional fill_size is then absent, so
   testing it without first testing fill_defined raises E_elem -- which a
   union does not recover from, unlike the E_constraint that rejects the arm.
   The payload below is what a shared fill value resolves to out of a tiny
   fractal-heap ID, where the bytes past the message are the ID's zero
   padding. */
var fill_v3_blob = [3UB, 10UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var fill_v3_ios = open("*unit-ohdr-fill-v3-zero-tail*");
byte[fill_v3_blob'length] @ fill_v3_ios : 0#B = fill_v3_blob;
var fill_v3 = oh_msg_fill @ fill_v3_ios : 0#B;
expect_ohdr_msg("fill_v3_absent_fill_size",
                fill_v3'size/#B == 2
                && fill_v3.version == 3UB
                && fill_v3.space.v3.flags == 10UB);
close(fill_v3_ios);

/* Coverage gap: until now this file only exercised oh_msg_fill's v3 arm.
   A v1/v2 message with fill_defined set exercises the other arm of the
   #14/#15 guard (see ohdr_msgs.pk), including its own fill_size/fill_value
   pair. */
var fill_v1v2_blob = [2UB, 5UB, 1UB, 1UB, 3UB, 0UB, 0UB, 0UB, 9UB, 9UB, 9UB];
var fill_v1v2_ios = open("*unit-ohdr-fill-v1v2*");
byte[fill_v1v2_blob'length] @ fill_v1v2_ios : 0#B = fill_v1v2_blob;
var fill_v1v2 = oh_msg_fill @ fill_v1v2_ios : 0#B;
expect_ohdr_msg("fill_v1v2_defined_with_value",
                fill_v1v2'size/#B == fill_v1v2_blob'length
                && fill_v1v2.version == 2UB
                && fill_v1v2.space.v1_v2.alloc_time == 5UB
                && fill_v1v2.space.v1_v2.fill_time == 1UB
                && fill_v1v2.space.v1_v2.fill_defined == 1UB
                && fill_v1v2.space.v1_v2.fill_size == 3U
                && fill_v1v2.space.v1_v2.fill_value[0] == 9UB
                && fill_v1v2.space.v1_v2.fill_value[2] == 9UB);
close(fill_v1v2_ios);

/* An unresolvable shared message must report the sentinel rather than raise,
   so that one unreachable reference does not abort a whole object header.
   A version-3 SOHM reference is unresolvable while no Shared Message Table
   has been decoded. */
var sohm_ref_blob = [3UB, OH_SHARE_TYPE_SOHM,
                     0x21UB, 3UB, 10UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var sohm_ref_ios = open("*unit-ohdr-shared-sohm-unresolved*");
byte[sohm_ref_blob'length] @ sohm_ref_ios : 0#B = sohm_ref_blob;

/* shared_msg_payload_offset() maps in the current IOS, so make the synthetic
   reference current for the call. It reports the reason on stdout; the point
   of the case is that it returns instead of raising. */
var saved_ios = get_ios();
var saved_table_known = global_sohm_table_known;
set_ios(sohm_ref_ios);
global_sohm_table_known = 0UB;
expect_ohdr_msg("shared_sohm_unresolved_is_not_fatal",
                shared_msg_payload_offset(0#B, 0x05UB) == SHARED_MSG_UNRESOLVED);
global_sohm_table_known = saved_table_known;
set_ios(saved_ios);
close(sohm_ref_ios);

/* Exercise the complete version-3 SOHM path with a tiny fractal-heap ID:
 *
 *   shared-message reference -> SMTB index -> FRHP header -> tiny-ID bytes
 *   -> fill-value payload.
 *
 * The one-index SMTB at byte 0 owns fill-value messages and names the FRHP at
 * byte 64.  The eight-byte tiny ID starts at byte 202; its two inline bytes
 * are a version-3 fill-value message.  Keeping the header real (rather than
 * setting the derived heap globals directly) pins the map-time state that
 * distinguishes a tiny ID from a managed one. */
var shared_tiny_ios = open("*unit-ohdr-shared-sohm-tiny*");
var smtb_prefix =
    [0x53UB, 0x4dUB, 0x54UB, 0x42UB,       /* SMTB */
     0UB, 0UB, 0x20UB, 0UB,                /* v0, list, fill-value bit */
     0UB, 0UB, 0UB, 0UB,                   /* min message size */
     0UB, 0UB, 0UB, 0UB, 0UB, 0UB,         /* list/btree/message counts */
     0UB, 0UB, 0UB, 0UB,                   /* index address */
     64UB, 0UB, 0UB, 0UB];                 /* fractal-heap address */
var smtb_blob = smtb_prefix
    + hdf5_u32_le_bytes(lookup3_hashlittle(smtb_prefix, 0U));
byte[smtb_blob'length] @ shared_tiny_ios : 0#B = smtb_blob;

/* A 4-byte-width, unfiltered fractal heap with an 8-byte ID.  The fields
 * unused by tiny IDs are zero, but the doubling table is well-formed so
 * fheap_hdr computes tiny_len_extended from the on-disk header. */
var frhp_unused_fields = byte[]();
var frhp_zero_i = 0UL;
while (frhp_zero_i < 48UL) {
    frhp_unused_fields += [0UB];
    frhp_zero_i = frhp_zero_i + 1UL;
}
var frhp_blob =
    [0x46UB, 0x52UB, 0x48UB, 0x50UB,       /* FRHP */
     0UB, 8UB, 0UB, 0UB, 0UB, 0UB,         /* version, ID/filter lengths, flags */
     16UB, 0UB, 0UB, 0UB]                  /* max managed object size */
    + frhp_unused_fields
    + [2UB, 0UB,                            /* doubling-table width */
       16UB, 0UB, 0UB, 0UB,                /* starting block size */
       16UB, 0UB, 0UB, 0UB,                /* maximum direct-block size */
       8UB, 0UB, 0UB, 0UB,                 /* max heap bits, starting rows */
       0UB, 0UB, 0UB, 0UB,                 /* root address */
       0UB, 0UB]                           /* current root rows */
    + [0UB, 0UB, 0UB, 0UB];                /* checksum */
byte[frhp_blob'length] @ shared_tiny_ios : 64#B = frhp_blob;

/* v3/SOHM, then a short tiny ID: type 0x20 and length 2, followed by the
 * payload [fill-message version 3, flags 10]. */
var shared_tiny_ref = [3UB, OH_SHARE_TYPE_SOHM,
                       0x22UB, 3UB, 10UB, 0UB, 0UB, 0UB, 0UB, 0UB];
byte[shared_tiny_ref'length] @ shared_tiny_ios : 200#B = shared_tiny_ref;

saved_ios = get_ios();
set_ios(shared_tiny_ios);
set_sohm_master_table(0UL, 1UL);
var shared_tiny_payload = shared_msg_payload_offset(200#B, 0x05UB);
var shared_tiny_fill = oh_msg_fill @ shared_tiny_payload;
expect_ohdr_msg("shared_sohm_tiny_fill_payload",
                shared_tiny_payload == 203#B
                && shared_tiny_fill.version == 3UB
                && shared_tiny_fill.space.v3.flags == 10UB
                && shared_tiny_fill'size / #B == 2);
set_ios(saved_ios);
close(shared_tiny_ios);

/* A SHMESG message registers the master table it names as a side effect of
 * decoding, so a table that cannot be read must not take the message down
 * with it: the constraint runs inside message_factory, and a raise there
 * ends the walk of every message that follows.  Here the table address is
 * the undefined-address sentinel, which is what a file that never allocated
 * one carries.
 *
 * The walk below holds two messages -- the unreadable SHMESG and a NIL after
 * it -- and completing it is the property under test.  Reaching the second
 * message is what regressed. */
var bad_smtb_ios = open("*unit-ohdr-shmesg-unreadable*");
var bad_smtb_msg =
    [0x0fUB, 0UB, 8UB, 0UB, 0UB, 0UB, 0UB, 0UB]   /* v1 prefix: SHMESG, 8 */
    + [0UB,                                        /* table version         */
       0xffUB, 0xffUB, 0xffUB, 0xffUB,             /* address: undefined    */
       1UB,                                        /* one index             */
       0UB, 0UB];                                  /* pad to 8-byte extent  */
var nil_after_smtb =
    [0UB, 0UB, 8UB, 0UB, 0UB, 0UB, 0UB, 0UB]      /* v1 prefix: NIL, 8     */
    + [0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var bad_smtb_chunk = bad_smtb_msg + nil_after_smtb;
byte[bad_smtb_chunk'length] @ bad_smtb_ios : 0#B = bad_smtb_chunk;

saved_ios = get_ios();
set_ios(bad_smtb_ios);
global_sohm_table_known = 0UB;
global_version = 1;
global_crt_tracked = 0;

var bad_smtb_decoded = 0;
try {
    var bad_smtb = oh_msg_shmesg_table @ 8#B;
    bad_smtb_decoded = 1;
} catch (Exception e) {
    bad_smtb_decoded = 0;
}
expect_ohdr_msg("shmesg_with_unreadable_table_still_decodes",
                bad_smtb_decoded && global_sohm_table_known == 0UB);

var bad_smtb_walked = 0;
try {
    get_all_messages(1UB, 8, 0#B, bad_smtb_chunk'length as uint<64>);
    bad_smtb_walked = 1;
} catch (Exception e) {
    bad_smtb_walked = 0;
}
expect_ohdr_msg("unreadable_table_does_not_abort_the_message_walk",
                bad_smtb_walked);

global_sohm_table_known = 0UB;
set_ios(saved_ios);
close(bad_smtb_ios);

/* Source-derived rejection checks.  These malformed payloads must fail while
 * mapping, before their count or length fields can drive a deeper decode. */
var bad_link_flags_ios = open("*unit-ohdr-link-bad-flags*");
byte[2] @ bad_link_flags_ios : 0#B = [1UB, 0x80UB];
var bad_link_flags_rejected = 0;
try {
    var bad_link_flags = oh_msg_link @ bad_link_flags_ios : 0#B;
} catch (Exception e) {
    bad_link_flags_rejected = 1;
}
expect_ohdr_msg("link_rejects_unknown_flags", bad_link_flags_rejected);
close(bad_link_flags_ios);

var zero_link_name_ios = open("*unit-ohdr-link-zero-name*");
byte[3] @ zero_link_name_ios : 0#B = [1UB, 0UB, 0UB];
var zero_link_name_rejected = 0;
try {
    var zero_link_name = oh_msg_link @ zero_link_name_ios : 0#B;
} catch (Exception e) {
    zero_link_name_rejected = 1;
}
expect_ohdr_msg("link_rejects_zero_name_length", zero_link_name_rejected);
close(zero_link_name_ios);

var zero_cont_ios = open("*unit-ohdr-cont-zero-size*");
byte[8] @ zero_cont_ios : 0#B = [0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var zero_cont_rejected = 0;
try {
    var zero_cont = oh_msg_cont @ zero_cont_ios : 0#B;
} catch (Exception e) {
    zero_cont_rejected = 1;
}
expect_ohdr_msg("continuation_rejects_zero_size", zero_cont_rejected);
close(zero_cont_ios);

var bad_layout_version_ios = open("*unit-ohdr-layout-bad-version*");
byte[1] @ bad_layout_version_ios : 0#B = [0UB];
var bad_layout_version_rejected = 0;
try {
    var bad_layout_version = oh_msg_layout @ bad_layout_version_ios : 0#B;
} catch (Exception e) {
    bad_layout_version_rejected = 1;
}
expect_ohdr_msg("layout_rejects_version_zero", bad_layout_version_rejected);
close(bad_layout_version_ios);

var bad_layout_index_ios = open("*unit-ohdr-layout-bad-index*");
byte[6] @ bad_layout_index_ios : 0#B = [4UB, 2UB, 0UB, 0UB, 1UB, 6UB];
var bad_layout_index_rejected = 0;
try {
    var bad_layout_index = oh_msg_layout @ bad_layout_index_ios : 0#B;
} catch (Exception e) {
    bad_layout_index_rejected = 1;
}
expect_ohdr_msg("layout_rejects_unknown_index", bad_layout_index_rejected);
close(bad_layout_index_ios);

var bad_farray_param_ios = open("*unit-ohdr-layout-farray-zero-param*");
byte[7] @ bad_farray_param_ios : 0#B = [4UB, 2UB, 0UB, 0UB, 1UB, 3UB, 0UB];
var bad_farray_param_rejected = 0;
try {
    var bad_farray_param = oh_msg_layout @ bad_farray_param_ios : 0#B;
} catch (Exception e) {
    bad_farray_param_rejected = 1;
}
expect_ohdr_msg("layout_rejects_zero_fixed_array_parameter", bad_farray_param_rejected);
close(bad_farray_param_ios);

var bad_pipeline_count_ios = open("*unit-ohdr-pipeline-too-many-filters*");
byte[2] @ bad_pipeline_count_ios : 0#B = [2UB, 33UB];
var bad_pipeline_count_rejected = 0;
try {
    var bad_pipeline_count = oh_msg_pline @ bad_pipeline_count_ios : 0#B;
} catch (Exception e) {
    bad_pipeline_count_rejected = 1;
}
expect_ohdr_msg("pipeline_rejects_more_than_32_filters", bad_pipeline_count_rejected);
close(bad_pipeline_count_ios);

var bad_scalar_space_ios = open("*unit-ohdr-dspace-scalar-rank*");
byte[4] @ bad_scalar_space_ios : 0#B = [2UB, 1UB, 0UB, 0UB];
var bad_scalar_space_rejected = 0;
try {
    var bad_scalar_space = oh_msg_sdspace @ bad_scalar_space_ios : 0#B;
} catch (Exception e) {
    bad_scalar_space_rejected = 1;
}
expect_ohdr_msg("dataspace_rejects_scalar_rank", bad_scalar_space_rejected);
close(bad_scalar_space_ios);

var bad_width_ios = open("*unit-superblock-bad-width*");
byte[11] @ bad_width_ios : 0#B =
    [0x89UB, 'H', 'D', 'F', 0x0dUB, 0x0aUB, 0x1aUB, 0x0aUB,
     2UB, 3UB, 4UB];
var bad_width_rejected = 0;
try {
    var bad_width = superblock @ bad_width_ios : 0#B;
} catch (Exception e) {
    bad_width_rejected = 1;
}
expect_ohdr_msg("superblock_rejects_unsupported_field_width", bad_width_rejected);
close(bad_width_ios);

/* Superblock v2/v3 checksum is over all bytes before the trailing uint32. */
var superblock_prefix =
    [0x89UB, 'H', 'D', 'F', 0x0dUB, 0x0aUB, 0x1aUB, 0x0aUB,
     2UB, 4UB, 4UB, 0UB,
     0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
     128UB, 0UB, 0UB, 0UB, 16UB, 0UB, 0UB, 0UB];
var superblock_hash = lookup3_hashlittle(superblock_prefix, 0U);
var good_superblock_blob = superblock_prefix
    + [(superblock_hash & 0xffU) as uint<8>,
       ((superblock_hash .>> 8) & 0xffU) as uint<8>,
       ((superblock_hash .>> 16) & 0xffU) as uint<8>,
       ((superblock_hash .>> 24) & 0xffU) as uint<8>];
var good_superblock_ios = open("*unit-superblock-checksum-good*");
byte[good_superblock_blob'length] @ good_superblock_ios : 0#B = good_superblock_blob;
var good_superblock_accepted = 0;
try {
    var good_superblock = superblock @ good_superblock_ios : 0#B;
    good_superblock_accepted = 1;
} catch (Exception e) {
    good_superblock_accepted = 0;
}
expect_ohdr_msg("superblock_accepts_valid_checksum", good_superblock_accepted);
close(good_superblock_ios);

var bad_superblock_checksum_ios = open("*unit-superblock-checksum-bad*");
good_superblock_blob[12] = good_superblock_blob[12] ^ 1UB;
byte[good_superblock_blob'length] @ bad_superblock_checksum_ios : 0#B = good_superblock_blob;
var bad_superblock_checksum_rejected = 0;
try {
    var bad_superblock_checksum = superblock @ bad_superblock_checksum_ios : 0#B;
} catch (Exception e) {
    bad_superblock_checksum_rejected = 1;
}
expect_ohdr_msg("superblock_rejects_bad_checksum", bad_superblock_checksum_rejected);
close(bad_superblock_checksum_ios);

if (ohdr_msg_failures != 0)
    {
        printf("UNIT OHDR MESSAGES: %i32d failure(s)\n", ohdr_msg_failures);
        exit(1);
    }
printf("UNIT OHDR MESSAGES: all passed\n");
