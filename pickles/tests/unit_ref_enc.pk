/* Deep reference-payload validation regressions. */
load "common.pk";
load "ref_enc.pk";

var failures = 0;
fun expect_ref = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else {
        printf("FAIL %s\n", name);
        failures = failures + 1;
    }
}

set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);
set_global_hdf5_base_addr([0UB, 0UB, 0UB, 0UB]);
set_global_hdf5_declared_eof([0UB, 2UB, 0UB, 0UB]); /* exclusive offset 512 */

var ios = open("*unit-ref-enc*");

/* A 40-byte global heap at 128: object 1 is a seven-byte external OBJECT2
 * blob (token size 4, token 100, empty filename). */
byte[40] @ ios : 128#B = [
    'G', 'C', 'O', 'L', 1UB, 0UB, 0UB, 0UB, 40UB, 0UB, 0UB, 0UB,
    0UB, 0UB, 0UB, 0UB,
    1UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 7UB, 0UB, 0UB, 0UB,
    0UB, 0UB, 0UB, 0UB,
    4UB, 100UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB
];

/* H5R_OBJECT2 external uses the blob descriptor. */
byte[14] @ ios : 0#B = [2UB, 1UB, 7UB, 0UB, 0UB, 0UB,
                        128UB, 0UB, 0UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var valid_blob = ref_enc_block @ ios : 0#B;
print_ref_enc_revised(0#B);
expect_ref("blob_object_size_matches_descriptor",
           global_gheap_last_obj_size == 7UL);

/* A valid reference encoding needs at least its type, flags, and token
 * length byte in the blob. */
byte[14] @ ios : 16#B = [2UB, 1UB, 2UB, 0UB, 0UB, 0UB,
                         128UB, 0UB, 0UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var short_blob_rejected = 0;
try {
    var short_blob = ref_enc_block @ ios : 16#B;
} catch (Exception e) {
    short_blob_rejected = 1;
}
expect_ref("non_null_blob_shorter_than_reference_header_rejected",
           short_blob_rejected);

/* H5HG object 0 is the free-space sentinel and is never reference data. */
byte[14] @ ios : 32#B = [2UB, 1UB, 7UB, 0UB, 0UB, 0UB,
                         128UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var free_object_rejected = 0;
try {
    var free_object = ref_enc_block @ ios : 32#B;
} catch (Exception e) {
    free_object_rejected = 1;
}
expect_ref("non_null_blob_free_object_index_rejected", free_object_rejected);

/* Legacy dataset-region references use the same non-free heap-object rule. */
byte[8] @ ios : 48#B = [128UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var legacy_free_object_rejected = 0;
try {
    var legacy_free_object = ref_enc_region1_block @ ios : 48#B;
} catch (Exception e) {
    legacy_free_object_rejected = 1;
}
expect_ref("legacy_region_free_object_index_rejected", legacy_free_object_rejected);

/* A stale byte count must be reported without mapping beyond object 1. */
byte[14] @ ios : 64#B = [2UB, 1UB, 8UB, 0UB, 0UB, 0UB,
                         128UB, 0UB, 0UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var mismatched_blob = ref_enc_block @ ios : 64#B;
print_ref_enc_revised(64#B);
expect_ref("mismatched_blob_size_does_not_extend_heap_object",
           global_gheap_last_obj_size == 7UL);

/* Keep the descriptor size correct but make the nested token overrun its
 * object.  The printer must report it rather than reading padding/neighbours. */
byte @ ios : 160#B = 16UB;
print_ref_enc_revised(0#B);
expect_ref("nested_token_overrun_is_bounded", global_gheap_last_obj_size == 7UL);

close(ios);
if (failures != 0) {
    printf("UNIT REF ENC: %i32d failure(s)\n", failures);
    exit(1);
}
printf("UNIT REF ENC: all passed\n");
