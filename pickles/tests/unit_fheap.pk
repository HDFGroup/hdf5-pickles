/* Focused fractal-heap resolution checks. */
load "common.pk";
load "fheap.pk";

var failures = 0;
fun expect_fheap = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else {
        printf("FAIL %s\n", name);
        failures = failures + 1;
    }
}

set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);
global_frhp_heap_off_size = 4UB;
global_frhp_filter_len = 0UH;
global_frhp_table_width = 1UH;
global_frhp_max_direct_rows = 2UL;
global_frhp_start_block_size = 16UL;
global_frhp_root_addr = 0UL;
global_frhp_curr_root_rows = 3UL;

var ios = open("*unit-fheap*");
var undef = [0xffUB, 0xffUB, 0xffUB, 0xffUB];
var root = [0x46UB, 0x48UB, 0x49UB, 0x42UB, 0UB]
           + [0UB, 0UB, 0UB, 0UB] + [0UB, 0UB, 0UB, 0UB]
           + undef + undef + [64UB, 0UB, 0UB, 0UB]
           + [0UB, 0UB, 0UB, 0UB];
var child = [0x46UB, 0x48UB, 0x49UB, 0x42UB, 0UB]
            + [0UB, 0UB, 0UB, 0UB] + [32UB, 0UB, 0UB, 0UB]
            + [128UB, 0UB, 0UB, 0UB] + undef
            + [0UB, 0UB, 0UB, 0UB];
byte[root'length] @ ios : 0#B = root;
byte[child'length] @ ios : 64#B = child;
expect_fheap("managed_id_reaches_nested_indirect_block",
             frhp_managed_id_to_addr(40UL) == 136UL);

/* A depth-zero type-1 huge-object B-tree: key 42 names file address 512. */
var bthd = [0x42UB, 0x54UB, 0x48UB, 0x44UB, 0UB, 1UB,
            64UB, 0UB, 0UB, 0UB, 12UB, 0UB, 0UB, 0UB, 100UB, 40UB,
            64UB, 1UB, 0UB, 0UB, 1UB, 0UB, 1UB, 0UB, 0UB, 0UB,
            0UB, 0UB, 0UB, 0UB];
var btlf = [0x42UB, 0x54UB, 0x4cUB, 0x46UB, 0UB, 1UB,
            0UB, 2UB, 0UB, 0UB, 2UB, 0UB, 0UB, 0UB, 42UB, 0UB,
            0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
byte[bthd'length] @ ios : 256#B = bthd;
byte[btlf'length] @ ios : 320#B = btlf;
expect_fheap("indirect_huge_id_resolves_through_type1_btree",
             frhp_find_huge_object(256UL, 42UL) == 512UL);

close(ios);
if (failures != 0) {
    printf("UNIT FHEAP: %i32d failure(s)\n", failures);
    exit(1);
}
printf("UNIT FHEAP: all passed\n");
