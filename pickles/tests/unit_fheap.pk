/* Focused fractal-heap resolution checks. */
load "common.pk";
load "fheap.pk";

var failures = 0;
fun expect_fheap = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else {
        printf("FAIL %s\n", name);
        failures = failures + 1;
    }
}

set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);
global_frhp_heap_off_size = 4UB;
global_frhp_filter_len = 0UH;
global_frhp_table_width = 1UH;
global_frhp_max_direct_rows = 2UL;
global_frhp_start_block_size = 16UL;
global_frhp_root_addr = 0UL;
global_frhp_curr_root_rows = 3UL;

var ios = open("*unit-fheap*");
var undef = [0xffUB, 0xffUB, 0xffUB, 0xffUB];
var root = [0x46UB, 0x48UB, 0x49UB, 0x42UB, 0UB]
           + [0UB, 0UB, 0UB, 0UB] + [0UB, 0UB, 0UB, 0UB]
           + undef + undef + [64UB, 0UB, 0UB, 0UB]
           + [0UB, 0UB, 0UB, 0UB];
var child = [0x46UB, 0x48UB, 0x49UB, 0x42UB, 0UB]
            + [0UB, 0UB, 0UB, 0UB] + [32UB, 0UB, 0UB, 0UB]
            + [128UB, 0UB, 0UB, 0UB] + undef
            + [0UB, 0UB, 0UB, 0UB];
byte[root'length] @ ios : 0#B = root;
byte[child'length] @ ios : 64#B = child;
expect_fheap("managed_id_reaches_nested_indirect_block",
             frhp_managed_id_to_addr(40UL) == 136UL);

/* A depth-zero type-1 huge-object B-tree: key 42 names file address 512. */
var bthd_prefix = [0x42UB, 0x54UB, 0x48UB, 0x44UB, 0UB, 1UB,
            64UB, 0UB, 0UB, 0UB, 12UB, 0UB, 0UB, 0UB, 100UB, 40UB,
            64UB, 1UB, 0UB, 0UB, 1UB, 0UB, 1UB, 0UB, 0UB, 0UB];
var bthd = bthd_prefix + hdf5_u32_le_bytes(lookup3_hashlittle(bthd_prefix, 0U));
var btlf_prefix = [0x42UB, 0x54UB, 0x4cUB, 0x46UB, 0UB, 1UB,
            0UB, 2UB, 0UB, 0UB, 2UB, 0UB, 0UB, 0UB, 42UB, 0UB,
            0UB, 0UB];
var btlf = btlf_prefix + hdf5_u32_le_bytes(lookup3_hashlittle(btlf_prefix, 0U));
byte[bthd'length] @ ios : 256#B = bthd;
byte[btlf'length] @ ios : 320#B = btlf;
expect_fheap("indirect_huge_id_resolves_through_type1_btree",
             frhp_find_huge_object(256UL, 42UL) == 512UL);

/* The width-1 table above cannot tell `row` apart from the child row count
 * the doubling table actually prescribes, since they differ by log2(width).
 * This width-2 heap can: rows 0 and 1 hold two 16-byte direct blocks each
 * (heap offsets 0..63), row 2 holds two 32-byte indirect children, and heap
 * offset 100 falls in the row-2 column-1 child that starts at 96.  That
 * child spans 32 bytes, i.e. one row of two columns -- 2 - log2(2) -- not
 * the two rows `row` alone would claim.
 *
 * The resolved address is the same either way (entry offsets within an
 * indirect block do not depend on the row count), so the geometry the
 * descent left behind is what pins the derivation: an over-counted child
 * makes fheap_iblock map entries past the block's end. */
set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);
global_frhp_heap_off_size = 4UB;
global_frhp_filter_len = 0UH;
global_frhp_table_width = 2UH;
global_frhp_max_direct_rows = 2UL;
global_frhp_start_block_size = 16UL;
global_frhp_root_addr = 0UL;
global_frhp_curr_root_rows = 3UL;

var w2_ios = open("*unit-fheap-width2*");
var w2_root = [0x46UB, 0x48UB, 0x49UB, 0x42UB, 0UB]  /* FHIB, version 0    */
              + [0UB, 0UB, 0UB, 0UB]                 /* heap header addr   */
              + [0UB, 0UB, 0UB, 0UB]                 /* block offset 0     */
              + undef + undef                        /* row 0: direct      */
              + undef + undef                        /* row 1: direct      */
              + undef + [64UB, 0UB, 0UB, 0UB]        /* row 2: indirect    */
              + [0UB, 0UB, 0UB, 0UB];                /* checksum           */
var w2_child = [0x46UB, 0x48UB, 0x49UB, 0x42UB, 0UB]
               + [0UB, 0UB, 0UB, 0UB]
               + [96UB, 0UB, 0UB, 0UB]               /* block offset 96    */
               + [200UB, 0UB, 0UB, 0UB] + undef      /* its single row     */
               + [0UB, 0UB, 0UB, 0UB];               /* checksum           */
byte[w2_root'length] @ w2_ios : 0#B = w2_root;
byte[w2_child'length] @ w2_ios : 64#B = w2_child;

/* frhp_managed_id_to_addr() maps in the current IOS, which is still the one
   the cases above wrote to. */
var saved_ios = get_ios();
set_ios(w2_ios);
expect_fheap("child_row_count_drops_the_table_width_bits",
             frhp_managed_id_to_addr(100UL) == 204UL
             && global_frhp_iblock_nrows == 1UL
             && global_frhp_iblock_ndir_entries == 2UL
             && global_frhp_iblock_nindir_entries == 0UL);
set_ios(saved_ios);
close(w2_ios);

close(ios);
if (failures != 0) {
    printf("UNIT FHEAP: %i32d failure(s)\n", failures);
    exit(1);
}
printf("UNIT FHEAP: all passed\n");
