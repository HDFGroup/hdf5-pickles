/* Canonical literals shared by the declarative mappings and independent raw
   validators.  Executable constraints, cross-field rules, and constants used
   by only one structure remain with that structure's pickle.  */

/* Fixed libhdf5 compatibility ceilings.  A dataset layout encodes one extra
   dimension for the datatype element size.  */
var H5S_MAX_RANK = 32UL;
var H5O_LAYOUT_NDIMS = 33UL;

/* File and object-header signatures.  */
var H5_FORMAT_FILE_SIGNATURE
    = [0x89UB, 0x48UB, 0x44UB, 0x46UB, 0x0dUB, 0x0aUB, 0x1aUB, 0x0aUB];
var H5_FORMAT_OHDR_SIGNATURE = [0x4fUB, 0x48UB, 0x44UB, 0x52UB]; /* OHDR */
var H5_FORMAT_OCHK_SIGNATURE = [0x4fUB, 0x43UB, 0x48UB, 0x4bUB]; /* OCHK */
var H5_FORMAT_OCHK_SIGNATURE_SIZE = 4#B;

/* Version 1 and version 2 B-tree signatures.  */
var H5_FORMAT_TREE_SIGNATURE = [0x54UB, 0x52UB, 0x45UB, 0x45UB]; /* TREE */
var H5_FORMAT_BTHD_SIGNATURE = [0x42UB, 0x54UB, 0x48UB, 0x44UB]; /* BTHD */
var H5_FORMAT_BTLF_SIGNATURE = [0x42UB, 0x54UB, 0x4cUB, 0x46UB]; /* BTLF */
var H5_FORMAT_BTIN_SIGNATURE = [0x42UB, 0x54UB, 0x49UB, 0x4eUB]; /* BTIN */

/* Dataset chunk-index signatures shared with h5policy.  */
var H5_FORMAT_FAHD_SIGNATURE = [0x46UB, 0x41UB, 0x48UB, 0x44UB]; /* FAHD */
var H5_FORMAT_FADB_SIGNATURE = [0x46UB, 0x41UB, 0x44UB, 0x42UB]; /* FADB */
var H5_FORMAT_EAHD_SIGNATURE = [0x45UB, 0x41UB, 0x48UB, 0x44UB]; /* EAHD */
var H5_FORMAT_EAIB_SIGNATURE = [0x45UB, 0x41UB, 0x49UB, 0x42UB]; /* EAIB */
var H5_FORMAT_EASB_SIGNATURE = [0x45UB, 0x41UB, 0x53UB, 0x42UB]; /* EASB */
var H5_FORMAT_EADB_SIGNATURE = [0x45UB, 0x41UB, 0x44UB, 0x42UB]; /* EADB */

/* Heap and legacy-group signatures.  */
var H5_FORMAT_FRHP_SIGNATURE = [0x46UB, 0x52UB, 0x48UB, 0x50UB]; /* FRHP */
var H5_FORMAT_FHIB_SIGNATURE = [0x46UB, 0x48UB, 0x49UB, 0x42UB]; /* FHIB */
var H5_FORMAT_FHDB_SIGNATURE = [0x46UB, 0x48UB, 0x44UB, 0x42UB]; /* FHDB */
var H5_FORMAT_HEAP_SIGNATURE = [0x48UB, 0x45UB, 0x41UB, 0x50UB]; /* HEAP */
var H5_FORMAT_SNOD_SIGNATURE = [0x53UB, 0x4eUB, 0x4fUB, 0x44UB]; /* SNOD */
var H5_FORMAT_GCOL_SIGNATURE = [0x47UB, 0x43UB, 0x4fUB, 0x4cUB]; /* GCOL */

/* H5HG_MINSIZE (H5HGpkg.h): the smallest a global heap collection may declare
   itself to be.  It is also the metadata cache's speculative first read for a
   collection, which is why a smaller declared size is refused outright rather
   than tolerated -- H5HG__hdr_deserialize rejects it before any object is
   parsed.  */
var H5_FORMAT_GCOL_MIN_COLLECTION_SIZE = 4096UL;

/* Datatype classes, for the few call sites that must branch on the class after
   the datatype has been validated rather than while decoding it.  H5T_class_t
   values; only the ones named here are referenced by name.  */
var H5_DTYPE_CLASS_NONE = 0xffffffffffffffffUL;   /* no datatype validated yet */
var H5_DTYPE_CLASS_REFERENCE = 7UL;               /* H5T_REFERENCE */
var H5_DTYPE_CLASS_VLEN = 9UL;                    /* H5T_VLEN */

/* Reference sub-types (the second byte of a class-7 datatype's class bit
   field).  Only type 1 -- the legacy dataset-region reference -- stores a bare
   global-heap ID; type 0 is a plain address and types 2..4 are revised
   references whose encoded blob layout differs.  */
var H5_DTYPE_REF_TYPE_REGION = 1UL;               /* H5R_DATASET_REGION1 */

/* Revised references (H5R_OBJECT2 / H5R_DATASET_REGION2 / H5R_ATTR).  Their
   on-disk element is
     [type:1][flags:1][declared blob size:4][heap address][heap index:4]
   so the global-heap ID starts at H5R_ENCODE_HEADER_SIZE + sizeof(uint32_t) = 6
   (src/H5Tref.c, H5T__ref_disk_isnull and H5T__ref_disk_read agree on it).
   ONE EXCEPTION carries no blob at all: H5T__ref_disk_getsize direct-copies a
   type-2 reference that does NOT set H5R_IS_EXTERNAL, so those six bytes are
   reference data rather than a size and an ID.  */
var H5_DTYPE_REF_TYPE_OBJECT2 = 2UL;              /* H5R_OBJECT2 */
var H5_DTYPE_REF_TYPE_REGION2 = 3UL;              /* H5R_DATASET_REGION2 */
var H5_DTYPE_REF_TYPE_ATTR = 4UL;                 /* H5R_ATTR -- highest revised */
var H5_DTYPE_REF_REVISED_ID_OFFSET = 6UL;         /* header(2) + declared size(4) */
var H5_DTYPE_REF_FLAG_EXTERNAL = 1UL;             /* H5R_IS_EXTERNAL (H5Rpkg.h) */
/* A revised region reference's blob is
     [token_size:1][token:token_size][selection bytes:4][rank:4][selection]
   -- H5R__encode_region writes the size and the rank as "a safety check" ahead
   of the serialized selection, and H5R__decode_region requires the declared
   size plus those two words to fit the blob.  A LEGACY region reference has no
   such header: its blob is the object address followed straight by the
   selection.  */
var H5_DTYPE_REF_REGION2_SEL_HEADER = 8UL;        /* the two u32 safety words */

/* Shared-object-header-message signatures.  */
var H5_FORMAT_SMTB_SIGNATURE = [0x53UB, 0x4dUB, 0x54UB, 0x42UB]; /* SMTB */
var H5_FORMAT_SMLI_SIGNATURE = [0x53UB, 0x4dUB, 0x4cUB, 0x49UB]; /* SMLI */

/* Free-space manager signatures.  */
var H5_FORMAT_FSHD_SIGNATURE = [0x46UB, 0x53UB, 0x48UB, 0x44UB]; /* FSHD */
var H5_FORMAT_FSSE_SIGNATURE = [0x46UB, 0x53UB, 0x53UB, 0x45UB]; /* FSSE */

/* Metadata cache image block signature.  */
var H5_FORMAT_MDCI_SIGNATURE = [0x4dUB, 0x44UB, 0x43UB, 0x49UB]; /* MDCI */
