load "common.pk";
load "superblock.pk";
load "ohdr_msgs.pk";

/* Convert integers to little-endian byte arrays for raw metadata fields. */
fun u64_to_bytes_le = (uint<64> v, uint<64> n) byte[]:
{
  var out = byte[]();
  var i = 0UL;

  while (i < n)
    {
      out += [(v .>> (i * 8)) as byte];
      i = i + 1;
    }

  return out;
}

/* Version 2 object header message prefix without creation-order tracking. */
type msg_prefix_v2 =
  struct
  {
    byte msg_type;
    uint<16> msg_size;
    byte msg_flags;
  };

/* Constructible helper for a version 2 superblock. */
type superblock_v2 =
  struct
  {
    byte[8] signature == H5_FORMAT_FILE_SIGNATURE;
    byte super_vers == 2;
    uint<8> sizeof_offsets: set_global_sizeof_offsets(sizeof_offsets);
    uint<8> sizeof_lengths: set_global_sizeof_lengths(sizeof_lengths);
    byte status_flags;
    byte[global_sizeof_offsets] base_addr_raw;
    byte[global_sizeof_offsets] ext_addr_raw;
    byte[global_sizeof_offsets] eof_addr_raw;
    byte[global_sizeof_offsets] root_obj_addr_raw;
    uint<32> chksum;
  };

/* Constructible helper for a version 2 object header. */
type ohdr_v2 =
  struct
  {
    byte[4] signature == H5_FORMAT_OHDR_SIGNATURE;
    uint<8> version == 2;
    byte flags;

    hdr_timestamps timestamps if (flags & 1 <<. 5);
    hdr_attr_phase attr_phase if (flags & 1 <<. 4);

    var _chunk0_num_bytes = 1 <<. (flags & 3U);
    byte[_chunk0_num_bytes] chunk0_size;

    var _chunk0_size = bytes_to_u64_le(chunk0_size);
    /* msg_chunk already spans messages plus any trailing gap padding --
       chunk0_size covers both -- so a caller wanting a gap simply includes
       those bytes in msg_chunk itself; a separate gap field here would
       double-count them and push chksum too far into the file. */
    byte[_chunk0_size] msg_chunk;

    uint<32> chksum;
  };
