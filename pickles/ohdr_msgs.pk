/* NOTE:
 *  For oh_msg_dtype():
 *  print_recurse_dtype()
 *  --print dtype (recursive) after mapping oh_msg_dtype to a variable
 *  print_dtype()
 *  --print dtype (recursive/non-recursive) after mapping oh_msg_dtype to a variable
 */

/* NOTE:
 * Needed by oh_msg_drvinfo
 *    OH_DRVINFO_ID     0x0014 Driver info message.
 * file_drv_type() is defined in drv_info.pk
 */
load "drv_info.pk";

/* NOTE:
 * Needed to resolve OH_MSG_FLAG_SHARED (SOHM) messages in get_all_messages():
 *   sohm.pk  -- master SMTB table / per-index mesg_types+heap_addr lookup
 *   fheap.pk -- frhp_id_to_addr() resolves a fractal heap ID to a file address
 * Do NOT load common.pk here -- see stab.pk's explanation of the shadowing
 * hazard; only entry-point pickles (h5explain.pk/construct.pk) load it.
 */
load "sohm.pk";
load "fheap.pk";

/*
 * Covers:
 *   - Object Header Prefix, version 1 (no signature) and version 2
 *     (signature "OHDR"), Section IV.A.1 of the HDF5 format spec v3
 *   - All Object Header Message types, Section IV.A.2, IDs 0x0000-0x0018:
 *       - 0x00 NIL
 *       - 0x01 Dataspace
 *       - 0x02 Link Info
 *       - 0x03 Datatype
 *       - 0x04 Fill Value (old)
 *       - 0x05 Fill Value
 *       - 0x06 Link
 *       - 0x07 External Data Files
 *       - 0x08 Data Layout
 *       - 0x0a Group Info
 *       - 0x0b Filter Pipeline
 *       - 0x0c Attribute
 *       - 0x0d Object Name (old)
 *       - 0x0e Modification Time (old)
 *       - 0x0f Shared Message ("SOHM") Table
 *       - 0x10 Object Header Continuation
 *       - 0x11 Symbol Table
 *       - 0x12 Modification Time
 *       - 0x13 v1 B-tree 'K' Values
 *       - 0x14 Driver Info
 *       - 0x15 Attribute Info
 *       - 0x16 Object Reference Count
 *       - 0x17 File Space Info
 *       - 0x18 Metadata Cache Image
 *     (0x09 "Bogus valid" is a library self-test message only and falls
 *     through to the raw-byte-dump default in message_factory)
 *   - Message chunk / continuation-block walking (get_all_messages,
 *     get_cont_messages) shared by both header versions
 *
 * Load order:
 *   (poke) .load pickles/common.pk
 *   (poke) .load pickles/superblock.pk   <- sets global_sizeof_offsets and
 *                                                global_sizeof_lengths
 *   (poke) .load pickles/ohdr_msgs.pk    <- also loads drv_info.pk
 *                                                transitively (for
 *                                                oh_msg_drvinfo)
 *
 * Quick start:
 *   var oh = oh_hdr @ off;   <- off is an object header address (e.g. from
 *                                a Symbol Table Entry or B-tree leaf)
 *   oh.get_messages();       <- walks the message chunk(s), populating
 *                                global_all_cont_chunks / _sizes as needed
 */

/* NULL_ID        0x0000 Null Message.  */
type oh_msg_nil =
    struct {
    };

/* SDSPACE_ID     0x0001 Dataspace Message. */
type oh_msg_sdspace =
    struct {
        byte version: version == 1UB || version == 2UB;
        union {
            struct {
                byte ndims: ndims <= 32UB;
                byte flags;
                byte[5] res;
                byte[global_sizeof_lengths] [ndims] dim_size;
                byte[global_sizeof_lengths] [ndims] max if (flags & 1U) != 0;
                byte[global_sizeof_lengths] [ndims] perm if (flags & 2U) != 0; /* not implemented in library */

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("space=struct {\n");
                    indent(depth); printf("  v1=struct {\n");
                    indent(depth); printf("    ndims=%v\n", ndims);
                    indent(depth); printf("    flags=%v\n", flags);
                    indent(depth); printf("    res=%v\n", res);
                    if (ndims > 0UB) {
                        indent(depth); printf("    dim_size=%v\n", dim_size);
                        if ((flags & 1U) != 0) {
                            indent(depth); printf("    max=%v\n", max);
                        }
                        if ((flags & 2U) != 0) {
                            indent(depth); printf("    perm=%v\n", perm);
                        }
                    }
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

            } v1: version == 1;

            struct {
                byte ndims: ndims <= 32UB;
                byte flags;
                byte space_type: space_type <= 2UB && (space_type == 1UB || ndims == 0UB);
                byte[global_sizeof_lengths] [ndims] dim_size if (space_type == 1);
                byte[global_sizeof_lengths] [ndims] max if (flags & 1U) != 0;

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("space=struct {\n");
                    indent(depth); printf("  v2=struct {\n");
                    indent(depth); printf("    ndims=%v\n", ndims);
                    indent(depth); printf("    flags=%v\n", flags);
                    indent(depth); printf("    space_type=%v (%s)\n", space_type,
                        (space_type == 0 ? "Scalar"
                         : (space_type == 1 ? "Simple"
                            : (space_type == 2 ? "Null" : "Unknown"))));
                    if (space_type == 1) {
                        indent(depth); printf("    dim_size=%v\n", dim_size);
                        if ((flags & 1U) != 0) {
                            indent(depth); printf("    max=%v\n", max);
                        }
                    }
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

            } v2: version == 2;

        } space;

        method print_dspace_indent = (int depth) void:
        {
            indent(depth); printf("oh_msg_sdspace {\n");
            indent(depth); printf("  version=%v\n", version);
            if (version == 1) {
                space.v1.print_indented(depth+1);
            } else if (version == 2) {
                space.v2.print_indented(depth+1);
            }
            indent(depth); printf("}\n");
        }
    };

/* LINFO_ID       0x0002 Link info Message. */
type oh_msg_linfo =
    struct {
        byte version == 0UB;
        byte flags: (flags & 0xfcUB) == 0UB;
        uint<64> max_corder if (flags & 1U) != 0;    /* Maximum creation index */

        /* Address of fractal heap for storing "dense" links */
        byte[global_sizeof_offsets] fheap_addr_raw;

        /* Address of v2 btree for indexing names of links */
        byte[global_sizeof_offsets] name_bt2_addr_raw;

        /* Address of v2 btree for indexing creation order values of links */
        byte[global_sizeof_offsets] corder_bt2_addr_raw if (flags & 2U) != 0;
    };

/* 
 * For DTYPE_ID       0x0003 Datatype Message.  
 */

/* elm_size in dtype_hdr is used in calculating memb_off for version 3 compound type */
var global_dt_elm_size = 0;

/* The compound `membs` union's element types (compound_props1/2/3, below) are
   standalone named types, not anonymous structs nested inside oh_msg_dtype --
   so unlike oh_msg_fill's guards (see #14/#15), they cannot reference the
   enclosing type's `ver` lexically. Set right before mapping `membs`, and
   read by a `byte[0] _guard` at the top of each compound_propsN, so that
   whichever version poke tries first, a version mismatch aborts before
   any of that element's fields -- including the recursive, unboundedly
   expensive memb_props -- are read. */
var global_compound_ver = 0;

fun set_global_compound_ver = (int v) int: { global_compound_ver = v; return 0; }

/* Same reasoning as global_compound_ver above, for the `memb_names` union's
   element types (enum_props, enum_name_v3, below) inside oh_msg_dtype's
   `enumeration` arm -- enum_props is a standalone named type, and the v3
   alternative uses poke's built-in `string` type directly, which cannot be
   given a `_guard` field at all, hence the enum_name_v3 wrapper. */
var global_enum_ver = 0;

fun set_global_enum_ver = (int v) int: { global_enum_ver = v; return 0; }

/* The datatype message header section */
type dtype_hdr = 
    struct {
        uint<32> flags;
        uint<32> elm_size;         

        method get_version = int: { return (flags .>>4 & 0xf) as int; }
        method get_ctype = int: { return (flags & 0xf) as int; }

        /* Class 11 (Complex) class bit fields: bit 0 marks the homogeneous
           encoding, bits 1-2 the form, and everything above is reserved.  Only
           a homogeneous rectangular complex has a property layout the format
           defines -- one inline base datatype -- so any other encoding is
           undecodable rather than merely unsupported, and this decoder must not
           size or interpret properties for it. */
        method complex_homogeneous = int: { return (flags .>>8 & 0x1) as int; }
        method complex_form = int: { return (flags .>>9 & 0x3) as int; }
        method complex_encoding_defined = int:
        {
            return (complex_homogeneous() == 1 && complex_form() == 0
                    && (flags .>>11) == 0) ? 1 : 0;
        }
        //method set_global_memb_off_size = int: { global_memb_off_size = elm_size; return 0; }
        method set_global_dt_elm_size = int: { global_dt_elm_size = elm_size; return 0; }

    };

/* Name of a class-11 complex form (dtype_hdr.complex_form()).  Shared so that
   the datatype printer and the Emacs record emitter cannot drift apart. */
fun complex_form_name = (int form) string:
{
    if (form == 0) return "rectangular";
    if (form == 1) return "polar";
    if (form == 2) return "exponential";
    return "reserved";
}

/* Function to round up a string to multiple of 8 bytes */
fun round_up_8 = (uint32 n) uint32:
{
  var r = n % 8;
  if (r == 0)
    return n;
  return n + (8 - r);
}

/* Function to calculate the field size of the "Byte Offset of Member" field
   in the compound properties description version 3 */
fun get_v3_cmpd_memb_off_size = (uint32 dt_elm_size) uint32:
{
    if (dt_elm_size < 256U)        
        return 1;  /* compound record < 256B   */
    else if (dt_elm_size < 65536U)      
        return 2;  /* compound record < 64KB   */
    else if (dt_elm_size < 4294967296U) 
        return 4;  /* compound record < 4GB    */
    else                             
        return 8;  /* compound record >= 4GB   */
}

fun nul_term_len = (off64 off) uint32:
{
    var len = 0U;
    while ((byte @ (off + len#B)) != 0UB)
        len = len + 1;
    return len;
}

fun dtype_props_size_at = (off64 off) uint32:
{
    var hdr = dtype_hdr@off;
    var ctype = hdr.get_ctype();
    var ver = hdr.get_version();

    
    /* ---- class 0: Fixed-Point --------------------------------
     * bit_offset    uint16
     * bit_precision uint16
     * total: 4B
     * --------------------------------------------------------- */
    if (ctype == 0UB)
        return 4;

    /* ---- class 1: Floating-Point ----------------------------
     * bit_offset       uint16
     * bit_precision    uint16
     * exponent_loc     byte
     * exponent_size    byte
     * mantissa_loc     byte
     * mantissa_size    byte
     * exponent_bias    uint32
     * total: 12B
     * --------------------------------------------------------- */
    else if (ctype == 1UB)
        return 12;

    /* ---- class 2: Time --------------------------------------
     * bit_precision uint16
     * total: 2B
     * --------------------------------------------------------- */
    else if (ctype == 2UB)
        return 2;

    /* ---- class 3: String ------------------------------------
     * No property bytes 
     * total: 0B
     * --------------------------------------------------------- */
    else if (ctype == 3UB)
        return 0;

    /* ---- class 4: Bit Field ---------------------------------
     * bit_offset    uint16
     * bit_precision uint16
     * total: 4B
     * --------------------------------------------------------- */
    else if (ctype == 4UB)
        return 4;

    /* ---- class 5: Opaque ------------------------------------
     * ASCII tag — length in class_bit_fields[0], padded to 8B
        NOTE: tag_len should be aligned already when stored
     *  total: round_up_8 (tag_len)
     * --------------------------------------------------------- */
    else if (ctype == 5UB) {
        var ff = hdr.flags .>>8;
        var tag_len = (ff & 0xff);
        return(tag_len);

    } 

    /* ---- class 6: Compound ----------------------------------
     * Walk all members — version-aware because:
     *   V1: name(pad8) + uint32 memb_off + ndim(1)+res1(3)+
     *       perm(4)+res2(4)+adim..ddim(16) + dtype blob
     *   V2: name(pad8) + uint32 memb_off + dtype blob
     *   V3: name + variable memb_off + dtype blob
     * Each member's dtype blob is recursive.
     * --------------------------------------------------------- */
    else if (ctype == 6UB) {
        var ff = hdr.flags .>>8;
        var nn = (ff & 0xffff);

        /* members start.. */
        var cur  = off + 8#B;   /* Skip outer header */

        var start = cur;
        var i     = 0;

        while (i < nn as int) {

            /* name — NUL-terminated, padded to 8B in all versions */
            var nlen = nul_term_len (cur);

            if (ver == 1UB || ver == 2UB)
                /* NUL-terminated, padded to next 8B boundary */
                cur = cur + round_up_8 (nlen + 1)#B;
            else /* ver == 3UB */
                /* NUL-terminated only, no padding */
                cur = cur + (nlen + 1)#B;

            if (ver == 1UB) {
                cur = cur + 4#B;   /* memb_off  uint32        */
                cur = cur + 1#B;   /* ndim      byte          */
                cur = cur + 3#B;   /* res1      byte[3]       */
                cur = cur + 4#B;   /* perm      byte[4]       */
                cur = cur + 4#B;   /* res2      byte[4]       */
                cur = cur + 16#B;  /* adim..ddim 4 x uint32   */

            } else if (ver == 2UB) {
                cur = cur + 4#B;   /* memb_off  uint32        */

            } else { /* ver == 3UB */
                /* memb_off width determined by compound element size */

                var off_size = get_v3_cmpd_memb_off_size(hdr.elm_size);

                cur = cur + off_size#B;
            }

            /* member dtype blob — recursive */
            var mp = dtype_props_size_at(cur);
            cur = cur + 8#B + mp#B;

            i = i + 1;
        }

        return ((cur - start) / 1#B) as uint32;

    }

    /* ---- class 7: Reference ---------------------------------
     * No property bytes
     * total: 0B
     * --------------------------------------------------------- */
    else if (ctype == 7UB) {
        return 0;
    }

    /* ---- class 8: Enum --------------------------------------
     * base type blob  (8B hdr + props) — recursive
     * member names    num_members x NUL-terminated, padded to 8B
     * member values   num_members x base_hdr.elm_size bytes
     * --------------------------------------------------------- */
    else if (ctype == 8UB) {
        var ff = hdr.flags .>>8;
        var num = (ff & 0xffff);
        var cur  = off + 8#B;       /* Skip outer header */

        /* base type — recursive */
        var base_hdr  = dtype_hdr@ cur;
        var base_size = base_hdr.elm_size;
        var bp        = dtype_props_size_at(cur);
        cur = cur + 8#B + bp#B;

        /* member names */
        var i = 0;
        while (i < num as int) {
          var nlen = nul_term_len (cur);
          cur = cur + round_up_8 (nlen + 1)#B;
          i = i + 1;
        }

        /* member values */
        cur = cur + (num as uint32 * base_size)#B;

        return ((cur - (off + 8#B)) / 1#B) as uint32;
    }

    /* ---- class 9: Variable-Length ---------------------------
     * base type blob  (8B hdr + props) — recursive, inline
     * nothing else
     * --------------------------------------------------------- */
    else if (ctype == 9UB) {
        /* base type — recursive */
        var bp = dtype_props_size_at(off + 8#B);
        return (8 + bp);
    }

    /* ---- class 10: Array ------------------------------------
     * rank           byte
     * reserved       byte[3]         (V2 only)
     * dim_sizes      rank x uint32
     * permutation    rank x uint32   (V2 only)
     * base type blob (8B hdr + props) — recursive
     * --------------------------------------------------------- */
    else if (ctype == 10UB) {
        var cur  = off + 8#B;       /* skip outer hdr */
        var rank = byte @ cur;
        cur = cur + 1#B;            /* rank */

        if (ver == 2UB)
            cur = cur + 3#B;        /* V2 only: reserved */

        cur = cur + (rank as uint32 * 4)#B;     /* dim_sizes     */

        if (ver == 2UB)
            cur = cur + (rank as uint32 * 4)#B; /*  V2 only: permutation */

        /* base type — recursive */
        var bp = dtype_props_size_at(cur);
        cur = cur + 8#B + bp#B;

        return ((cur - (off + 8#B)) / 1#B) as uint32;

    }

    /* ---- class 11: Complex ----------------------------------
     * base type blob  (8B hdr + props) — recursive, inline
     * nothing else
     *
     * Only the homogeneous rectangular encoding has that layout.  Any other
     * class bit field has no layout to size, so report "cannot size" the same
     * way an unknown class does, rather than a plausible-looking extent that
     * would silently shift every field a caller decodes after it.
     * --------------------------------------------------------- */
    else if (ctype == 11UB) {
        if (hdr.complex_encoding_defined() == 0)
            return 0;
        var bp = dtype_props_size_at(off + 8#B);
        return (8 + bp);
    }

    /* ---- unknown class --------------------------------------
     * Return 0
     * No printf here — silent fallback because it will be called
     * eagerly by Poke at struct map time
     *         
     * --------------------------------------------------------- */
    else {
        //printf("dtype_props_size_at: unknown class %u8d at %u64d\n",
         //       ctype, off / 1#B);
        return 0;
    }


}

var OH_MSG_FLAG_SHARED = 2UB;

var OH_SHARE_TYPE_UNSHARED  = 0UB;
var OH_SHARE_TYPE_SOHM      = 1UB;
var OH_SHARE_TYPE_COMMITTED = 2UB;
var OH_SHARE_TYPE_HERE      = 3UB;

/* Object header continuation message ID -- declared here (rather than
   alongside DTYPE_ID/LAYOUT_ID below) because msg_payload_offset_in_ohdr()
   references it and Poke resolves top-level var bindings in file order. */
var CONT_ID = 0x0010;

/* Driver info message ID -- like CONT_ID above, exposed for external
   callers (multi_vfd.pk's multi_discover()) that ask
   msg_payload_offset_in_ohdr() for this specific message type. */
var DRVINFO_ID = 0x0014;

fun is_v2_ohdr_at = (off64 off) int:
{
    return (((byte @ off) == 'O')
            && ((byte @ (off + 1#B)) == 'H')
            && ((byte @ (off + 2#B)) == 'D')
            && ((byte @ (off + 3#B)) == 'R'));
}

/* SHARED_MSG_UNRESOLVED -- sentinel offset returned when a shared message
 * cannot be followed to its real payload. A negative offset can never name a
 * position in the file, so it is unambiguous.
 *
 * Resolution failures are reported and returned, not raised: a shared message
 * whose target is unreachable (an undecoded SOHM table, a filtered huge heap
 * object, a truncated file) must not abort the decoding of every message that
 * follows it. Callers test for the sentinel and fall back to reporting the
 * raw shared reference. */
var SHARED_MSG_UNRESOLVED = (-1L)#B;

fun shared_msg_error = (string msg) off64:
{
    printf("shared_msg_payload_offset: %s\n", msg);
    return SHARED_MSG_UNRESOLVED;
}

fun msg_payload_offset_in_ohdr = (off64 obj_off, uint<8> wanted_type,
                                      uint<16> wanted_index, int use_index) off64:
{
    var is_v2 = is_v2_ohdr_at(obj_off);
    var prefix_bytes = 8UL;
    var crt_order_tracked = 0;
    var chunk_off = obj_off + 16#B;
    var chunk_size = 0UL;

    if (is_v2) {
        var ohdr_flags = byte @ (obj_off + 5#B);
        var chunk0_size_len = 1UL <<. (ohdr_flags & 3U);
        var cur0 = obj_off + 6#B;

        crt_order_tracked = (ohdr_flags & 4U) != 0;
        prefix_bytes = crt_order_tracked ? 6UL : 4UL;

        if ((ohdr_flags & 32U) != 0)
            cur0 = cur0 + 16#B;
        if ((ohdr_flags & 16U) != 0)
            cur0 = cur0 + 4#B;

        chunk_size = bytes_to_u64_le(byte[chunk0_size_len] @ cur0);
        chunk_off = cur0 + chunk0_size_len#B;
    } else {
        chunk_size = bytes_to_u64_le(byte[4] @ (obj_off + 8#B));
    }

    /* Object header continuation messages (0x0010) seen while scanning
     * the current chunk get queued here and scanned afterwards -- the
     * wanted message may live in a later chunk, as it does whenever the
     * first chunk holds nothing but a continuation pointer (mirrors
     * get_all_messages()/get_cont_messages()'s chunk-walking). */
    var cont_addrs = off64[]();
    var cont_sizes = uint64[]();
    var qi = 0;

    while (1) {
        var cur = chunk_off;
        var chunk_end = chunk_off + chunk_size#B;
        var msg_no = 0UL;

        while ((cur + prefix_bytes#B) <= chunk_end) {
            var m_type = 0UL;
            var m_size = 0UL;
            var match_index = 0;

            if (is_v2) {
                m_type = byte @ cur;
                m_size = bytes_u16_at(cur + 1#B);
            } else {
                m_type = bytes_u16_at(cur);
                m_size = bytes_u16_at(cur + 2#B);
            }

            if (use_index == 0) {
                match_index = 1;
            } else if (is_v2 && crt_order_tracked) {
                var crt_order = bytes_u16_at(cur + 4#B);
                match_index = crt_order == (wanted_index as uint<64>);
            } else {
                match_index = msg_no == (wanted_index as uint<64>);
            }

            if (m_type == (wanted_type as uint<64>) && match_index)
                return cur + prefix_bytes#B;

            if (m_type == CONT_ID) {
                var cont_payload = cur + prefix_bytes#B;
                var addr_raw = byte[global_sizeof_offsets] @ cont_payload;
                var size_raw = byte[global_sizeof_lengths] @ (cont_payload + global_sizeof_offsets#B);
                cont_addrs += [bytes_to_off(addr_raw) as off64];
                cont_sizes += [bytes_to_u64_le(size_raw)];
            }

            cur = cur + (prefix_bytes + m_size)#B;
            msg_no = msg_no + 1;
        }

        if (qi >= cont_addrs'length)
            break;

        chunk_off = cont_addrs[qi];
        chunk_size = cont_sizes[qi];
        qi = qi + 1;

        if (is_v2) {
            /* Skip the 4-byte "OCHK" signature; the trailing 4 bytes are
             * a checksum, not part of the message list. */
            chunk_off = chunk_off + H5_FORMAT_OCHK_SIGNATURE_SIZE;
            chunk_size = chunk_size - 4;
        }
    }

    printf("shared_msg_payload_offset: message type %v not found in object header at %v\n",
           wanted_type, obj_off / 1#B);
    return SHARED_MSG_UNRESOLVED;
}

fun shared_msg_payload_offset = (off64 shared_off, uint<8> wanted_type) off64:
{
    var version = byte @ shared_off;
    var share_type = byte @ (shared_off + 1#B);
    var loc_off = shared_off + 2#B;

    if (version == 1UB) {
        /* Version 1 stores 2+4 reserved bytes followed by the Link Name
           Offset field before the object-header address. The Link Name
           Offset reuses stab_ent's field of the same name (sec. III.C) and
           is sized by global_sizeof_lengths, not global_sizeof_offsets;
           per the spec it is skipped over, not read, by the shared message
           decoding code, so we only need its extent to reach Address. */
        share_type = OH_SHARE_TYPE_COMMITTED;
        var lnk_nm_off_raw = byte[global_sizeof_lengths] @ (shared_off + 8#B);
        loc_off = lnk_nm_off_raw'offset + lnk_nm_off_raw'size;
    } else if (version == 2UB) {
        /* The second byte was historically unused; version 2 always points to
           a committed object header. */
        share_type = OH_SHARE_TYPE_COMMITTED;
    } else if (version != 3UB) {
        return shared_msg_error("unsupported shared message version");
    }

    if (share_type == OH_SHARE_TYPE_COMMITTED) {
        var obj_off = bytes_to_off(byte[global_sizeof_offsets] @ loc_off);
        return msg_payload_offset_in_ohdr(obj_off, wanted_type, 0UH, 0);
    }

    if (share_type == OH_SHARE_TYPE_SOHM) {
        if (global_sohm_table_known == 0UB)
            return shared_msg_error("SOHM shared message but the Shared Message Table (SHMESG, type 0x0f) has not been decoded yet -- walk the superblock extension's messages first");

        var idx = sohm_index_for_type(wanted_type);
        if (idx == NO_SOHM_INDEX)
            return shared_msg_error("no SOHM index covers this message type");

        /* get_sohm_heap_addr() returns sohm.pk's raw, base-relative value --
         * translate it here at the cross-pickle call site, per this
         * codebase's convention that a callee's raw getter/global leaves
         * translation to the caller. */
        var heap_addr = hdf5_addr_to_file_u64(get_sohm_heap_addr(idx));
        var id_bytes  = byte[8] @ loc_off;
        var obj_addr  = frhp_id_to_addr(heap_addr#B, id_bytes);

        /* frhp_id_to_addr() has already reported why it gave up. */
        if (obj_addr == FRHP_ADDR_UNRESOLVED)
            return SHARED_MSG_UNRESOLVED;

        return obj_addr#B;
    }

    if (share_type == OH_SHARE_TYPE_UNSHARED)
        return shared_msg_error("version 3 shared message is marked unshared");

    if (share_type == OH_SHARE_TYPE_HERE)
        return shared_msg_error("version 3 HERE message is not an external shared reference");

    return shared_msg_error("unknown shared message type");
}

/* The datatype message properties section for compound class type version 1 */
type compound_props1 = 
    struct {
        /* Field-level guard, checked immediately (zero bytes consumed) before
           any other field.  The `membs` union below (oh_msg_dtype's `compound`
           arm) evaluates compound_props1[nn]/2[nn]/3[nn] in declaration order,
           mapping each element in full before its own trailing-label
           discriminant (`v1: ver == 1`, etc.) is ever consulted -- so a
           wrong-version compound datatype can still reach the recursive,
           unboundedly expensive memb_props below before that label fires.
           This guard re-checks the same condition as the trailing label, but
           as the very first thing evaluated, aborting before memb_props can
           be reached regardless of union declaration order. See #14/#15.
           global_compound_ver is set immediately before `membs` is mapped
           (oh_msg_dtype's `compound` arm) -- these are standalone named
           types, not anonymous structs nested in oh_msg_dtype, so they have
           no lexical access to that arm's `ver`.

           This is independent of, not made redundant by, the `compound`
           arm's own `ctype == 6` guard (PR #90 review, issue #15): that one
           only confirms the message's *class* is genuinely compound -- it
           says nothing about *version*, so a real ctype==6 message with
           ver==3 would still reach here with v1 tried first, same hazard,
           one layer in. Confirmed directly: removing only this guard (the
           ctype==6 guard left in place) measurably reintroduces the cost
           (~2.6x) on a real v3 message crafted so v1's misaligned memb_hdr
           recurses expensively. */
        byte[0] _guard: global_compound_ver == 1;
        string memb_name;
        byte[round_up_8 (memb_name'size / 1#B) - (memb_name'size / 1#B)] pad;
        byte[4] memb_off;
        byte ndim;
        byte[3] res1;
        byte[4] perm;
        byte[4] res2;
        byte[4] [4] dim_sizes;
        dtype_hdr memb_hdr;

        /* Use memb_flags to determine size of the dtype_props */
        var ss = dtype_props_size_at(memb_hdr'offset);
        byte[ss] memb_props; 

        method print_indented = (int depth) void:
        {
            indent(depth); printf("  membs=struct {\n");
            indent(depth); printf("    memb_name=%v\n", memb_name);
            indent(depth); printf("    pad=%v\n", pad);
            indent(depth); printf("    memb_off=%v\n", memb_off);
            indent(depth); printf("    ndim=%v\n", ndim);
            indent(depth); printf("    dim_sizes=");
            /* Version-1 compound members encode exactly four dimension sizes;
               a larger ndim is out of spec. Members needing more use an
               array datatype (class 10), whose own ndims allows up to 32. */
            var nd = ndim as int;
            if (nd > 4)
                nd = 4;
            var i = 0;
            while (i < nd) {
                printf("[%u64d]", bytes_to_u64_le(dim_sizes[i]));
                i++;
            }
            if (nd == 0)
                printf("(scalar)");
            if (ndim > 4)
                printf(" <ndim=%v exceeds the 4 encoded dimensions>", ndim);
            printf("\n");
            indent(depth); printf("    memb_hdr=%v\n", memb_hdr);
            indent(depth); printf("    memb_props=%v\n", memb_props);
            indent(depth); printf("  }\n");
        }

        method _print = void:
        {
            print_indented (2);
        }
    };

/* The datatype message properties section for compound class type version 2 */
type compound_props2 =
    struct {
        /* See compound_props1 above: same field-level guard technique. */
        byte[0] _guard: global_compound_ver == 2;
        string memb_name;
        byte[round_up_8 (memb_name'size / 1#B) - (memb_name'size / 1#B)] pad;
        byte[4] memb_off;
        dtype_hdr memb_hdr;

        /* Use memb_flags to determine size of the dtype_props */
        var ss = dtype_props_size_at(memb_hdr'offset);
        byte[ss] memb_props; 

        method print_indented = (int depth) void:
        {
            indent(depth); printf("  membs=struct {\n");
            indent(depth); printf("    memb_name=%v\n", memb_name);
            indent(depth); printf("    pad=%v\n", pad);
            indent(depth); printf("    memb_off=%v\n", memb_off);
            indent(depth); printf("    memb_hdr=%v\n", memb_hdr);
            indent(depth); printf("    memb_props=%v\n", memb_props);
            indent(depth); printf("  }\n");
        }

        method _print = void:
        {
            print_indented (2);
        }
    };

/* The datatype message properties section for compound class type version 3 */
type compound_props3 =
    struct {
        /* See compound_props1 above: same field-level guard technique. */
        byte[0] _guard: global_compound_ver >= 3;
        string memb_name;
        byte[get_v3_cmpd_memb_off_size(global_dt_elm_size)] memb_off;
            dtype_hdr memb_hdr;

            /* Use memb_flags to determine size of the dtype_props */
            var ss = dtype_props_size_at(memb_hdr'offset);
            byte[ss] memb_props; 

            method print_indented = (int depth) void:
            {
                indent(depth); printf("  membs=struct {\n");
                indent(depth); printf("    memb_name=%v\n", memb_name);
                indent(depth); printf("    memb_off=%v\n", memb_off);
                indent(depth); printf("    memb_hdr=%v\n", memb_hdr);
                indent(depth); printf("    memb_props=%v\n", memb_props);
                indent(depth); printf("  }\n");
            }

            method _print = void:
            {
                print_indented (2);
            }
        };

/* The datatype message properties section for enumerated class type version 1 & 2 */
type enum_props =
    struct {
        /* Field-level guard, same technique and rationale as
           compound_props1/2/3 above (see #14/#15, PR #90 review): the
           `memb_names` union below (oh_msg_dtype's `enumeration` arm)
           evaluates enum_props[nn]/enum_name_v3[nn] in declaration order,
           mapping each element in full before its own trailing-label
           discriminant is checked -- so a version-3 enumeration can still
           have its names misread with this padded (v1/v2) layout before
           that label fires. global_enum_ver is set immediately before
           `memb_names` is mapped, for the same standalone-type reason
           global_compound_ver is. */
        byte[0] _guard: global_enum_ver <= 2;
        string name;
        byte[round_up_8 (name'size / 1#B) - (name'size / 1#B)] pad;
    };

/* Wraps poke's built-in `string` so the `memb_names` union's v3 alternative
   (enumeration/enumeration class, ver>=3) can carry the same field-level
   guard as enum_props above -- `string` itself is a built-in type and
   cannot be given a `_guard` field directly. */
type enum_name_v3 =
    struct {
        byte[0] _guard: global_enum_ver >= 3;
        string name;
    };

/* The datatype message properties section for array class type version 2 */
type array_props2 =
    struct {
        byte ndims;
        byte[3] res;
        uint<32> [ndims] dim_size;
        uint<32> [ndims] perm_size;
    };

/* The datatype message properties section for array class type version 3 */
type array_props3 =
    struct {
        byte ndims;
        uint<32> [ndims] dim_size;
    };

/* DTYPE_ID       0x0003 Datatype Message.  */
type oh_msg_dtype = 
    struct { 
        dtype_hdr hdr;

        var ver = hdr.get_version();
        var ctype = hdr.get_ctype();

        /* Just a stub for value returned to temp */
        /* Used by version 3 compound type properties */
        var temp = hdr.set_global_dt_elm_size();

        union {
            struct {
                /* Field-level guard, checked immediately (zero bytes
                   consumed) before any other field in this arm. This outer
                   `types` union -- one arm per datatype class -- was itself
                   unaudited for #14/#15: it dispatches on trailing `ctype`
                   labels alone, so a wrong-class arm can map real,
                   attacker/format-influenced bytes as its own fields before
                   its label is ever checked. Most notably the `enumeration`
                   arm below can attempt a `byte[nn * base_hdr.elm_size]`
                   read sized from bits that are unconstrained for any other
                   class. Guards on every arm here (matching each arm's own
                   existing trailing label exactly) close this regardless of
                   declaration order. See PR #90 review on issue #15. */
                byte[0] _guard: ctype == 0;
                uint<16> bit_offset;
                uint<16> bit_precision;

                var tt = hdr.flags;
                var ss = hdr.elm_size;

                var ff = tt .>>8;

                method byte_order = int: { return (ff & 0x1) as int; }
                method low_pad   = int:  { return (ff .>>1 & 0x1) as int; }
                method high_pad  = int:  { return (ff .>>2 & 0x1) as int; }
                method signed = int:     { return (ff .>>3 & 0x1) as int; }

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  fixed_point=struct {\n");
                    indent(depth); printf("    Version:%v\n", ver);
                    indent(depth); printf("    Byte order:%s\n", byte_order() ? "big endian" : "little endian");
                    indent(depth); printf("    Low pad type:%s\n", low_pad() ? "one" : "zero");
                    indent(depth); printf("    High pad type:%s\n", high_pad() ? "one" : "zero");
                    indent(depth); printf("    Sign scheme:%s\n", signed() ? "2's com" : "unsigned type");
                    indent(depth); printf("    bit_offset=%v\n", bit_offset);
                    indent(depth); printf("    bit_precision=%v\n", bit_precision);
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void:
                {
                    print_indented (1);
                }


            } fixed_point: ctype == 0;

            struct {
                /* See fixed_point's `_guard` above for the rationale. */
                byte[0] _guard: ctype == 1;
                uint<16> bit_offset;
                uint<16> bit_precision;
                uint<8> eloc;
                uint<8> esize;
                uint<8> mloc;
                uint<8> msize;
                uint<32> ebias;

                var tt = hdr.flags;
                var ss = hdr.elm_size;
                var ff = tt .>>8;

                method vax_byte_order = int: 
                { 
                    if (ver >= 3) {
                        return (((ff .>> 6 & 0x1) && ff & 0x1)) as int;
                    } else
                        return(0);
                }

                method byte_order = int: { return (ff & 0x1) as int; }

                method low_pad  = int:      { return (ff .>>1 & 0x1) as int; }
                method high_pad = int:      { return (ff .>>2 & 0x1) as int; }
                method internal_pad = int:  { return (ff .>>3 & 0x1) as int; }

                method norm  = int:{ return (ff .>>4 & 0x3) as int; }

                method sign_loc = int:     { return (ff .>>8 & 0xff) as int; }

                method print_indented = (int depth) void:
                {
                    var vax = vax_byte_order();
                    var nn = norm();

                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  floating_point=struct {\n");

                    indent(depth); printf("    Version:%v\n", ver);
                    indent(depth); printf("    Byte order:%s\n", vax ? "VAX" : (byte_order() ? "big endian" : "little endian"));
                    indent(depth); printf("    Low pad type:%s\n", low_pad() ? "one" : "zero");
                    indent(depth); printf("    High pad type:%s\n", high_pad() ? "one" : "zero");
                    indent(depth); printf("    Internal pad type:%s\n", internal_pad() ? "one" : "zero");
                    /* Questionable about implied and none in the library coding v.s. debug coding */
                    indent(depth); printf("    Normalization:%s\n", nn == 0 ? "none" : (nn == 1 ? "msb set" : "implied"));
                    indent(depth); printf("    Sign bit location:%v\n", sign_loc());

                    indent(depth); printf("    bit_offset=%v\n", bit_offset);
                    indent(depth); printf("    bit_precision=%v\n", bit_precision);
                    indent(depth); printf("    exponent_location=%v\n", eloc);
                    indent(depth); printf("    exponent_size=%v\n", esize);
                    indent(depth); printf("    mantissa_location=%v\n", mloc);
                    indent(depth); printf("    mantissa_size=%v\n", msize);
                    indent(depth); printf("    exponent_bias=%v\n", ebias);
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void:
                {
                    print_indented (1);
                }

            } floating_point: ctype == 1;

            /* Not verified yet for time */
            struct {
                /* See fixed_point's `_guard` above for the rationale. */
                byte[0] _guard: ctype == 2;
                uint<16> bit_precision;

                var tt = hdr.flags;
                var ss = hdr.elm_size;
                var ff = tt .>>8;

                method byte_order = int: { return (ff & 0x1) as int; }

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  time=struct {\n");
                    indent(depth); printf("    Version:%v\n", ver);
                    indent(depth); printf("    Byte order:%s\n", byte_order() ? "big endian" : "little endian");
                    indent(depth); printf("    bit_precision=%v\n", bit_precision);
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void: 
                {
                    print_indented (1);
                }

            } time: ctype == 2;
 
            struct {
                /* See fixed_point's `_guard` above for the rationale. This
                   arm has no mapped fields at all, so there is nothing to
                   protect -- kept for consistency/auditability, not because
                   it is otherwise at risk. */
                byte[0] _guard: ctype == 3;
                var tt = hdr.flags;
                var ss = hdr.elm_size;
                var ff = tt .>>8;

                method pad_type = int: { return (ff & 0xf) as int; }
                method cset = int: { return (ff .>> 4 & 0xf) as int; }

                method print_indented = (int depth) void:
                {
                    var pp = pad_type();
                    var cs = cset();

                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  string=struct {\n");
                    indent(depth); printf("    Version:%v\n", ver);
                    indent(depth); printf("    String padding:%s\n", pp == 0 ? "NULL Terminated" : (pp == 1 ? "NULL Padded" : "Space Padded"));
                    indent(depth); printf("    Character set:%s\n", cs == 0 ? "ASCII" : "UTF-8");
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void: 
                {
                    print_indented (1);
                }

            } text_string: ctype  == 3;

            struct {
                /* See fixed_point's `_guard` above for the rationale. */
                byte[0] _guard: ctype == 4;
                uint<16> bit_offset;
                uint<16> bit_precision;

                var tt = hdr.flags;
                var ss = hdr.elm_size;
                var ff = tt .>>8;

                method byte_order = int: { return (ff & 0x1) as int; }
                method low_pad   = int:  { return (ff .>>1 & 0x1) as int; }
                method high_pad  = int:  { return (ff .>>2 & 0x1) as int; }

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  bitfield=struct {\n");
                    indent(depth); printf("    Version:%v\n", ver);
                    indent(depth); printf("    Byte order:%s\n", byte_order() ? "big endian" : "little endian");
                    indent(depth); printf("    Low pad type:%s\n", low_pad() ? "one" : "zero");
                    indent(depth); printf("    High pad type:%s\n", high_pad() ? "one" : "zero");
                    indent(depth); printf("    bit_offset=%v\n", bit_offset);
                    indent(depth); printf("    bit_precision=%v\n", bit_precision);
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void: 
                {
                    print_indented (1);
                }

            } bitfield: ctype == 4;

            struct {
                /* See fixed_point's `_guard` above for the rationale.
                   `tag` below is an unbounded null-terminated scan when
                   wrongly entered against another class's bytes. */
                byte[0] _guard: ctype == 5;
                string tag;
                byte[round_up_8 (tag'size / 1#B) - (tag'size / 1#B)] pad;

                var tt = hdr.flags;
                var ss = hdr.elm_size;
                var ff = tt .>>8;
            
                method tag_len = int: { return (ff & 0xff) as int; }

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  opaque=struct {\n");
                    indent(depth); printf("    Version:%v\n", ver);
                    indent(depth); printf("    Length of tag:%v\n", tag_len());
                    indent(depth); printf("    tag=%s\n", tag);
                    indent(depth); printf("    pad=%v\n", pad);
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void: 
                {
                    print_indented (1);
                }

            } opaque: ctype == 5;

            struct {
                /* See fixed_point's `_guard` above for the rationale. This
                   one matters even with compound_props1/2/3's own guards
                   (PR #90 review, issue #15): those check *version*, not
                   *class* -- so if `compound` gets tried for a message that
                   isn't actually class 6, the inner guards have no way to
                   detect that, and let the (wrong) attempt through anyway.
                   Concretely: `ver` covers the whole 1-15 range across the
                   three of them (`==1`, `==2`, `>=3`), so whatever garbage
                   `ver` a misread produces, one of those guards is almost
                   certain to pass regardless of the message's true class,
                   and `nn` (below, attacker/format-influenced when
                   ctype != 6) still drives a real compound_propsN[nn]
                   attempt. This guard is what actually stops that.

                   The two guards are independent, not redundant: this one
                   rejects the wrong *class* before nn is ever trusted; each
                   compound_propsN's own guard rejects the wrong *version*
                   once a class-6 message is confirmed. Removing either one
                   alone reopens a real gap -- confirmed directly: with only
                   compound_props1's guard removed (this one left in place),
                   a genuine v3 message crafted so v1's misaligned memb_hdr
                   recurses into dtype_props_size_at still cost measurably
                   more (~2.6x) than with both guards present. */
                byte[0] _guard: ctype == 6;
                var ff = hdr.flags;
                var ss = hdr.elm_size;

                var t_flags = hdr.flags .>>8;
                var nn = t_flags & 0xffff;

                method nmembs = int: { return (t_flags & 0xffff) as int; }

                /* compound_props1/2/3 (below) are standalone named types
                   without lexical access to `ver` -- publish it through this
                   global so each one's own field-level guard can check it.
                   See the comment on compound_props1's `_guard` field. */
                var _set_compound_ver = set_global_compound_ver(ver);

                union {
                    compound_props1[nn] v1: ver == 1;
                    compound_props2[nn] v2: ver == 2;
                    compound_props3[nn] v3: ver >= 3;
                } membs;

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", ff);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  compound=struct {\n");
                    indent(depth); printf("    Version: %v\n", ver);
                    var n = nmembs();
                    indent(depth); printf("    Number of members: %v\n", n);

                    var i = 0;
                    while (i < n) {
                       //membs[i].print_indented(depth+1);
                        if (ver == 1)
                            membs.v1[i].print_indented(depth+1);
                        else if (ver == 2)
                            membs.v2[i].print_indented(depth+1);
                        else if (ver >= 3)
                            membs.v3[i].print_indented(depth+1);
                        i++;
                    }
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");

                }

                method _print = void:
                {
                    print_indented (1);
                }

            } compound: ctype == 6;

            struct {
                /* See fixed_point's `_guard` above for the rationale. This
                   arm has no mapped fields at all, so there is nothing to
                   protect -- kept for consistency/auditability. */
                byte[0] _guard: ctype == 7;

                var tt = hdr.flags;
                var ss = hdr.elm_size;
                var ff = tt .>>8;
            
                method rtype = int: { return (ff & 0xf) as int; }

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", tt);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  Reference=struct {\n");
                    indent(depth); printf("    Version:%v\n", ver);

                    var rr = rtype();

                    if (ver < 4) {
                        indent(depth); printf("    Reference type:%v\n", rr == 0 ? "H5R_OBJECT1" : "H5R_DATASET_REGION1");
                    } else {
                        /* Version 4: type bits are always 2 (H5R_OBJECT2), used as a
                         * placeholder for the new-style opaque reference (H5T_STD_REF).
                         * The actual sub-type (object/region/attr) is encoded at the
                         * data-element level, not in the datatype message. */
                        indent(depth); printf("    Reference type:%v\n", rr == 2 ? "H5R_OBJECT2" : format("UNKNOWN(%v)", rr));
                        indent(depth); printf("    Encoded version:%v\n", (ff .>> 4 & 0x0f));
                    }

                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void: 
                {
                    print_indented (1);
                }

            } reference: ctype == 7;

            struct {
                /* See fixed_point's `_guard` above for the rationale. This
                   is the arm the PR #90 review specifically flagged:
                   memb_values below (byte[nn*base_hdr.elm_size]) is sized
                   from bits that are unconstrained for any other class,
                   so a wrong-class message could otherwise drive an
                   attacker/format-influenced allocation before ctype == 8
                   is checked.

                   The inner memb_names union just below has the same
                   #14/#15 hazard one layer in -- v1_2/v3 selects between
                   enum_props and the built-in `string` by a trailing `ver`
                   label -- and is guarded separately: see enum_props and
                   enum_name_v3 above. */
                byte[0] _guard: ctype == 8;
                var ff = hdr.flags;
                var ss = hdr.elm_size;

                var t_flags = hdr.flags .>>8;
                var nn = t_flags & 0xffff;

                method nmembs = int: { return (t_flags & 0xffff) as int; }

                dtype_hdr base_hdr;

                /* Use base_hdr.flags to get class type to determine property size for each class type */
                //var jj = dtype_props_size(base_hdr.flags);
                var jj = dtype_props_size_at(base_hdr'offset);
                byte[jj] base_props;

                var _set_enum_ver = set_global_enum_ver(ver);

                union {
                    enum_props[nn] v1_2: ver <= 2;
                    enum_name_v3[nn] v3: ver >= 3;
                } memb_names;

                byte[nn*base_hdr.elm_size] memb_values;

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", ff);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  enumeration=struct {\n");
                    indent(depth); printf("    Version: %v\n", ver);
                    var n = nmembs();
                    indent(depth); printf("    Number of members: %v\n", n);
                    indent(depth); printf("    base_hdr=%v\n", base_hdr);
                    indent(depth); printf("    base_props=%v\n", base_props);

                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");

                }

                method _print = void:
                {
                    print_indented (1);
                }

            } enumeration: ctype == 8;

            struct {
                /* See fixed_point's `_guard` above for the rationale.
                   base_props below is sized via dtype_props_size_at on a
                   nested header that, if this arm is wrongly entered,
                   reads bytes belonging to some other class entirely. */
                byte[0] _guard: ctype == 9;

                var ff = hdr.flags;
                var ss = hdr.elm_size;

                var t_flags = hdr.flags .>>8;

                method vlen_type = int: { return (t_flags & 0x0f) as int; }

                dtype_hdr base_hdr;

                /* Determine property size for each class type */
                var jj = dtype_props_size_at(base_hdr'offset);
                byte[jj] base_props; 

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", ff);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  variable-length=struct {\n");
                    indent(depth); printf("    Version: %v\n", ver);
                    var vtype = vlen_type();
                    indent(depth); printf("    Type: %s\n", vtype == 0 ? "sequence" : "string");

                    indent(depth); printf("    base_hdr=%v\n", base_hdr);
                    indent(depth); printf("    base_props=%v\n", base_props);

                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");

                }

                method _print = void:
                {
                    print_indented (1);
                }

            } variable_length: ctype == 9;

            struct {
                /* See fixed_point's `_guard` above for the rationale. */
                byte[0] _guard: ctype == 10;
                var ff = hdr.flags;
                var ss = hdr.elm_size;

                /* Version shouldn't be less than 2 */
                union {
                    array_props2 v2: ver == 2;
                    array_props3 v3: ver >= 3;
                    byte[20] unknown;
                } arr;

                dtype_hdr base_hdr;

                /* Determine property size for each class type */
                var jj = dtype_props_size_at(base_hdr'offset);
                byte[jj] base_props; 

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", ff);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  array=struct {\n");
                    indent(depth); printf("    Version: %v\n", ver);

                    if (ver == 2) {
                        indent(depth); printf("    arr.v2=%v\n", arr.v2);
                    } else if (ver >= 3) {
                        indent(depth); printf("    arr.v3=%v\n", arr.v3);
                    }

                    indent(depth); printf("    base_hdr=%v\n", base_hdr);
                    indent(depth); printf("    base_props=%v\n", base_props);

                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");

                }

                method _print = void:
                {
                    print_indented (1);
                }

            } array: ctype == 10;

            struct {
                /* See fixed_point's `_guard` above for the rationale. */
                byte[0] _guard: ctype == 11 && hdr.complex_encoding_defined() == 1;
                var ff = hdr.flags;
                var ss = hdr.elm_size;
                /* The class bit math lives in dtype_hdr, so both complex arms
                   read the same fields the same way; a method body cannot reach
                   the enclosing struct, hence the map-time copies. */
                var hh = hdr.complex_homogeneous();
                var fm = hdr.complex_form();

                method homogeneous = int: { return hh; }
                method form = int: { return fm; }

                dtype_hdr base_hdr;

                /* Determine property size for the floating-point base type. */
                var jj = dtype_props_size_at(base_hdr'offset);
                byte[jj] base_props;

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", ff);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  complex=struct {\n");
                    indent(depth); printf("    Version: %v\n", ver);
                    indent(depth); printf("    Homogeneous: %s\n",
                                          homogeneous() ? "yes" : "no");
                    indent(depth); printf("    Form: %s\n",
                                          complex_form_name(form()));
                    indent(depth); printf("    base_hdr=%v\n", base_hdr);
                    indent(depth); printf("    base_props=%v\n", base_props);
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void:
                {
                    print_indented (1);
                }

            } complex: ctype == 11 && hdr.complex_encoding_defined() == 1;

            /* A class-11 datatype whose class bit field is not the homogeneous
               rectangular encoding.  The format defines no property layout for
               it and libhdf5 refuses the datatype outright, so nothing past the
               8-byte header is decoded: the class bits are reported as found and
               the property bytes stay raw.  Printing a base type here would
               invent structure that no consumer will ever read.  The constraint
               is the exact complement of the arm above, so a *defined* complex
               that is merely truncated still fails to map instead of being
               mislabelled as an undefined encoding. */
            struct {
                /* See fixed_point's `_guard` above for the rationale. This
                   arm has no mapped fields at all, so there is nothing to
                   protect -- kept for consistency/auditability. */
                byte[0] _guard: ctype == 11;
                var ff = hdr.flags;
                var ss = hdr.elm_size;
                var hh = hdr.complex_homogeneous();
                var fm = hdr.complex_form();

                method homogeneous = int: { return hh; }
                method form = int: { return fm; }

                method print_indented = (int depth) void:
                {
                    indent(depth); printf("hdr.flags=%v\n", ff);
                    indent(depth); printf("hdr.elm_size=%v\n", ss);
                    indent(depth); printf("types=struct {\n");
                    indent(depth); printf("  complex=struct {\n");
                    indent(depth); printf("    Version: %v\n", ver);
                    indent(depth); printf("    Homogeneous: %s\n",
                                          homogeneous() ? "yes" : "no");
                    indent(depth); printf("    Form: %s\n",
                                          complex_form_name(form()));
                    indent(depth); printf("    Undefined encoding: properties not decoded\n");
                    indent(depth); printf("  }\n");
                    indent(depth); printf("}\n");
                }

                method _print = void:
                {
                    print_indented (1);
                }

            } complex_undefined: ctype == 11;

        } types;

        method print_dtype_indent = (int depth) void:
        {
            indent(depth); printf("oh_msg_dtype {\n");
            if (ctype == 0) {
                types.fixed_point.print_indented(depth+1);
            } else if (ctype == 1) {
                types.floating_point.print_indented(depth+1);
            } else if (ctype == 2) {
                types.time.print_indented(depth+1);
            } else if (ctype == 3) {
                types.text_string.print_indented(depth+1);
            } else if (ctype == 4) {
                types.bitfield.print_indented(depth+1);
            } else if (ctype == 5) {
                types.opaque.print_indented(depth+1);
            } else if (ctype == 6) {
                types.compound.print_indented(depth+1);
            } else if (ctype == 7) {
                types.reference.print_indented(depth+1);
            } else if (ctype == 8) {
                types.enumeration.print_indented(depth+1);
            } else if (ctype == 9) {
                types.variable_length.print_indented(depth+1);
            } else if (ctype == 10) {
                types.array.print_indented(depth+1);
            } else if (ctype == 11) {
                if (hdr.complex_encoding_defined())
                    types.complex.print_indented(depth+1);
                else
                    types.complex_undefined.print_indented(depth+1);
            } else {
                indent(depth+1); printf("Unknown class type=%v\n", ctype);
            }
            indent(depth); printf("}\n");
        }

        /* 
         *  NOTE: Printing for ctype 6, 8, 9, 10, 11 is not done here due to recursion issue.
         *        They are printed via print_recurse_dtype() in ohdr_msgs.pk.
         */
        method _print = void:
        {
            if (ctype == 0) {
                printf("oh_msg_dtype {\n");
                types.fixed_point._print;
                printf("}\n");
            } else if (ctype == 1) {
                printf("oh_msg_dtype {\n");
                types.floating_point._print;
                printf("}\n");
            } else if (ctype == 2) {
                printf("oh_msg_dtype {\n");
                types.time._print;
                printf("}\n");
            } else if (ctype == 3) {
                printf("oh_msg_dtype {\n");
                types.text_string._print;
                printf("}\n");
            } else if (ctype == 4) {
                printf("oh_msg_dtype {\n");
                types.bitfield._print;
                printf("}\n");
            } else if (ctype == 5) {
                printf("oh_msg_dtype {\n");
                types.opaque._print;
                printf("}\n");
            } else if (ctype == 7) {
                printf("oh_msg_dtype {\n");
                types.reference._print;
                printf("}\n");
            } else if (ctype > 11) {
                /* Unknown class warning belongs here, not in dtype_props_size_at() calculator */
                printf ("Unknown class type=%v\n", ctype);

            }
        }
    };

/* Function to recursively print datatype */
fun print_recurse_dtype = (oh_msg_dtype dt, int depth) void:
{
    var ctype = dt.hdr.get_ctype();
    var ver = dt.hdr.get_version();
  
    if (ctype == 0) { /* Fixed Point */

        dt.types.fixed_point.print_indented(depth+1);

    } else if (ctype == 1) { /* Floating Point */

        dt.types.floating_point.print_indented(depth+1);

    } else if (ctype == 2) {

        dt.types.time.print_indented(depth+1);

    } else if (ctype == 3) {

        dt.types.text_string.print_indented(depth+1);

    } else if (ctype == 4) {

        dt.types.bitfield.print_indented(depth+1);
    
    } else if (ctype == 5) {

        dt.types.opaque.print_indented(depth+1);

    } else if (ctype == 6) { /* Compound */
        indent(depth); printf("oh_msg_dtype {\n");

        dt.types.compound.print_indented(depth+1);

        var n = dt.types.compound.nmembs();
        var i = 0;
        while (i < n) {
            indent(depth+1); printf("Member %v:\n", i);
            indent(depth+1); printf("  oh_msg_dtype {\n");
            if (ver == 1) {
                var memb_dt = oh_msg_dtype @ dt.types.compound.membs.v1[i].memb_hdr'offset;
                print_recurse_dtype(memb_dt, depth+2);
                indent(depth+1); printf("  }\n");
            } else if (ver == 2) {
                var memb_dt = oh_msg_dtype @ dt.types.compound.membs.v2[i].memb_hdr'offset;
                print_recurse_dtype(memb_dt, depth+2);
                indent(depth+1); printf("  }\n");
            } else if (ver >= 3) {
                var memb_dt = oh_msg_dtype @ dt.types.compound.membs.v3[i].memb_hdr'offset;
                print_recurse_dtype(memb_dt, depth+2);
                indent(depth+1); printf("  }\n");
            }
            i++;
        }
        indent(depth); printf("}\n");

    } else if (ctype == 7) {

        dt.types.reference.print_indented(depth+1);

    } else if (ctype == 8) {

        indent(depth); printf("oh_msg_dtype {\n");

        dt.types.enumeration.print_indented(depth+1);

        var n = dt.types.enumeration.nmembs();
        var i = 0;
        var memb_dt = oh_msg_dtype @ dt.types.enumeration.base_hdr'offset;
        indent(depth+1); printf("Base type: {\n");
        print_recurse_dtype(memb_dt, depth+1);
        indent(depth+1); printf("}\n");
        while (i < n) {
            if (ver <= 2) {
                indent(depth+1); printf("Member %v:\n", i);
                indent(depth+2); printf("names=%v\n", dt.types.enumeration.memb_names.v1_2[i]);
            } else if (ver >= 3) {
                indent(depth+1); printf("Member %v:\n", i);
                indent(depth+2); printf("names=%v\n", dt.types.enumeration.memb_names.v3[i].name);
            }
            i++;
        }
        indent(depth); printf("}\n");

    } else if (ctype == 9) {

        indent(depth); printf("oh_msg_dtype {\n");

        dt.types.variable_length.print_indented(depth+1);

        var memb_dt = oh_msg_dtype @ dt.types.variable_length.base_hdr'offset;
        indent(depth+1); printf("Base type: {\n");
        print_recurse_dtype(memb_dt, depth+1);
        indent(depth+1); printf("}\n");

        indent(depth); printf("}\n");

    } else if (ctype == 10) {

        indent(depth); printf("oh_msg_dtype {\n");

        dt.types.array.print_indented(depth+1);

        var memb_dt = oh_msg_dtype @ dt.types.array.base_hdr'offset;
        indent(depth+1); printf("Base type: {\n");
        print_recurse_dtype(memb_dt, depth+1);
        indent(depth+1); printf("}\n");

        indent(depth); printf("}\n");

    } else if (ctype == 11) {

        indent(depth); printf("oh_msg_dtype {\n");

        if (dt.hdr.complex_encoding_defined()) {

            dt.types.complex.print_indented(depth+1);

            var memb_dt = oh_msg_dtype @ dt.types.complex.base_hdr'offset;
            indent(depth+1); printf("Base type: {\n");
            print_recurse_dtype(memb_dt, depth+1);
            indent(depth+1); printf("}\n");

        } else
            /* No property layout is defined, so there is no base type to
               recurse into. */
            dt.types.complex_undefined.print_indented(depth+1);

        indent(depth); printf("}\n");

    }
}

/* Print dtype (recursive/non-recursive) after mapping oh_msg_dtype to a variable */
fun print_dtype = (oh_msg_dtype dt, int depth) void:
{
    var ctype = dt.hdr.get_ctype();

    /* Recursive printing for: 
       ctype 6 -- compound type
       ctype 8 -- enumeration type
       ctype 9 -- variable-length type
       ctype 10 -- array type
       ctype 11 -- complex type
     */
    if (ctype == 6 || ctype == 8 || ctype == 9 || ctype == 10 || ctype == 11)
        print_recurse_dtype(dt, depth);
    else {
        dt.print_dtype_indent(depth);
    }
}


/* FILL_ID        0x0004 Fill Value Message. (Old)  */
type oh_msg_old_fill = 
    struct {
        uint<32> fill_size;
        if (fill_size > 0)
            byte[fill_size] fill_value;
    };


/* FILL_NEW_ID    0x0005 Fill Value Message. (New)  */
type oh_msg_fill = 
    struct {
        byte version: version < 4;
        union {
            struct {
                /* Field-level guard, checked immediately (zero bytes consumed)
                   before any other field in this arm.  Poke maps a union
                   alternative's fields in full before checking a *trailing*
                   label constraint (the `v1_v2: version < 3` below) -- see
                   issue #14 for the resulting hazard: a wrong-version message
                   can still reach fill_value below with a garbage fill_size
                   before that label is ever consulted. This guard re-checks
                   the same condition as the trailing label, but as the very
                   first thing evaluated, so it aborts before fill_value can
                   be reached regardless of union declaration order. See #15. */
                byte[0] _guard: version < 3;
                byte alloc_time;
                byte fill_time;
                byte fill_defined;
                uint<32> fill_size if (fill_defined > 0);
                /* fill_size is absent unless fill_defined is set, and reading
                   an absent field raises E_elem -- which a union does not
                   recover from, unlike the E_constraint that selects between
                   these two arms. Guard on presence first, as the v3 arm
                   below does, so that a version-3 message whose bytes happen
                   to leave fill_defined zero still falls through to v3
                   instead of aborting the whole decode. */
                if (fill_defined > 0 && fill_size > 0)
                    byte[fill_size] fill_value;
            } v1_v2: version < 3;

            struct {
                /* See the v1_v2 arm above: same field-level guard technique,
                   protecting fill_value from a garbage-sized read if this arm
                   is ever tried against a non-v3 message. */
                byte[0] _guard: version == 3;
                byte flags;
                uint<32> fill_size if (flags & 0x020U);
                if ((flags & 0x020U) && (fill_size > 0))
                    byte[fill_size] fill_value;
            } v3: version == 3;

        } space;
    };

/* LINK_ID        0x0006 Link Message. */
var LNK_TYPE_SOFT = 1;   /* Soft link */
var LNK_TYPE_EXT = 64;   /* External link */
type oh_msg_link = 
    struct {
        byte version == 1UB;
        byte flags: (flags & 0xe0UB) == 0UB;
        var _has_lnk_type = (flags & 8U) != 0;
        byte lnk_type if (_has_lnk_type);         /* bit 3 of flags */
        var _lnk_type = _has_lnk_type ? lnk_type : 0UB;

        uint<64> corder if (flags & 4U) != 0;   /* Bit 2 of flags */
        byte cset if (flags & 16U) != 0;        /* Bit 4 of flags */

        var _lnk_len_num_bytes = 1 <<. (flags & 3U);
        byte[_lnk_len_num_bytes] lnk_len: hdf5_bytes_nonzero(lnk_len);

        var _lnk_len = bytes_to_u64_le(lnk_len);
        char[_lnk_len] lnk_name;    /* non-null terminated */

        /* Hard-link: Address of the object header for the link points to */
        byte[global_sizeof_offsets] ohdr_addr_raw:
            hdf5_addr_in_declared_eof(ohdr_addr_raw, 0) if (_lnk_type == 0);

        /* Soft link */
        uint<16> soft_len if (_lnk_type == LNK_TYPE_SOFT);
        if (_lnk_type == LNK_TYPE_SOFT && soft_len > 0)
            char[soft_len] soft_name; /* non-null terminated */

        /* External/user-defined link */
        uint<16> ud_len if (_lnk_type >= LNK_TYPE_EXT);
        if (_lnk_type >= LNK_TYPE_EXT && ud_len > 0)
            char[ud_len] ud_data; /* external link: string is null terminated */
    };


/* EFL_ID         0x0007 External File List Message (IV.A.2.h) */

/* One entry in the External File List slot array. */
type ext_slot =
    struct {
        byte[global_sizeof_lengths] name_off_raw;  /* Name offset in local heap */
        byte[global_sizeof_lengths] file_off_raw;  /* Byte offset into external file */
        byte[global_sizeof_lengths] data_size_raw; /* Bytes reserved in external file */
    };

type oh_msg_external =
    struct {
        byte version;
        byte[3] reserved;
        uint<16> allocated_slots;
        uint<16> used_slots;
        byte[global_sizeof_offsets] heap_addr_raw:
            hdf5_addr_in_declared_eof(heap_addr_raw, 0);
        ext_slot[used_slots] slots;
    };



/* LAYOUT_ID      0x0008 Data Layout Message.  */

var COMPACT = 0;   /* Compact storage */
var CONTIG = 1;    /* Contiguous storage */
var CHUNKED = 2;   /* Chunked storage */
var VIRTUAL = 3;   /* Virtual storage */
/* Versions 4 and 5 share one on-disk encoding: v5 only widens the *chunk
   index records'* filtered-chunk size field to the file's size-of-lengths
   (libhdf5 src/H5Dearray.c, H5Dfarray.c, H5Dbtree2.c), while the layout
   message itself is byte-identical.  They therefore share one union arm, the
   way versions 1 and 2 do.  */
type oh_msg_layout =
    struct {
        byte version: version >= 1UB && version < 6UB;
        union {
            struct {
                byte layout_class: layout_class == COMPACT || layout_class == CONTIG || layout_class == CHUNKED;
                union {
                    struct {
                        byte ndims: ndims >= 2UB && ndims <= 33UB;
                        byte[global_sizeof_offsets] idx_addr_raw;
                        uint<32> [ndims] dim_size;
                    } chunked: layout_class == CHUNKED;

                    struct {
                        byte[global_sizeof_offsets] data_addr_raw;
                        byte[global_sizeof_lengths] data_size_raw;
                    } contig: layout_class == CONTIG;

                    struct {
                        uint<16> size;
                        if (size > 0)
                            byte[size] raw_data;
                    } compact: layout_class == COMPACT;
                } properties;

            } v3: version == 3;

            struct {
                byte layout_class: layout_class == COMPACT || layout_class == CONTIG || layout_class == CHUNKED || layout_class == VIRTUAL;
                union {
                    struct {
                        byte flags: (flags & 0xfcUB) == 0UB;
                        byte ndims: ndims <= 33UB;
                        byte enc_bytes_per_dim: enc_bytes_per_dim >= 1UB && enc_bytes_per_dim <= 8UB;
                        byte[enc_bytes_per_dim] [ndims] dim_size;
                        byte idx_type: idx_type >= 1UB && idx_type <= 5UB;
                        union {
                            struct {
                                if (flags & 2U)
                                    byte[global_sizeof_lengths] filter_chunk_size;
                                if (flags & 2U)
                                    uint<32> filter_mask;
                            } single: idx_type == 1;

                            struct {
                            } implicit: idx_type == 2;

                            struct {
                                uint<8> max_dblk_page_nelmts_bits: max_dblk_page_nelmts_bits > 0UB;
                            } farray: idx_type == 3;

                            struct {
                                uint<8> max_nelmts_bits: max_nelmts_bits > 0UB;
                                uint<8> idx_blk_elmts: idx_blk_elmts > 0UB;
                                uint<8> sup_blk_min_data_ptrs: sup_blk_min_data_ptrs > 0UB;
                                uint<8> data_blk_min_elmts: data_blk_min_elmts > 0UB;
                                uint<8> max_dblk_page_nelmts_bits: max_dblk_page_nelmts_bits > 0UB;
                            } earray: idx_type == 4;
                            struct {
                                uint<32> node_size;
                                uint<8> split_percent: split_percent > 0UB && split_percent <= 100UB;
                                uint<8> merge_percent: merge_percent > 0UB && merge_percent <= 100UB;
                            } bt2: idx_type == 5;
                        } idx_info;

                        byte[global_sizeof_offsets] idx_addr_raw;
                    } chunked: layout_class == CHUNKED;

                    struct {
                        byte[global_sizeof_offsets] data_addr_raw;
                        byte[global_sizeof_lengths] data_size_raw;
                    } contig: layout_class == CONTIG;

                    struct {
                        uint<16> size;
                        if (size > 0)
                            byte[size] raw_data;

                        /* Custom Pretty Printer: not printing raw_data if too big */
                        method _print = void:
                        {
                            printf("struct {");
                            if (size > 300U)
                                printf ("<size=%u16d, raw_data=NOT PRINTED>", size);
                            else
                                printf ("<size=%u16d, raw_data=%v>", size, raw_data);
                            printf("}");
                        }
                    } compact: layout_class == COMPACT;

                    struct {
                        byte[global_sizeof_offsets] gheap_addr_raw;
                        uint<32> idx;
                    } virtual: layout_class == VIRTUAL;

                } properties;
            } v4_v5: version >= 4;

            struct {
                byte ndims: ndims >= 1UB && ndims <= 33UB;
                byte layout_class: layout_class == COMPACT || layout_class == CONTIG || layout_class == CHUNKED;
                byte[5] res;

                union {
                    struct {
                        byte[global_sizeof_offsets] data_addr_raw;
                        uint<32> [ndims] dim_size;
                    } contig: layout_class == CONTIG;

                    struct {
                        byte[global_sizeof_offsets] idx_addr_raw;
                        uint<32> [ndims] dim_size;
                    } chunked: layout_class == CHUNKED;

                    struct {
                        uint<32> [ndims] dim_size;
                        uint<32> size;
                        if (size > 0)
                            byte[size] compact_data;
                    } compact: layout_class == COMPACT;

                } properties;

            } v1_v2: version < 3;

        } layout;
    };

/* Chunked layout messages encode dataset-rank + 1 dimensions.  The final
   dimension is not part of the chunk shape: it is the datatype size stored in
   the layout and checked against the datatype message when a dataset opens. */
fun oh_layout_has_stored_element_size = (oh_msg_layout msg) int:
{
    if (msg.version < 3UB)
        return msg.layout.v1_v2.layout_class == CHUNKED
               && msg.layout.v1_v2.ndims > 0UB;
    if (msg.version == 3UB)
        return msg.layout.v3.layout_class == CHUNKED
               && msg.layout.v3.properties.chunked.ndims > 0UB;
    return msg.layout.v4_v5.layout_class == CHUNKED
           && msg.layout.v4_v5.properties.chunked.ndims > 0UB;
}

fun oh_layout_stored_element_size = (oh_msg_layout msg) uint<64>:
{
    if (!oh_layout_has_stored_element_size(msg)) return 0UL;

    if (msg.version < 3UB) {
        var ndims = msg.layout.v1_v2.ndims as uint<64>;
        return msg.layout.v1_v2.properties.chunked.dim_size[ndims - 1UL]
               as uint<64>;
    }
    if (msg.version == 3UB) {
        var ndims = msg.layout.v3.properties.chunked.ndims as uint<64>;
        return msg.layout.v3.properties.chunked.dim_size[ndims - 1UL]
               as uint<64>;
    }

    var ndims = msg.layout.v4_v5.properties.chunked.ndims as uint<64>;
    return bytes_to_u64_le(
        msg.layout.v4_v5.properties.chunked.dim_size[ndims - 1UL]);
}



/* BOGUS_VALID_ID 0x0009 "Bogus valid" Message.  */
/* This message is used for testing the HDF5 Library’s response to an “unknown” message type and 
   should never be encountered in a valid HDF5 file.


/* GINFO_ID       0x000a Group info Message.  */
type oh_msg_ginfo =
    struct {
        byte version;
        byte flags;
        uint<16> max_compact if (flags & 1U) != 0;      /* Maximum number of links to store “compactly” */
        uint<16> min_dense if (flags & 1U) != 0;        /* Minimum number of links to store “densely” */
        uint<16> est_num_entries if (flags & 2U) != 0;  /* Estimated # of entries in group   */
        uint<16> est_name_len if (flags & 2U) != 0;     /* Estimated length of entry name    */
    };


/* PLINE_ID       0x000b Filter pipeline message.  */
type oh_msg_pline =
    struct {
        byte version: version == 1UB || version == 2UB;
        byte nfilters: nfilters <= 32UB;
        union {
            struct { 
                /* Field-level guard, checked immediately (zero bytes consumed)
                   before any other field in this arm.  Poke maps a union
                   alternative's fields in full before checking a *trailing*
                   label constraint (the `v1: version == 1` below) -- see
                   issue #14 for the resulting hazard: a wrong-version pipeline
                   message can still reach filt_list below -- up to 32 filters,
                   each with a name up to ~64KB and cd_data up to ~256KB --
                   before that label is ever consulted. This guard re-checks
                   the same condition as the trailing label, but as the very
                   first thing evaluated, so it aborts before filt_list can be
                   reached regardless of union declaration order. See #15. */
                byte[0] _guard: version == 1;
                byte[6] res;

                type filt_descr = 
                    struct  {
                        uint<16> id;
                        uint<16> name_len;
                        uint<16> flags;
                        uint<16> cd_nelmts;
                        if (name_len != 0)
                            char[name_len] name;
                        uint<32>[cd_nelmts] cd_data;
                        byte[4] padding if (cd_nelmts % 2) != 0; 
                    };

                filt_descr[nfilters] filt_list;

            } v1: version == 1;
            
            struct {
                /* See the v1 arm above: same field-level guard technique,
                   protecting filt_list from a wasted parse if this arm is
                   ever tried against a non-v2 message. */
                byte[0] _guard: version == 2;
                type filt_descr =
                    struct {
                        uint<16> id;
                        /* Version 2 omits the name-length and name fields for
                           built-in filters (IDs below 256).  Optional and
                           user-defined filters retain them.  */
                        uint<16> name_len if id >= 256UH;
                        uint<16> flags;
                        uint<16> cd_nelmts;
                        if (id >= 256UH && name_len != 0)
                            char[name_len] name;
                        uint<32>[cd_nelmts] cd_data;
                    };
                filt_descr[nfilters] filt_list;

            } v2: version == 2;
    
        } pline;
    };



/* ATTR_ID        0x000c Attribute Message.  */
type oh_msg_attr =
    struct {
        byte version: version >= 1UB && version < 4UB;
        byte flags: version == 1UB || (flags & 0xfcUB) == 0UB;/* for version 1, reserved; flags for version == 2 or 3 */
        uint<16> name_size: name_size > 1UH;
        uint<16> dtype_size;
        uint<16> dspace_size;
        uint<8> cset if version == 3;

        byte[(version == 1 ? align8(name_size as uint<64>) : name_size as uint<64>)] name;
        byte[(version == 1 ? align8(dtype_size as uint<64>) : dtype_size as uint<64>)] dtype;
        byte[(version == 1 ? align8(dspace_size as uint<64>) : dspace_size as uint<64>)] dspace;

        fun dim_size_at = (off64 dims_off, int idx) uint<64>:
        {
            var width = global_sizeof_lengths as uint<64>;
            return bytes_to_u64_le(byte[global_sizeof_lengths] @
                                   (dims_off + ((idx as uint<64>) * width)#B));
        }

        fun attr_shared_msg_payload_offset = (off64 shared_off, uint<8> wanted_type) off64:
        {
            return shared_msg_payload_offset(shared_off, wanted_type);
        }

        fun dtype_msg_offset = off64:
        {
            if (version >= 2UB && (flags & 1U) != 0)
                return attr_shared_msg_payload_offset(dtype'offset, 0x03UB);
            return dtype'offset;
        }

        fun dspace_msg_offset = off64:
        {
            if (version >= 2UB && (flags & 2U) != 0)
                return attr_shared_msg_payload_offset(dspace'offset, 0x01UB);
            return dspace'offset;
        }

        /* Function to calculate data size */
        fun get_data_size = uint<64>:
        {
            /* An attribute's datatype/dataspace may themselves be shared. If
             * either reference cannot be followed the element size and the
             * dimensions are both unknown, so the extent of the data area is
             * unknowable too -- map none of it rather than raising, which
             * would take the rest of the object header's messages down with
             * it. The message prefix's msg_size still bounds the message. */
            var dt_off = dtype_msg_offset();
            var ds_off = dspace_msg_offset();

            if (dt_off == SHARED_MSG_UNRESOLVED || ds_off == SHARED_MSG_UNRESOLVED) {
                printf("oh_msg_attr: shared datatype or dataspace is unresolved -- attribute data size unknown, showing none\n");
                return 0UL;
            }

            var dt = oh_msg_dtype @ dt_off;
            var ds = oh_msg_sdspace @ ds_off;

            if (ds.version >= 2) {
                if (ds.space.v2.space_type == 2UB) /* H5S_NULL */
                    return 0UL;

                var nelem = 1UL; /* H5S_SCALAR */
                if (ds.space.v2.space_type == 1UB) { /* H5S_SIMPLE */
                    var i = 0;
                    while (i < ds.space.v2.ndims as int) {
                        nelem *= dim_size_at(ds.space.v2.dim_size'offset, i);
                        i++;
                    }
                }

                return (dt.hdr.elm_size as uint<64>) * nelem;
            }
            else {
                var nelem = 1UL; /* H5S_SCALAR when ndims == 0 */
                var i = 0;
                while (i < ds.space.v1.ndims as int) {
                    nelem *= dim_size_at(ds.space.v1.dim_size'offset, i);
                    i++;
                }

                return (dt.hdr.elm_size as uint<64>) * nelem;
            }
        }

        var mm = get_data_size();
        byte[mm] data;

        method _print = void:
        {
            printf("oh_msg_attr {\n");

            printf("  version=%v\n", version);
            printf("  %s%v\n", (version == 1 ? "reserved=" : "flags="), flags);
            printf("  name_size=%v\n", name_size);
            printf("  dtype_size=%v\n", dtype_size);
            printf("  dspace_size=%v\n", dspace_size);
            if (version == 3)
                printf("  cset=%v\n", cset == 0 ? "ASCII" : "UTF-8");

            printf("  name=%v-->%v\n", name, char_array_to_string(name));

            var dt_off = dtype_msg_offset();
            var ds_off = dspace_msg_offset();

            if (dt_off == SHARED_MSG_UNRESOLVED)
                printf("  dtype=<shared, unresolved> reference=%v\n", dtype);
            else {
                var ii = oh_msg_dtype@dt_off;
                print_dtype(ii, 1);
            }

            if (ds_off == SHARED_MSG_UNRESOLVED)
                printf("  dspace=<shared, unresolved> reference=%v\n", dspace);
            else {
                var jj = oh_msg_sdspace@ds_off;
                jj.print_dspace_indent(1);
            }

            printf("  data=%v\n", data);

            printf("}");
        }
    };

/* NAME_ID        0x000d Object name message.  */
type oh_msg_name =
    struct {
        string name;
    };



/* MTIME_ID       0x000e Modification time message. (Old)  */
type oh_msg_old_mtime =
    struct {
        char[14] timestamp; /* ASCII YYYYMMDDhhmmss */
        byte[2] res;
    };




/* SHMESG_ID      0x000f Shared message "SOHM" table. */
type oh_msg_shmesg_table =
    struct {
        byte version;
        byte[global_sizeof_offsets] addr_raw:
            hdf5_addr_in_declared_eof(addr_raw, 1); /* Address of the master table for
                                                       shared object header message indexes */
        byte nindexes  /* The number of indices in the master table */
            /* addr_raw is base-relative; set_sohm_master_table() (sohm.pk)
             * is documented as taking an already-physical address, so
             * translate here at the call site rather than inside the
             * callee -- matches every other cross-pickle boundary in this
             * codebase. */
            : set_sohm_master_table(hdf5_addr_to_file_u64(bytes_to_u64_le(addr_raw)), nindexes as uint<64>);
    };



/* CONT_ID        0x0010 Object header continuation message.  */
type oh_msg_cont =
    struct {
        byte[global_sizeof_offsets] addr_raw; /* Address of the header continuation block */
        byte[global_sizeof_lengths] size_raw:
            hdf5_bytes_nonzero(size_raw) && hdf5_range_in_declared_eof(addr_raw, size_raw, 0); /* Size of the header continuation block */
    };



/* STAB_ID        0x0011 Symbol table message.  */
type oh_msg_stab =
    struct {
        byte[global_sizeof_offsets] btree_addr_raw; /* v1 B-tree address */
        byte[global_sizeof_offsets] heap_addr_raw;  /* Local heap address */
    };



/* MTIME_NEW_ID   0x0012 Modification time message. (New)  */
type oh_msg_mtime =
    struct {
        byte version;
        byte[3] res;
        uint<32> seconds;
    };


/* BTREEK_ID      0x0013 v1 B-tree 'K' values message.  */
type oh_msg_btreek =
    struct {
        byte version;
        uint<16> btree_k_chunk; /* Internal node 'K' value of an indexed storage v1 B-tree */
        uint<16> btree_k_snode; /* Internal node 'K' value of a group v1 B-tree */
        uint<16> sym_leaf_k;    /* Leaf node's 'K' value of a group (symbol table) v1 B-tree */
    };

/* DRVINFO_ID     0x0014 Driver info message. */
type oh_msg_drvinfo =
    struct {
        byte version;
        char[8] drv_id;
        uint<16> drv_info_size;

        var dtype = file_drv_type(drv_id);

        union {
            struct {
                byte[6] member_mapping;
                byte[2] reserved       == [0UB, 0UB];
                var n_members = count_unique(member_mapping);
                multi_drv_member_addr[n_members] member_addrs;
                byte[multi_drv_names_size(drv_info_size as uint<32>, n_members)] member_names_raw;
            } multi : (dtype == 1);

            struct {
                uint<64> member_size;
            } fami : (dtype == 2);

            struct {
                byte[drv_info_size] data;
            } raw;
        } drv_info;
    };


/* AINFO_ID       0x0015 Attribute info message.  */
type oh_msg_ainfo =
    struct {
        byte version == 0UB;
        byte flags: (flags & 0xfcUB) == 0UB;     /* Attribute index information flag */

        /* Maximum creation order index value for the attributes on the object */
        uint<16> max_crt_idx if (flags & 1U) != 0;  

        /* Address of fractal heap to store "dense" attributes */
        byte[global_sizeof_offsets] fheap_addr_raw;  

        /* Address of v2 B-tree to index names of "dense" attributs */
        byte[global_sizeof_offsets] name_bt2_addr_raw; 

        /* Address of v2 B-tree to index the creation order of "dense" attributes */
        byte[global_sizeof_offsets] corder_bt2_addr_raw if (flags & 2U) != 0;
    };

/* REFCOUNT_ID    0x0016 Reference count message.  */
type oh_msg_refcount =
    struct {
        byte version;
        uint<32> ref_cnt;
    };

/* FSINFO_ID      0x0017 File space info message.  */
var FS_ALLOC_TYPES =  6;
type oh_msg_fsinfo =
    struct {
        byte version if version < 2;    /* only version 0 (deprecated) and 1 are defined */
        union {
            /* Version 0 (deprecated, H5Ofsinfo.c maps it to v1 on decode): no persist byte,
             * no page_size/pgend_meta_thres/eoa fields. Address array is present only when
             * strategy == H5F_FILE_SPACE_ALL_PERSIST(1), and holds FS_ALLOC_TYPES addresses
             * of the basic H5FD_mem_t types (SUPER..OHDR) -- there is no small/large split. */
            struct {
                byte strategy;    /* H5F_file_space_type_t: 0=DEFAULT 1=ALL_PERSIST 2=ALL 3=AGGR_VFD 4=VFD */
                byte[global_sizeof_lengths] threshold;
                byte[global_sizeof_offsets][FS_ALLOC_TYPES] fs_addr if strategy == 1UB;
            } v0: version == 0;

            struct {
                byte strategy;    /* H5F_fspace_strategy_t: 0=FSM_AGGR 1=PAGE 2=AGGR 3=NONE */
                byte persist;
                byte[global_sizeof_lengths] threshold;
                byte[global_sizeof_lengths] page_size;      /* Error in spec */
                uint<16> pgend_meta_thres;
                byte[global_sizeof_offsets] eoa;
                /* Free-space manager addresses are only stored when persist is set */
                byte[global_sizeof_offsets][FS_ALLOC_TYPES] small_fs_addr if persist;
                byte[global_sizeof_offsets][FS_ALLOC_TYPES] large_fs_addr if persist;
            } v1: version == 1;
        } info;
    };


/* MDCI_MSG_ID    0x0018 Metadata Cache Image Message */
type oh_msg_mdci=
    struct {
        byte version if version == 0;
        byte[global_sizeof_offsets] image_addr_raw;
        byte[global_sizeof_lengths] image_size:
            hdf5_range_in_declared_eof(image_addr_raw, image_size, 0);
    };

/* UNKNOWN_ID     0x0019 Placeholder message ID for unknown message.  */


/*
 *
 */


/* The factory maps the message struct at the provided offset */
fun message_factory = (uint<8> m_type, uint<16> m_size, offset<uint<64>,B> off) any:
{
    if (m_type == 0x00UB)  return oh_msg_nil @ off;            /* Nil message: 0x0000 */
    if (m_type == 0x01UB)  return oh_msg_sdspace @ off;        /* Dataspace message: 0x0001 */
    if (m_type == 0x02UB)  return oh_msg_linfo @ off;          /* Link info message: 0x0002 */

    if (m_type == 0x03UB)  return oh_msg_dtype @ off;          /* Datatype message: 0x0003 */

    if (m_type == 0x04UB)  return oh_msg_old_fill @ off;       /* Fill value message (old): 0x0004 */
    if (m_type == 0x05UB)  return oh_msg_fill @ off;           /* Fill value message: 0x0005 */
    if (m_type == 0x06UB)  return oh_msg_link @ off;           /* Link message :  0x0006 */


    if (m_type == 0x07UB)  return oh_msg_external @ off;       /* External Data Files message :  0x0007 */

    if (m_type == 0x08UB)  return oh_msg_layout @ off;         /* layout message :  0x0008 */

    /* OH_BOGUS_VALID_ID 0x0009 "Bogus valid" Message.  */

    if (m_type == 0x0aUB)  return oh_msg_ginfo @ off;          /* Group info message :  0x000a */
    if (m_type == 0x0bUB)  return oh_msg_pline @ off;          /* Filter pipeline message :  0x000b */

    if (m_type == 0x0cUB)  return oh_msg_attr @ off;           /* Attribute message : 0x000c */

    if (m_type == 0x0dUB)  return oh_msg_name @ off;           /* Object name message :  0x000d */
    if (m_type == 0x0eUB)  return oh_msg_old_mtime @ off;      /* Modification time message (old): 0x000e */
    if (m_type == 0x0fUB)  return oh_msg_shmesg_table @ off;   /* Shared message "SOHM" table message: 0x000f */
    if (m_type == 0x010UB) return oh_msg_cont @ off;           /* Object header continuation message: 0x0010 */
    if (m_type == 0x011UB) return oh_msg_stab @ off;           /* Symbol table message: 0x0011 */
    if (m_type == 0x012UB) return oh_msg_mtime @ off;          /* Modification time message: 0x0012 */
    if (m_type == 0x013UB) return oh_msg_btreek @ off;         /* v1 B-tree 'K' value message: 0x0013 */
    if (m_type == 0x014UB) return oh_msg_drvinfo @ off;        /* Driver info message: 0x0014 */
    if (m_type == 0x015UB) return oh_msg_ainfo @ off;          /* Attribute info message: 0x0015  */
    if (m_type == 0x016UB) return oh_msg_refcount @ off;       /* Reference count message: 0x0016 */
    if (m_type == 0x017UB) return oh_msg_fsinfo @ off;         /* File space info message: 0x0017  */
    if (m_type == 0x018UB) return oh_msg_mdci @ off;           /* Meta cache image message: 0x0018  */

    /* Fallback for unknown types */
    return byte[m_size] @ off;
}



/* Global arrays for continuation chunks */
var global_cont_size = 0UL;
type cont_chunk = struct { byte[global_cont_size] data;};

var global_all_cont_chunks = cont_chunk[]();
var global_all_cont_sizes = uint<64>[]();

var global_version = 0;
var global_crt_tracked = 0;
/* Message prefix for v1 and v2 object header messages */
type msg_prefix = 
    union
    {
        struct {
            uint<16> msg_type;  /* Message type */
            uint<16> msg_size;  /* Message size */
            byte msg_flags;     /* Message flags */
        } v1_msg_prefix: global_version == 1;

        struct {
            byte msg_type;
            uint<16> msg_size;
            byte msg_flags;
            uint<16> crt_order if global_crt_tracked;
        } v2_msg_prefix: global_version == 2;
    };

/* Append a continuation chunk to the global array */
fun append_cont_chunk = (uint<64> sz, offset<uint<64>,B> off) void:
{

  global_cont_size = sz; 

  /* We map the new chunk/sizes and append it to our global arrays */
  global_all_cont_chunks += [cont_chunk @ off];
  global_all_cont_sizes += [sz]; 
}

/* Datatype message ID */
var DTYPE_ID = 0x003;
/* Data layout message ID */
var LAYOUT_ID = 0x008;

/* Decode the messages in an object header chunk  */
fun get_all_messages = (uint<8> version, int prefix_bytes, offset<uint<64>,B> chunk_off, uint<64> chunk_size) void:
{
   var i = 0UL;
   var msg_cnt = 0UL;

    /* msg_cnt include the # of messages from continuation block also */
    while ((i + prefix_bytes) < chunk_size) {
            var m_type = 0UL;
            var m_size = 0UL;
            var m_flags = 0UB;

            var _msg_prefix = msg_prefix@ (chunk_off + i#B);

            if (version == 1) {
                m_type = _msg_prefix.v1_msg_prefix.msg_type as uint<64>;
                m_size = _msg_prefix.v1_msg_prefix.msg_size as uint<64>;
                m_flags = _msg_prefix.v1_msg_prefix.msg_flags;
            }
            if (version == 2) {
                m_type = _msg_prefix.v2_msg_prefix.msg_type as uint<64>;
                m_size = _msg_prefix.v2_msg_prefix.msg_size as uint<64>;
                m_flags = _msg_prefix.v2_msg_prefix.msg_flags;
            }

            /* A shared message (OH_MSG_FLAG_SHARED) is encoded as an
             * H5O_shared_t reference rather than the message's native
             * layout -- resolve it to the real payload location before
             * handing it to message_factory().                          */
            var ref_off = chunk_off + i#B + prefix_bytes#B;
            var payload_off = ref_off;
            if ((m_flags & OH_MSG_FLAG_SHARED) != 0UB) {
                var shared_version = byte @ payload_off;
                var shared_type = shared_version < 3UB ? OH_SHARE_TYPE_COMMITTED
                                                        : (byte @ (payload_off + 1#B));
                var shared_type_name = shared_type == OH_SHARE_TYPE_COMMITTED ? "Obj Hdr" :
                                        shared_type == OH_SHARE_TYPE_SOHM      ? "SOHM" :
                                        shared_type == OH_SHARE_TYPE_HERE      ? "Here" : "Unshared";

                payload_off = shared_msg_payload_offset(payload_off, m_type as uint<8>);

                /* Resolution can land on bytes that do not decode -- a stale
                 * or corrupt reference, a truncated file. Probe the target
                 * first so that failure degrades to the raw-reference report
                 * below instead of aborting the listing. */
                if (payload_off != SHARED_MSG_UNRESOLVED) {
                    try {
                        var probe = message_factory(m_type, m_size, payload_off);
                    } catch (Exception e) {
                        printf("shared_msg_payload_offset: the payload resolved at %v does not decode as message type %v\n",
                               payload_off / 1#B, m_type);
                        payload_off = SHARED_MSG_UNRESOLVED;
                    }
                }

                if (payload_off == SHARED_MSG_UNRESOLVED) {
                    /* The reference could not be followed. Decoding the
                     * message's native layout over the H5O_shared_t record
                     * would print the exact garbage this resolution exists to
                     * avoid, so report the raw reference and carry on with the
                     * next message -- the prefix's msg_size still advances the
                     * loop correctly. */
                    printf("\n[Message %u64d is shared (type: %s) -- unresolved; showing the raw reference]\n",
                           msg_cnt, shared_type_name);
                    printf("\nMessage %u64d...\n", msg_cnt);
                    printf("%Tv\n", _msg_prefix);
                    printf("shared reference at %v = %v\n",
                           ref_off / 1#B, byte[m_size] @ ref_off);

                    i = i + prefix_bytes + (m_size as uint<64>);
                    ++msg_cnt;
                    continue;
                }

                printf("\n[Message %u64d is shared (type: %s) -- resolved payload at %v]\n",
                       msg_cnt, shared_type_name, payload_off / 1#B);
            }

            //var payload = oh_message_factory(m_type, m_size, chunk'offset + i#B + prefix_bytes#B);
            var payload = message_factory(m_type, m_size, payload_off);

            printf("\nMessage %u64d...\n", msg_cnt);
            printf("%Tv\n", _msg_prefix);
            printf("%Tv\n", payload);

            if (m_type == LAYOUT_ID) {
                var pp = payload as oh_msg_layout;
                if (oh_layout_has_stored_element_size(pp))
                    printf("stored_element_size=%u64d\n",
                           oh_layout_stored_element_size(pp));
            }

            if(m_type == DTYPE_ID) {
                var pp = payload as oh_msg_dtype;

                if ( (pp.hdr.flags & 0xf) == 6 ||   /* compound type */
                     (pp.hdr.flags & 0xf) == 8 ||   /* enumeration type */
                     (pp.hdr.flags & 0xf) == 9 ||   /* variable-length type */
                     (pp.hdr.flags & 0xf) == 10 ||  /* array type */
                     (pp.hdr.flags & 0xf) == 11 )   /* complex type */
                { 
                    print_recurse_dtype(pp, 0);
                }
            }

            if(m_type == CONT_ID) {
                var pp = payload as oh_msg_cont;

                var ss = bytes_to_u64_le(pp.size_raw);

                append_cont_chunk (ss,  bytes_to_off(pp.addr_raw));
            } 

            /* Advance to next message: Prefix + Data Size */
            i = i + prefix_bytes + (m_size as uint<64>);
            ++msg_cnt;
    }
}

/* Decode the messages in the global array of continuation chunks */
fun get_cont_messages = (uint<8> version, int prefix_bytes, int crt_tracked) void:
{
    var num_cont_chunks = global_all_cont_chunks'length;

    var idx = 0;
    while (idx < global_all_cont_chunks'length)
    {
        var chunk = global_all_cont_chunks[idx];

        //printf("chunk.data'size = %v\n", chunk.data'size);
        printf("\nContinuation chunk %v:\n", idx);
        printf("Address: %v\n", chunk.data'offset/1#B);

        var true_sz = global_all_cont_sizes[idx];
        printf("Size = %v\n", true_sz);

        var kk = 0#B as offset<uint<64>,B>;
        if (version == 2) {
            /*  Map exactly 4 bytes from the start of the chunk */
            var actual_sig = byte[4] @ chunk.data'offset;

            /* Direct comparison with your predefined array */
            if (actual_sig != H5_FORMAT_OCHK_SIGNATURE) {
                printf("ERROR: Signature mismatch at %v. Expected %v, got %v\n",
                        chunk.data'offset, H5_FORMAT_OCHK_SIGNATURE, actual_sig);
                continue;
            }
            /* Success! */
            printf("Continuation signature verified: %v\n", actual_sig);

            /* Account for checksum at the end */
            true_sz -= 4;

            /* Calculate the start of the actual message data */
            kk = (chunk.data'offset) + H5_FORMAT_OCHK_SIGNATURE_SIZE;
        } else {
            /* Calculate the start of the actual message data */
            kk = (chunk.data'offset);
        }

        get_all_messages(version, prefix_bytes, kk, true_sz);

        /* Move to the next chunk */
        idx = idx + 1;
    }
}



/*
 * Version 1 object header 
 */


/* Version 1: Message prefix size in bytes: 
   header message type (2), size of header message data (2), header message flags (1), reserved (3) */
var V1_PREFIX_BYTES = 8;


/*
 * Version 2 object header 
 */


/* Version 2: Message prefix size in bytes: 
   header message type (2), size of header message data (2), header message flags (1) */
var V2_PREFIX_BYTES = 4;

type hdr_timestamps =
    struct
    {
        uint<32> access;
        uint<32> modification;
        uint<32> change;
        uint<32> birth;
    };

type hdr_attr_phase =
    struct
    {
        uint<16> max_compact;
        uint<16> min_dense;
    };

/*
 * Decode both v1 and v2 object headers
*/
type oh_hdr =
    struct {
        byte[4] sig_peek @ 0#b;
        union {
            struct {
                byte[4] signature: signature == H5_FORMAT_OHDR_SIGNATURE;
                uint<8> version: version == 2;  /* Object header version */ 
                byte flags;     /* Additional information about the object header */

                hdr_timestamps timestamps if (flags & 1 <<. 5);
                hdr_attr_phase attr_phase if (flags & 1 <<. 4);

                var _chunk0_num_bytes  = 1 <<. (flags & 3U);
                byte[_chunk0_num_bytes] chunk0_size;

                var _chunk0_size = bytes_to_u64_le(chunk0_size);
                struct {
                    byte[_chunk0_size] msg_chunk;
                    /* Custom Pretty Printer: not printing raw_data if too big */
                    method _print = void:
                    {
                        printf("struct {");
                        if (_chunk0_size > 300U)
                            printf ("<msg_chunk=NOT PRINTED>");
                        else
                            printf ("<msg_chunk=%v>", msg_chunk);
                        printf("}");
                    }
                } _msg_chunk;
        
                var crt_order_tracked = (flags & 4U) != 0;

                /* Function to retrieve gap size.  msg_chunk (above) already
                   spans messages + gap -- _chunk0_size covers both, per this
                   function's own leftover-bytes computation -- so the gap
                   bytes are the trailing gap_size bytes of msg_chunk itself,
                   not additional bytes past it.  Mapping a separate `gap`
                   field here would double-count them and push chksum
                   gap_size bytes too far into the file; call this on demand
                   (e.g. from a _print method) instead of mapping a field. */
                fun get_gap_size = uint<64>:
                {
                    var i = 0, _gap_size = 0;
                    var prefix_bytes = (crt_order_tracked) ? (V2_PREFIX_BYTES + 2) : V2_PREFIX_BYTES;
                    while (i + prefix_bytes <= _chunk0_size)
                    {
                        var sz = [_msg_chunk.msg_chunk[i+2], _msg_chunk.msg_chunk[i+1]] as uint<16>;
                        i = i + sz + prefix_bytes;
                    }

                    _gap_size = _chunk0_size - i;
                    return _gap_size;
                }

                byte[4] chksum;

                method print_indented = (int depth) void:
                {
                    printf("struct {\n");
                    indent(depth); printf("  signature=%v,\n", signature);
                    indent(depth); printf("  version=%u8d,\n", version);
                    indent(depth); printf("  flags=0x%u8x,\n", flags);
                    if (flags & 1 <<. 5) {
                        indent(depth); printf("  timestamps=%v,\n", timestamps);
                    }
                    if (flags & 1 <<. 4) {
                        indent(depth); printf("  attr_phase=%v,\n", attr_phase);
                    }
                    indent(depth); printf("  chunk0_size=%v,\n", chunk0_size);
                    indent(depth); printf("  _msg_chunk="); _msg_chunk._print; printf(",\n");
                    indent(depth); printf("  gap_size=%u64d,\n", get_gap_size);
                    indent(depth); printf("  chksum=%v\n", chksum);
                    indent(depth); printf("}\n");
                }

                method _print = void:
                {
                    print_indented(2);
                }

            } v2: sig_peek == H5_FORMAT_OHDR_SIGNATURE;

            struct {
                uint<8> version: version == 1;  /* Object header version */
                byte res1;                      /* Reserved */
                uint<16> msg_cnt;               /* Total numbe of header messages */
                uint<32> obj_ref_cnt;           /* Object reference count */
                uint<32> obj_hdr_size;          /* Object header size */
                byte[4] res2;                   /* Reserved */
                var hdr_size = obj_hdr_size;
                struct {
                    byte[obj_hdr_size] msg_chunk;   /* Chunk of <msg_cnt> messages */

                    /* Custom Pretty Printer: not printing raw_data if too big */
                    method _print = void:
                    {
                        printf("struct {");
                        if (hdr_size > 300U)
                            printf ("<msg_chunk=NOT PRINTED>");
                        else
                            printf ("<msg_chunk=%v>", msg_chunk);
                        printf("}");
                    }
                } _msg_chunk;
            } v1;

        } _ohdr @0#b; /* <--- CRITICAL: Pin the union to the start */


        /* Retrieve messages from <msg_chunk> */
        /* Not saving all entries in results, just print prefix and payload one at a time */
        /* Because I couldn't figure out how to prepend msg_prefix info to payload and save all in results */
        method get_messages = void:
        {
            /* Clean the slate: global arrays */
            global_all_cont_chunks = cont_chunk[]();
            global_all_cont_sizes = uint<64>[]();

            var version = 0;
            var crt_order_tracked = 0;
            var prefix_bytes = 0;
            var msg_chunk = byte[](); 
            var chunk_size = 0;

            if (sig_peek == H5_FORMAT_OHDR_SIGNATURE) {
                version = _ohdr.v2.version;
                crt_order_tracked = ((_ohdr.v2.flags & 4U) != 0);
                prefix_bytes = (crt_order_tracked) ? (V2_PREFIX_BYTES + 2) : V2_PREFIX_BYTES;
                msg_chunk = _ohdr.v2._msg_chunk.msg_chunk;
                chunk_size = bytes_to_u64_le(_ohdr.v2.chunk0_size);

            } else {
                version = _ohdr.v1.version;
                prefix_bytes = V1_PREFIX_BYTES;
                msg_chunk = _ohdr.v1._msg_chunk.msg_chunk;
                chunk_size = _ohdr.v1.obj_hdr_size;

            } 

            global_version = version;
            global_crt_tracked = crt_order_tracked;

            get_all_messages(version, prefix_bytes, msg_chunk'offset, chunk_size);

            if (global_all_cont_chunks'length != 0)
                get_cont_messages(version, prefix_bytes, 0);
        }

    };
