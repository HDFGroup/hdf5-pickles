"""Differential harness: h5policy vs. libhdf5 (h5py / h5dump / h5debug).

h5policy parses HDF5 bytes independently of libhdf5.  This tool cross-checks
that independent parse against the reference implementation, catching the class
of field-offset bug that unit tests miss (e.g. mis-decoding a datatype version).

For each file it runs h5policy in forensic mode (so the walk accumulates full
metrics) and compares against:

  * h5py    - the structural reference: does libhdf5 open the bytes, and what
              external links / dataset shapes / ranks does it see?
  * h5dump  - an independent "does libhdf5 accept these bytes" signal (rc).
  * h5debug - a second such signal, plus a human-auditable superblock dump.

Cross-invariants (a hard failure exits non-zero; a warning is informational):

  A  libhdf5 structurally opens => h5policy is not reject_corrupt  (no false +)
     unless a deeper libhdf5 probe also rejects attrs/data/tools (A+, warning),
     or h5policy eagerly rejects a structure or range that libhdf5's read path
     leaves unchecked -- SOHM search indexes, free-space managers, secondary
     creation-order indexes, a chunk-index capacity re-derived only when an
     index is rebuilt, or an impossible declared data extent (A~, warning);
     "tools" includes h5dump reading data (no -H), which unlike the header-only
     probe exercises filter/decompression rejections
  A' libhdf5 rejects           => h5policy explicitly refuses the file (no false -)
     a non-corrupt refusal (policy/resource/coverage) is retained as a warning,
     and a refusal that is only the reference library predating a defined
     message version is retained as a warning too (A'~)
  B  (h5py sees an external link)  <=>  (h5policy external_links > 0)
  C  h5policy max logical dataset bytes  <=  h5py's                (no overcount)
  D  h5policy max rank seen  <=  h5py's                            (no overcount)

A hard failure for one (fixture, invariant) pair registered in
registry/h5policy-diff-tolerances.yml -- an already-triaged, fixture-specific
reference-library defect, see registry/cases/ -- still prints but is excluded
from total_fail ("tracked", not silenced).  See load_tolerances() below.

Usage: h5policy-diff FILE [FILE ...]
       h5policy-diff --dir DIR        # every *.h5 under DIR
"""
import argparse
import glob
import json
import os
import resource
import shutil
import subprocess
import sys

import yaml

try:
    import h5py
except ImportError:  # pragma: no cover
    sys.exit("h5policy-diff: h5py is required (it is the reference implementation)")

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
H5POLICY = os.path.join(HERE, "h5policy")
TESTS_DIR = os.path.join(REPO, "h5policy", "tests")
TOLERANCES_FILE = os.path.join(REPO, "registry", "h5policy-diff-tolerances.yml")
KNOWN_EXITS = {0, 1, 2, 3, 4, 5, 70}
READ_PROBE_MAX_BYTES = 16 * 1024 * 1024
KNOWN_INVARIANTS = {"A", "A'", "B", "D"}

# Address-space ceiling for every child this harness spawns.  The 60s timeouts
# below bound how LONG a child runs; they say nothing about how much memory it
# claims while running, and several fixtures in this corpus are memory
# amplifiers under libhdf5: cve/dtype_unbounded_recursion.h5,
# cve/dtype_compound_unbounded_recursion.h5,
# malformed/oversize_v2_btree_node_size.h5 and (data path only)
# malformed/attr_vlen_size_under.h5 each drive h5dump past 4 GiB within four
# seconds and are still climbing.  Uncapped, one 60s budget is enough to
# exhaust a 14 GiB machine -- on 2026-08-16 this took out the whole session,
# not just the child.
#
# 3 GiB is measured, not guessed: the full corpus runs to "0 hard failures"
# under this ceiling, because a capped h5dump still exits non-zero on the
# fixtures those checks expect it to reject.  Raising it re-opens the hazard;
# lowering it risks converting a legitimate accept into a spurious rejection.
DEFAULT_MEM_MB = 3072


def _mem_cap(mem_mb=None):
    """preexec_fn capping a child's address space, or None to leave it alone.

    Set H5POLICY_DIFF_MEM_MB=0 to disable -- needed when --hdf5-bindir points at
    an ASAN-instrumented build, since ASAN maps a ~20 TB shadow region at
    startup and aborts before main() under any RLIMIT_AS (see h5policy-probe).

    The closure never raises.  Some hosts refuse RLIMIT_AS outright, and a
    preexec_fn that throws turns every child into a subprocess failure -- which
    reads as "libhdf5 rejects these bytes" and would silently corrupt every
    invariant here.  Failing open (uncapped child) is wrong in the same
    direction as the old behaviour and no worse; failing closed is a fake
    differential result.
    """
    if mem_mb is None:
        mem_mb = int(os.environ.get("H5POLICY_DIFF_MEM_MB", DEFAULT_MEM_MB))
    if mem_mb <= 0:
        return None

    def apply():
        try:
            soft_as = mem_mb * 1024 * 1024
            resource.setrlimit(resource.RLIMIT_AS, (soft_as, soft_as))
        except (ValueError, OSError):
            pass

    return apply


def load_tolerances():
    """Per-fixture, per-invariant exemptions from a hard-failure exit status.

    Unlike the A+/A~/A'~ exceptions below -- narrow, code-scoped predicates
    keyed to h5policy's OWN finding codes, so they generalize across any
    fixture that happens to hit the same code path -- an entry here excuses
    one specific fixture's one specific invariant letter, because of an
    already-triaged REFERENCE-library defect recorded in registry/cases/. It
    never broadens silently: a different fixture, a different invariant
    letter, or the same fixture producing a different failure no longer
    matches, and h5policy-diff reports the hard failure as before.

    A tolerated failure still prints as FAIL in this tool's output -- tracked,
    not silenced -- but is excluded from total_fail, so it does not fail the
    regression suite. See registry/h5policy-diff-tolerances.yml.
    """
    if not os.path.exists(TOLERANCES_FILE):
        return {}
    data = yaml.safe_load(open(TOLERANCES_FILE)) or {}
    table = {}
    for entry in data.get("tolerances", []):
        fixture, invariant = entry["fixture"], entry["invariant"]
        if invariant not in KNOWN_INVARIANTS:
            sys.exit(f"h5policy-diff: {TOLERANCES_FILE}: unknown invariant "
                     f"{invariant!r} for fixture {fixture!r}")
        case_path = os.path.join(REPO, "registry", "cases", f"{entry['case']}.yml")
        if not os.path.exists(case_path):
            sys.exit(f"h5policy-diff: {TOLERANCES_FILE}: fixture {fixture!r} "
                     f"references missing case registry/cases/{entry['case']}.yml")
        table[(fixture, invariant)] = entry
    return table


TOLERANCES = load_tolerances()


def tolerance_key(path):
    """The fixture identity tolerances are keyed on: path relative to tests/."""
    try:
        return os.path.relpath(os.path.realpath(path), TESTS_DIR)
    except ValueError:
        return None


class ToolError(RuntimeError):
    """h5policy produced no readable verdict.

    Deliberately NOT a differential result.  Every check below compares a
    h5policy verdict against libhdf5, so a run that yields no verdict has
    nothing to compare -- reporting it as a hard failure says "h5policy
    disagrees with libhdf5" when what happened is that h5policy did not answer.
    That miscue is exactly how a wrapper bug that prefixed the JSON with poke's
    stderr got read for days as a differential regression.
    """


def run_h5policy(path):
    """Forensic run so metrics reflect the whole reachable graph."""
    try:
        proc = subprocess.run([H5POLICY, "--profile", "forensic", "--json", path],
                              capture_output=True, text=True, errors="replace",
                              timeout=60, preexec_fn=_mem_cap())
    except subprocess.TimeoutExpired:
        raise ToolError("h5policy exceeded the 60s harness timeout")
    err = proc.stderr.strip()[:200]
    if proc.returncode not in KNOWN_EXITS:
        raise ToolError(f"h5policy exited {proc.returncode}: {err}")
    if proc.returncode == 70:
        raise ToolError(f"h5policy internal error (exit 70): {err}")
    try:
        return json.loads(proc.stdout), proc.returncode
    except (json.JSONDecodeError, ValueError):
        raise ToolError("h5policy report is not JSON: "
                        f"{proc.stdout.strip()[:120]!r} (stderr: {err})")


def reference_rc(tool, path):
    """rc of an independent libhdf5 tool, or None if the tool is unavailable."""
    if shutil.which(tool) is None:
        return None
    args = [tool, "-pBH", path] if tool == "h5dump" else [tool, path]
    try:
        return subprocess.run(args, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=60,
                              preexec_fn=_mem_cap()).returncode
    except subprocess.TimeoutExpired:
        return 124


def h5dump_data_rc(path):
    """rc of h5dump *reading dataset data* (no -H), or None if unavailable.

    The header-only reference_rc probe never decodes chunks, so it cannot see a
    filter/decompression rejection (e.g. an n-bit/scale-offset chunk element
    count that mismatches the real chunk).  This probe forces the data path so
    that a data-level tool rejection counts as deeper A+ evidence."""
    if shutil.which("h5dump") is None:
        return None
    try:
        return subprocess.run(["h5dump", "-pB", path], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=60,
                              preexec_fn=_mem_cap()).returncode
    except subprocess.TimeoutExpired:
        return 124


def introspect(path):
    """Structural facts from libhdf5, following only hard links.

    A file libhdf5 cannot fully traverse (it may open but then throw while
    reading corrupt metadata, e.g. an out-of-file address) counts as not
    opened -- that is the "libhdf5 rejects it" signal for invariant A'.
    """
    facts = dict(opens=False, ext_links=0, max_logical=0, max_rank=0, error="")
    try:
        f = h5py.File(path, "r")
    except Exception as exc:
        facts["error"] = _err(exc)
        return facts
    try:
      stack, seen = [f], set()
      while stack:
        grp = stack.pop()
        for key in grp.keys():
            link = grp.get(key, getlink=True)
            if isinstance(link, h5py.ExternalLink):
                facts["ext_links"] += 1
                continue
            if isinstance(link, h5py.SoftLink):
                continue
            obj = grp[key]                # hard link: raises if unopenable
            if isinstance(obj, h5py.Group):
                if id(obj) not in seen:
                    seen.add(id(obj))
                    stack.append(obj)
            elif isinstance(obj, h5py.Dataset):
                n = 1
                for d in obj.shape:
                    n *= int(d)
                # Use libhdf5's on-disk datatype size (H5Tget_size), not numpy's
                # in-memory itemsize: they differ for VLEN/reference types, and
                # the on-disk size is what h5policy reads from the file.
                elm = obj.id.get_type().get_size()
                facts["max_logical"] = max(facts["max_logical"], n * elm)
                facts["max_rank"] = max(facts["max_rank"], len(obj.shape))
      facts["opens"] = True            # fully traversed
    except Exception as exc:
        facts["opens"] = False         # opened but unreadable: libhdf5 rejects
        facts["error"] = _err(exc)
    finally:
        try:
            f.close()
        except Exception:
            pass
    return facts


def introspect_isolated(path):
    """introspect() in a child process, so a libhdf5 crash can't kill us.

    libhdf5 is not crash-safe on hostile input; since introspect() drives it
    in-process via h5py, we fork a child.  A crashed/timed-out child means
    libhdf5 could not accept the bytes -- read as opens=False, the same signal
    as a clean rejection (the strongest form of "libhdf5 rejects").  A child
    that dies on the _mem_cap() ceiling lands in the same bucket, which is the
    honest reading: libhdf5 could not traverse the file within a sane memory
    budget.  h5py links libhdf5 in-process, so this child amplifies exactly
    like h5dump does and needs the same ceiling.
    """
    hard_reject = dict(opens=False, ext_links=0, max_logical=0, max_rank=0,
                       error="child process crashed or timed out")
    try:
        proc = subprocess.run(
            [sys.executable, os.path.realpath(__file__), "--introspect", path],
            capture_output=True, text=True, errors="replace", timeout=60,
            preexec_fn=_mem_cap())
    except subprocess.TimeoutExpired:
        return hard_reject
    if proc.returncode != 0:
        return hard_reject
    try:
        return json.loads(proc.stdout)
    except (json.JSONDecodeError, ValueError):
        return hard_reject


def _err(exc):
    msg = str(exc).replace("\n", " ")
    return f"{type(exc).__name__}: {msg[:240]}"


def _object_path(obj):
    try:
        return obj.name or "/"
    except Exception:
        return "?"


def _object_key(obj):
    """Stable-ish identity for cycle guards across h5py wrapper objects."""
    try:
        return ("addr", int(h5py.h5o.get_info(obj.id).addr))
    except Exception:
        return ("py", id(obj))


def _dataset_logical_bytes(dset):
    n = 1
    for d in dset.shape:
        n *= int(d)
    return n * dset.id.get_type().get_size()


def eager_probe(path):
    """Exercise deeper libhdf5 paths after a structural open succeeds.

    h5py's basic group traversal is deliberately shallow: it can say a file
    "opens" while corrupt attributes or chunk addresses are only rejected when a
    consumer asks for them.  h5policy intentionally catches those eagerly.  This
    probe gathers bounded evidence for that distinction without making the main
    harness run hostile libhdf5 calls in-process.
    """
    facts = dict(open_error=None, traversal_errors=[], attr_errors=[],
                 read_errors=[], datasets_seen=0, datasets_read=0,
                 skipped_large_reads=0, skipped_object_reads=0)

    def record(bucket, where, op, exc):
        facts[bucket].append(dict(path=where or "/", op=op, error=_err(exc)))

    def probe_attrs(obj):
        try:
            list(obj.attrs.keys())
        except Exception as exc:
            record("attr_errors", _object_path(obj), "attrs.keys", exc)
        try:
            flags = obj.id.get_create_plist().get_attr_creation_order()
            if flags & h5py.h5p.CRT_ORDER_INDEXED:
                h5py.h5a.iterate(
                    obj.id, lambda name: None,
                    index_type=h5py.h5.INDEX_CRT_ORDER,
                    order=h5py.h5.ITER_INC)
        except Exception as exc:
            record("attr_errors", _object_path(obj),
                   "attrs.creation_order", exc)

    def probe_link_corder(grp):
        try:
            flags = grp.id.get_create_plist().get_link_creation_order()
            if flags & h5py.h5p.CRT_ORDER_INDEXED:
                grp.id.links.iterate(
                    lambda name: None,
                    idx_type=h5py.h5.INDEX_CRT_ORDER,
                    order=h5py.h5.ITER_INC)
        except Exception as exc:
            record("traversal_errors", _object_path(grp),
                   "links.creation_order", exc)

    def probe_dataset(dset):
        facts["datasets_seen"] += 1
        where = _object_path(dset)
        try:
            logical = _dataset_logical_bytes(dset)
        except Exception as exc:
            record("traversal_errors", where, "dataset.size", exc)
            return
        try:
            if getattr(dset.dtype, "hasobject", False):
                facts["skipped_object_reads"] += 1
                return
        except Exception as exc:
            record("traversal_errors", where, "dataset.dtype", exc)
            return
        if logical > READ_PROBE_MAX_BYTES:
            facts["skipped_large_reads"] += 1
            return
        try:
            dset[...]
            facts["datasets_read"] += 1
        except Exception as exc:
            record("read_errors", where, "dataset.read", exc)

    try:
        f = h5py.File(path, "r")
    except Exception as exc:
        facts["open_error"] = _err(exc)
        return facts
    try:
        stack, seen = [f], {_object_key(f)}
        while stack:
            grp = stack.pop()
            probe_attrs(grp)
            probe_link_corder(grp)
            try:
                keys = list(grp.keys())
            except Exception as exc:
                record("traversal_errors", _object_path(grp), "group.keys", exc)
                continue
            for key in keys:
                try:
                    link = grp.get(key, getlink=True)
                except Exception as exc:
                    record("traversal_errors", _object_path(grp), "getlink", exc)
                    continue
                if isinstance(link, (h5py.ExternalLink, h5py.SoftLink)):
                    continue
                try:
                    obj = grp[key]
                except Exception as exc:
                    record("traversal_errors", _object_path(grp), "open child", exc)
                    continue
                if isinstance(obj, h5py.Group):
                    key_id = _object_key(obj)
                    if key_id not in seen:
                        seen.add(key_id)
                        stack.append(obj)
                elif isinstance(obj, h5py.Dataset):
                    probe_attrs(obj)
                    probe_dataset(obj)
    finally:
        try:
            f.close()
        except Exception:
            pass
    return facts


def eager_probe_isolated(path):
    """Run the eager probe in a child so crashes/hangs/OOM become evidence."""
    try:
        proc = subprocess.run(
            [sys.executable, os.path.realpath(__file__), "--probe-eager", path],
            capture_output=True, text=True, errors="replace", timeout=60,
            preexec_fn=_mem_cap())
    except subprocess.TimeoutExpired:
        return {"probe_error": "timeout"}
    if proc.returncode != 0:
        err = proc.stderr.strip()[:240] or "no stderr"
        return {"probe_error": f"rc={proc.returncode}: {err}"}
    try:
        return json.loads(proc.stdout)
    except (json.JSONDecodeError, ValueError) as exc:
        return {"probe_error": f"unparseable JSON: {_err(exc)}"}


def eager_evidence(eager, h5dump_rc, h5debug_rc, h5dump_data=None):
    """Summarise deeper libhdf5 rejection evidence for A+ demotion."""
    parts = []
    if eager.get("probe_error"):
        parts.append("probe_error")
    if eager.get("open_error"):
        parts.append("open_error")
    for key, label in (("traversal_errors", "traverse"),
                       ("attr_errors", "attrs"),
                       ("read_errors", "reads")):
        n = len(eager.get(key, []))
        if n:
            parts.append(f"{label}={n}")
    for tool, rc in (("h5dump", h5dump_rc), ("h5debug", h5debug_rc),
                     ("h5dump-data", h5dump_data)):
        if rc not in (None, 0):
            parts.append(f"{tool} rc={rc}")
    return parts


def lazy_global_metadata_only(report):
    """Whether every corruption is in eagerly validated, file-global metadata
    that libhdf5's read path deliberately leaves unopened.

    Two structures qualify.  SOHM shared-message search indexes: shared-message
    wrappers contain their heap IDs directly, so libhdf5 reads every object
    without loading the SMLI/type-7 index.  Free-space managers: their FSHD/FSSE
    structures are loaded only when a writer allocates or frees space, never on
    a read-only open.  Both remain active metadata that h5policy intentionally
    validates on discovery.  Keep this narrow: every finding must come from the
    superblock-extension validator and carry its contextual message prefix
    (including the generic checksum code).

    "fractal-heap free-space " is the same free-space story one level down: the
    client-0 FSHD/FSSE pair hanging off a fractal-heap header (h5_frhp_fspace.pk,
    added with the heap free-space closure) is loaded only when a writer
    allocates or frees heap space, so a read-only open never authenticates it
    either.  It needs its own prefix because those messages name the heap that
    owns the manager, so they do not start with the bare "free-space ".  The
    hyphen matters and the boundary is deliberate: the heap HEADER's own checks
    say "fractal heap header" (no hyphen) and are excluded, because libhdf5 does
    read that header on open, so a disagreement there would be a real A failure.
    """
    findings = report.get("findings", [])
    return bool(findings) and all(
        finding.get("object") == "/<superblock-extension>"
        and str(finding.get("message", "")).startswith(
            ("SOHM ", "free-space ", "fractal-heap free-space "))
        for finding in findings)


def secondary_creation_order_only(report):
    """Whether all corruption is confined to a dense secondary-order index.

    Current libhdf5 read paths can enumerate through the primary name index
    without authenticating every type-6/type-9 block.  h5policy deliberately
    validates both active indexes.  Keep this exception message-scoped so an
    unrelated corruption finding on the same object remains a hard A failure.

    The prefixes must track h5policy_dense_corder_role in h5_dense_links.pk:
    the corder walker names its role (link for type 6, attribute for type 9)
    because the two belong to different record families, so there is no longer
    a role-less "dense creation-order" message to match.
    """
    corder_prefixes = ("dense link creation-order",
                       "dense attribute creation-order")
    findings = report.get("findings", [])
    return bool(findings) and all(
        finding.get("class") == "corrupt"
        and (str(finding.get("message", "")).startswith(corder_prefixes)
             or str(finding.get("code", "")).startswith(
                 "H5_CORRUPT_DENSE_CORDER"))
        for finding in findings)


def nbit_member_bounds_only(report):
    """Whether the only defect is an n-bit member outside its parent type.

    libhdf5 reads THIS file without complaint, because whether the malformed
    parameter tree is actually dereferenced depends on the member class and the
    stored chunk bytes -- on the corpus specimen it is, and the same defect is a
    heap-buffer-overflow WRITE in H5Z__nbit_decompress_one_nooptype
    (corpus seed 43).  A member declared at or past its compound's own
    size is malformed either way; libhdf5 tolerating one instance of it is not
    evidence that h5policy is wrong to refuse it.

    So this is deliberately stricter than libhdf5, and invariant A must not read
    "libhdf5 opens" as agreement.  Message-scoped like the other A~ cases: any
    other finding on the same file stays a hard A failure.
    """
    findings = report.get("findings", [])
    corrupt = [f for f in findings if f.get("class") == "corrupt"]
    return bool(corrupt) and all(
        f.get("code") == "H5_CORRUPT_NBIT_MEMBER_BOUNDS" for f in corrupt)


def fill_value_size_mismatch_only(report):
    """Whether the only defect is a fill value shorter than its datatype.

    libhdf5 opens such a file, and h5dump/h5debug/h5dump --data all exit 0 --
    so the A+ evidence path finds nothing to corroborate with.  That is not
    because the file is fine: H5D__fill copies at the DATATYPE size out of a
    buffer allocated at the fill message's declared size, so H5Dread returns 0
    and hands the caller adjacent heap bytes as data (corpus seed 52 --
    ASAN reports the over-read, the stock build reports nothing).

    The defect lives in returned CONTENT, which this harness never inspects; it
    compares exit codes and structure.  So "libhdf5 opens" carries no
    information here, and invariant A must not read it as agreement.  Kept
    message-scoped, like the other A~ cases: any other finding on the same file
    stays a hard A failure.
    """
    findings = report.get("findings", [])
    return bool(findings) and all(
        f.get("class") == "corrupt"
        and f.get("code") == "H5_CORRUPT_FILL_VALUE_SIZE_MISMATCH"
        for f in findings)


def unallocated_chunk_size_overflow_only(report):
    """Whether the only defect is a legacy 32-bit chunk-size overflow on a
    chunk that was never allocated.

    The corpus specimen (chunk_size_uint32_wrap) patches a chunk dimension so
    its byte size overflows H5O_layout_chunk_t.size on vulnerable libhdf5
    builds, but H5Pset_chunk already refuses a chunk that large at creation
    time -- so the fixture is built with no data ever written, and the chunk
    address stays undefined.  libhdf5's read path, h5dump, h5debug, and the
    data-forcing h5dump probe all report the dataset's declared fill value
    without ever resolving that address, so none of them can produce evidence
    either way: there is no on-disk chunk for any of them to decode.  h5policy
    still flags the overflow from the layout message alone, ahead of any read.
    Message-scoped like the other A~ cases: any other finding on the same file
    stays a hard A failure.
    """
    findings = report.get("findings", [])
    return bool(findings) and all(
        f.get("class") == "corrupt"
        and f.get("code") == "H5_CORRUPT_CHUNK_SIZE_EXCEEDS_32BIT"
        for f in findings)


SILENT_WRONG_DATA_CODES = {
    # A raw-data extent pointing into metadata -- a chunk record or a contiguous
    # layout, one code for both since the invariant is one: libhdf5 seeks to the
    # address it is given and returns those bytes as dataset values.
    "H5_CORRUPT_RAW_DATA_OVERLAPS_METADATA",
    # Two chunk keys claiming one offset: libhdf5 searches the tree on that
    # order, so one chunk becomes unreachable and the other is served in its
    # place, the displaced region coming back as the fill value.
    "H5_CORRUPT_CHUNK_KEY_ORDER",
}


def chunk_silent_wrong_data_only(report):
    """Whether every defect is one libhdf5 answers WRONGLY but successfully.

    libhdf5 never re-checks that raw data and metadata occupy disjoint bytes on
    READ.  Its allocator guarantees it on write, and the read path simply seeks
    to the address the chunk record gives and returns what it finds -- so a
    chunk pointed at metadata is served without any error at all.  Measured on
    the corpus fixture: h5dump exits 0 and the dataset's first two int32 values
    are 1178880137 and 169478669, i.e. 0x46444889 and 0x0A1A0A0D, the file's own
    "\x89HDF\r\n\x1a\n" signature returned as data.  Pointing the same record
    at a v1 B-tree node yields 0x45455254, "TREE".

    So "libhdf5 opens" carries no information here, and neither does "libhdf5
    reads": BOTH succeed, which is precisely the defect.  There is no deeper
    evidence for the A+ path to find, because a silent wrong answer leaves no
    trace a return code can carry -- this is the one A~ case in this file where
    the reference library is not merely lazy but actively wrong.

    THE SECOND MEMBER, H5_CORRUPT_CHUNK_KEY_ORDER, is the same story through a
    different field: two v1 B-tree keys declaring one chunk offset.  libhdf5
    locates chunks by searching that ordering, so a duplicate makes one chunk
    unreachable and serves the other in its place.  Measured: h5dump exits 0 and
    returns chunk (0,5)'s bytes at logical position (0,0), with the displaced
    region reported as the dataset's fill value.

    Code-scoped rather than per-fixture, and both members pass the test that form
    requires: EVERY file emitting either code deserves the exemption, because in
    both cases the absence of the check is a property of libhdf5's read path and
    not of any one specimen.  Message-scoped like the other A~ cases: any other
    finding on the same file stays a hard A failure.
    """
    findings = report.get("findings", [])
    return bool(findings) and all(
        f.get("class") == "corrupt"
        and f.get("code") in SILENT_WRONG_DATA_CODES
        for f in findings)


def fixed_array_capacity_mismatch_only(report):
    """Whether the only defect is a fixed-array index sized for a different
    maximum extent than the dataspace declares.

    Reading a dataset never rebuilds its chunk index: libhdf5 walks the FAHD
    header and the chunk addresses already on disk, so the stored capacity is
    used as found and h5py, h5dump, h5debug and the data-forcing probe all exit
    0.  The capacity libhdf5 recomputes from the dataspace is consulted only
    where an index is (re)created -- H5Ocopy, and therefore h5repack.  Measured
    there on the corpus fixture: an assert-enabled build aborts the process in
    the metadata cache (H5Centry.c:2208, entry_ptr->size < H5C_MAX_ENTRY_SIZE),
    and a release build with that assert compiled out reports success while
    writing a 2.8 TB output file from a 2.4 KB input.

    Neither is reachable through this harness, which never copies a file --
    running h5repack over the corpus to produce the evidence would write that
    output for real.  So "libhdf5 opens" carries no information here, and
    invariant A must not read it as agreement.  Message-scoped like the other
    A~ cases: any other finding on the same file stays a hard A failure.
    """
    findings = report.get("findings", [])
    return bool(findings) and all(
        f.get("class") == "corrupt"
        and f.get("code") == "H5_CORRUPT_FIXED_ARRAY_EXTENT_MISMATCH"
        for f in findings)


def impossible_contiguous_length_only(report):
    """Whether corruption is only an impossible contiguous-data extent.

    libhdf5 structurally opens the direct wide-length controls and reports their
    scalar dataspace without checking that the contiguous layout's declared
    byte range can exist in the physical file.  h5dump and the bounded eager
    probe do the same because neither needs that range to report the structure.
    h5policy intentionally validates the complete on-disk extent at metadata
    decode time.  Keep the exception code-scoped and require the range-overflow
    finding, so an unrelated wide-length corruption remains a hard A failure.
    """
    corrupt = [
        finding for finding in report.get("findings", [])
        if finding.get("class") == "corrupt"
    ]
    allowed = {
        "H5_CORRUPT_LENGTH_EXCEEDS_U64",
        "H5_CORRUPT_LENGTH_OVERFLOW",
    }
    codes = {finding.get("code") for finding in corrupt}
    return (bool(corrupt)
            and codes <= allowed
            and "H5_CORRUPT_LENGTH_OVERFLOW" in codes)


# libhdf5's wording when a decoder meets a message version it does not know.
# It is emitted both for a genuinely corrupt version byte and for a version the
# running library simply predates; only the second reading survives the guard in
# reference_predates_message_version below.
_VERSION_REFUSAL_MARKERS = ("bad version number for",
                            "unknown version of",
                            "unsupported version")


def reference_predates_message_version(ref, decision):
    """Whether the reference libhdf5 refused a message version h5policy accepts.

    The in-process reference is whatever libhdf5 h5py links, and h5py releases
    trail the library: a file written by a newer libhdf5 can carry a perfectly
    legal message version (data layout v5, say, introduced with the 2.x
    H5F_LIBVER_V200 bound) that the reference refuses to decode.  Reading that
    refusal as "libhdf5 rejects it" would make invariant A' demand h5policy
    reject a valid file -- the exact false positive this repo is meant to avoid.

    The guard is the decision: h5policy only accepts a layout/message version
    that the format defines, so an accepting decision paired with a
    version-shaped refusal means the reference is behind, not that the file is
    malformed.  A corrupt version byte instead makes h5policy reject, so this
    never fires for one.  Kept as narrow as the other A~ exemptions: any other
    refusal from the reference stays a hard A' failure.
    """
    if decision not in ("accept", "accept_with_warnings"):
        return False
    error = str(ref.get("error", "")).lower()
    return any(marker in error for marker in _VERSION_REFUSAL_MARKERS)


def check(path):
    """Return (hard_failures, warnings, lines, tracked) for one file."""
    fails, warns, lines, tracked = [], [], [], []
    report, _ = run_h5policy(path)
    decision = report["decision"]
    feat = report.get("features", {})
    ref = introspect_isolated(path)
    h5dump_rc = reference_rc("h5dump", path)
    h5debug_rc = reference_rc("h5debug", path)
    tol_key = tolerance_key(path)

    def hard(ok, msg, invariant=None):
        if ok:
            lines.append("PASS " + msg)
            return
        entry = TOLERANCES.get((tol_key, invariant)) if invariant else None
        if entry:
            tracked.append((("FAIL " + msg), entry))
        else:
            fails.append("FAIL " + msg)

    def soft(ok, msg):
        (lines if ok else warns).append(("ok   " if ok else "WARN ") + msg)

    # A / A': corruption agreement with libhdf5.
    if ref["opens"]:
        if decision == "reject_corrupt":
            eager = eager_probe_isolated(path)
            evidence = eager_evidence(eager, h5dump_rc, h5debug_rc,
                                      h5dump_data_rc(path))
            if evidence:
                soft(False,
                     "A+ libhdf5 opens structurally; h5policy eager "
                     f"reject_corrupt has deeper libhdf5 evidence "
                     f"({', '.join(evidence)})")
            elif lazy_global_metadata_only(report):
                soft(False,
                     "A~ libhdf5 read traversal leaves file-global SOHM "
                     "search / free-space metadata (including a fractal "
                     "heap's own free-space manager) unopened; h5policy "
                     "validates it eagerly")
            elif impossible_contiguous_length_only(report):
                soft(False,
                     "A~ libhdf5 leaves the declared contiguous-data extent "
                     "unchecked; h5policy validates its physical range "
                     "eagerly")
            elif nbit_member_bounds_only(report):
                soft(False,
                     "A~ h5policy is deliberately stricter: an n-bit member "
                     "declared at or past its compound's own size is malformed "
                     "even where libhdf5 does not dereference the parameter "
                     "tree (it does on the corpus specimen -- overflow WRITE)")
            elif fill_value_size_mismatch_only(report):
                soft(False,
                     "A~ libhdf5 opens and reads this file without error; the "
                     "fill-size defect surfaces only in H5Dread CONTENT (heap "
                     "bytes returned as data), which this harness does not "
                     "inspect")
            elif secondary_creation_order_only(report):
                soft(False,
                     "A~ libhdf5 traverses the primary dense index without "
                     "authenticating every secondary creation-order block; "
                     "h5policy validates both indexes")
            elif fixed_array_capacity_mismatch_only(report):
                soft(False,
                     "A~ libhdf5 reads a chunk index as it finds it and never "
                     "re-derives its capacity; the mismatch bites only where "
                     "an index is rebuilt (H5Ocopy: process abort, or a 2.8 TB "
                     "write with the assert compiled out), which this harness "
                     "does not run")
            elif chunk_silent_wrong_data_only(report):
                soft(False,
                     "A~ libhdf5 answers this file WRONGLY but successfully: it "
                     "trusts the chunk record's address and key order, so it "
                     "returns metadata bytes (or another chunk's bytes) as data "
                     "and exits 0 -- neither 'opens' nor 'reads' carries "
                     "information, which is why there is no A+ evidence to find")
            elif unallocated_chunk_size_overflow_only(report):
                soft(False,
                     "A~ the overflowing chunk was never allocated (rejected "
                     "at creation on any libhdf5 that could write it), so no "
                     "reader ever resolves its address; h5policy flags the "
                     "overflow from the layout message alone")
            else:
                hard(False,
                     f"A  libhdf5 opens => not reject_corrupt (got {decision})",
                     invariant="A")
        else:
            hard(True,
                 f"A  libhdf5 opens => not reject_corrupt (got {decision})",
                 invariant="A")
    else:
        safe_rejections = {
            "reject_corrupt",
            "reject_policy",
            "reject_resource",
            "unsupported_coverage_gap",
        }
        if reference_predates_message_version(ref, decision):
            soft(False,
                 "A'~ the reference libhdf5 "
                 f"({getattr(h5py.version, 'hdf5_version', '?')}) refuses a "
                 "message version this file legally uses "
                 f"({ref.get('error', '')}); h5policy decodes it and accepts")
        else:
            hard(decision in safe_rejections,
                 f"A' libhdf5 rejects => explicit rejection (got {decision})",
                 invariant="A'")
        if decision in safe_rejections and decision != "reject_corrupt":
            soft(False,
                 "A' libhdf5 rejects as corrupt; h5policy safely refuses "
                 f"earlier as {decision}")

    # Independent oracles should agree with h5py on open-ability.
    for tool, rc in (("h5dump", h5dump_rc), ("h5debug", h5debug_rc)):
        if rc is not None:
            soft((rc == 0) == ref["opens"],
                 f"   {tool} rc={rc} vs h5py structural open={ref['opens']}")

    if ref["opens"]:
        # B: external-reference detection.
        hard((feat.get("external_links", 0) > 0) == (ref["ext_links"] > 0),
             f"B  external links: h5policy={feat.get('external_links',0)} "
             f"h5py={ref['ext_links']}",
             invariant="B")

        # C: logical dataset bytes -- ADVISORY, not a hard invariant.  h5policy
        # reads the DECLARED on-disk element size; libhdf5's H5Tget_size reports
        # a smaller PACKED size for padded compounds (and a different size again
        # for VLEN).  A security oracle using the larger declared size is
        # conservative and correct, so a mismatch is informational.  Rank (D)
        # and safe rejection agreement (A/A') remain the hard offset-bug guards.
        pmax, rmax = feat.get("max_logical_dataset_bytes_seen", 0), ref["max_logical"]
        note = "" if pmax == rmax else \
            (" (declared>packed; conservative)" if pmax > rmax
             else " (undercount; coverage gap)")
        soft(pmax == rmax, f"C  max logical bytes: h5policy={pmax} h5py={rmax}{note}")

        # D: rank must never exceed the reference.
        prank, rrank = feat.get("max_rank_seen", 0), ref["max_rank"]
        hard(prank <= rrank,
             f"D  max rank: h5policy={prank} h5py={rrank}",
             invariant="D")
        if prank < rrank:
            soft(False, f"D  rank undercount: h5policy={prank} < h5py={rrank}")

    return fails, warns, lines, tracked


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="*", help="HDF5 files")
    ap.add_argument("--dir", help="check every *.h5 under this directory")
    ap.add_argument("--hdf5-bindir", help="resolve h5dump/h5debug from this "
                    "build's bin dir instead of PATH (h5py is not repointed; "
                    "its version is recorded for provenance)")
    ap.add_argument("--json", action="store_true",
                    help="emit results and tool provenance as JSON")
    ap.add_argument("--introspect", metavar="FILE",
                    help=argparse.SUPPRESS)  # internal: out-of-process oracle
    ap.add_argument("--probe-eager", metavar="FILE",
                    help=argparse.SUPPRESS)  # internal: deeper libhdf5 probe
    args = ap.parse_args()

    # Prepend the selected build's bin dir so shutil.which / subprocess pick its
    # h5dump and h5debug.  h5py links its own libhdf5 in-process and cannot be
    # repointed here; the differential still records which version that is.
    if args.hdf5_bindir:
        os.environ["PATH"] = args.hdf5_bindir + os.pathsep + os.environ.get("PATH", "")

    if args.introspect:  # child invocation: emit libhdf5 facts and exit
        print(json.dumps(introspect(args.introspect)))
        return 0
    if args.probe_eager:  # child invocation: emit deeper libhdf5 evidence
        print(json.dumps(eager_probe(args.probe_eager)))
        return 0

    files = list(args.paths)
    if args.dir:
        files += sorted(glob.glob(os.path.join(args.dir, "**", "*.h5"),
                                  recursive=True))
    # fuzz-findings/ is ephemeral h5policy-fuzz scratch (and may hold files that
    # crash libhdf5); it is not part of the curated regression corpus.
    files = [f for f in files if "fuzz-findings" not in f.split(os.sep)]
    if not files:
        ap.error("no files given (pass files or --dir)")

    for tool in ("h5dump", "h5debug"):
        if shutil.which(tool) is None:
            print(f"note: {tool} not found; skipping its oracle", file=sys.stderr)

    provenance = {
        "hdf5_bindir": args.hdf5_bindir,
        "h5py_hdf5_version": getattr(h5py.version, "hdf5_version", None),
        "tools": {t: _tool_version_diff(t) for t in ("h5dump", "h5debug")},
    }

    total_fail = 0
    total_tool_error = 0
    total_tracked = 0
    records = []
    for path in files:
        rel = os.path.relpath(path)
        try:
            fails, warns, lines, tracked = check(path)
        except ToolError as exc:
            # Counted and reported SEPARATELY from differential failures: the
            # tool misbehaved, it did not disagree with libhdf5.
            if not args.json:
                print(f"\n{rel}\n  TOOL_ERROR {exc}")
            records.append({"file": rel, "status": "TOOL_ERROR",
                            "error": str(exc)})
            total_tool_error += 1
            continue
        except Exception as exc:
            if not args.json:
                print(f"\n{rel}\n  ERROR {exc}")
            records.append({"file": rel, "status": "ERROR", "error": str(exc)})
            total_fail += 1
            continue
        # TRACKED ranks above WARN: it says a hard invariant failed, just not
        # newly -- registry/cases/ already has a triaged explanation, and the
        # fixture keeps failing that invariant every run, on purpose, until the
        # reference defect is fixed or the tolerance is withdrawn.
        if fails:
            status = "FAIL"
        elif tracked:
            status = "TRACKED"
        elif warns:
            status = "WARN"
        else:
            status = "PASS"
        tracked_lines = [f"{ln}  (tracked: {entry['case']})"
                         for ln, entry in tracked]
        records.append({"file": rel, "status": status, "checks": lines,
                        "warnings": warns, "failures": fails,
                        "tracked": [{"check": ln, "case": entry["case"],
                                    "reason": entry.get("reason")}
                                   for ln, entry in tracked]})
        if not args.json:
            print(f"\n{rel}  [{status}]")
            for ln in lines + warns + tracked_lines + fails:
                print(f"  {ln}")
        total_fail += len(fails)
        total_tracked += len(tracked)

    if args.json:
        print(json.dumps({"tool": "h5policy-diff", "provenance": provenance,
                          "hard_failures": total_fail,
                          "tracked_divergences": total_tracked,
                          "tool_errors": total_tool_error,
                          "files": len(files),
                          "results": records}, indent=2))
    else:
        summary = (f"\ndifferential: {total_fail} hard failure(s) across "
                   f"{len(files)} file(s)")
        if total_tracked:
            summary += (f"; {total_tracked} tracked (known, "
                        f"registry-documented) divergence(s)")
        if total_tool_error:
            summary += (f"; {total_tool_error} file(s) produced NO h5policy "
                        f"verdict (tool error, not a differential result)")
        print(summary)
    # Both are non-zero exits -- a tool that cannot answer still has to stop the
    # suite -- but the counts stay distinct so the cause is never guessed at.
    # Tracked divergences are deliberately NOT part of this: they are a known
    # reference-library defect, not an open question about h5policy.
    return 1 if (total_fail or total_tool_error) else 0


def _tool_version_diff(tool):
    if shutil.which(tool) is None:
        return None
    try:
        out = subprocess.run([tool, "--version"], capture_output=True,
                             text=True, timeout=10).stdout
        import re
        m = re.search(r"\d+\.\d+\.\d+", out)
        return m.group(0) if m else "?"
    except Exception:
        return "?"


if __name__ == "__main__":
    sys.exit(main())
