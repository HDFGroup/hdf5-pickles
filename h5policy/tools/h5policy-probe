"""Exact-build libhdf5 probe with OS-level activation tracing.

h5policy-diff observes whichever libhdf5 h5py bundles; h5policy-crashfuzz drives
whatever tools are on PATH.  Neither pins an exact build, and neither proves that
a rejection preceded activation.  This tool does both:

  * It compiles the h5probe C program against a SELECTED build (--hdf5-bindir,
    default: the build behind h5cc on PATH) and runs it on one file, so the
    result is attributable to an exact, provenance-stamped libhdf5.

  * It runs that probe under the h5trace LD_PRELOAD interposer inside a sandbox
    (read-only input, isolated work dir, resource limits, controlled plugin
    path) and reports the OS-observable activation events the corpus forbids on
    a hostile file: external/VDS/EFL opens, filter-plugin dlopen, writes, and
    network.

libhdf5's behaviour on a malformed file is NOT specification truth: the declared
invariant (the h5policy oracle) is.  This tool answers a different question --
"did the selected build reject safely, and did anything activate before it did?"
-- which is what a release gate needs.  Internal event counters (cache-insertion
order, ID registration) require a patched libhdf5 and are out of scope here.

Outcome is one of: accepted (opened, no traversal error), rejected_at_open,
rejected_in_traversal (opened but a later call refused, no crash), crashed
(killed by a fault signal -- SIGSEGV, SIGFPE, SIGABRT), timeout (did not
terminate: the wall-clock deadline, or SIGXCPU from the RLIMIT_CPU guard), or
build_unavailable.

crashed and timeout are kept apart deliberately, because they support opposite
conclusions about the selected build: a fault is a memory-safety or arithmetic
defect, a non-termination is a denial-of-service one.  `--forbid crash` covers
BOTH, so the violation it raises does not distinguish them -- read `outcome`,
not the violation name, when the difference matters.

Usage:
  h5policy-probe FILE [--hdf5-bindir DIR] [--json]
                      [--forbid external_open,plugin_load,write,network,crash]
Exit: 0 clean; 2 a forbidden activation/crash occurred; 3 the build/toolchain
was unavailable (skip, like the differential harness).
"""
import argparse
import hashlib
import json
import os
import re
import resource
import signal
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
PROBE_SRC = os.path.join(HERE, "probe", "h5probe.c")
TRACE_SRC = os.path.join(HERE, "probe", "h5trace.c")
BUILD_ROOT = os.path.join(HERE, "probe", ".build")

FORBIDDABLE = ("external_open", "plugin_load", "write", "network", "crash")

# Reports are checked in (registry/cases/) or kept as case-bundle evidence, so
# they must not carry this workstation's directory layout.  Paths are portable
# on the way OUT only: the values held internally stay absolute, because
# build_identity's h5cc drives both the sibling-lib lookup and the probe build
# cache key.
REPO_ROOT = os.path.dirname(os.path.dirname(HERE))


def portable_path(path):
    """An absolute path rewritten to something meaningful off this machine.

    Inside the repo it becomes repo-relative; a build install collapses to its
    soname or basename, which is the part that identifies the build.  Anything
    else keeps only its basename -- enough to say WHICH file, not where the
    person who ran it keeps their home directory.
    """
    if not isinstance(path, str) or not path:
        return path
    real = os.path.realpath(path) if os.path.exists(path) else path
    if real.startswith(REPO_ROOT + os.sep):
        return os.path.relpath(real, REPO_ROOT)
    return os.path.basename(real.rstrip(os.sep)) or real


def portable_identity(ident):
    """A copy of the build identity with its host paths made portable."""
    out = dict(ident)
    for k in ("h5cc", "linked_library"):
        if k in out:
            out[k] = portable_path(out[k])
    return out


def portable_probe(probe):
    """A copy of the probe's own report with its host paths made portable.

    The probe reports the library it actually resolved, via dladdr, which is an
    absolute install path.  That block is emitted alongside `build`, so it needs
    the same treatment: without this the identity is portable in one place and a
    home directory in another, three lines apart.
    """
    if not isinstance(probe, dict):
        return probe
    out = dict(probe)
    if "linked_library" in out:
        out["linked_library"] = portable_path(out["linked_library"])
    return out


# One absolute path token inside an ASan frame: everything up to whitespace or a
# parenthesis.  A frame carries the path in one of two shapes -- symbolized,
# "#0 0x... in H5Z__filter_fletcher32 /abs/src/H5Zfletcher32.c:75", or
# unsymbolized, "#3 0x... (/abs/lib/libhdf5.so.1000.0.0+0x1234)" -- so the
# trailing ":line[:col]" or "+0xoffset" has to survive the rewrite.
_ASAN_PATH_RE = re.compile(r"/[^\s()]+")


def _portable_frame_path(match):
    token = match.group(0)
    head, plus, offset = token.partition("+")
    path, _, suffix = head.partition(":")
    return portable_path(path) + (":" + suffix if suffix else "") + plus + offset


def portable_asan(report):
    """A copy of an ASan summary with its host paths made portable.

    The frames name the SOURCE TREE the instrumented build was compiled from,
    which is neither the repo nor an install -- an absolute path that identifies
    nothing off this machine but pins the record to this one.  Without this the
    build identity is portable three lines above while every stack frame below
    it still spells out a home directory, which is how ASan probe results kept
    failing tools/check_hygiene.py.
    """
    if not isinstance(report, dict):
        return report
    out = dict(report)
    frames = out.get("top_frames")
    if isinstance(frames, list):
        out["top_frames"] = [
            _ASAN_PATH_RE.sub(_portable_frame_path, f) if isinstance(f, str) else f
            for f in frames]
    if isinstance(out.get("access"), str):
        out["access"] = _ASAN_PATH_RE.sub(_portable_frame_path, out["access"])
    return out


def _is_runtime_noise(rp):
    """True for loader/libc/runtime artifacts an HDF5 open legitimately touches.

    Deliberately NARROW: it matches shared objects and the loader/locale/timezone
    machinery, NOT whole directory trees.  An EFL or external link pointing at a
    real data file under a "system" path -- /etc/passwd being the canonical
    arbitrary-read target -- is exactly the activation we must surface, so a broad
    /etc or /usr prefix allowlist would defeat the tracer's purpose."""
    base = os.path.basename(rp)
    if ".so" in base:                          # shared objects, any version suffix
        return True
    # Separated debug info an in-process symbolizer reads while formatting a
    # crash report (the ASAN build is the motivating case): the split-debuglink
    # (*.debug), the /usr/lib/debug tree, and .build-id / .debug lookup dirs.
    # None is ever a legitimate HDF5 external-data target, so filtering them
    # keeps a real /etc/passwd-style read visible while dropping symbolizer noise.
    if base.endswith(".debug") or rp.startswith("/usr/lib/debug"):
        return True
    if "/.build-id/" in rp or "/.debug/" in rp:
        return True
    if rp.startswith(("/proc/", "/sys/", "/dev/")):
        return True
    if rp in ("/etc/ld.so.cache", "/etc/ld.so.preload", "/etc/localtime"):
        return True
    if rp.startswith(("/usr/lib/locale", "/usr/share/locale", "/usr/share/zoneinfo",
                      "/usr/lib/gconv", "/usr/lib64/gconv")):
        return True
    return False


def _die_skip(msg, as_json):
    out = {"tool": "h5policy-probe", "outcome": "build_unavailable", "reason": msg}
    print(json.dumps(out, indent=2) if as_json else f"h5policy-probe: {msg}")
    sys.exit(3)


def resolve_h5cc(bindir):
    if bindir:
        cand = os.path.join(bindir, "h5cc")
        return cand if os.path.exists(cand) else None
    return shutil.which("h5cc")


def build_identity(h5cc):
    """Provenance for the selected build: authoritative linked version comes
    later from the probe itself (dladdr); this is the static configuration."""
    ident = {"h5cc": os.path.realpath(h5cc)}
    try:
        cfg = subprocess.run([h5cc, "-showconfig"], capture_output=True,
                             text=True, timeout=30).stdout
    except Exception:
        cfg = ""
    fields = {
        "HDF5 Version": "hdf5_version_configured",
        "Configured on": "configured_on",
        "Build Mode": "build_mode",
        "C Compiler": "compiler",
        "Parallel HDF5": "parallel",
        "Thread Safety": "thread_safe",
    }
    cflags = ""
    for line in cfg.splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        k, v = k.strip(), v.strip()
        if k in fields:
            ident[fields[k]] = v
        if "CFLAGS" in k or "FLAGS" in k:
            cflags += " " + v
    ident["sanitizers"] = sorted({
        tok.split("=", 1)[1] if "=" in tok else "on"
        for tok in cflags.split() if tok.startswith("-fsanitize")
    }) or []
    # Pin the exact configuration by hashing libhdf5.settings if we can find it.
    libdir = os.path.join(os.path.dirname(os.path.dirname(ident["h5cc"])), "lib")
    settings = os.path.join(libdir, "libhdf5.settings")
    if os.path.exists(settings):
        ident["settings_sha256"] = hashlib.sha256(
            open(settings, "rb").read()).hexdigest()
    ident["plugin_path"] = os.environ.get("HDF5_PLUGIN_PATH", "(default)")
    return ident


def is_asan(ident):
    """True when the build under test is AddressSanitizer-instrumented.

    Derived from the linked build's own CFLAGS (build_identity), so it reflects
    the library we will actually load -- not a flag we chose.  This gates the
    ASAN-specific handling everywhere: the harness must be built with ASAN so
    libasan initializes ahead of the instrumented libhdf5, and RLIMIT_AS must be
    dropped because ASAN reserves a ~20 TB shadow at startup that a 2 GB address
    cap would refuse.
    """
    return any("address" in s for s in ident.get("sanitizers", []))


# Bumped whenever the compile recipe below changes so old cache dirs recompile.
_PROBE_BUILD_RECIPE = "v2-asan"


def ensure_built(h5cc, ident, as_json):
    """Compile probe (against the selected build) and interposer, cached by a
    key over the toolchain + config so a build swap recompiles."""
    if not shutil.which("cc"):
        _die_skip("cc not found; cannot build the activation interposer", as_json)
    asan = is_asan(ident)
    key = hashlib.sha256(
        (ident["h5cc"] + ident.get("settings_sha256", "") + _PROBE_BUILD_RECIPE +
         str(os.path.getmtime(PROBE_SRC)) + str(os.path.getmtime(TRACE_SRC))
         ).encode()).hexdigest()[:16]
    bdir = os.path.join(BUILD_ROOT, key)
    probe = os.path.join(bdir, "h5probe")
    trace = os.path.join(bdir, "h5trace.so")
    if os.path.exists(probe) and os.path.exists(trace):
        return probe, trace
    os.makedirs(bdir, exist_ok=True)
    # Match the library's instrumentation: an ASAN libhdf5 requires the main
    # executable to carry -fsanitize=address (libasan must be the first runtime
    # loaded).  The LD_PRELOAD interposer stays uninstrumented -- it only wraps
    # open()/etc. via dlsym and needs no shadow of its own.
    probe_cmd = [h5cc, "-O2", "-o", probe, PROBE_SRC]
    if asan:
        probe_cmd = [h5cc, "-O1", "-g", "-fno-omit-frame-pointer",
                     "-fsanitize=address", "-o", probe, PROBE_SRC]
    try:
        subprocess.run(probe_cmd,
                       check=True, capture_output=True, text=True, timeout=180)
        subprocess.run(["cc", "-O2", "-fPIC", "-shared", "-o", trace, TRACE_SRC,
                        "-ldl"], check=True, capture_output=True, text=True,
                       timeout=120)
    except subprocess.CalledProcessError as e:
        _die_skip(f"probe build failed: {e.stderr.strip()[:400]}", as_json)
    return probe, trace


def inherited_cap(which, want):
    """`want`, lowered to the hard limit this process already runs under.

    setrlimit RAISES when the requested value exceeds the inherited HARD limit,
    and a raise inside a preexec_fn reaches the caller as a bare
    `SubprocessError: Exception occurred in preexec_fn` -- no limit named, no
    value, no traceback into this file.  That is not hypothetical: running the
    regression suite under the `ulimit -v` its own guidance recommends (an
    uncapped h5dump on a corpus fixture can OOM the session) put every child
    under a 3.9 GiB hard limit, and the tools that ask for 4 GiB died with that
    message instead of running.

    Clamping in the PARENT rather than the child is deliberate: the parent
    inherits the same limit, so it can compute the effective value AND report
    it.  A child that clamped silently would leave a run looking like it had a
    2 GiB cap when it had 200 MB, which changes what "rejected" means for an
    allocation-amplification case.
    """
    soft, hard = resource.getrlimit(which)
    if hard != resource.RLIM_INFINITY and want > hard:
        return hard, True
    return want, False


def effective_limits(cpu, mem_mb, fsize_mb):
    """The limits actually applicable here, and what was lowered to get them."""
    mem_b, mem_clamped = inherited_cap(resource.RLIMIT_AS, mem_mb * 1024 * 1024)
    cpu_s, cpu_clamped = inherited_cap(resource.RLIMIT_CPU, cpu + 2)
    fsize_b, fsize_clamped = inherited_cap(resource.RLIMIT_FSIZE,
                                           fsize_mb * 1024 * 1024)
    return {
        "mem_mb": mem_b // (1024 * 1024),
        "mem_mb_requested": mem_mb,
        "cpu_seconds": max(1, cpu_s - 2),
        "fsize_mb": fsize_b // (1024 * 1024),
        "fsize_mb_requested": fsize_mb,
        "clamped_to_inherited_rlimit": bool(mem_clamped or cpu_clamped
                                            or fsize_clamped),
    }


def _limits(cpu, mem_mb, fsize_mb, asan=False):
    def apply():
        cpu_hard, _ = inherited_cap(resource.RLIMIT_CPU, cpu + 2)
        resource.setrlimit(resource.RLIMIT_CPU, (min(cpu, cpu_hard), cpu_hard))
        # ASAN maps an enormous (~20 TB) shadow region at startup; a virtual
        # address-space cap makes it abort before main().  Skip RLIMIT_AS for an
        # ASAN build and rely on RLIMIT_CPU/timeout plus ASAN's own
        # hard_rss_limit_mb (set in the env) to bound runaway memory instead.
        if not asan:
            soft_as, _ = inherited_cap(resource.RLIMIT_AS, mem_mb * 1024 * 1024)
            resource.setrlimit(resource.RLIMIT_AS, (soft_as, soft_as))
        fsize, _ = inherited_cap(resource.RLIMIT_FSIZE, fsize_mb * 1024 * 1024)
        resource.setrlimit(resource.RLIMIT_FSIZE, (fsize, fsize))
        resource.setrlimit(resource.RLIMIT_NOFILE, (256, 256))
        try:
            resource.setrlimit(resource.RLIMIT_NPROC, (64, 64))
        except (ValueError, OSError):
            pass
    return apply


_ASAN_ERROR_RE = re.compile(r"ERROR: AddressSanitizer: ([a-z0-9-]+)")


def parse_asan(stderr_text):
    """Extract a structured summary from an AddressSanitizer stderr report.

    Returns None when the text contains no ASAN error (a clean exit, or a
    non-ASAN crash).  Otherwise the error kind, the read/write access line, and
    the first few symbolized frames -- enough to prove which invariant faulted
    without pasting a full report into the case bundle.
    """
    m = _ASAN_ERROR_RE.search(stderr_text)
    if not m:
        return None
    lines = stderr_text.splitlines()
    access = next((ln.strip() for ln in lines
                   if re.search(r"(READ|WRITE) of size ", ln)), None)
    frames = [ln.strip() for ln in lines if re.match(r"\s*#\d+ ", ln)][:6]
    return {"error": m.group(1), "access": access, "top_frames": frames}


def classify(trace_lines, input_realpath, workdir):
    ext_open, writes, plugins, net = [], [], [], 0
    for line in trace_lines:
        parts = line.rstrip("\n").split("\t")
        kind = parts[0]
        if kind == "OPEN" and len(parts) >= 3:
            mode, path = parts[1], parts[2]
            abspath = path if os.path.isabs(path) else os.path.join(workdir, path)
            try:
                rp = os.path.realpath(abspath)
            except Exception:
                rp = abspath
            if mode == "W":
                writes.append(path)
            elif rp == input_realpath:
                continue                                   # the file under test
            elif _is_runtime_noise(rp) or _is_runtime_noise(abspath):
                # Check both the resolved and the raw path: a symbolizer reading
                # /proc/self/exe resolves to the probe binary (not itself noise),
                # but the /proc/ path it actually opened is.
                continue                                   # loader/libc/runtime noise
            else:
                ext_open.append(path)                      # external / VDS / EFL
        elif kind == "DLOPEN" and len(parts) >= 2:
            plugins.append(parts[1])
        elif kind == "NET":
            net += 1
    return {
        "external_open": {"count": len(ext_open), "paths": ext_open},
        "plugin_load": {"count": len(plugins), "names": plugins},
        "write": {"count": len(writes), "paths": writes},
        "network": {"count": net},
    }


def probe_file(path, probe, trace, ident, timeout, cpu, mem_mb, fsize_mb,
               exercise="generic", asan=False):
    workdir = tempfile.mkdtemp(prefix="h5probe-")
    limits = effective_limits(cpu, mem_mb, fsize_mb)
    mem_mb = limits["mem_mb"]          # ASAN's hard_rss_limit_mb uses this too
    fsize_mb = limits["fsize_mb"]
    result = {"timed_out": False, "signal": None, "limits": limits}
    try:
        local = os.path.join(workdir, "input.h5")
        shutil.copy(path, local)
        # Writes are exercised only against this isolated copy.
        os.chmod(local, 0o644 if exercise == "external_file_list" else 0o444)
        input_realpath = os.path.realpath(local)

        plugin_iso = os.path.join(workdir, "noplugins")
        os.makedirs(plugin_iso, exist_ok=True)
        env = {
            "PATH": "/usr/bin:/bin",
            "LD_PRELOAD": trace,
            "H5TRACE_FD": "3",
            "HDF5_PLUGIN_PATH": plugin_iso,                # no arbitrary plugins
            "HDF5_DISABLE_VERSION_CHECK": "1",
            "HOME": workdir,
        }
        if asan:
            # Stop at the first error, abort so it presents as a signal (the
            # existing crash path), and suppress LeakSanitizer -- a corrupt file
            # that leaves the library "closing" mid-teardown floods the report
            # with leaks that would bury the actual out-of-bounds access we came
            # for.  hard_rss_limit_mb substitutes for the RLIMIT_AS we dropped.
            # verify_asan_link_order=0: the harness is linked with -fsanitize=
            # address, so libasan initializes from its own DT_NEEDED constructor.
            # But the activation interposer is LD_PRELOADed ahead of it, which
            # trips ASAN's "runtime does not come first" guard and aborts before
            # main(). Disabling the *order check* (not the runtime) lets the
            # uninstrumented interposer coexist with the instrumented library.
            env["ASAN_OPTIONS"] = (
                "abort_on_error=1:halt_on_error=1:detect_leaks=0:"
                "verify_asan_link_order=0:symbolize=1:print_legend=0:"
                f"hard_rss_limit_mb={mem_mb}")
        # ASAN writes its report to stderr; capture it so a fault can be turned
        # into a structured finding instead of an opaque signal.
        stderr_dst = subprocess.PIPE if asan else subprocess.DEVNULL
        trace_path = os.path.join(workdir, "trace.txt")
        with open(trace_path, "w") as tf:
            try:
                proc = subprocess.run(
                    [probe, "--exercise", exercise, "input.h5"], cwd=workdir, env=env,
                    stdout=subprocess.PIPE, stderr=stderr_dst,
                    pass_fds=(tf.fileno(),),
                    preexec_fn=_limits(cpu, mem_mb, fsize_mb, asan),
                    timeout=timeout)
            except subprocess.TimeoutExpired:
                result.update(outcome="timeout", timed_out=True,
                              probe=None, activation=classify(
                                  open(trace_path).readlines()
                                  if os.path.exists(trace_path) else [],
                                  input_realpath, workdir))
                return result

        if asan and proc.stderr:
            report = parse_asan(proc.stderr.decode(errors="replace"))
            if report:
                result["asan"] = report

        trace_lines = open(trace_path).readlines()
        activation = classify(trace_lines, input_realpath, workdir)
        # EFL write canary deliberately writes only the private copied target;
        # that write is the exercise, not an out-of-scope activation.
        if exercise == "external_file_list":
            activation["write"] = {"count": 0, "paths": []}

        probe_json = None
        try:
            probe_json = json.loads(proc.stdout.decode())
        except Exception:
            pass

        if proc.returncode < 0:
            # SIGXCPU is the RLIMIT_CPU guard firing, which means the child did
            # not TERMINATE -- semantically the wall-clock `timeout` branch
            # above, not a fault.  Distinguishing them matters because these two
            # outcomes support opposite conclusions about libhdf5: a SIGSEGV or
            # SIGFPE is a memory-safety or arithmetic defect, a CPU-limit kill is
            # a non-termination (DoS) defect.  Reporting both as `crashed` made
            # them indistinguishable to every consumer of this JSON -- including
            # the expected-fixture matrix, where the reasoned override for a hang
            # then had to be written as if libhdf5 had crashed.
            # `--forbid crash` still covers this (it accepts crashed OR timeout),
            # so the violation and every allowed_statuses contract are unchanged;
            # only the diagnosis gets sharper.
            if -proc.returncode == signal.SIGXCPU:
                result.update(outcome="timeout", timed_out=True)
            else:
                result["outcome"] = "crashed"
            result["signal"] = -proc.returncode
        elif probe_json is None:
            result["outcome"] = "crashed"                  # died without valid JSON
            result["signal"] = result["signal"]
        elif probe_json["decision"] == "rejected":
            result["outcome"] = "rejected_at_open"
        elif probe_json["materialization"]["call_errors"] > 0:
            result["outcome"] = "rejected_in_traversal"
        else:
            result["outcome"] = "accepted"

        result["probe"] = probe_json
        result["activation"] = activation
        return result
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def main():
    ap = argparse.ArgumentParser(description="exact-build libhdf5 probe")
    ap.add_argument("file")
    ap.add_argument("--exercise", choices=("generic", "datatype", "dataspace", "dataset_layout",
                                             "btree", "address_space", "free_space",
                                             "chunk_index", "dense_index", "heap_structures",
                                             "shared_messages_legacy", "message_envelope", "legacy_messages", "cache_image", "external_link",
                                             "external_file_list", "virtual_dataset"),
                    default="generic", help="explicit registry canary")
    ap.add_argument("--hdf5-bindir", help="dir containing the h5cc of the build "
                    "under test (default: h5cc on PATH)")
    ap.add_argument("--forbid", default="",
                    help="comma list; nonzero exit if any occur: " +
                    ",".join(FORBIDDABLE))
    ap.add_argument("--json", action="store_true", help="emit the full result")
    ap.add_argument("--timeout", type=int, default=60)
    ap.add_argument("--cpu", type=int, default=30, help="RLIMIT_CPU seconds")
    ap.add_argument("--mem-mb", type=int, default=2048, help="RLIMIT_AS")
    ap.add_argument("--fsize-mb", type=int, default=64, help="RLIMIT_FSIZE")
    args = ap.parse_args()

    if not os.path.exists(args.file):
        _die_skip(f"no such file: {args.file}", args.json)
    h5cc = resolve_h5cc(args.hdf5_bindir)
    if not h5cc:
        _die_skip("h5cc not found (need --hdf5-bindir or h5cc on PATH)", args.json)

    ident = build_identity(h5cc)
    asan = is_asan(ident)
    probe, trace = ensure_built(h5cc, ident, args.json)

    result = probe_file(args.file, probe, trace, ident, args.timeout,
                        args.cpu, args.mem_mb, args.fsize_mb, args.exercise,
                        asan)
    # Authoritative linked identity comes from the probe (dladdr / H5get_libversion).
    if result.get("probe"):
        ident["libhdf5_version"] = result["probe"]["libhdf5_version"]
        ident["linked_library"] = result["probe"]["linked_library"]

    forbid = [f.strip() for f in args.forbid.split(",") if f.strip()]
    bad = [f for f in forbid if f not in FORBIDDABLE]
    if bad:
        _die_skip(f"unknown --forbid token(s): {','.join(bad)}", args.json)

    violations = []
    act = result.get("activation", {})
    for f in forbid:
        if f == "crash" and result["outcome"] in ("crashed", "timeout"):
            violations.append("crash")
        elif f in act and act[f]["count"] > 0:
            violations.append(f)

    out = {
        "tool": "h5policy-probe",
        "input": portable_path(args.file),
        "outcome": result["outcome"],
        "signal": result.get("signal"),
        "timed_out": result.get("timed_out", False),
        "build": portable_identity(ident),
        "probe": portable_probe(result.get("probe")),
        "activation": act,
        "forbid": forbid,
        "violations": violations,
        "limits": result.get("limits"),
    }
    if result.get("asan"):
        out["asan"] = portable_asan(result["asan"])
    if args.json:
        print(json.dumps(out, indent=2))
    else:
        v = f"  VIOLATIONS: {','.join(violations)}" if violations else ""
        a = f"  ASAN: {result['asan']['error']}" if result.get("asan") else ""
        san = " +asan" if asan else ""
        print(f"{result['outcome']:>22}  {os.path.basename(args.file)}  "
              f"[hdf5 {ident.get('libhdf5_version','?')}{san}]{v}{a}")
    sys.exit(2 if violations else 0)


if __name__ == "__main__":
    main()
