# ------------------------------------------------------------- families -------
# A family is a LOCATOR plus a recipe table, and the split is what lets one
# engine serve several record families.  The locator turns a seed into whatever
# context that family's recipes need, and raises when the seed does not carry the
# structure at all -- a plain dataset is not a continuation seed, and that is a
# skip, not an error.  Recipes never parse the file: they edit fields the locator
# already found and reseal what the locator says encloses them.
#
# `record` names the row in registry/validation-coverage.yml whose fuzz_targets
# block these recipes are the evidence for, so the two cannot drift silently.

FAMILIES = {
    "object_header_continuation": {
        "record": "object_header_continuation",
        "analyze": walk_chain,
        "recipes": RECIPES,
    },
    "heap_structures": {
        "record": "heap_structures",
        "analyze": locate_frhp,
        "recipes": FRHP_RECIPES,
    },
    # FOUR records for one locator, and `records` rather than `record` because
    # that is the whole point of this family: a BTHD is one structure whose
    # client id decides which record family owns the tree, while the geometry
    # fields belong to btree_heap_index's shared validator whatever the client
    # is.  Every row listed here carries these recipes in its `fuzz_targets`.
    "global_heap": {
        "records": ["virtual_dataset", "message_envelope"],
        "analyze": locate_gcol,
        "recipes": GCOL_RECIPES,
    },
    "free_space": {
        "record": "validation_controls",
        "analyze": locate_fsm,
        "recipes": FSM_RECIPES,
    },
    "v2_btree": {
        "records": ["btree_heap_index", "dense_index", "chunk_index",
                    "shared_messages_legacy"],
        "analyze": locate_bt2,
        "recipes": BT2_RECIPES,
    },
}

ALL_RECIPES = {name: (fn, inv, finding, family)
               for family, spec in FAMILIES.items()
               for name, (fn, inv, finding) in spec["recipes"].items()}


def _analyze(spec, raw):
    """Run a family's locator, or return None when the seed does not carry its
    structure.  Locators are allowed to fail in the ordinary parse ways."""
    try:
        return spec["analyze"](raw)
    except (ValueError, AssertionError, struct.error, IndexError, KeyError):
        return None


def sha256(b):
    return hashlib.sha256(b).hexdigest()


def apply_recipe(seed_bytes, name):
    fn, invariant, finding, family = ALL_RECIPES[name]
    raw = bytearray(seed_bytes)
    ctx = _analyze(FAMILIES[family], raw)
    if ctx is None:
        return None            # the seed does not carry this family's structure
    result = fn(raw, ctx)
    if result is None:
        return None
    changed, resealed, note = result
    sidecar = {
        "recipe": name,
        "family": family,
        "note": note,
        "parent_sha256": sha256(bytes(seed_bytes)),
        "mutant_sha256": sha256(bytes(raw)),
        "intended_invariant": invariant,
        "intended_finding": finding,
        "changed_ranges": changed,
        "resealed": [{"structure": s, "offset": o} for s, o in resealed],
    }
    return bytes(raw), sidecar


# ------------------------------------------------------------------ cli -------

def cmd_list(args):
    raw = bytearray(open(args.seed, "rb").read()) if args.seed else None
    for family, spec in FAMILIES.items():
        ctx = _analyze(spec, raw) if raw is not None else None
        head = f"# {family}"
        if raw is not None:
            head += "  (seed carries this structure)" if ctx is not None \
                    else "  (N/A: seed does not carry this structure)"
        print(head)
        for name, (fn, inv, finding) in spec["recipes"].items():
            note = ""
            # Applicability beyond "does the structure exist": a recipe that
            # needs more of it than this seed has returns None, and saying so
            # here is cheaper than a failed apply.
            if ctx is not None:
                probe = bytearray(raw)
                pctx = _analyze(spec, probe)
                if pctx is None or fn(probe, pctx) is None:
                    note = "  (N/A for this seed)"
            print(f"  {name:28} {inv:34} -> {finding}{note}")
    return 0


def cmd_apply(args):
    if args.recipe not in ALL_RECIPES:
        sys.exit(f"h5mutate: unknown recipe {args.recipe!r}")
    seed = open(args.seed, "rb").read()
    out = apply_recipe(seed, args.recipe)
    if out is None:
        sys.exit(f"h5mutate: recipe {args.recipe} not applicable to this seed")
    mutant, sidecar = out
    with open(args.out, "wb") as f:
        f.write(mutant)
    sc = args.sidecar or (args.out + ".recipe.yml")
    with open(sc, "w") as f:
        yaml.safe_dump(sidecar, f, sort_keys=False)
    print(f"{args.recipe}: wrote {os.path.relpath(args.out)} "
          f"(+ {os.path.relpath(sc)})")
    return 0


def _verify(mutant_path, expected_finding):
    try:
        p = subprocess.run([H5POLICY, "--profile", "untrusted-strict", "--json",
                            mutant_path], capture_output=True, text=True, timeout=60)
        codes = [f.get("code") for f in json.loads(p.stdout).get("findings", [])]
        return expected_finding in codes, codes
    except Exception as e:
        return False, [f"error: {e}"]


def cmd_family(args):
    seed = open(args.seed, "rb").read()
    os.makedirs(args.out_dir, exist_ok=True)
    rc = 0
    made = 0
    names = [n for n, (_, _, _, fam) in ALL_RECIPES.items()
             if args.family is None or fam == args.family]
    if args.family is not None and args.family not in FAMILIES:
        sys.exit(f"h5mutate: unknown family {args.family!r}; "
                 f"known: {', '.join(FAMILIES)}")
    for name in names:
        out = apply_recipe(seed, name)
        if out is None:
            print(f"{name:30} SKIP (not applicable to seed)")
            continue
        mutant, sidecar = out
        mpath = os.path.join(args.out_dir, name + ".h5")
        with open(mpath, "wb") as f:
            f.write(mutant)
        with open(mpath + ".recipe.yml", "w") as f:
            yaml.safe_dump(sidecar, f, sort_keys=False)
        made += 1
        if args.verify:
            ok, codes = _verify(mpath, sidecar["intended_finding"])
            status = "PASS" if ok else "FAIL"
            if not ok:
                rc = 1
            extra = "" if ok else f"  (got {codes})"
            print(f"{name:30} {status}  {sidecar['intended_finding']}{extra}")
        else:
            print(f"{name:30} wrote  {sidecar['intended_finding']}")
    print(f"\n{made} mutant(s) in {os.path.relpath(args.out_dir)}"
          + ("  [--verify]" if args.verify else ""))
    return rc


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list", help="list recipes (and applicability to a seed)")
    p.add_argument("--seed")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("apply", help="apply one recipe")
    p.add_argument("--seed", required=True)
    p.add_argument("--recipe", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--sidecar")
    p.set_defaults(fn=cmd_apply)

    p = sub.add_parser("family", help="generate every applicable recipe")
    p.add_argument("--seed", required=True)
    p.add_argument("--out-dir", required=True)
    p.add_argument("--verify", action="store_true",
                   help="assert each mutant triggers its intended h5policy finding")
    p.add_argument("--family", help="restrict to one family (default: all)")
    p.set_defaults(fn=cmd_family)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
