# ----------------------------------------------------------- superblock -------
# Every locator needs the file's offset and length widths, and they live in the
# superblock -- which is NOT necessarily at byte 0.  A user block pushes it to
# 512, 1024 or beyond, and reading the widths from fixed offsets 9 and 10 then
# reads user-block bytes instead: measured 0/0 on valid/userblock_latest.h5,
# whose real widths are 8/8.  Every derived field offset is then wrong.  The
# self-validating design caught it (the heap family failed verification with a
# bad checksum rather than mutating the wrong field silently), but a locator
# that cannot read a userblock seed at all is a coverage hole, not a design
# feature.
H5_SIGNATURE = b"\x89HDF\r\n\x1a\n"


def superblock_offset(raw):
    """Where the superblock actually starts.  The format allows it only at
    byte 0 or at a power-of-two user-block boundary from 512 up, so a signature
    hit elsewhere is payload, not a superblock."""
    off = raw.find(H5_SIGNATURE)
    if off < 0:
        raise ValueError("no HDF5 signature in this seed")
    if off != 0 and (off < 512 or off & (off - 1)):
        raise ValueError(f"HDF5 signature at {off} is not a user-block boundary")
    return off


def superblock_widths(raw):
    """(size_of_offsets, size_of_lengths), read from the real superblock.

    The two widths move with the superblock VERSION, which is the second thing
    that makes them easy to read from the wrong place.  Versions 0 and 1 carry
    four more version bytes first -- free-space, root symbol-table entry,
    reserved, shared-header-message -- and put the widths at +13/+14; versions
    2 and 3 dropped those and put them at +9/+10.  Reading the v2 offsets from
    a v0 superblock yields (0, 0): offset 10 there is the root symbol-table
    entry version.  20 of the 64 seeds in tests/valid are v0, so this is the
    common case, not a legacy corner -- and a zero width silently collapses
    every derived field offset to the head of the structure.
    """
    sb = superblock_offset(raw)
    version = raw[sb + 8]
    if version in (0, 1):
        return raw[sb + 13], raw[sb + 14]
    if version in (2, 3):
        return raw[sb + 9], raw[sb + 10]
    raise ValueError(f"unsupported superblock version {version}")


# --------------------------------------------------------------- reseal -------

def reseal_superblock(raw):
    sb = superblock_offset(raw)
    soff = raw[sb + 9]
    off = sb + 12 + 4 * soff
    struct.pack_into("<I", raw, off, JENKINS(bytes(raw[sb:off])))
    return ("superblock", sb)


def reseal_v2_ohdr(raw, off):
    assert raw[off:off + 4] == b"OHDR" and raw[off + 4] == 2
    flags = raw[off + 5]
    cur = off + 6 + (16 if flags & (1 << 5) else 0) + (4 if flags & (1 << 4) else 0)
    sw = 1 << (flags & 3)
    csize = int.from_bytes(raw[cur:cur + sw], "little")
    coff = cur + sw + csize
    struct.pack_into("<I", raw, coff, JENKINS(bytes(raw[off:coff])))
    return ("OHDR", off)


def reseal_ochk(raw, off, size):
    assert raw[off:off + 4] == b"OCHK"
    coff = off + size - 4
    struct.pack_into("<I", raw, coff, JENKINS(bytes(raw[off:coff])))
    return ("OCHK", off)


# --------------------------------------------------------------- parse --------

def superblock(raw):
    sb = superblock_offset(raw)
    if raw[sb + 8] not in (2, 3):
        raise ValueError("only v2/v3 superblocks are supported")
    soff, loff = raw[sb + 9], raw[sb + 10]
    # Stored addresses are relative to the superblock's own base, so a
    # user-block file needs the base added to reach a physical offset.
    root_off = sb + int.from_bytes(
        raw[sb + 12 + 3 * soff:sb + 12 + 3 * soff + soff], "little")
    return root_off, soff, loff


def _conts_in_region(raw, mstart, mend, prefix, soff, loff):
    """Every object-header continuation message (type 0x10) in [mstart, mend),
    as (addr_field_off, size_field_off, target_addr, target_size)."""
    out, i = [], mstart
    while i + prefix <= mend:
        mtype = raw[i]
        msize = struct.unpack_from("<H", raw, i + 1)[0]
        payload = i + prefix
        if mtype == 0x10:
            a = int.from_bytes(raw[payload:payload + soff], "little")
            l = int.from_bytes(raw[payload + soff:payload + soff + loff], "little")
            out.append((payload, payload + soff, a, l))
        i = payload + msize
    return out


def parse_chunk(raw, off, size, is_ochk, root_flags, soff, loff):
    """Return (phys_lo, phys_hi, conts).  For a v2 OCHK the physical size is not
    self-describing, so it is taken from the parent continuation message."""
    prefix = 4 + (2 if root_flags & 0x04 else 0)
    if is_ochk:
        assert raw[off:off + 4] == b"OCHK", "not an OCHK chunk"
        mstart, mend, phys_hi = off + 4, off + size - 4, off + size
    else:
        flags = raw[off + 5]
        cur = off + 6 + (16 if flags & (1 << 5) else 0) + (4 if flags & (1 << 4) else 0)
        sw = 1 << (flags & 3)
        csize = int.from_bytes(raw[cur:cur + sw], "little")
        mstart = cur + sw
        mend = mstart + csize
        phys_hi = mend + 4                         # trailing checksum
    conts = _conts_in_region(raw, mstart, mend, prefix, soff, loff)
    return off, phys_hi, conts


def walk_chain(raw):
    """Follow root -> continuation -> continuation..., returning the ordered
    edges and the root's flags/extent.  Each edge is the continuation message in
    one chunk pointing at the next."""
    root_off, soff, loff = superblock(raw)
    if raw[root_off:root_off + 4] != b"OHDR" or raw[root_off + 4] != 2:
        raise ValueError("root object header is not v2 OHDR")
    root_flags = raw[root_off + 5]

    edges = []
    off, size, is_ochk = root_off, None, False
    root_phys = None
    seen = set()
    while True:
        lo, hi, conts = parse_chunk(raw, off, size, is_ochk, root_flags, soff, loff)
        if root_phys is None:
            root_phys = (lo, hi)
        if not conts or off in seen:
            break
        seen.add(off)
        addr_off, size_off, taddr, tsize = conts[0]
        edges.append({"chunk_off": off, "is_ochk": is_ochk, "chunk_size": size,
                      "addr_field_off": addr_off, "size_field_off": size_off,
                      "target_addr": taddr, "target_size": tsize})
        off, size, is_ochk = taddr, tsize, True
    return {"root_off": root_off, "soff": soff, "loff": loff,
            "root_flags": root_flags, "root_phys": root_phys, "edges": edges}


# -------------------------------------------------------------- recipes -------

def _set_uint(raw, off, width, value):
    old = bytes(raw[off:off + width])
    raw[off:off + width] = value.to_bytes(width, "little")
    return {"offset": off, "length": width, "old": old.hex(),
            "new": bytes(raw[off:off + width]).hex()}


def _reseal_edge_chunk(raw, edge):
    if edge["is_ochk"]:
        return reseal_ochk(raw, edge["chunk_off"], edge["chunk_size"])
    return reseal_v2_ohdr(raw, edge["chunk_off"])


def _retarget_root(raw, ch, new_addr):
    """Repoint the root's first continuation to new_addr, resealing the OHDR."""
    e = ch["edges"][0]
    ch_change = _set_uint(raw, e["addr_field_off"], ch["soff"], new_addr)
    resealed = [reseal_v2_ohdr(raw, ch["root_off"])]
    return [ch_change], resealed


# Every root-retargeting recipe needs at least one continuation edge; a seed
# without a continuation chain (e.g. a plain dataset or an EFL file) is simply
# not applicable, and returns None rather than raising.

def recipe_overlap_source_start(raw, ch):
    if not ch["edges"]:
        return None
    changed, resealed = _retarget_root(raw, ch, ch["root_off"])
    return changed, resealed, "continuation target == source chunk start"


def recipe_overlap_source_inside(raw, ch):
    if not ch["edges"]:
        return None
    changed, resealed = _retarget_root(raw, ch, ch["root_off"] + 4)
    return changed, resealed, "continuation target a few bytes inside the source chunk"


def recipe_overlap_source_end(raw, ch):
    if not ch["edges"]:
        return None
    changed, resealed = _retarget_root(raw, ch, ch["root_phys"][1] - 1)
    return changed, resealed, "continuation target on the source chunk's last byte"


def recipe_zero_size(raw, ch):
    if not ch["edges"]:
        return None
    e = ch["edges"][0]
    changed = [_set_uint(raw, e["size_field_off"], ch["loff"], 0)]
    resealed = [reseal_v2_ohdr(raw, ch["root_off"])]
    return changed, resealed, "continuation with zero declared size"


def recipe_out_of_file(raw, ch):
    if not ch["edges"]:
        return None
    changed, resealed = _retarget_root(raw, ch, len(raw) + 4096)
    return changed, resealed, "continuation target past end of file"


def recipe_alias_prior_chunk(raw, ch):
    """Point the deepest continuation back onto the FIRST continuation chunk,
    which is already decoded and disjoint from the current source -- an alias,
    not a self-overlap."""
    edges = ch["edges"]
    if len(edges) < 3:
        return None
    last, first_target = edges[-1], edges[0]["target_addr"]
    changed = [_set_uint(raw, last["addr_field_off"], ch["soff"], first_target)]
    resealed = [_reseal_edge_chunk(raw, last)]
    return changed, resealed, "continuation aliases an already-decoded chunk"


# ---- fractal-heap doubling table (heap_structures) --------------------------
# The second family, and the one that made the engine's shape general: its
# locator finds a structure by signature rather than by walking a chain from the
# superblock, and its reseal is a single trailing checksum rather than an
# enclosing object header.  Nothing in the continuation family had to change to
# accommodate it, which is the property the split exists to give.

def reseal_frhp(raw, off, chksum_off):
    struct.pack_into("<I", raw, chksum_off, JENKINS(bytes(raw[off:chksum_off])))
    return ("FRHP", off)


def locate_frhp(raw):
    """The first fractal-heap header, with the offsets of its doubling-table
    fields and its own trailing checksum.

    Field order is the format's (pickles/fheap.pk fheap_hdr): a fixed 14-byte
    prefix, ten length-sized and two offset-sized counters, then the doubling
    table.  A filtered heap carries three more fields before the checksum, so
    the checksum offset is computed rather than assumed.
    """
    off = raw.find(b"FRHP")
    if off < 0:
        raise ValueError("no fractal-heap header in this seed")
    if raw[off + 4] != 0:
        raise ValueError("unsupported fractal-heap header version")
    soff, loff = superblock_widths(raw)
    filter_len = struct.unpack_from("<H", raw, off + 7)[0]
    dtable = off + 14 + (10 * loff) + (2 * soff)
    body = 14 + (2 * soff) + (10 * loff) + (8 + 2 * loff + soff)
    if filter_len:
        body += loff + 4 + filter_len
    chksum = off + body
    if chksum + 4 > len(raw):
        raise ValueError("fractal-heap header runs past the seed")
    width = struct.unpack_from("<H", raw, dtable)[0]
    start = int.from_bytes(raw[dtable + 2:dtable + 2 + loff], "little")
    return {
        "off": off, "soff": soff, "loff": loff, "chksum": chksum,
        "width_off": dtable, "start_off": dtable + 2,
        "max_direct_off": dtable + 2 + loff,
        "max_heap_bits_off": dtable + 2 + 2 * loff,
        "width": width, "start": start,
    }


def _frhp_edit(raw, fh, off, width, value):
    changed = [_set_uint(raw, off, width, value)]
    return changed, [reseal_frhp(raw, fh["off"], fh["chksum"])]


def _log2_exact(n):
    """floor(log2(n)); the caller only uses it on powers of two."""
    b = -1
    while n:
        n >>= 1
        b += 1
    return b


def recipe_frhp_width_zero(raw, fh):
    changed, resealed = _frhp_edit(raw, fh, fh["width_off"], 2, 0)
    return changed, resealed, "doubling-table width of zero"


def recipe_frhp_width_not_power_of_two(raw, fh):
    changed, resealed = _frhp_edit(raw, fh, fh["width_off"], 2, 3)
    return changed, resealed, "doubling-table width of 3, which is not a power of two"


def _first_row_bits(fh):
    """Bits addressed by the doubling table's first row: log2(start block size)
    + log2(width).  libhdf5 derives max_root_rows by subtracting this from the
    declared maximum heap size in bits, so a declared size below it underflows
    (H5HFdtable.c)."""
    if fh["width"] == 0 or fh["start"] == 0:
        return None
    return _log2_exact(fh["start"]) + _log2_exact(fh["width"])


def recipe_frhp_no_root_rows(raw, fh):
    bits = _first_row_bits(fh)
    if bits is None or bits < 1:
        return None
    changed, resealed = _frhp_edit(raw, fh, fh["max_heap_bits_off"], 2, bits - 1)
    return changed, resealed, "declared heap size exactly one bit under the first row"


def recipe_frhp_first_row_overflow(raw, fh):
    bits = _first_row_bits(fh)
    if bits is None or bits < 2:
        return None
    changed, resealed = _frhp_edit(raw, fh, fh["max_heap_bits_off"], 2, bits - 2)
    return changed, resealed, "declared heap size two bits under the first row, wrapping max_root_rows"


# NOT A RECIPE: a start block size of one byte (below a direct block's own
# prefix) was tried and REJECTED as unsound for this engine.  Measured on four
# heap-bearing seeds -- valid/dense_links.h5, valid/dense_attribute.h5,
# valid/sohm_btree.h5, coverage/sohm_huge_btree.h5 -- it never produced the
# intended H5_CORRUPT_LENGTH_OVERFLOW: the dense seeds reject it as
# H5_CORRUPT_FRACTAL_HEAP_ID instead, because every heap ID becomes unresolvable
# before any extent is measured, and the SOHM seed does not reject it at all --
# the resolver reports a coverage gap.  The field is consumed by several checks
# whose order depends on the seed, so no single intended finding is a sound
# contract for it, which is exactly what a typed recipe has to promise.  The
# committed malformed/dblock_size_below_floor.h5 fixture stays the right
# instrument for that invariant, because it pins one base file.


# ---- version-2 B-tree header (btree_heap_index and its three clients) -------
# The third family, and the first whose ONE locator serves several record
# families.  A BTHD is signature-findable with a single trailing checksum, the
# same shape as FRHP, but the structure is shared: the client id in the header
# selects which of dense_index / chunk_index / shared_messages_legacy owns the
# tree, while the geometry fields (node_size, record_size) belong to
# btree_heap_index's shared validator whatever the client is.
#
# The locator ENUMERATES rather than taking the first match, which FRHP can get
# away with and this cannot.  valid/sohm_btree.h5 carries a type-5 dense-link
# header BEFORE its type-7 SOHM root, so a first-match locator would edit the
# dense-link tree while the sidecar claimed a SOHM target -- a recipe recording
# an intent it did not carry out.

# Client ids (H5B2_subid_t order, src/H5B2pkg.h).  Only the ids the corpus
# actually carries are named; a recipe that needs to pick a WRONG client for a
# located header uses the neighbour table below.
BT2_CLIENT_NAMES = {
    0: "test", 1: "huge_indirect", 2: "huge_indirect_filtered",
    3: "huge_direct", 4: "huge_direct_filtered", 5: "grp_dense_name",
    6: "grp_dense_corder", 7: "sohm_index", 8: "attr_dense_name",
    9: "attr_dense_corder", 10: "chunk_filtered", 11: "chunk_non_filtered",
}
# A wrong-but-in-range client for each id we can locate.  In range matters: the
# point of the invariant is that libhdf5 range-checks the id against the NUMBER
# of B-tree types and never against the client the caller opened the tree as,
# so the FILE picks the class.  An out-of-range id would be caught by the range
# check instead and prove nothing.
# MEASURED, not assumed: the swap has to keep the RECORD WIDTH the same, or the
# mismatch is caught as a record-layout error before the client confusion is
# reached.  Name<->creation-order pairs keep it; the filtered<->non-filtered
# chunk pair does not, because a filtered chunk record carries extra fields.
# Verified on valid/dense_links.h5 (5), valid/dense_attribute.h5 (8) and
# valid/sohm_btree.h5, where this emits H5_CORRUPT_V2_BTREE_RECORD_TYPE, and on
# valid/chunk_v2_btree.h5 (10), where it emitted H5_CORRUPT_V2_BTREE_RECORD_LAYOUT
# instead -- which is why the chunk pair is `bt2_chunk_client_swap` below.
BT2_WRONG_CLIENT = {5: 6, 6: 5, 7: 5, 8: 9, 9: 8}
BT2_CHUNK_CLIENT = {10: 11, 11: 10}

# Leaf node overhead: 4 signature + 1 version + 1 type + 4 checksum.
BT2_LEAF_OVERHEAD = 10


def reseal_bt2_hdr(raw, off, chksum_off):
    struct.pack_into("<I", raw, chksum_off, JENKINS(bytes(raw[off:chksum_off])))
    return ("BTHD", off)


def locate_bt2(raw):
    """Every v2 B-tree header in the seed, with its field offsets.

    Field order is the format's (pickles/v2_btree.pk bt2_hdr): signature,
    version, record type, node size, record size, depth, split and merge
    percents, root address, root record count, total record count, checksum.
    """
    soff, loff = superblock_widths(raw)
    headers, at = [], 0
    while True:
        off = raw.find(b"BTHD", at)
        if off < 0:
            break
        at = off + 4
        if off + 16 + soff + 2 + loff + 4 > len(raw) or raw[off + 4] != 0:
            continue        # not a v0 header, or runs past the seed
        root_off = off + 16
        nrr_off = root_off + soff
        total_off = nrr_off + 2
        chksum_off = total_off + loff
        h = {
            "off": off, "soff": soff, "loff": loff,
            "record_type": raw[off + 5],
            "node_size_off": off + 6,
            "record_size_off": off + 10,
            "depth_off": off + 12,
            "root_addr_off": root_off,
            "num_root_records_off": nrr_off,
            "total_nrec_off": total_off,
            "chksum": chksum_off,
            "node_size": struct.unpack_from("<I", raw, off + 6)[0],
            "record_size": struct.unpack_from("<H", raw, off + 10)[0],
            "depth": struct.unpack_from("<H", raw, off + 12)[0],
            "num_root_records": struct.unpack_from("<H", raw, nrr_off)[0],
        }
        # A stored checksum that does not verify means this is not a header we
        # can edit and reseal honestly -- most likely a false signature hit
        # inside payload.  Skip it rather than corrupt an unrelated span.
        if struct.unpack_from("<I", raw, chksum_off)[0] != JENKINS(
                bytes(raw[off:chksum_off])):
            continue
        headers.append(h)
    if not headers:
        raise ValueError("no v2 B-tree header in this seed")
    return {"headers": headers, "soff": soff, "loff": loff}


def _bt2_pick(ctx, clients=None):
    """The first located header, optionally restricted to given client ids."""
    for h in ctx["headers"]:
        if clients is None or h["record_type"] in clients:
            return h
    return None


def _bt2_edit(raw, h, off, width, value):
    changed = [_set_uint(raw, off, width, value)]
    return changed, [reseal_bt2_hdr(raw, h["off"], h["chksum"])]


def recipe_bt2_node_size_over_file(raw, ctx):
    h = _bt2_pick(ctx)
    changed, resealed = _bt2_edit(raw, h, h["node_size_off"], 4, 0xFFFFFFFF)
    return changed, resealed, (
        f"node size 0xFFFFFFFF on the {BT2_CLIENT_NAMES.get(h['record_type'], '?')} "
        f"tree, against a {len(raw)}-byte file")


def recipe_bt2_node_size_below_overhead(raw, ctx):
    """A node too small to hold even its own framing, so leaf capacity is
    zero.  The lower half of the geometry rule, where the oversize recipe above
    is the upper."""
    h = _bt2_pick(ctx)
    changed, resealed = _bt2_edit(raw, h, h["node_size_off"], 4,
                                  BT2_LEAF_OVERHEAD)
    return changed, resealed, (
        f"node size {BT2_LEAF_OVERHEAD}, exactly the leaf framing, leaving "
        f"room for zero records")


def recipe_bt2_record_size_zero(raw, ctx):
    h = _bt2_pick(ctx)
    changed, resealed = _bt2_edit(raw, h, h["record_size_off"], 2, 0)
    return changed, resealed, "record size of zero"


def recipe_bt2_wrong_client(raw, ctx):
    """An in-range client id that is not the one the caller opened the tree as.
    In range on purpose: libhdf5 checks the id against the NUMBER of types and
    then lets the FILE pick the class, so an out-of-range id would be caught by
    the range check and prove nothing about the confusion."""
    h = _bt2_pick(ctx, clients=set(BT2_WRONG_CLIENT))
    if h is None:
        return None
    wrong = BT2_WRONG_CLIENT[h["record_type"]]
    changed = [_set_uint(raw, h["off"] + 5, 1, wrong)]
    resealed = [reseal_bt2_hdr(raw, h["off"], h["chksum"])]
    return changed, resealed, (
        f"client id {wrong} ({BT2_CLIENT_NAMES[wrong]}) on a tree opened as "
        f"{h['record_type']} ({BT2_CLIENT_NAMES[h['record_type']]})")


def recipe_bt2_root_addr_out_of_file(raw, ctx):
    h = _bt2_pick(ctx)
    changed, resealed = _bt2_edit(raw, h, h["root_addr_off"], h["soff"],
                                  len(raw) + 4096)
    return changed, resealed, "root node address past the end of file"


def recipe_bt2_chunk_client_swap(raw, ctx):
    """The chunk pair of the client confusion: filtered <-> non-filtered.  Its
    own recipe because the two record layouts differ in width, so the layout
    check fires before the client mismatch -- a different finding, promised
    separately rather than folded into `bt2_wrong_client`."""
    h = _bt2_pick(ctx, clients=set(BT2_CHUNK_CLIENT))
    if h is None:
        return None
    wrong = BT2_CHUNK_CLIENT[h["record_type"]]
    changed = [_set_uint(raw, h["off"] + 5, 1, wrong)]
    resealed = [reseal_bt2_hdr(raw, h["off"], h["chksum"])]
    return changed, resealed, (
        f"chunk client id {wrong} ({BT2_CLIENT_NAMES[wrong]}) on a tree whose "
        f"records are laid out for {h['record_type']} "
        f"({BT2_CLIENT_NAMES[h['record_type']]})")


def recipe_bt2_depth_inflated(raw, ctx):
    """A declared depth far above the real tree.  The intended finding is the
    RESOURCE one on purpose: measured on four seeds, the profile's depth ceiling
    is reached before any geometry check, so this recipe pins that the ceiling
    pre-empts the descent rather than pinning a corruption rule.  It is
    therefore the one recipe here whose contract depends on a profile setting,
    which is why the dependency is stated instead of discovered later."""
    h = _bt2_pick(ctx)
    changed, resealed = _bt2_edit(raw, h, h["depth_off"], 2, 0xFFFF)
    return changed, resealed, "declared depth of 65535"


# The total-record-count recipes.  These were WITHDRAWN on 2026-09-03 and
# reinstated the same day, and the round trip is the point: the first version
# used zero, produced three different outcomes across seeds, and could not
# promise one finding.  Two of those outcomes were ACCEPT -- a false accept in
# which the name-index walkers never compared the header's total against their
# own tree, because the rule was emitted from exactly one site in the oracle
# (the creation-order walker).  Chasing the inflated direction then showed the
# accept was memory-unsafe in libhdf5, not merely a detection gap:
# H5O__linfo_decode sets linfo->nlinks = HSIZET_MAX unconditionally and
# H5G__obj_get_linfo fills it from H5B2_get_nrec, so this field alone sizes the
# link table that the tree walk fills, and n+1 segfaults while n-1 corrupts the
# heap.  See registry/cases/v2-btree-total-nrec-unchecked-in-name-walker.yml.
# Both name walkers now enforce it, so the promise is sound and all three
# values are recipes.  Zero is kept even though it is the one value libhdf5
# survives -- it is the value a naive mutator reaches first, and it is the
# regression guard for the walkers' `valid` sentinel.

# The dense NAME indexes, whose walkers enforce the total-count rule and whose
# header field sizes libhdf5's link table.  Restricted deliberately: the CHUNK
# v2-B-tree carries the same field, but measured on valid/chunk_v2_btree_deep.h5
# the same edit produces H5_CORRUPT_V2_BTREE_ROOT_COUNT on one chunk seed, no
# finding at all on the other, and NO consequence in libhdf5 -- h5dump -d reads
# the dataset at rc=0 for n+1, n-1 and the base alike.  A chunk index's total
# count is not load-bearing for reads, so a recipe promising one finding across
# both client families would be promising something untrue.
BT2_DENSE_NAME_CLIENTS = {5, 8}


def _bt2_total_edit(raw, ctx, delta):
    h = _bt2_pick(ctx, clients=BT2_DENSE_NAME_CLIENTS)
    if h is None or h["num_root_records"] == 0:
        return None
    stored = int.from_bytes(
        raw[h["total_nrec_off"]:h["total_nrec_off"] + h["loff"]], "little")
    value = 0 if delta is None else stored + delta
    if value < 0:
        return None
    changed, resealed = _bt2_edit(raw, h, h["total_nrec_off"], h["loff"], value)
    return changed, resealed, (
        f"total record count {stored} -> {value} against a tree holding "
        f"{stored}")


def recipe_bt2_total_nrec_zero(raw, ctx):
    """Zero: libhdf5 skips the allocation entirely and reports an empty index,
    so this is the benign value and the one that hides records rather than
    faulting."""
    return _bt2_total_edit(raw, ctx, None)


def recipe_bt2_total_nrec_plus_one(raw, ctx):
    """n+1: the link table gets a slot the walk never fills, and the sort
    comparator dereferences its NULL name.  Stock libhdf5 SIGSEGVs."""
    return _bt2_total_edit(raw, ctx, +1)


def recipe_bt2_total_nrec_minus_one(raw, ctx):
