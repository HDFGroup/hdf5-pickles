load h5_policy;

var message_failures = 0;

fun expect_message = (string name, int cond) void:
{
    if (cond)
        printf("PASS %s\n", name);
    else
        {
            printf("FAIL %s\n", name);
            message_failures = message_failures + 1;
        }
}

fun message_has_code = (string code) int:
{
    var i = 0UL;
    while (i < h5policy_finding_codes'length as uint<64>)
        {
            if (h5policy_finding_codes[i] == code)
                return 1;
            i = i + 1UL;
        }
    return 0;
}

fun run_message_blob = (uint<64> message_type, byte[] blob,
                        string object) void:
{
    var ios = open("*unit-message*");
    byte[blob'length] @ ios : 0#B = blob;
    h5policy_reset_findings;
    var ctx = h5policy_new_walk_context;
    ctx = h5policy_validate_message_payload(
        ios, H5_UNTRUSTED_STRICT, ctx, message_type, 0UB,
        0#B, blob'length as uint<64>, object);
    close(ios);
}

fun run_linfo_blob = (byte[] blob) void:
{
    var ios = open("*unit-linfo*");
    byte[blob'length] @ ios : 0#B = blob;
    h5policy_reset_findings;
    var ctx = h5policy_new_walk_context;
    ctx = h5policy_validate_linfo_payload(
        ios, H5_UNTRUSTED_STRICT, ctx, 0#B,
        blob'length as uint<64>, "/g");
    close(ios);
}

fun run_ainfo_blob = (byte[] blob) void:
{
    var ios = open("*unit-ainfo*");
    byte[blob'length] @ ios : 0#B = blob;
    h5policy_reset_findings;
    var ctx = h5policy_new_walk_context;
    ctx = h5policy_validate_ainfo_payload(
        ios, H5_UNTRUSTED_STRICT, ctx, 0#B,
        blob'length as uint<64>, "/d");
    close(ios);
}

fun run_shared_blob = (uint<64> message_type, byte[] blob,
                       string object) H5PolicyMsgRef:
{
    var ios = open("*unit-shared*");
    byte[blob'length] @ ios : 0#B = blob;
    h5policy_reset_findings;
    var ref = h5policy_resolve_shared_message(
        ios, H5_UNTRUSTED_STRICT, message_type, 0#B,
        blob'length as uint<64>, object);
    close(ios);
    return ref;
}

set_global_sizeof_offsets(4UB);
set_global_sizeof_lengths(4UB);

/* Old mtime is ASCII YYYYMMDDhhmmss plus two reserved bytes. */
var OLD_MTIME = [0x32UB, 0x30UB, 0x32UB, 0x36UB,
                 0x30UB, 0x37UB, 0x31UB, 0x38UB,
                 0x31UB, 0x36UB, 0x30UB, 0x35UB,
                 0x30UB, 0x39UB, 0UB, 0UB];
run_message_blob(0x0eUL, OLD_MTIME, "/u");
expect_message("old_mtime_ascii_envelope_is_accepted",
               h5policy_finding_codes'length == 0);

var OLD_MTIME_BAD = OLD_MTIME;
OLD_MTIME_BAD[8] = 0x78UB;
run_message_blob(0x0eUL, OLD_MTIME_BAD, "/u");
expect_message("old_mtime_rejects_non_decimal_timestamp",
               message_has_code("H5_CORRUPT_OLD_MTIME_FORMAT"));

run_message_blob(0x12UL,
                 [1UB, 0UB, 0UB, 0UB, 0x78UB, 0x56UB, 0x34UB, 0x12UB],
                 "/u");
expect_message("new_mtime_envelope_is_accepted",
               h5policy_finding_codes'length == 0);
run_message_blob(0x12UL,
                 [1UB, 1UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB], "/u");
expect_message("new_mtime_rejects_reserved_bytes",
               message_has_code("H5_CORRUPT_MTIME_RESERVED"));

h5policy_super_indexed_internal_k = 32UL;
h5policy_super_stab_internal_k = 16UL;
h5policy_super_stab_leaf_k = 4UL;
run_message_blob(0x13UL,
                 [0UB, 9UB, 0UB, 7UB, 0UB, 5UB, 0UB],
                 "/<superblock-extension>");
expect_message("btreek_updates_all_three_file_defaults",
               h5policy_finding_codes'length == 0
               && h5policy_super_indexed_internal_k == 9UL
               && h5policy_super_stab_internal_k == 7UL
               && h5policy_super_stab_leaf_k == 5UL);
run_message_blob(0x13UL,
                 [0UB, 0UB, 0UB, 7UB, 0UB, 5UB, 0UB],
                 "/<superblock-extension>");
expect_message("btreek_rejects_zero_k",
               message_has_code("H5_CORRUPT_BTREEK_VALUE"));

/* version, 8-byte VFD name, u16 body size, one opaque body byte */
run_message_blob(0x14UL,
                 [0UB, 0x54UB, 0x45UB, 0x53UB, 0x54UB,
                  0x44UB, 0x52UB, 0x56UB, 0x52UB,
                  1UB, 0UB, 0UB],
                 "/<superblock-extension>");
expect_message("driver_info_is_explicit_coverage_refusal",
               message_has_code("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP")
               && !message_has_code("H5_CORRUPT_DRVINFO_LENGTH"));
run_message_blob(0x14UL,
                 [0UB, 0x54UB, 0x45UB, 0x53UB, 0x54UB,
                  0x44UB, 0x52UB, 0x56UB, 0x52UB,
                  2UB, 0UB, 0UB],
                 "/<superblock-extension>");
expect_message("driver_info_rejects_body_length_mismatch",
               message_has_code("H5_CORRUPT_DRVINFO_LENGTH")
               && !message_has_code("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP"));

run_message_blob(0x18UL,
                 [0UB,
                  0xffUB, 0xffUB, 0xffUB, 0xffUB,
                  0UB, 0UB, 0UB, 0UB],
                 "/<superblock-extension>");
expect_message("cache_image_undef_address_is_accepted",
               h5policy_finding_codes'length == 0);

run_message_blob(0x16UL, [0UB, 2UB, 0UB, 0UB, 0UB], "/u");
expect_message("reference_count_envelope_is_accepted",
               h5policy_finding_codes'length == 0);
run_message_blob(0x16UL, [1UB, 2UB, 0UB, 0UB, 0UB], "/u");
expect_message("reference_count_rejects_unknown_version",
               message_has_code("H5_CORRUPT_UNSUPPORTED_REFCOUNT_VERSION"));

var SHARED_OHDR_OOB = [1UB, 0UB, 0UB, 0UB,
                       0UB, 0UB, 0UB, 0UB,
                       0UB, 0UB, 0UB, 0UB,
                       0x40UB, 0UB, 0UB, 0UB];
var shared_oob = run_shared_blob(0x08UL, SHARED_OHDR_OOB, "/d");
expect_message("shared_committed_header_oob_is_corrupt_not_gap",
               shared_oob.found == 0UB
               && h5policy_finding_codes'length == 1UL
               && h5policy_finding_classes[0UL] == "corrupt"
               && !message_has_code("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP")
               && !message_has_code("H5_CORRUPT_SHARED_MESSAGE_TOO_SMALL"));

var SHARED_OHDR_MISS = [1UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0x20UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        1UB, 0UB, 1UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        8UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB,
                        0UB, 0UB, 0UB, 0UB];
var shared_miss = run_shared_blob(0x08UL, SHARED_OHDR_MISS, "/d");
expect_message("shared_committed_header_in_bounds_miss_is_corrupt",
               shared_miss.found == 0UB
               && message_has_code("H5_CORRUPT_SHARED_MESSAGE_TARGET_TYPE")
               && !message_has_code("H5_CORRUPT_OFFSET_OUT_OF_FILE"));

var SHARED_OHDR_SELF_CYCLE = [2UB, 2UB, 0x20UB, 0UB, 0UB, 0UB,
                              0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
                              0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
                              0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
                              0UB, 0UB, 0UB, 0UB, 0UB, 0UB,
                              0UB, 0UB,
                              0x4fUB, 0x48UB, 0x44UB, 0x52UB,
                              2UB, 0UB, 10UB,
                              0x08UB, 6UB, 0UB, 0x02UB,
                              2UB, 2UB, 0x20UB, 0UB, 0UB, 0UB,
                              0UB, 0UB, 0UB, 0UB];
var shared_cycle = run_shared_blob(0x08UL, SHARED_OHDR_SELF_CYCLE, "/d");
expect_message("shared_committed_header_self_cycle_is_corrupt_not_gap",
               shared_cycle.found == 0UB
               && message_has_code("H5_CORRUPT_SHARED_MESSAGE_CYCLE")
               && !message_has_code("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP"));

var SHARED_BAD_LOCATION = [3UB, 0xe8UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var shared_bad_location = run_shared_blob(0x08UL, SHARED_BAD_LOCATION, "/d");
expect_message("shared_message_invalid_location_is_corrupt",
               shared_bad_location.found == 0UB
               && message_has_code("H5_CORRUPT_SHARED_MESSAGE_LOCATION")
               && !message_has_code("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP"));

/* LINFO/AINFO share the version/flags and paired dense-storage addresses. */
var DENSE_INFO_EMPTY = [0UB, 0UB,
                        0xffUB, 0xffUB, 0xffUB, 0xffUB,
                        0xffUB, 0xffUB, 0xffUB, 0xffUB];
run_linfo_blob(DENSE_INFO_EMPTY);
expect_message("link_info_empty_envelope_is_accepted",
               h5policy_finding_codes'length == 0);
run_ainfo_blob(DENSE_INFO_EMPTY);
expect_message("attribute_info_empty_envelope_is_accepted",
               h5policy_finding_codes'length == 0);

var DENSE_INFO_INDEX_WITHOUT_TRACK =
    [0UB, 2UB,
     0xffUB, 0xffUB, 0xffUB, 0xffUB,
     0xffUB, 0xffUB, 0xffUB, 0xffUB,
     0xffUB, 0xffUB, 0xffUB, 0xffUB];
run_linfo_blob(DENSE_INFO_INDEX_WITHOUT_TRACK);
expect_message("link_info_index_requires_tracking",
               message_has_code("H5_CORRUPT_LINK_INFO_FLAGS"));
run_ainfo_blob(DENSE_INFO_INDEX_WITHOUT_TRACK);
expect_message("attribute_info_index_requires_tracking",
               message_has_code("H5_CORRUPT_ATTRIBUTE_INFO_FLAGS"));

var DENSE_INFO_UNPAIRED = [0UB, 0UB,
                           0UB, 0UB, 0UB, 0UB,
                           0xffUB, 0xffUB, 0xffUB, 0xffUB];
run_linfo_blob(DENSE_INFO_UNPAIRED);
expect_message("link_info_requires_paired_dense_addresses",
               message_has_code("H5_CORRUPT_LINK_INFO_ADDRESS_PAIR"));
run_ainfo_blob(DENSE_INFO_UNPAIRED);
expect_message("attribute_info_requires_paired_dense_addresses",
               message_has_code("H5_CORRUPT_ATTRIBUTE_INFO_ADDRESS_PAIR"));

run_ainfo_blob(DENSE_INFO_EMPTY + [0UB]);
expect_message("attribute_info_rejects_trailing_bytes",
               message_has_code("H5_CORRUPT_ATTRIBUTE_INFO_TRAILING_BYTES"));

/* Version-1 object headers include 8-byte slot padding in msg_size. */
global_version = 1;
run_message_blob(0x0aUL,
                 [0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB], "/g");
expect_message("v1_group_info_accepts_slot_padding",
               h5policy_finding_codes'length == 0);
run_linfo_blob(DENSE_INFO_EMPTY +
               [0UB, 0UB, 0UB, 0UB, 0UB, 0UB]);
expect_message("v1_link_info_accepts_slot_padding",
               h5policy_finding_codes'length == 0);
run_ainfo_blob(DENSE_INFO_EMPTY +
               [0UB, 0UB, 0UB, 0UB, 0UB, 0UB]);
expect_message("v1_attribute_info_accepts_slot_padding",
               h5policy_finding_codes'length == 0);
global_version = 0;

/* ---- driver-info body minimum ------------------------------------------- *

   The corpus fixtures cover the three REJECTIONS.  The controls that matter
   most cannot be corpus fixtures at all: a well-formed "NCSAmult" block names a
   driver H5FD_sb_load refuses under sec2, so a valid/ fixture carrying one
   would be rejected by libhdf5 for a reason that has nothing to do with this
   bound.  Here the payload validator is driven directly, so the accept side is
   testable -- and without it the minimum could be wrong in the over-strict
   direction and the whole corpus would still pass. */
var DRV_FAMILY = [0x4eUB, 0x43UB, 0x53UB, 0x41UB, 0x66UB, 0x61UB, 0x6dUB, 0x69UB];
var DRV_MULTI  = [0x4eUB, 0x43UB, 0x53UB, 0x41UB, 0x6dUB, 0x75UB, 0x6cUB, 0x74UB];
var DRV_OTHER  = [0x4eUB, 0x43UB, 0x53UB, 0x41UB, 0x74UB, 0x65UB, 0x73UB, 0x74UB];
var MAP_SPLIT  = [1UB, 1UB, 3UB, 3UB, 1UB, 1UB];   /* UNIQUE_MEMBERS -> 2 */
var MAP_BAD    = [7UB, 1UB, 3UB, 3UB, 1UB, 1UB];   /* 7 == H5FD_MEM_NTYPES; -> 3 */
var DRV_PAD2   = [0UB, 0UB];
var DRV_Z8     = [0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB, 0UB];
var DRV_Z16    = DRV_Z8 + DRV_Z8;
var DRV_Z24    = DRV_Z16 + DRV_Z8;
var DRV_Z32    = DRV_Z16 + DRV_Z16;
var DRV_Z48    = DRV_Z32 + DRV_Z16;

fun run_drvinfo_blob = (byte[] blob) void:
{
    var ios = open("*unit-drvinfo*");
    byte[blob'length] @ ios : 0#B = blob;
    h5policy_reset_findings;
    h5policy_validate_drvinfo_payload(
        ios, H5_UNTRUSTED_STRICT, 0#B,
        blob'length as uint<64>, "/<superblock-extension>");
    close(ios);
}

/* A body of 1 is below the flat floor both drivers share. */
run_drvinfo_blob([0UB] + DRV_FAMILY + [1UB, 0UB] + [0UB]);
expect_message("drvinfo_family_body_below_floor_rejected",
               message_has_code("H5_CORRUPT_DRVINFO_BODY_TOO_SHORT"));

/* NON-FALSE-REJECT CONTROL: 8 bytes is exactly what the family driver reads. */
run_drvinfo_blob([0UB] + DRV_FAMILY + [8UB, 0UB] + DRV_Z8);
expect_message("drvinfo_family_exact_minimum_accepted",
               !message_has_code("H5_CORRUPT_DRVINFO_BODY_TOO_SHORT"));

/* Clears the floor, fails the map-derived minimum: 8 < 8 + 2*16 + 2*8. */
run_drvinfo_blob([0UB] + DRV_MULTI + [8UB, 0UB] + MAP_SPLIT + DRV_PAD2);
expect_message("drvinfo_multi_body_below_map_minimum_rejected",
               message_has_code("H5_CORRUPT_DRVINFO_BODY_TOO_SHORT"));

/* NON-FALSE-REJECT CONTROL, and the one the corpus cannot express: a two-member
   multi body of exactly 56 bytes is what H5Pset_fapl_split actually writes. */
run_drvinfo_blob([0UB] + DRV_MULTI + [0x38UB, 0UB]
                 + MAP_SPLIT + DRV_PAD2 + DRV_Z32 + DRV_Z16);
expect_message("drvinfo_multi_exact_minimum_accepted",
               !message_has_code("H5_CORRUPT_DRVINFO_BODY_TOO_SHORT"));

/* Map byte 7 with a body sized for the three members it selects, so only the
   map value is wrong and the length bound cannot shadow it. */
run_drvinfo_blob([0UB] + DRV_MULTI + [0x50UB, 0UB]
                 + MAP_BAD + DRV_PAD2 + DRV_Z48 + DRV_Z24);
expect_message("drvinfo_multi_undefined_member_type_rejected",
               message_has_code("H5_CORRUPT_DRVINFO_MEMBER_MAP"));
expect_message("drvinfo_multi_undefined_member_type_not_shadowed",
               !message_has_code("H5_CORRUPT_DRVINFO_BODY_TOO_SHORT"));

/* CONTROL AGAINST AN INVENTED BOUND: h5policy knows no minimum for a driver
   libhdf5 does not dispatch on, so a 1-byte body under any other name must not
   be called too short. */
run_drvinfo_blob([0UB] + DRV_OTHER + [1UB, 0UB] + [0UB]);
expect_message("drvinfo_unknown_driver_has_no_minimum",
               !message_has_code("H5_CORRUPT_DRVINFO_BODY_TOO_SHORT"));

if (message_failures != 0)
    {
        printf("UNIT MESSAGES: %i32d failure(s)\n", message_failures);
        exit(1);
    }
printf("UNIT MESSAGES: all passed\n");
