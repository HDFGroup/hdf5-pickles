/* unit_paths.pk - Contract checks for byte-path report serialization.  */

/* Copyright (C) 2026 The HDF Group.  */

load h5_policy;

var path_failures = 0;

fun path_bytes = (uint<8>[] values) string:
{
    var result = "";
    var i = 0UL;
    while (i < values'length)
        {
            result = result + ((values[i] as char) as string);
            i = i + 1UL;
        }
    return result;
}

fun expect_path = (string name, string input, string expected) void:
{
    var actual = h5policy_path_encode(input);
    if (actual == expected)
        printf("PASS %s\n", name);
    else
        {
            printf("FAIL %s: expected %s, got %s\n", name, expected, actual);
            path_failures = path_failures + 1;
        }
}

expect_path("safe_ascii", "/group/dataset", "/group/dataset");
expect_path("literal_percent", "/rate%89", "/rate%2589");
expect_path("controls_and_del",
            path_bytes([0x2fUB, 0x61UB, 0x01UB, 0x7fUB]),
            "/a%01%7F");
expect_path("non_utf8_specimen_name",
            path_bytes([0x2fUB, 0x41UB, 0x72UB, 0x72UB, 0x61UB, 0x79UB,
                        0x4fUB, 0x89UB, 0x53UB, 0x74UB, 0x72UB, 0x75UB,
                        0x80UB]),
            "/ArrayO%89Stru%80");

var valid_utf8 = path_bytes([0x2fUB, 0xc3UB, 0xa9UB, 0x2fUB,
                             0xe2UB, 0x82UB, 0xacUB, 0x2fUB,
                             0xf0UB, 0x9fUB, 0x98UB, 0x80UB]);
expect_path("valid_utf8_is_unchanged", valid_utf8, valid_utf8);

expect_path("overlong_two_byte",
            path_bytes([0xc0UB, 0xafUB]), "%C0%AF");
expect_path("invalid_continuation",
            path_bytes([0xe2UB, 0x28UB, 0xa1UB]), "%E2(%A1");
expect_path("utf8_surrogate",
            path_bytes([0xedUB, 0xa0UB, 0x80UB]), "%ED%A0%80");
expect_path("above_unicode_limit",
            path_bytes([0xf4UB, 0x90UB, 0x80UB, 0x80UB]),
            "%F4%90%80%80");
expect_path("truncated_sequence",
            path_bytes([0xf0UB, 0x9fUB, 0x98UB]), "%F0%9F%98");

if (path_failures != 0)
    {
        printf("UNIT PATHS: %i32d failure(s)\n", path_failures);
        exit(1);
    }
printf("UNIT PATHS: all passed\n");
