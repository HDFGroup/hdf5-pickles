/* h5_vds.pk - Bounded virtual-dataset global-heap mapping validation. */

type H5PolicyHeapRef = struct
{
    uint<8> found;
    offset<uint<64>,B> data_off;
    uint<64> data_size;
};

fun h5policy_heap_ref_none = H5PolicyHeapRef:
{
    return H5PolicyHeapRef { found = 0UB, data_off = 0UL#B,
                             data_size = 0UL };
}

/* ---- Collection walk memo ---------------------------------------------------
   The walker below parses a WHOLE collection to answer for one index, which is
   correct -- a global heap has no per-object access path, so a defect anywhere
   in it blocks the open regardless of which object was asked for.  But it makes
   a per-descriptor caller quadratic, and one exists: an attribute value can hold
   an array of global-heap IDs (h5policy_validate_attr_heap_ids).

   Measured before this memo: a valid file with 60 vlen string attributes of 80
   elements each took 11.1 s against 0.8 s without the attribute checks, and
   tripped the profile's wall-clock budget -- turning a perfectly ordinary file
   into unsupported_coverage_gap.  Metadata-heavy files with many vlen attributes
   are common, so that was a false positive, not a corner case.

   So the walk records every object it accepts, keyed by the collection address,
   and repeat lookups against the SAME collection are served from the record.
   One collection at a time is enough: descriptors in one attribute overwhelmingly
   name one collection, and a second address simply refills the memo.

   A cache HIT deliberately re-emits nothing.  A malformed collection is reported
   by the first descriptor that reaches it and stays reported; repeating the same
   finding once per element would bury the report in duplicates.  */
/* The cost unit is the WALK, not the descriptor: a memo hit is a few
   comparisons, a miss re-parses a whole collection.  So the budget is counted in
   walks.  A file's vlen values do not all land in one collection -- 4800 short
   strings fill about fifteen 4 KiB collections -- so a per-descriptor caller
   striding across them thrashes a single-entry memo, and bounding descriptors
   would not bound the work.  Bounding walks does.

   Set high enough that ordinary files are fully checked and low enough that no
   file can spend the wall-clock budget here.  Exceeding it stops FURTHER
   validation; it never turns into a finding, because running out of budget is
   not evidence about the file.  */
var H5_GHEAP_WALK_BUDGET = 64UL;
var h5policy_gheap_walks_left = 64UL;

var h5policy_gheap_memo_addr = 0xffffffffffffffffUL;
var h5policy_gheap_memo_valid = 0UB;      /* the collection parsed to its end */
/* Set when the walk of memo_addr FAILED.  A malformed collection is as worth
   recording as a good one, and for the same reason plus one more: without it
   every descriptor re-walks the same broken collection and re-emits the same
   finding, so one corrupt collection reported itself once per element.  Measured
   on a corpus specimen with an over-long object header: seven copies of
   H5_CORRUPT_GLOBAL_HEAP_OBJECT at one offset in the forensic profile.  */
var h5policy_gheap_memo_bad = 0UB;
var h5policy_gheap_memo_idxs = uint<64>[]();
var h5policy_gheap_memo_offs = uint<64>[]();
var h5policy_gheap_memo_sizes = uint<64>[]();

fun h5policy_reset_gheap_memo = void:
{
    h5policy_gheap_walks_left = H5_GHEAP_WALK_BUDGET;
    h5policy_gheap_memo_addr = 0xffffffffffffffffUL;
    h5policy_gheap_memo_valid = 0UB;
    h5policy_gheap_memo_bad = 0UB;
    h5policy_gheap_memo_idxs = uint<64>[]();
    h5policy_gheap_memo_offs = uint<64>[]();
    h5policy_gheap_memo_sizes = uint<64>[]();
}

/* Serve `wanted` from the memo.  found = 0 with memo_valid set means the
   collection really has no such object, which is a finding the CALLER must
   still make -- the memo cannot emit it, because it does not know the role.  */
fun h5policy_gheap_memo_lookup = (uint<64> heap_addr, uint<64> wanted) H5PolicyHeapRef:
{
    if (h5policy_gheap_memo_addr != heap_addr || h5policy_gheap_memo_valid == 0UB)
        return h5policy_heap_ref_none;
    var total = h5policy_gheap_memo_idxs'length as uint<64>;
    /* Fast path.  libhdf5 allocates object indexes sequentially from 1 and the
       walk records them in file order, so `wanted` is almost always at
       wanted - 1.  Guess-and-verify, so an out-of-order or sparse collection
       just falls through to the scan below and stays correct.

       This is not a micro-optimization: a collection can hold thousands of
       objects (one per vlen element in the file), and a linear scan per
       descriptor made the memo itself quadratic -- 3.45 s on the 60-attribute
       measurement, against 0.35 s with this path.  */
    if (wanted >= 1UL && wanted <= total
        && h5policy_gheap_memo_idxs[wanted - 1UL] == wanted)
        return H5PolicyHeapRef { found = 1UB,
                                 data_off = h5policy_gheap_memo_offs[wanted - 1UL]#B,
                                 data_size = h5policy_gheap_memo_sizes[wanted - 1UL] };
    var n = 0UL;
    while (n < total)
        {
            if (h5policy_gheap_memo_idxs[n] == wanted)
                return H5PolicyHeapRef { found = 1UB,
                                         data_off = h5policy_gheap_memo_offs[n]#B,
                                         data_size = h5policy_gheap_memo_sizes[n] };
            n = n + 1UL;
        }
    return h5policy_heap_ref_none;
}

/* Find one indexed object in a GCOL while validating every cursor advance.
 *
 * The walk deliberately does NOT stop at the wanted object.  A global heap has
 * no per-object access path: H5HG__cache_heap_deserialize parses the whole
 * collection into the metadata cache before any single object can be read, so
 * a defect anywhere in the collection blocks the open just as surely as one in
 * the object the VDS layout names.  Returning early -- which this walker used
 * to do, both at the wanted index and at the first free-space object -- left
 * everything past that point unexamined, and libhdf5 rejects (or, for a
 * zero-length free-space object, hangs on) files h5policy therefore accepted.
 *
 * Two rules from the post-parse block are modelled here and one is not:
 *
 *   - obj[0] 8-alignment (H5HGcache.c:373) IS modelled; it is reachable when
 *     an explicit free-space object advances the cursor by an unaligned amount
 *     and a second one closes the collection.
 *   - "partially decoded global heap" (:371) is NOT modelled: every advance is
 *     already bounded by the overrun guard below, so the cursor can only land
 *     exactly on the end of the collection.  The same reasoning applies to
 *     libhdf5, whose H5_IS_BUFFER_OVERFLOW guard bounds p identically -- the
 *     check appears to be unreachable there too, and no construction we tried
 *     reached it.
 */
fun h5policy_find_gheap_object = (int ios, H5PolicyProfile profile,
                                  uint<64> heap_addr, uint<64> wanted,
                                  off64 loc, string object,
                                  string role, string field_ns) H5PolicyHeapRef:
{
    var l = global_sizeof_lengths as uint<64>;
    var file_size = h5policy_ceiling(ios);
    var hdr_size = align8(8UL + l);
    if (!h5policy_checked_addr_range(heap_addr, hdr_size, file_size,
                                     role + " global heap header outside file",
                                     loc, object))
        return h5policy_heap_ref_none;
    if (h5policy_msg_bytes(ios, profile, heap_addr#B, 4UL)
        != H5_FORMAT_GCOL_SIGNATURE)
        {
            h5policy_emit_error("H5_CORRUPT_BAD_SIGNATURE", "corrupt",
                                heap_addr#B, object,
                                role + " global heap signature mismatch");
            return h5policy_heap_ref_none;
        }
    h5policy_mark_reached(heap_addr, "GCOL");
    if (h5policy_msg_u64_at(ios, profile, heap_addr#B + 4#B, 1UL) != 1UL
        || h5policy_msg_u64_at(ios, profile, heap_addr#B + 5#B, 3UL) != 0UL)
        {
            h5policy_emit_error("H5_CORRUPT_GLOBAL_HEAP_HEADER", "corrupt",
                                heap_addr#B, object,
                                role + " global heap version or reserved bytes are invalid");
            return h5policy_heap_ref_none;
        }
    var coll_size = h5policy_msg_u64_at(ios, profile, heap_addr#B + 8#B, l);
    /* H5HG__hdr_deserialize refuses a collection that declares itself smaller
       than H5HG_MINSIZE before it parses a single object, so this is a header
       fault rather than an object one.  hdr_size alone -- the old bound -- let
       through every collection between 16 bytes and 4 KiB.  */
    if (coll_size < H5_FORMAT_GCOL_MIN_COLLECTION_SIZE)
        {
            h5policy_emit_error_ev("H5_CORRUPT_GLOBAL_HEAP_HEADER", "corrupt",
                                   heap_addr#B + 8#B, object,
                                   role + " global heap collection size is below the format minimum",
                                   H5Evidence {
                                       field = field_ns + ".global_heap_collection_size",
                                       actual = coll_size,
                                       expected = H5_FORMAT_GCOL_MIN_COLLECTION_SIZE,
                                       comparison = "at_least",
                                       has_loc1 = 1, loc1_role = "actual",
                                       loc1 = heap_addr#B + 8#B, loc1_len = l,
                                   });
            return h5policy_heap_ref_none;
        }
    if (!h5policy_checked_addr_range(heap_addr, coll_size, file_size,
                                     role + " global heap collection outside file",
                                     loc, object))
        return h5policy_heap_ref_none;
    /* Start a fresh memo for this collection.  Invalidated up front so an
       early return on a malformed collection cannot leave a half-filled record
       that a later lookup would trust.  The WALK BUDGET is deliberately not
       touched here -- it is per analysis, and this function is the thing it
       counts.  */
    h5policy_gheap_memo_valid = 0UB;
    /* Assume the worst until the walk reaches the collection's declared end.
       Every failure path below returns early, so this is what they leave
       behind -- and it is what suppresses the duplicate reports.  */
    h5policy_gheap_memo_bad = 1UB;
    h5policy_gheap_memo_idxs = uint<64>[]();
    h5policy_gheap_memo_offs = uint<64>[]();
    h5policy_gheap_memo_sizes = uint<64>[]();
    h5policy_gheap_memo_addr = heap_addr;
    var pos = hdr_size;
    var found = 0UB;
    var found_off = 0UL#B;
    var found_size = 0UL;
    /* obj[0] is the collection's free space.  It is recorded rather than
       returned so the post-parse alignment rule can see it, and so a second
       one is caught the way libhdf5 catches it.  */
    var free_seen = 0UB;
    var free_size = 0UL;
    var free_len_off = heap_addr#B + 8#B;
    while (pos < coll_size)
        {
            h5policy_walk_tick(1UL);
            if (hdr_size > coll_size - pos)
                {
                    /* Tail too small to hold an object header: libhdf5 takes it
                       as the free-space object.  If an explicit index-0 object
                       already claimed that role the header is inconsistent
                       ("object 0 should not be set", H5HGcache.c:280).  */
                    if (free_seen != 0UB)
                        {
                            h5policy_emit_error("H5_CORRUPT_GLOBAL_HEAP_OBJECT",
                                                "corrupt", heap_addr#B + pos#B,
                                                object,
                                                role + " global heap has a trailing free-space region after an explicit free-space object");
                            return h5policy_heap_ref_none;
                        }
                    free_seen = 1UB;
                    free_size = coll_size - pos;
                    free_len_off = heap_addr#B + pos#B;
                    pos = coll_size;
                    break;
                }
            var oh = heap_addr#B + pos#B;
            var idx = h5policy_msg_u64_at(ios, profile, oh, 2UL);
            var reserved = h5policy_msg_u64_at(ios, profile, oh + 4#B, 4UL);
            var data_size = h5policy_msg_u64_at(ios, profile, oh + 8#B, l);
            /* A zero length is the denial-of-service shape FOR INDEX 0 ONLY:
               there the parse advance IS the length, so libhdf5 re-reads the
               same header forever.  Reached through a VDS layout this happens at
               H5Dopen, not only in an orphaned collection.

               For any other index the advance is H5HG_SIZEOF_OBJHDR(f) +
               H5HG_ALIGN(size), which is 16 even at size zero -- so the parse
               progresses and there is nothing to reject.  This test used to
               refuse a zero length at EVERY index, which was broader than its
               own justification and WRONG: libhdf5 writes a size-zero heap
               object for an EMPTY variable-length element, so the rule rejected
               files libhdf5 itself had just written.  Latent while only a VDS
               layout reached this walker -- a VDS collection is unlikely to hold
               an unrelated empty vlen -- and immediate once attribute values
               reached it, where h5py writing attrs["x"] = "" produces exactly
               this shape (measured: collection object idx 1, size 0, and
               h5dump -A exits 0).  */
            if (reserved != 0UL || (data_size == 0UL && idx == 0UL))
                {
                    h5policy_emit_error("H5_CORRUPT_GLOBAL_HEAP_OBJECT", "corrupt",
                                        oh, object,
                                        role + " global heap object header is invalid");
                    return h5policy_heap_ref_none;
                }
            if (idx == 0UL)
                {
                    /* The free-space object is sized to its whole extent, the
                       header included, and is never padded -- so it advances
                       the cursor by exactly its length.  */
                    if (data_size > coll_size - pos)
                        {
                            h5policy_emit_error("H5_CORRUPT_GLOBAL_HEAP_OBJECT",
                                                "corrupt", oh, object,
                                                role + " global heap free-space object overruns the collection");
                            return h5policy_heap_ref_none;
                        }
                    free_seen = 1UB;
                    free_size = data_size;
                    free_len_off = oh + 8#B;
                    pos = pos + data_size;
                }
            else
                {
                    /* BOUND THE DECLARED SIZE BEFORE ALIGNING IT.  align8 is
                       ((x + 7) / 8) * 8 in uint<64>, so a declared size in
                       [2**64-7, 2**64-1] wraps to ZERO -- and then hdr_size + 0
                       is 16, the checked add does not trip, and the object is
                       admitted with a nonsense size while the cursor advances
                       only 16 bytes.  libhdf5's H5HG_ALIGN is the same formula
                       (8 * ((X + 7) / 8)), so it desynchronizes identically and
                       the two agree on the verdict -- MEASURED: on a crafted
                       collection whose bytes keep the desynchronized parse
                       self-consistent, libhdf5 refuses the dereference with "bad
                       heap index" and h5policy reported the same object missing.

                       So this is not a divergence.  It is bounded here anyway for
                       two reasons.  The size that survives is handed to callers
                       through the memo, and a consumer sizing anything from a
                       2**64 value inherits the wrap -- the walker should not be
                       a source of that.  And the finding it produced was the
                       wrong one: a length mismatch reported by whatever later
                       read the object, instead of the overrun that is actually
                       wrong here.

                       Strictly weaker than the span test that follows, so it can
                       add no false positive: for any object libhdf5 accepts,
                       data_size <= align8(data_size) < span <= remaining.  */
                    if (data_size > coll_size - pos)
                        {
                            h5policy_emit_error_ev(
                                "H5_CORRUPT_GLOBAL_HEAP_OBJECT", "corrupt",
                                oh + 8#B, object,
                                role + " global heap object declares more bytes than the collection holds",
                                H5Evidence {
                                    field = field_ns + ".global_heap_object_size",
                                    actual = data_size,
                                    expected = coll_size - pos,
                                    comparison = "at_most",
                                    has_loc1 = 1, loc1_role = "actual",
                                    loc1 = oh + 8#B, loc1_len = l,
                                });
                            return h5policy_heap_ref_none;
                        }
                    var padded = align8(data_size);
                    var span = h5policy_checked_add_u64(hdr_size, padded,
                                                        0xffffffffffffffffUL,
                                                        "H5_CORRUPT_LENGTH_OVERFLOW",
                                                        "corrupt", oh, object,
                                                        role + " global heap object size overflow");
                    if (span > coll_size - pos)
                        {
                            h5policy_emit_error("H5_CORRUPT_GLOBAL_HEAP_OBJECT",
                                                "corrupt", oh, object,
                                                role + " global heap object overruns the collection");
                            return h5policy_heap_ref_none;
                        }
                    h5policy_gheap_memo_idxs += [idx];
                    h5policy_gheap_memo_offs += [(oh + hdr_size#B)/#B];
                    h5policy_gheap_memo_sizes += [data_size];
                    if (idx == wanted && found == 0UB)
                        {
                            found = 1UB;
                            found_off = oh + hdr_size#B;
                            found_size = data_size;
                        }
                    pos = pos + span;
                }
        }

    /* Post-parse: the free-space object's length is the one quantity libhdf5
       requires to be 8-aligned once the whole collection has been read.  */
    if (free_seen != 0UB && free_size != align8(free_size))
        {
            h5policy_emit_error_ev("H5_CORRUPT_GLOBAL_HEAP_OBJECT", "corrupt",
                                   free_len_off, object,
                                   role + " global heap free-space object length is not 8-aligned",
                                   H5Evidence {
                                       field = field_ns + ".global_heap_free_space_alignment",
                                       actual = free_size,
                                       expected = 8UL,
                                       comparison = "multiple_of",
                                       has_loc1 = 1, loc1_role = "actual",
                                       loc1 = free_len_off, loc1_len = l,
                                   });
            return h5policy_heap_ref_none;
        }
    /* The collection parsed to its declared end, so the record is complete and
       repeat lookups may be served from it.  */
    h5policy_gheap_memo_valid = 1UB;
    h5policy_gheap_memo_bad = 0UB;
    if (found != 0UB)
        return H5PolicyHeapRef { found = 1UB,
                                 data_off = found_off,
                                 data_size = found_size };
    h5policy_emit_error("H5_CORRUPT_HEAP_OBJECT_MISSING", "corrupt",
                        loc, object,
                        role + " reference names a missing global heap object");
    return h5policy_heap_ref_none;
}

/* Serialized H5S selections are the one FILE-RESIDENT use of the H5S selection
   encoding: they appear only inside a VDS mapping block, two per mapping
   (source then virtual).  libhdf5 decodes them in H5S__hyper_deserialize
   (src/H5Shyper.c) and H5S__point_deserialize (src/H5Spoint.c).

   Set when this sizer has already emitted a SPECIFIC finding, so the caller
   does not follow it with the generic H5_CORRUPT_SELECTION.  Each
   selection is sized exactly once per call site and never speculatively, so
   the flag cannot leak into an unrelated decode; the caller clears it before
   each call.  */
var h5policy_selection_reported = 0;

/* enc_size legality.  libhdf5 filters it TWICE and the two filters disagree,
   which is why this is set membership rather than the mask or the range it
   looks like:

     if (enc_size & ~H5S_SELECT_INFO_ENC_SIZE_BITS)   -- admits any subset of
                                                        {2,4,8}, so 0, 6, 10,
                                                        12 and 14 all pass
     switch (enc_size) { case 2: case 4: case 8: ... default: HGOTO_ERROR }

   The switch default is the real gate, so the effective rule is exactly
   {2,4,8}.  h5policy models the EFFECTIVE rule.  The previous bound here was
   `enc == 0 || enc > 8`, which was wrong in both directions: it admitted 1, 3,
   5, 6 and 7 (all of which libhdf5 refuses) and it sized the payload using
   them, so the extent h5policy computed for such a selection matched nothing
   libhdf5 would ever compute.  */
fun h5policy_selection_enc_ok = (uint<64> enc) int:
{
    return (enc == 2UL || enc == 4UL || enc == 8UL) ? 1 : 0;
}

/* Unknown flag bits.  H5S_SELECT_FLAG_BITS is H5S_HYPER_REGULAR alone
   (0x01, src/H5Spkg.h), and libhdf5 refuses anything outside it:
     if (flags & ~H5S_SELECT_FLAG_BITS) HGOTO_ERROR(... "unknown flag ...")
   Hyperslab versions 2 and 3 only -- version 1 has no flags byte, and point
   selections have none at any version.  The bit matters beyond hygiene: 0x01
   selects between the regular and the block-list payload encodings, so an
   unknown neighbour riding alongside it is a signal that the byte is not what
   the writer thought it was.  */
fun h5policy_selection_flags_ok = (uint<64> flags) int:
{
    return (flags & 0xfeUL) == 0UL ? 1 : 0;
}

/* rank must be 1..H5S_MAX_RANK.  libhdf5 states it once per deserializer, in
   both cases immediately after decoding the rank and before any rank-dependent
   work:
     if (0 == rank || rank > H5S_MAX_RANK) HGOTO_ERROR(...)
   The zero case is the half h5policy used to miss entirely: a rank-0 regular
   hyperslab sizes its payload as 4 * 0 * enc == 0, so it passed as a
   well-formed 14-byte selection.  */
fun h5policy_selection_rank_ok = (uint<64> rank) int:
{
    return (rank != 0UL && rank <= H5S_MAX_RANK) ? 1 : 0;
}

/* Size one serialized H5S selection using only bounded scalar reads. */
fun h5policy_selection_size = (int ios, H5PolicyProfile profile,
                               off64 off, uint<64> available,
                               string object, string role,
                               string field_ns) uint<64>:
{
    if (available < 8UL)
        return 0UL;
    var st = h5policy_msg_u64_at(ios, profile, off, 4UL);
    var ver = h5policy_msg_u64_at(ios, profile, off + 4#B, 4UL);
    if (st == 0UL || st == 3UL)
        return available >= 16UL ? 16UL : 0UL;
    if ((st == 1UL || st == 2UL) && ver == 1UL)
        {
            /* THE SAME MISTAKE THE VERSION-2 ARM BELOW CARRIED, in the arm next
               to it.  Version 1 has no flags byte and no encoded size: libhdf5
               skips EIGHT bytes after the version and pins enc_size to 4 --
               `pp += 8; enc_size = H5S_SELECT_INFO_ENC_SIZE_4;` in the
               `version >= 2` else arm of BOTH H5S__hyper_deserialize
               (src/H5Shyper.c) and H5S__point_deserialize (src/H5Spoint.c).

               So the header is type(4) + version(4) + 8 skipped + rank(4) = 20
               bytes, and the element count that follows is a 4-byte field at
               +20.  This arm used to read the u32 at +12 -- INSIDE the skipped
               span, which libhdf5 never looks at -- and return 16 + it.  The
               size therefore came out wrong by the whole payload, the mapping
               cursor desynchronised, and the NEXT selection in the block was
               reported as malformed: a false positive on a valid file, the
               mechanism recorded in
               registry/cases/vds-selection-rank-oracle-false-positive.yml.  That
               record fixed the version-2 arm and flagged this one as probably
               wrong in the same way.  It was.

               The rank is not optional here.  It was previously checked only
               `if (available >= 20)`, which let a truncated selection past the
               rank gate; libhdf5 always decodes it, so too short to hold it is
               too short to size.  */
            if (available < 24UL) return 0UL;
            var rank1 = h5policy_msg_u64_at(ios, profile, off + 16#B, 4UL);
            if (!h5policy_selection_rank_ok(rank1))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_RANK", "corrupt", off + 16#B,
                        object,
                        role + " serialized selection rank is outside 1..H5S_MAX_RANK",
                        H5Evidence {
                            field = field_ns + ".selection_rank",
                            actual = rank1, expected = H5S_MAX_RANK,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 16#B, loc1_len = 4UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            var count1 = h5policy_msg_u64_at(ios, profile, off + 20#B, 4UL);
            /* A hyperslab BLOCK carries a start and an end coordinate per
               dimension; a POINT carries one.  Version 1 has no flags byte, so
               H5S_HYPER_REGULAR can never be set and a version-1 hyperslab is
               always the block-list form -- the regular form does not exist at
               this version.  */
            var per1 = st == 2UL ? 2UL * rank1 : rank1;
            var unit1 = h5policy_checked_mul_u64(per1, 4UL,
                                                 0xffffffffffffffffUL,
                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                 "corrupt", off, object,
                                                 role + " version-1 selection size overflow");
            var bytes1 = h5policy_checked_mul_u64(unit1, count1,
                                                  0xffffffffffffffffUL,
                                                  "H5_CORRUPT_LENGTH_OVERFLOW",
                                                  "corrupt", off, object,
                                                  role + " version-1 selection size overflow");
            return bytes1 <= available - 24UL ? 24UL + bytes1 : 0UL;
        }
    if (st == 2UL && ver == 2UL)
        {
            /* Version 2 carries a flags byte but no encoded size: libhdf5 pins
               enc_size to 8 and SKIPS four bytes of header remainder, so the
               rank sits at +13 and the payload starts at +17.

               h5policy used to read those four skipped bytes as a length and
               return 13 + that value.  They are not a length -- libhdf5 never
               looks at them -- so the size was wrong by the whole payload, the
               mapping cursor desynchronised, and the NEXT selection in the
               block was reported as malformed.  That is the mechanism behind
               the false positive in
               registry/cases/vds-selection-rank-oracle-false-positive.yml: the
               rejected file was valid, and the rank was never the problem.  */
            if (available < 17UL) return 0UL;
            var flags2 = h5policy_msg_u64_at(ios, profile, off + 8#B, 1UL);
            var rank2 = h5policy_msg_u64_at(ios, profile, off + 13#B, 4UL);
            if (!h5policy_selection_flags_ok(flags2))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_FLAGS", "corrupt", off + 8#B,
                        object,
                        role + " serialized selection sets unknown flag bits",
                        H5Evidence {
                            field = field_ns + ".selection_flags",
                            actual = flags2, expected = 1UL,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 8#B, loc1_len = 1UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if (!h5policy_selection_rank_ok(rank2))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_RANK", "corrupt", off + 13#B,
                        object,
                        role + " serialized selection rank is outside 1..H5S_MAX_RANK",
                        H5Evidence {
                            field = field_ns + ".selection_rank",
                            actual = rank2, expected = H5S_MAX_RANK,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 13#B, loc1_len = 4UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if ((flags2 & 1UL) != 0UL)
                {
                    var payload2 = h5policy_checked_mul_u64(4UL * rank2, 8UL,
                                                           0xffffffffffffffffUL,
                                                           "H5_CORRUPT_LENGTH_OVERFLOW",
                                                           "corrupt", off, object,
                                                           role + " hyperslab selection size overflow");
                    return payload2 <= available - 17UL ? 17UL + payload2 : 0UL;
                }
            if (available < 25UL) return 0UL;
            var blocks2 = h5policy_msg_u64_at(ios, profile, off + 17#B, 8UL);
            var unit2 = h5policy_checked_mul_u64(2UL * rank2, 8UL,
                                                 0xffffffffffffffffUL,
                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                 "corrupt", off, object,
                                                 role + " hyperslab selection size overflow");
            var bytes2 = h5policy_checked_mul_u64(unit2, blocks2,
                                                  0xffffffffffffffffUL,
                                                  "H5_CORRUPT_LENGTH_OVERFLOW",
                                                  "corrupt", off, object,
                                                  role + " hyperslab selection size overflow");
            return bytes2 <= available - 25UL ? 25UL + bytes2 : 0UL;
        }
    if (st == 2UL && ver == 3UL)
        {
            if (available < 14UL) return 0UL;
            var flags = h5policy_msg_u64_at(ios, profile, off + 8#B, 1UL);
            var enc = h5policy_msg_u64_at(ios, profile, off + 9#B, 1UL);
            var ndims = h5policy_msg_u64_at(ios, profile, off + 10#B, 4UL);
            /* libhdf5's own order: flags, then enc_size, then rank.  Kept
               because the first failure is what a reader comparing h5policy's
               finding against an HDF5 error stack will see.  */
            if (!h5policy_selection_flags_ok(flags))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_FLAGS", "corrupt", off + 8#B,
                        object,
                        role + " serialized selection sets unknown flag bits",
                        H5Evidence {
                            field = field_ns + ".selection_flags",
                            actual = flags, expected = 1UL,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 8#B, loc1_len = 1UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if (!h5policy_selection_enc_ok(enc))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_ENC_SIZE", "corrupt", off + 9#B, object,
                        role + " serialized selection uses an unsupported offset encoding size",
                        H5Evidence {
                            field = field_ns + ".selection_enc_size",
                            actual = enc,
                            expected = 8UL,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 9#B, loc1_len = 1UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if (!h5policy_selection_rank_ok(ndims))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_RANK", "corrupt", off + 10#B,
                        object,
                        role + " serialized selection rank is outside 1..H5S_MAX_RANK",
                        H5Evidence {
                            field = field_ns + ".selection_rank",
                            actual = ndims, expected = H5S_MAX_RANK,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 10#B, loc1_len = 4UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if ((flags & 1UL) != 0UL)
                {
                    var payload = h5policy_checked_mul_u64(4UL * ndims, enc,
                                                           0xffffffffffffffffUL,
                                                           "H5_CORRUPT_LENGTH_OVERFLOW",
                                                           "corrupt", off, object,
                                                           role + " hyperslab selection size overflow");
                    return payload <= available - 14UL ? 14UL + payload : 0UL;
                }
            if (enc > available - 14UL) return 0UL;
            var blocks = h5policy_msg_u64_at(ios, profile, off + 14#B, enc);
            var block_unit = h5policy_checked_mul_u64(2UL * ndims, enc,
                                                0xffffffffffffffffUL,
                                                "H5_CORRUPT_LENGTH_OVERFLOW",
                                                "corrupt", off, object,
                                                role + " hyperslab selection size overflow");
            var bytes = h5policy_checked_mul_u64(block_unit, blocks,
                                                 0xffffffffffffffffUL,
                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                 "corrupt", off, object,
                                                 role + " hyperslab selection size overflow");
            return bytes <= available - 14UL - enc ? 14UL + enc + bytes : 0UL;
        }
    if (st == 1UL && ver == 2UL)
        {
            if (available < 14UL) return 0UL;
            var encp = h5policy_msg_u64_at(ios, profile, off + 8#B, 1UL);
            var ndimsp = h5policy_msg_u64_at(ios, profile, off + 9#B, 4UL);
            /* Point selections carry no flags byte at any version, so the two
               header fields are the encoding size and the rank, in that
               order.  */
            if (!h5policy_selection_enc_ok(encp))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_ENC_SIZE", "corrupt", off + 8#B, object,
                        role + " serialized selection uses an unsupported point encoding size",
                        H5Evidence {
                            field = field_ns + ".selection_enc_size",
                            actual = encp,
                            expected = 8UL,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 8#B, loc1_len = 1UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if (!h5policy_selection_rank_ok(ndimsp))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_SELECTION_RANK", "corrupt", off + 9#B,
                        object,
                        role + " serialized selection rank is outside 1..H5S_MAX_RANK",
                        H5Evidence {
                            field = field_ns + ".selection_rank",
                            actual = ndimsp, expected = H5S_MAX_RANK,
                            comparison = "at_most",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = off + 9#B, loc1_len = 4UL
                        });
                    h5policy_selection_reported = 1;
                    return 0UL;
                }
            if (encp > available - 13UL) return 0UL;
            var points = h5policy_msg_u64_at(ios, profile, off + 13#B, encp);
            var point_unit = h5policy_checked_mul_u64(ndimsp, encp,
                                                 0xffffffffffffffffUL,
                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                 "corrupt", off, object,
                                                 role + " point selection size overflow");
            var pbytes = h5policy_checked_mul_u64(point_unit, points,
                                                  0xffffffffffffffffUL,
                                                  "H5_CORRUPT_LENGTH_OVERFLOW",
                                                  "corrupt", off, object,
                                                  role + " point selection size overflow");
            return pbytes <= available - 13UL - encp ? 13UL + encp + pbytes : 0UL;
        }
    return 0UL;
}

/* Scan a NUL-terminated VDS name and optionally classify the source path.
   Returns bytes consumed including NUL, or zero when unterminated. */
fun h5policy_vds_name_size = (int ios, H5PolicyProfile profile, off64 off,
                              uint<64> available, int classify,
                              string object) uint<64>:
{
    var i = 0UL;
    var first = 0UL; var second = 0UL; var third = 0UL;
    var parent = 0; var component_start = 1;
    while (i < available)
        {
            var ch = h5policy_msg_u64_at(ios, profile, off + i#B, 1UL);
            if (i == 0UL) first = ch;
            if (i == 1UL) second = ch;
            if (i == 2UL) third = ch;
            if (ch == 0UL)
                {
                    if (classify && profile.features.allow_vds != 0UB)
                        {
                            var absolute = first == ('/' as uint<64>)
                                           || first == ('\\' as uint<64>)
                                           || (second == (':' as uint<64>)
                                               && (third == ('/' as uint<64>)
                                                   || third == ('\\' as uint<64>)));
                            if (parent)
                                h5policy_emit_warning("H5_ADVISORY_VDS_PARENT_SOURCE",
                                                      off, object,
                                                      "VDS source path contains a parent-directory component and can direct dataset I/O outside the expected directory");
                            else if (absolute)
                                h5policy_emit_warning("H5_ADVISORY_VDS_ABSOLUTE_SOURCE",
                                                      off, object,
                                                      "VDS uses an absolute source path and can direct dataset I/O to that file");
                            else
                                h5policy_emit_warning("H5_ADVISORY_VDS_RELATIVE_SOURCE",
                                                      off, object,
                                                      "VDS uses a relative source path whose I/O target depends on consumer path resolution");
                        }
                    return i + 1UL;
                }
            if (component_start && ch == ('.' as uint<64>) && i + 1UL < available)
                {
                    var next = h5policy_msg_u64_at(ios, profile, off + (i + 1UL)#B, 1UL);
                    if (next == ('.' as uint<64>))
                        {
                            var after = i + 2UL < available
                                        ? h5policy_msg_u64_at(ios, profile,
                                                              off + (i + 2UL)#B, 1UL)
                                        : 0UL;
                            if (after == 0UL || after == ('/' as uint<64>)
                                || after == ('\\' as uint<64>)) parent = 1;
                        }
                }
            component_start = ch == ('/' as uint<64>) || ch == ('\\' as uint<64>);
            i = i + 1UL;
        }
    return 0UL;
}

fun h5policy_validate_vds_layout = (int ios, H5PolicyProfile profile,
                                    offset<uint<64>,B> payload_off,
                                    uint<64> msg_size, string object) void:
{
    var o = global_sizeof_offsets as uint<64>;
    var l = global_sizeof_lengths as uint<64>;
    if (!h5policy_payload_range_ok(msg_size, 2UL, o + 4UL,
                                   "H5_CORRUPT_VDS_LAYOUT_TOO_SMALL",
                                   payload_off, object,
                                   "VDS layout global-heap ID is truncated")) return;
    var heap_addr = h5policy_msg_addr_at(ios, profile, payload_off + 2#B, o);
    var heap_idx = h5policy_msg_u64_at(ios, profile,
                                       payload_off + (2UL + o)#B, 4UL);
    var ref = h5policy_find_gheap_object(ios, profile, heap_addr, heap_idx,
                                         payload_off + 2#B, object,
                                         "VDS", "vds");
    if (ref.found == 0UB) return;
    if (ref.data_size < l + 5UL)
        {
            h5policy_emit_error("H5_CORRUPT_VDS_MAPPING_HEADER", "corrupt",
                                ref.data_off, object,
                                "VDS mapping block is too small");
            return;
        }
    var version = h5policy_msg_u64_at(ios, profile, ref.data_off, 1UL);
    var nmaps = h5policy_msg_u64_at(ios, profile, ref.data_off + 1#B, l);
    if (version > 1UL || nmaps == 0UL || nmaps > ref.data_size)
        {
            h5policy_emit_error("H5_CORRUPT_VDS_MAPPING_HEADER", "corrupt",
                                ref.data_off, object,
                                "VDS mapping block version or mapping count is invalid");
            return;
        }
    var cur = 1UL + l;
    var end = ref.data_size - 4UL;
    var m = 0UL;
    while (m < nmaps)
        {
            h5policy_walk_tick(1UL);
            var flags = 0UL;
            if (version == 1UL)
                {
                    if (cur >= end) return;
                    flags = h5policy_msg_u64_at(ios, profile, ref.data_off + cur#B, 1UL);
                    cur = cur + 1UL;
                    if ((flags & 0xf8UL) != 0UL)
                        {
                            h5policy_emit_error("H5_CORRUPT_VDS_MAPPING_FLAGS", "corrupt",
                                                ref.data_off + (cur - 1UL)#B,
                                                object, "VDS mapping flags use reserved bits");
                            return;
                        }
                }
            if ((flags & 4UL) == 0UL)
                {
                    if ((flags & 1UL) != 0UL)
                        {
                            if (l > end - cur) return;
                            var origin = h5policy_msg_u64_at(ios, profile,
                                                            ref.data_off + cur#B, l);
                            if (origin >= m) return;
                            cur = cur + l;
                        }
                    else
                        {
                            var fn = h5policy_vds_name_size(ios, profile,
                                                            ref.data_off + cur#B,
                                                            end - cur, 1, object);
                            if (fn == 0UL)
                                {
                                    h5policy_emit_error("H5_CORRUPT_VDS_SOURCE_NAME",
                                                        "corrupt",
                                                        ref.data_off + cur#B,
                                                        object,
                                                        "VDS source filename is not terminated within the mapping block");
                                    return;
                                }
                            cur = cur + fn;
                        }
                }
            if ((flags & 2UL) != 0UL)
                {
                    if (l > end - cur) return;
                    var dorigin = h5policy_msg_u64_at(ios, profile,
                                                      ref.data_off + cur#B, l);
                    if (dorigin >= m) return;
                    cur = cur + l;
                }
            else
                {
                    var dn = h5policy_vds_name_size(ios, profile,
                                                    ref.data_off + cur#B,
                                                    end - cur, 0, object);
                    if (dn == 0UL)
                        {
                            h5policy_emit_error("H5_CORRUPT_VDS_SOURCE_NAME",
                                                "corrupt", ref.data_off + cur#B,
                                                object,
                                                "VDS source dataset name is not terminated within the mapping block");
                            return;
                        }
                    cur = cur + dn;
                }
            /* The generic finding is the fallback for "this did not size", not
               a second report.  When the sizer identified the defective header
               field it has already emitted a specific finding at that field's
               own offset, which is strictly better evidence than a generic one
               anchored at the start of the selection.  */
            h5policy_selection_reported = 0;
            var ss = h5policy_selection_size(ios, profile,
                                             ref.data_off + cur#B,
                                             end - cur, object,
                                             "VDS", "vds");
            if (ss == 0UL)
                {
                    if (!h5policy_selection_reported)
                        h5policy_emit_error("H5_CORRUPT_SELECTION", "corrupt",
                                            ref.data_off + cur#B, object,
                                            "VDS source selection is malformed or overruns the mapping block");
                    return;
                }
            cur = cur + ss;
            h5policy_selection_reported = 0;
            var vs = h5policy_selection_size(ios, profile,
                                             ref.data_off + cur#B,
                                             end - cur, object,
                                             "VDS", "vds");
            if (vs == 0UL)
                {
                    if (!h5policy_selection_reported)
                        h5policy_emit_error("H5_CORRUPT_SELECTION", "corrupt",
                                            ref.data_off + cur#B, object,
                                            "VDS virtual selection is malformed or overruns the mapping block");
                    return;
                }
            cur = cur + vs;
            m = m + 1UL;
        }
    if (cur != end)
        {
            h5policy_emit_error("H5_CORRUPT_VDS_MAPPING_TRAILING_BYTES", "corrupt",
                                ref.data_off + cur#B, object,
                                "VDS mapping block has unclaimed bytes");
            return;
        }
    var body = h5policy_msg_bytes(ios, profile, ref.data_off, end);
    var stored = lookup3_u32_le(h5policy_msg_bytes(ios, profile,
                                                   ref.data_off + end#B, 4UL));
    if (lookup3_hashlittle(body, 0) != stored)
        h5policy_emit_error("H5_CORRUPT_BAD_CHECKSUM", "corrupt",
                            ref.data_off, object,
                            "VDS mapping block checksum mismatch");
}
