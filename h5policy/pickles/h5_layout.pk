/* Layout messages connect logical dataset shape to physical storage.  h5policy
   validates the metadata envelope and chunk-index references, but it never
   reads dataset bytes or runs the filter pipeline over raw data.  */

/* Compact layout stores raw element bytes inside the layout message itself.
   This validator records the embedded byte count for later comparison against
   dataspace * datatype size, and checks that the embedded data remains inside
   the message payload.  */
fun h5policy_validate_compact_layout_data = (int ios,
                                             H5PolicyProfile profile,
                                             H5WalkContext ctx,
                                             offset<uint<64>,B> payload_off,
                                             uint<64> msg_size,
                                             uint<64> size_rel,
                                             uint<64> size_width,
                                             string object) H5WalkContext:
{
    if (!h5policy_payload_range_ok(msg_size, size_rel, size_width,
                                   "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                   payload_off + size_rel#B, object,
                                   "compact layout data-size field overruns the layout message"))
        return ctx;

    var compact_size = h5policy_msg_u64_at(ios, profile,
                                           payload_off + size_rel#B,
                                           size_width);
    ctx.has_compact_layout = 1UB;
    ctx.compact_layout_size = compact_size;

    var data_rel = h5policy_checked_add_u64(size_rel, size_width,
                                            0xffffffffffffffffUL,
                                            "H5_CORRUPT_LENGTH_OVERFLOW",
                                            "corrupt", payload_off, object,
                                            "compact layout data offset overflow");
    var ok = h5policy_payload_range_ok(msg_size, data_rel, compact_size,
                                       "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                       payload_off + data_rel#B, object,
                                       "compact layout data overruns the layout message");
    return ctx;
}

/* A contiguous layout stores its data at [data_addr, data_addr + data_size).
   That extent must lie within the declared EOF ceiling; libhdf5 rejects a file
   whose contiguous data runs past the EOF ("invalid dataset size").  The v3,
   v4, and v5 layout encodings place the address and size identically (after the
   1-byte version + 1-byte class), so they share this check.  */
fun h5policy_check_contiguous_extent = (int ios, H5PolicyProfile profile,
                                        H5WalkContext ctx,
                                        offset<uint<64>,B> payload_off,
                                        uint<64> msg_size, uint<64> file_size,
                                        string object) H5WalkContext:
{
    var min_size = 2UL + (global_sizeof_offsets as uint<64>)
                   + (global_sizeof_lengths as uint<64>);
    if (!h5policy_payload_range_ok(msg_size, 0UL, min_size,
                                   "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                   payload_off, object,
                                   "contiguous layout message is too small"))
        return ctx;

    var data_addr_raw = h5policy_msg_bytes(ios, profile, payload_off + 2#B,
                                           global_sizeof_offsets as uint<64>);
    var data_size = h5policy_msg_u64_at(ios, profile,
                                        payload_off
                                        + (2UL + (global_sizeof_offsets as uint<64>))#B,
                                        global_sizeof_lengths as uint<64>);
    /* Recorded BEFORE the allocation gate, and this is the point of the change.
       The stored size is a property of the message, not of the storage: libhdf5
       requires it to equal nelmts * dt_size on the COPY path
       (H5O__layout_copy_file, for layout version 3 and later) whether or not the
       data has ever been allocated -- and its own writer emits that equality
       either way.  MEASURED on h5py, layout v3 contiguous: an unwritten (10,)
       int32 dataset stores size 40 with an UNDEFINED address, and an unwritten
       scalar stores 4.  An undefined address does not mean a zero size.

       Everything below stays inside the allocation gate, correctly: an extent
       with no address has nothing to bound against the file and nothing to
       intersect with metadata.  What was missing was a rule that needs no
       address at all, and leaving the recording inside the gate is exactly why
       an unallocated dataset's stored size was never examined.  */
    ctx.has_contiguous_stored_size = 1UB;
    ctx.contiguous_stored_size = data_size;
    ctx.contiguous_stored_size_offset =
        (payload_off + (2UL + (global_sizeof_offsets as uint<64>))#B)/#B;

    if (!h5policy_msg_addr_is_undef(data_addr_raw))
        {
            ctx.has_contiguous_layout = 1UB;
            ctx.contiguous_layout_size = data_size;

            /* The data address is encoded at payload_off + 2, so the finding
               can cite the bytes carrying it rather than only the rejected
               range -- which, being outside the file, is not decodable. */
            var data_addr = hdf5_addr_to_file_u64(bytes_to_u64_le(data_addr_raw));
            /* Kept for the finalize-time bound on the COMPUTED extent, which is
               the one libhdf5 actually enforces -- see the long note in
               h5policy_update_logical_dataset_size.  */
            ctx.contiguous_layout_addr = data_addr;
            ctx.contiguous_layout_addr_offset = (payload_off + 2#B)/#B;

            /* THE STORED SIZE IS A WARNING, NOT CORRUPTION, and this is measured
               rather than assumed.  libhdf5 never bounds the size field the
               layout message carries: H5D__contig_check recomputes the extent
               from the dataspace and datatype and checks only that
               (H5Dcontig.c:391-411).  Inflating this field to 10,000,000 in a
               2448-byte file leaves libhdf5 opening the dataset AND returning
               all 100 correct values, while h5policy called it corrupt -- a live
               invariant-A false positive, since "libhdf5 opens" must imply "not
               reject_corrupt".

               IT IS STILL WORTH REPORTING, because the field is not dead.  For
               layout version 3 and later libhdf5 KEEPS the stored value (it
               recomputes only for v1/v2, H5Dcontig.c:536-551) and then uses it:
               as store.contig.dset_size on the I/O path (:227, :637), as the
               length passed to H5MF_xfree when the dataset is deleted (:352),
               as the sieve-buffer bound (:559), and as the answer
               H5Dget_storage_size hands the application (H5Dint.c:2572).  A
               value past the end of the file is wrong in every one of those
               uses; it simply is not what stops the open.  So: warning here,
               corrupt on the computed extent.

               `ok` still gates the metadata-overlap check below, because an
               extent reaching outside the file has no meaningful intersection
               with anything inside it and would only produce noise.  */
            var ok = 1;
            if (data_size > 0xffffffffffffffffUL - data_addr
                || data_addr + data_size > file_size)
                {
                    ok = 0;
                    h5policy_emit_warning("H5_ADVISORY_CONTIGUOUS_STORED_SIZE_PAST_EOF",
                                          payload_off, object,
                                          "contiguous layout stored size reaches past the end of the file");
                }
            /* In-file is not enough: the extent must also miss file METADATA.
               A contiguous dataset is the plainest instance of the primitive --
               no filter, no checksum, nothing to notice the substitution -- so
               libhdf5 seeks to whatever address the message gives and hands the
               bytes back as data.  MEASURED: with the address set to 0, h5dump
               exits 0 and the dataset's first two int32 values are 1178880137
               and 169478669, the file's own "\x89HDF\r\n\x1a\n" signature.
               Same invariant as the chunk-index case, different layout, so the
               same finding routed to this family -- see
               registry/cases/chunk-data-over-metadata.yml.  */
            if (ok)
                ok = h5policy_data_extent_disjoint(data_addr, data_size,
                                                   (payload_off + 2#B), object,
                                                   "contiguous");
        }
    return ctx;
}

/* Poison sentinel for a chunk byte size this validator could not compute.
   The chunk-index walkers in h5_chunkindex.pk already treat 0xffff...ff as
   "stored size unknown, skip the extent check", so reusing that value keeps one
   convention instead of two.  A geometry whose TRUE product is exactly this
   value is therefore not extent-checked -- a deliberate false negative on an
   absurd shape, never a false positive.  */
var H5POLICY_CHUNK_SIZE_UNKNOWN = 0xffffffffffffffffUL;

/* Accumulate a chunk's byte size across its encoded dimensions.

   libhdf5 computes H5O_layout_chunk_t.size as the product of *all* encoded
   chunk dims (the trailing dim is the element size in bytes) and never bounds
   the accumulation.  H5Olayout.c multiplies straight through in both the
   pre-v4 and the shared v4/v5 arm, and H5D__chunk_set_sizes recomputes the same
   product on OPEN (H5Dchunk.c:849-860, reached via the open_op branch at
   :1179) behind a guard -- `(uint64_t)size != chunk_size` -- that compares two
   64-bit values and cannot fire.  A product that wraps to zero then walks past
   libhdf5's own >4 GiB guard *because* it is zero, leaving only
   assert(layout->u.chunk.size > 0) in H5D__chunk_lock, which no release build
   contains.  Measured: heap-buffer-overflow read AND write from a 479-byte
   file, read-only through h5dump.  See
   registry/cases/chunk-dim-product-64bit-overflow.yml.

   So the bound enforced here is 64-bit representability, NOT the legacy 32-bit
   field.  A chunk above 4 GiB has been legal to write since libhdf5 2.0.0
   (layout message version 5) and is legal to READ at any layout version --
   H5Dchunk.c:1182-1187 says so in as many words -- so bounding the product at
   0xffffffff rejects writer-produced files.  The narrower 32-bit rules depend
   on the chunk index type, which is encoded AFTER the dimensions, and are
   applied by h5policy_chunk_size32_verdict once the caller knows it.

   Call once per (nonzero) dimension with the running product, starting at 1.
   Returns the new product, or the poison sentinel once 64-bit representability
   is blown; the sentinel emits the finding exactly once and is then carried
   through the rest of the loop.  Both divisions are safe: `acc` starts at 1 and
   only ever grows, and zero dims are rejected by the caller before this runs.  */
fun h5policy_chunk_size_accum_with_sources = (
    uint<64> acc, uint<64> dim, off64 loc, uint<64> field_width,
    uint<64>[] source_offsets, uint<64>[] source_lengths,
    string object) uint<64>:
{
    if (acc == H5POLICY_CHUNK_SIZE_UNKNOWN)
        return acc;                     /* already flagged; stay poisoned */
    if (dim != 0UL && acc != 0UL && dim > H5POLICY_CHUNK_SIZE_UNKNOWN / acc)
        {
            /* The product itself is not representable, so the evidence names
               the operands instead: the dimension that overflowed it, against
               the largest dimension that would still have fit.  */
            var largest = H5POLICY_CHUNK_SIZE_UNKNOWN / acc;
            if (source_offsets'length != 0UL
                && source_offsets'length == source_lengths'length)
                h5policy_emit_error_ev(
                    "H5_CORRUPT_CHUNK_SIZE_PRODUCT_OVERFLOW", "corrupt",
                    loc, object,
                    "chunk dimensions multiply past a representable byte size",
                    H5Evidence {
                        field = "layout.chunk_size_product_dimension",
                        actual = dim, expected = largest,
                        comparison = "less_than_or_equal",
                        source_offsets = source_offsets,
                        source_lengths = source_lengths,
                    });
            else if (field_width != 0UL)
                h5policy_emit_error_ev(
                    "H5_CORRUPT_CHUNK_SIZE_PRODUCT_OVERFLOW", "corrupt",
                    loc, object,
                    "chunk dimensions multiply past a representable byte size",
                    H5Evidence {
                        field = "layout.chunk_size_product_dimension",
                        actual = dim, expected = largest,
                        comparison = "less_than_or_equal",
                        has_loc1 = 1, loc1_role = "actual_source",
                        loc1 = loc, loc1_len = field_width,
                    });
            else
                h5policy_emit_error_ev(
                    "H5_CORRUPT_CHUNK_SIZE_PRODUCT_OVERFLOW", "corrupt",
                    loc, object,
                    "chunk dimensions multiply past a representable byte size",
                    H5Evidence {
                        field = "layout.chunk_size_product_dimension",
                        actual = dim, expected = largest,
                        comparison = "less_than_or_equal",
                    });
            return H5POLICY_CHUNK_SIZE_UNKNOWN;
        }
    return acc * dim;
}

/* Compatibility seam for arithmetic unit tests that have a value but no
   corresponding encoded field width.  */
fun h5policy_chunk_size_accum = (uint<64> acc, uint<64> dim,
                                 off64 loc, string object) uint<64>:
{
    return h5policy_chunk_size_accum_with_sources(
        acc, dim, loc, 0UL, uint<64>[](), uint<64>[](), object);
}

/* Apply the 32-bit chunk-size rules once the whole dimension vector and the
   chunk index type are known.  Two DIFFERENT statements, which the previous
   single unconditional bound conflated:

     * A chunk above 4 GiB cannot be indexed by a v1 B-tree.  That index's
       record carries the chunk byte size in a four-byte field, so the geometry
       is unrepresentable on disk and libhdf5 refuses the dataset at open
       (H5Dchunk.c:1185).  Corruption, and the oracle and the library agree.

     * A chunk above 4 GiB below layout message version 5 is FORMAT-LEGAL.
       libhdf5 declines to create one (H5Dchunk.c:917) but deliberately opens
       one, because "they're not disallowed by the file format".  A library
       older than 2.0.0 cannot read it, so this is a compatibility statement --
       an advisory, the same shape as the external-link path advisories -- and
       not a defect in the file.

   Layout versions 1, 2 and 3 have no encoded index type: the index is always
   the v1 B-tree, so those callers pass idx_is_v1_btree.  Layout versions 4 and
   5 cannot legitimately carry one (a v1 B-tree index type in a v4 message is
   rejected as an unknown index type, matching libhdf5), so they pass 0 and
   reach at most the advisory.  */
fun h5policy_chunk_size32_verdict = (
    uint<64> product, uint<8> idx_is_v1_btree, uint<64> layout_version,
    off64 loc, uint<64>[] source_offsets, uint<64>[] source_lengths,
    string object) void:
{
    if (product == H5POLICY_CHUNK_SIZE_UNKNOWN || product <= 0xffffffffUL)
        return;
    var has_sources = source_offsets'length != 0UL
                      && source_offsets'length == source_lengths'length;
    if (idx_is_v1_btree != 0UB)
        {
            if (has_sources)
                h5policy_emit_error_ev(
                    "H5_CORRUPT_CHUNK_SIZE_EXCEEDS_32BIT", "corrupt",
                    loc, object,
                    "chunk byte size exceeds the 32-bit size field of a v1 B-tree chunk index",
                    H5Evidence {
                        field = "layout.chunk_size_overflow_product",
                        actual = product, expected = 0xffffffffUL,
                        comparison = "less_than_or_equal",
                        source_offsets = source_offsets,
                        source_lengths = source_lengths,
                    });
            else
                h5policy_emit_error_ev(
                    "H5_CORRUPT_CHUNK_SIZE_EXCEEDS_32BIT", "corrupt",
                    loc, object,
                    "chunk byte size exceeds the 32-bit size field of a v1 B-tree chunk index",
                    H5Evidence {
                        field = "layout.chunk_size_overflow_product",
                        actual = product, expected = 0xffffffffUL,
                        comparison = "less_than_or_equal",
                    });
        }
    else if (layout_version < 5UL)
        h5policy_emit_warning(
            "H5_ADVISORY_CHUNK_SIZE_REQUIRES_LAYOUT_V5", loc, object,
            "chunk byte size above 4 GiB is only readable by libhdf5 2.0.0 or later at this layout version");
}

/* v4/v5 chunked layout: validate the chunk dimensions and dispatch on the
   chunk-index type (single/implicit/fixed-array/extensible-array/v2-btree).
   Split out of h5policy_validate_layout_payload.

   The layout message is encoded identically in both versions, so this decoder
   is shared.  Note that libhdf5's v4-and-later decoder accepts ndims == 0
   (H5Olayout.c bounds dimensionality only from above) and refuses such a
   dataset only later, on the chunk size; h5policy refuses the message itself.  */
fun h5policy_layout_chunked_v4_v5 = (int ios, H5PolicyProfile profile,
                                    H5WalkContext ctx,
                                    offset<uint<64>,B> payload_off,
                                    uint<64> msg_size, uint<64> version,
                                    string object) H5WalkContext:
{
    /* Byte 2 is the chunked-layout flags field; the only bit this validator
       needs is the filtered single-chunk marker, read where the index type is
       resolved below.  */
    var chunk_flags = h5policy_msg_u64_at(ios, profile,
                                          payload_off + 2#B, 1UL);
    var ndims4 = h5policy_msg_u64_at(ios, profile,
                                     payload_off + 3#B, 1UL);
    if (ndims4 == 0UL || ndims4 > H5O_LAYOUT_NDIMS)
        h5policy_emit_error("H5_CORRUPT_LAYOUT_DIMENSIONALITY",
                            "corrupt", payload_off + 3#B, object,
                            "layout dimensionality is out of range");
    var enc = h5policy_msg_u64_at(ios, profile,
                                  payload_off + 4#B, 1UL);
    var dims_rel4 = 5UL;
    var dims_bytes4 = h5policy_checked_mul_u64(ndims4, enc,
                                               0xffffffffffffffffUL,
                                               "H5_CORRUPT_LENGTH_OVERFLOW",
                                               "corrupt",
                                               payload_off, object,
                                               "chunk dimension byte count overflow");
    var idx_type_rel = dims_rel4 + dims_bytes4;
    var chunk_elem_count = 1UL;
    var chunk_byte_size = 1UL;
    var chunk_dims_ok = 1UB;
    if (h5policy_payload_range_ok(msg_size, dims_rel4,
                                  dims_bytes4,
                                  "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                  payload_off, object,
                                  "chunk dimensions overrun the layout message"))
        {
            /* Chunk dimensions multiply into a per-chunk element count.  As in
               the legacy encodings the final dimension is the element size in
               bytes, not a data dimension, so it is range-checked but excluded
               from the element-count product (a v4 chunk stores rank+1 dims).
               That count is used only for budget estimates and the filter
               chunk-consistency check; raw chunk data is still not read.  */
            var k = 0UL;
            var chunk_source_offsets4 = uint<64>[]();
            var chunk_source_lengths4 = uint<64>[]();
            while (k < ndims4)
                {
                    var dim4_off = payload_off
                        + (dims_rel4 + k * enc)#B;
                    var dim4 = h5policy_msg_u64_at(ios, profile, dim4_off, enc);
                    if (dim4 == 0UL)
                        {
                            chunk_dims_ok = 0UB;
                            h5policy_emit_error("H5_CORRUPT_ZERO_CHUNK_DIMENSION",
                                                "corrupt",
                                                payload_off, object,
                                                "chunk dimension is zero");
                        }
                    else
                        {
                            chunk_source_offsets4 += [dim4_off/#B];
                            chunk_source_lengths4 += [enc];
                            if (k + 1UL < ndims4)
                                {
                                    /* Data dimensions only: the chunk grid a
                                       fixed-array index's capacity was
                                       computed from at creation time.  */
                                    h5policy_chunk_grid_dims += [dim4];
                                    chunk_elem_count =
                                        h5policy_checked_mul_u64(chunk_elem_count, dim4,
                                                                 0xffffffffffffffffUL,
                                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                                 "corrupt", payload_off, object,
                                                                 "chunk element count overflow");
                                }
                            /* All dims (incl. the trailing element-size dim)
                               multiply into libhdf5's 32-bit chunk.size. */
                            chunk_byte_size =
                                h5policy_chunk_size_accum_with_sources(
                                    chunk_byte_size, dim4, dim4_off, enc,
                                    chunk_source_offsets4, chunk_source_lengths4,
                                    object);
                        }
                    k = k + 1UL;
                }
            if (chunk_dims_ok != 0UB)
                {
                    h5policy_chunk_size32_verdict(chunk_byte_size, 0UB, version,
                                                  payload_off + dims_rel4#B,
                                                  chunk_source_offsets4,
                                                  chunk_source_lengths4,
                                                  object);
                    ctx.has_chunked_layout = 1UB;
                    ctx.chunk_dataset_element_count = chunk_elem_count;
                }
        }
    if (h5policy_payload_range_ok(msg_size, idx_type_rel, 1UL,
                                  "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                  payload_off, object,
                                  "chunk index type overruns the layout message"))
        {
            var idx_type = h5policy_msg_u64_at(ios, profile,
                                               payload_off + idx_type_rel#B,
                                               1UL);
            var idx_info_len = 0UL;
            /* Index-type-specific payload before the shared address field.
               Type 2 has no extra bytes; fixed/extensible/v2 B-tree indexes
               carry small creation parameters before the address.

               A SINGLE CHUNK index normally has none either -- but when the
               chunked-layout flags carry H5O_LAYOUT_CHUNK_SINGLE_INDEX_WITH_
               FILTER (0x02) it keeps the one chunk's FILTERED size and filter
               mask in the layout message itself, ahead of the address
               (H5Olayout.c, case H5D_CHUNK_IDX_SINGLE).  Missing that shifted
               the address read by size-of-lengths plus four and made h5policy
               decode a filtered single-chunk dataset's address from the size
               field -- silently, because the value it landed on was still
               inside the file.  Measured on valid/layout_v5_single_filtered.h5:
               the address read as 256 where the file stores 2048.  */
            var single_filtered = (chunk_flags & 0x2UL) != 0UL;
            var single_size_rel = idx_type_rel + 1UL;
            if (idx_type == 1UL)
                idx_info_len = single_filtered
                               ? (global_sizeof_lengths as uint<64>) + 4UL : 0UL;
            else if (idx_type == 2UL)
                idx_info_len = 0UL;
            else if (idx_type == 3UL)
                idx_info_len = 1UL;
            else if (idx_type == 4UL)
                idx_info_len = 5UL;
            else if (idx_type == 5UL)
                idx_info_len = 6UL;
            else
                h5policy_emit_error("H5_CORRUPT_UNKNOWN_CHUNK_INDEX_TYPE",
                                    "corrupt", payload_off, object,
                                    "unknown chunk index type");

            var idx_addr_rel = idx_type_rel + 1UL + idx_info_len;
            if (h5policy_payload_range_ok(msg_size, idx_addr_rel,
                                          global_sizeof_offsets as uint<64>,
                                          "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                          payload_off, object,
                                          "chunk index address overruns the layout message"))
                {
                    var idx_addr4 = h5policy_msg_addr_at(ios, profile,
                                                        payload_off + idx_addr_rel#B,
                                                        global_sizeof_offsets as uint<64>);
                    if (idx_type == 5UL
                        && idx_addr4 != 0UL
                        && idx_addr4 != 0xffffffffffffffffUL)
                        /* v2 B-tree chunk indexes expose a checksummed header
                           and a recursively traversed node graph.  The real
                           dataset rank excludes the trailing element-size
                           dimension stored in the v4 layout. */
                        ctx = h5policy_walk_v2_btree_chunks(ios, profile, ctx,
                                                            idx_addr4,
                                                            ndims4 > 0UL
                                                            ? ndims4 - 1UL : 0UL,
                                                            chunk_byte_size,
                                                            payload_off + idx_addr_rel#B,
                                                            object);
                    else if (idx_type == 3UL
                             && idx_addr4 != 0UL
                             && idx_addr4 != 0xffffffffffffffffUL)
                        /* Fixed arrays are used when the chunk grid does not
                           grow.  The walker counts elements as chunks and
                           verifies initialized chunk addresses.  */
                        ctx = h5policy_walk_fixed_array_chunks(ios, profile, ctx,
                                                               idx_addr4,
                                                               payload_off + idx_addr_rel#B,
                                                               object);
                    else if (idx_type == 4UL
                             && idx_addr4 != 0UL
                             && idx_addr4 != 0xffffffffffffffffUL)
                        {
                            /* Extensible arrays should accompany an unlimited
                               dataspace dimension.  If the dataspace has
                               already been seen and it is bounded, flag the
                               inconsistency before walking the index root.  */
                            if (ctx.has_dataspace != 0UB
                                && ctx.dataspace_has_unlimited_dim == 0UB)
                                h5policy_emit_error("H5_CORRUPT_CHUNK_INDEX_WITHOUT_UNLIMITED_DIM",
                                                    "corrupt",
                                                    payload_off + idx_type_rel#B,
                                                    object,
                                                    "extensible-array chunk index requires an unlimited dataspace dimension");
                            ctx = h5policy_walk_ext_array_chunks(ios, profile, ctx,
                                                                 idx_addr4,
                                                                 chunk_byte_size,
                                                                 payload_off + idx_addr_rel#B,
                                                                 object);
                        }
                    else if (idx_type == 2UL)
                        {
                            /* Implicit: chunks stored contiguously from a base
                               address, no index structure.  Estimate the chunk
                               count from the dataspace and chunk element counts. */
                            if (idx_addr4 != 0UL
                                && idx_addr4 != 0xffffffffffffffffUL)
                                {
                                    var nch = 1UL;
                                    if (ctx.has_dataspace != 0UB
                                        && chunk_elem_count != 0UL)
                                        nch = (ctx.dataset_element_count
                                               + chunk_elem_count - 1UL)
                                              / chunk_elem_count;
                                    ctx = h5policy_count_chunks(
                                        ctx, profile, nch,
                                        payload_off + idx_addr_rel#B, object,
                                        "chunk count exceeds the selected profile limit");
                                    if (idx_addr4 >= (h5policy_ceiling(ios)))
                                        h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE", "corrupt",
                                                            payload_off + idx_addr_rel#B, object,
                                                            "implicit chunk base address outside file");
                                }
                        }
                    else if (idx_type == 1UL)
                        {
                            /* Single Chunk: the address field is
                               the one chunk's data address.  */
                            if (idx_addr4 != 0UL
                                && idx_addr4 != 0xffffffffffffffffUL)
                                {
                                    ctx = h5policy_count_chunks(
                                        ctx, profile, 1UL,
                                        payload_off + idx_addr_rel#B, object,
                                        "chunk count exceeds the selected profile limit");
                                    /* The extent, not just the start address.
                                       This index keeps no records, so it never
                                       reached a chunk-index walker and its one
                                       chunk was the only raw-data extent in the
                                       format that went undeclared -- measured:
                                       a writer-produced single-chunk dataset
                                       repointed at the root object header was
                                       ACCEPTED, and h5dump returned the header
                                       bytes as dataset values.  Same invariant
                                       as every other chunk record, missing for
                                       one index type; see
                                       registry/cases/single-chunk-index-data-
                                       extent.yml.

                                       The stored size is the FILTERED size when
                                       the layout carries one, exactly as a
                                       filtered index record's is, and otherwise
                                       the dimension product.  A poisoned
                                       product declares nothing: the overflow
                                       has already been reported and an extent
                                       derived from it would be fiction.  */
                                    var stored = chunk_byte_size;
                                    if (single_filtered)
                                        stored = h5policy_msg_u64_at(
                                            ios, profile,
                                            payload_off + single_size_rel#B,
                                            global_sizeof_lengths as uint<64>);
                                    if (stored != H5POLICY_CHUNK_SIZE_UNKNOWN
                                        && h5policy_chunk_record_size_ok(
                                               stored,
                                               payload_off + idx_addr_rel#B,
                                               object, "single-chunk"))
                                        {
                                            var ok = h5policy_checked_addr_range(
                                                idx_addr4, stored,
                                                h5policy_ceiling(ios),
                                                "single-chunk data outside file",
                                                payload_off + idx_addr_rel#B,
                                                object);
                                            if (ok)
                                                ok = h5policy_data_extent_disjoint(
                                                    idx_addr4, stored,
                                                    payload_off + idx_addr_rel#B,
                                                    object, "chunk");
                                        }
                                    else if (idx_addr4 >= (h5policy_ceiling(ios)))
                                        h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE", "corrupt",
                                                            payload_off + idx_addr_rel#B, object,
                                                            "single-chunk data address outside file");
                                }
                        }
                    else
                        /* An unrecognized index form is still counted as one
                           chunk-index reference so profile budgets and
                           coverage-gap reporting stay honest. */
                        ctx = h5policy_note_chunk_index_addr(ctx, profile,
                                                             idx_addr4,
                                                             payload_off + idx_addr_rel#B,
                                                             object);
                }
        }

    return ctx;
}


/* Top-level layout-message validator.  HDF5 defines five layout-message
   versions; the meaning of the bytes after version/class changes substantially
   between them, so the parser keeps each version branch explicit instead of
   forcing a generic table-driven decoder.  Versions 1/2 and 4/5 each encode the
   message identically and therefore share a branch.  */
fun h5policy_validate_layout_payload = (int ios,
                                        H5PolicyProfile profile,
                                        H5WalkContext ctx,
                                        offset<uint<64>,B> payload_off,
                                        uint<64> msg_size,
                                        string object) H5WalkContext:
{
    if (!h5policy_payload_range_ok(msg_size, 0UL, 1UL,
                                   "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                   payload_off, object,
                                   "layout message is too small"))
        return ctx;

    var version = h5policy_msg_u64_at(ios, profile, payload_off, 1UL);
    var layout_class = 0UL;
    var file_size = h5policy_ceiling(ios);

    ctx.has_dataset_layout = 1UB;

    if (version == 1UL || version == 2UL)
        {
            /* v1/v2 layout messages have an 8-byte prefix and encode old-style
               chunked layouts with a v1 B-tree address plus 32-bit chunk dims. */
            if (!h5policy_payload_range_ok(msg_size, 0UL, 8UL,
                                           "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                           payload_off, object,
                                           "layout v1/v2 message is too small"))
                return ctx;

            var ndims = h5policy_msg_u64_at(ios, profile, payload_off + 1#B, 1UL);
            layout_class = h5policy_msg_u64_at(ios, profile, payload_off + 2#B, 1UL);

            /* Chunked storage has a floor as well as a ceiling: in versions 1
               to 3 the last chunk dimension is the element size, so a chunk
               needs at least one real dimension plus that one.  libhdf5 refuses
               fewer ("bad dimensions for chunked storage"); h5policy only
               rejected zero, so a one-dimensional chunked layout -- a chunk
               with no real dimensions at all -- was accepted.  The floor is
               specific to chunked: contiguous and compact layouts in the same
               versions are fine at ndims 1.  */
            if (layout_class == 2UL && ndims == 1UL)
                h5policy_emit_error_ev("H5_CORRUPT_LAYOUT_DIMENSIONALITY",
                                       "corrupt", payload_off + 1#B, object,
                                       "chunked layout declares fewer than two dimensions",
                                       H5Evidence {
                                           field = "layout.chunk_dimensionality",
                                           actual = ndims,
                                           expected = 2UL,
                                           comparison = "at_least",
                                           has_loc1 = 1, loc1_role = "actual",
                                           loc1 = payload_off + 1#B, loc1_len = 1UL,
                                       });
            if (ndims == 0UL || ndims > H5O_LAYOUT_NDIMS)
                h5policy_emit_error("H5_CORRUPT_LAYOUT_DIMENSIONALITY",
                                    "corrupt", payload_off + 1#B, object,
                                    "layout dimensionality is out of range");
            /* V1/V2 CONTIGUOUS WAS NOT DECODED AT ALL before this: the branch
               handled only chunked and compact, so the data address was never
               even read, and neither the extent bound nor the metadata-overlap
               check could see such a dataset.  The corpus specimen is exactly
               this shape -- a version-1 contiguous layout.

               The v1/v2 prefix is version, dimensionality, class and five
               reserved bytes, so the address sits at payload_off + 8.  Only the
               address is recorded: libhdf5 DISCARDS the stored size for these
               versions, recomputing it from the dataspace and datatype
               (H5Dcontig.c:536-551), so the trailing 4-byte dimensions carry no
               size the file can be held to and has_contiguous_layout stays
               unset -- setting it would make the stored-size comparison above
               fire on a quantity libhdf5 overwrites.  */
            if (layout_class == CONTIG as uint<64>
                && h5policy_payload_range_ok(msg_size, 0UL,
                                             8UL + (global_sizeof_offsets as uint<64>),
                                             "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                             payload_off, object,
                                             "contiguous v1/v2 layout message is too small"))
                {
                    var v12_addr_raw = h5policy_msg_bytes(ios, profile,
                                                          payload_off + 8#B,
                                                          global_sizeof_offsets as uint<64>);
                    /* An undefined address means unallocated storage, which
                       libhdf5 skips (H5Dcontig.c:399). */
                    if (!h5policy_msg_addr_is_undef(v12_addr_raw))
                        {
                            ctx.contiguous_layout_addr =
                                hdf5_addr_to_file_u64(bytes_to_u64_le(v12_addr_raw));
                            ctx.contiguous_layout_addr_offset =
                                (payload_off + 8#B)/#B;
                        }
                }

            if (layout_class == CHUNKED as uint<64>)
                {
                    /* Legacy chunked layout stores dataset-rank-plus-one dims:
                       the extra dimension carries element size.  The shared
                       rank updater compares it with the dataspace when known. */
                    ctx.has_legacy_chunked_layout = 1UB;
                    ctx.legacy_chunked_layout_ndims = ndims;
                    ctx.legacy_chunked_layout_ndims_offset =
                        (payload_off + 1#B)/#B;
                    ctx = h5policy_update_legacy_chunked_layout_rank(ctx,
                                                                     payload_off + 1#B,
                                                                     object);
                    var idx_addr = h5policy_msg_addr_at(ios, profile,
                                                       payload_off + 8#B,
                                                       global_sizeof_offsets as uint<64>);
                    if (idx_addr != 0UL && idx_addr != 0xffffffffffffffffUL)
                        {
                            if (idx_addr >= file_size)
                                h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                                    "corrupt",
                                                    payload_off + 8#B, object,
                                                    "chunk B-tree address outside file");
                            else
                                /* Entry node: no parent level to match. */
                                ctx = h5policy_walk_chunk_btree(ios, profile, ctx,
                                                                idx_addr, ndims,
                                                                object, 0UL,
                                                                H5POLICY_BTREE_LEVEL_UNKNOWN);
                        }
                    var dims_rel = 8UL + (global_sizeof_offsets as uint<64>);
                    var dims_bytes = h5policy_checked_mul_u64(ndims, 4UL,
                                                             0xffffffffffffffffUL,
                                                             "H5_CORRUPT_LENGTH_OVERFLOW",
                                                             "corrupt",
                                                             payload_off, object,
                                                             "chunk dimension byte count overflow");
                    if (h5policy_payload_range_ok(msg_size, dims_rel, dims_bytes,
                                                  "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                                  payload_off, object,
                                                  "chunk dimensions overrun the layout message"))
                        {
                            var i = 0UL;
                            var chunk_dims_ok = 1UB;
                            var chunk_elem_count = 1UL;
                            var chunk_byte_size = 1UL;
                            var chunk_source_offsets = uint<64>[]();
                            var chunk_source_lengths = uint<64>[]();
                            while (i < ndims)
                                {
                                    var dim_off = payload_off
                                        + (dims_rel + i * 4UL)#B;
                                    var dim = h5policy_msg_u64_at(ios, profile,
                                                                  dim_off, 4UL);
                                    if (dim == 0UL)
                                        {
                                            chunk_dims_ok = 0UB;
                                            h5policy_emit_error("H5_CORRUPT_ZERO_CHUNK_DIMENSION",
                                                                "corrupt",
                                                                payload_off, object,
                                                                "chunk dimension is zero");
                                        }
                                    else
                                        {
                                            chunk_source_offsets += [dim_off/#B];
                                            chunk_source_lengths += [4UL];
                                            if (i + 1UL < ndims)
                                                chunk_elem_count =
                                                    h5policy_checked_mul_u64(chunk_elem_count, dim,
                                                                             0xffffffffffffffffUL,
                                                                             "H5_CORRUPT_LENGTH_OVERFLOW",
                                                                             "corrupt",
                                                                             payload_off, object,
                                                                             "chunk element count overflow");
                                            /* All dims (incl. the trailing element-size
                                               dim) multiply into libhdf5's 32-bit
                                               chunk.size. */
                                            chunk_byte_size =
                                                h5policy_chunk_size_accum_with_sources(
                                                    chunk_byte_size, dim,
                                                    dim_off, 4UL,
                                                    chunk_source_offsets,
                                                    chunk_source_lengths,
                                                    object);
                                        }
                                    i = i + 1UL;
                                }
                            if (chunk_dims_ok != 0UB)
                                {
                                    h5policy_chunk_size32_verdict(
                                        chunk_byte_size, 1UB, version,
                                        payload_off + dims_rel#B,
                                        chunk_source_offsets,
                                        chunk_source_lengths, object);
                                    ctx.has_chunked_layout = 1UB;
                                    ctx.chunk_dataset_element_count = chunk_elem_count;
                                }
                        }
                }
            else if (layout_class == COMPACT as uint<64>)
                {
                    /* For v1/v2 compact layout, dimensions precede the embedded
                       data-size field.  The data itself is not interpreted.  */
                    var compact_dims_rel = 8UL;
                    var compact_dims_bytes =
                        h5policy_checked_mul_u64(ndims, 4UL,
                                                 0xffffffffffffffffUL,
                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                 "corrupt",
                                                 payload_off, object,
                                                 "compact dimension byte count overflow");
                    if (h5policy_payload_range_ok(msg_size, compact_dims_rel,
                                                  compact_dims_bytes,
                                                  "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                                  payload_off, object,
                                                  "compact dimensions overrun the layout message"))
                        {
                            var compact_size_rel =
                                h5policy_checked_add_u64(compact_dims_rel,
                                                         compact_dims_bytes,
                                                         0xffffffffffffffffUL,
                                                         "H5_CORRUPT_LENGTH_OVERFLOW",
                                                         "corrupt",
                                                         payload_off, object,
                                                         "compact data-size offset overflow");
                            ctx = h5policy_validate_compact_layout_data(ios, profile,
                                                                        ctx, payload_off, msg_size,
                                                                        compact_size_rel, 4UL,
                                                                        object);
                        }
                }
        }
    else if (version == 3UL)
        {
            /* v3 separates layout class from dimensionality.  Contiguous and
               compact layouts share helpers with v4, while chunked v3 still
               uses the legacy v1 B-tree index.  */
            if (!h5policy_payload_range_ok(msg_size, 0UL, 2UL,
                                           "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                           payload_off, object,
                                           "layout v3 message is too small"))
                return ctx;

            layout_class = h5policy_msg_u64_at(ios, profile, payload_off + 1#B, 1UL);
            if (layout_class == CONTIG as uint<64>)
                /* Contiguous data is a single file extent.  The extent is
                   bounds-checked but the bytes are never interpreted.  */
                ctx = h5policy_check_contiguous_extent(ios, profile, ctx,
                                                       payload_off, msg_size,
                                                       file_size, object);
            else if (layout_class == CHUNKED as uint<64>)
                {
                    /* The v3 chunked form stores the chunk-index address before
                       dimensions.  Validate the index, then validate each
                       declared chunk dimension if the payload is long enough. */
                    if (h5policy_payload_range_ok(msg_size, 0UL,
                                                  3UL + (global_sizeof_offsets as uint<64>),
                                                  "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                                  payload_off, object,
                                                  "chunked layout message is too small"))
                        {
                            var ndims3 = h5policy_msg_u64_at(ios, profile,
                                                             payload_off + 2#B, 1UL);
                            /* Same floor as v1/v2: the trailing dimension is
                               the element size (H5Olayout.c, "bad dimensions
                               for chunked storage").  Version 4 dropped that
                               convention and stores the dataset rank directly,
                               so it has no floor and none is applied there.  */
                            if (ndims3 == 1UL)
                                h5policy_emit_error_ev("H5_CORRUPT_LAYOUT_DIMENSIONALITY",
                                                       "corrupt", payload_off + 2#B, object,
                                                       "chunked layout declares fewer than two dimensions",
                                                       H5Evidence {
                                                           field = "layout.chunk_dimensionality",
                                                           actual = ndims3,
                                                           expected = 2UL,
                                                           comparison = "at_least",
                                                           has_loc1 = 1, loc1_role = "actual",
                                                           loc1 = payload_off + 2#B,
                                                           loc1_len = 1UL,
                                                       });
                            if (ndims3 == 0UL || ndims3 > H5O_LAYOUT_NDIMS)
                                h5policy_emit_error("H5_CORRUPT_LAYOUT_DIMENSIONALITY",
                                                    "corrupt", payload_off + 2#B, object,
                                                    "layout dimensionality is out of range");
                            ctx.has_legacy_chunked_layout = 1UB;
                            ctx.legacy_chunked_layout_ndims = ndims3;
                            ctx.legacy_chunked_layout_ndims_offset =
                                (payload_off + 2#B)/#B;
                            ctx = h5policy_update_legacy_chunked_layout_rank(ctx,
                                                                             payload_off + 2#B,
                                                                             object);
                            var idx_addr3 = h5policy_msg_addr_at(ios, profile,
                                                                payload_off + 3#B,
                                                                global_sizeof_offsets as uint<64>);
                            if (idx_addr3 != 0UL && idx_addr3 != 0xffffffffffffffffUL)
                                {
                                    if (idx_addr3 >= file_size)
                                        h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                                            "corrupt",
                                                            payload_off + 3#B,
                                                            object,
                                                            "chunk B-tree address outside file");
                                    else
                                        /* Entry node: no parent level to match. */
                                        ctx = h5policy_walk_chunk_btree(ios, profile, ctx,
                                                                        idx_addr3, ndims3,
                                                                        object, 0UL,
                                                                        H5POLICY_BTREE_LEVEL_UNKNOWN);
                                }
                            var dims_rel3 = 3UL + (global_sizeof_offsets as uint<64>);
                            var dims_bytes3 = h5policy_checked_mul_u64(ndims3,
                                                                      4UL,
                                                                      0xffffffffffffffffUL,
                                                                      "H5_CORRUPT_LENGTH_OVERFLOW",
                                                                      "corrupt",
                                                                      payload_off, object,
                                                                      "chunk dimension byte count overflow");
                            if (h5policy_payload_range_ok(msg_size, dims_rel3,
                                                          dims_bytes3,
                                                          "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                                          payload_off, object,
                                                          "chunk dimensions overrun the layout message"))
                                {
                                    var j = 0UL;
                                    var chunk_dims3_ok = 1UB;
                                    var chunk_elem3_count = 1UL;
                                    var chunk_byte3_size = 1UL;
                                    var chunk_source_offsets3 = uint<64>[]();
                                    var chunk_source_lengths3 = uint<64>[]();
                                    while (j < ndims3)
                                        {
                                            var dim3_off = payload_off
                                                + (dims_rel3 + j * 4UL)#B;
                                            var dim3 = h5policy_msg_u64_at(
                                                ios, profile, dim3_off, 4UL);
                                            if (dim3 == 0UL)
                                                {
                                                    chunk_dims3_ok = 0UB;
                                                    h5policy_emit_error("H5_CORRUPT_ZERO_CHUNK_DIMENSION",
                                                                        "corrupt",
                                                                        payload_off, object,
                                                                        "chunk dimension is zero");
                                                }
                                            else
                                                {
                                                    chunk_source_offsets3 +=
                                                        [dim3_off/#B];
                                                    chunk_source_lengths3 += [4UL];
                                                    if (j + 1UL < ndims3)
                                                        chunk_elem3_count =
                                                            h5policy_checked_mul_u64(chunk_elem3_count, dim3,
                                                                                     0xffffffffffffffffUL,
                                                                                     "H5_CORRUPT_LENGTH_OVERFLOW",
                                                                                     "corrupt",
                                                                                     payload_off, object,
                                                                                     "chunk element count overflow");
                                                    /* All dims (incl. the trailing
                                                       element-size dim) multiply into
                                                       libhdf5's 32-bit chunk.size. */
                                                    chunk_byte3_size =
                                                        h5policy_chunk_size_accum_with_sources(
                                                            chunk_byte3_size, dim3,
                                                            dim3_off, 4UL,
                                                            chunk_source_offsets3,
                                                            chunk_source_lengths3,
                                                            object);
                                                }
                                            j = j + 1UL;
                                        }
                                    if (chunk_dims3_ok != 0UB)
                                        {
                                            h5policy_chunk_size32_verdict(
                                                chunk_byte3_size, 1UB, version,
                                                payload_off + dims_rel3#B,
                                                chunk_source_offsets3,
                                                chunk_source_lengths3, object);
                                            ctx.has_chunked_layout = 1UB;
                                            ctx.chunk_dataset_element_count = chunk_elem3_count;
                                        }
                                }
                        }
                }
            else if (layout_class == COMPACT as uint<64>)
                /* v3 compact layout puts the two-byte data-size field directly
                   after version/class.  */
                ctx = h5policy_validate_compact_layout_data(ios, profile,
                                                            ctx, payload_off, msg_size,
                                                            2UL, 2UL, object);
        }
    else if (version == 4UL || version == 5UL)
        {
            /* v4 is the modern layout message.  Chunked datasets choose an
               explicit index type, compact/contiguous reuse small fixed forms,
               and virtual datasets are a policy feature rather than corruption.
               v5 (libhdf5 2.x, H5F_LIBVER_V200) encodes that message
               identically; it differs only in the *chunk index records*,
               where the filtered-chunk size field becomes size-of-lengths wide
               instead of the v4 "just wide enough for the unfiltered chunk plus
               one byte" width.  Those records are decoded from self-describing
               index headers (fixed/extensible array `raw_elmt_size`, v2 B-tree
               `record_size`), so both widths validate without a version switch
               and the two versions share this branch.  */
            if (!h5policy_payload_range_ok(msg_size, 0UL, 2UL,
                                           "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                           payload_off, object,
                                           "layout v4/v5 message is too small"))
                return ctx;

            layout_class = h5policy_msg_u64_at(ios, profile, payload_off + 1#B, 1UL);
            if (layout_class == COMPACT as uint<64>)
                /* v4 compact uses the same compact data encoding as v3.  */
                ctx = h5policy_validate_compact_layout_data(ios, profile,
                                                            ctx, payload_off, msg_size,
                                                            2UL, 2UL, object);

            if (layout_class == CONTIG as uint<64>)
                /* v4 contiguous uses the same address/size layout as v3.  */
                ctx = h5policy_check_contiguous_extent(ios, profile, ctx,
                                                       payload_off, msg_size,
                                                       file_size, object);

            if (layout_class == VIRTUAL as uint<64>)
                {
                    /* A virtual dataset may name other files through VDS
                       mappings.  h5policy records the feature and lets the
                       active profile decide whether that indirection is allowed. */
                    h5policy_note_vds;
                    if (profile.features.allow_vds == 0UB)
                        h5policy_emit_error("H5_POLICY_VDS", "policy",
                                            payload_off, object,
                                            "virtual dataset layout encountered; profile denies VDS");
                    h5policy_validate_vds_layout(ios, profile, payload_off,
                                                 msg_size, object);
                }

            if (layout_class == CHUNKED as uint<64>
                && h5policy_payload_range_ok(msg_size, 0UL, 5UL,
                                             "H5_CORRUPT_LAYOUT_MESSAGE_TOO_SMALL",
                                             payload_off, object,
                                             "chunked v4/v5 layout message is too small"))
                    /* v4/v5 chunked layout is delegated because its index-type
                       matrix is larger than the other classes.  */
                    ctx = h5policy_layout_chunked_v4_v5(ios, profile, ctx,
                                                        payload_off, msg_size,
                                                        version, object);
        }
    else
        h5policy_emit_error("H5_CORRUPT_UNSUPPORTED_LAYOUT_VERSION",
                            "corrupt", payload_off, object,
                            "unsupported layout message version");

    /* THE VIRTUAL CLASS IS VERSION-GATED.  Class 3 is only legal from layout
       version 4 on, and libhdf5 refuses it below that through two separate
       doors:

         - versions 1 and 2 take their own decode block and allow only
           contiguous, chunked and compact -- anything else is "bad layout type
           for layout message" (H5Olayout.c:123-124);
         - version 3 shares the class switch with v4/v5, which opens
           `case H5D_VIRTUAL` with an explicit version test and fails with
           "invalid layout version with virtual layout" (H5Olayout.c:529-530).

       One predicate covers both because the h5policy-side rule is the same in
       each: the virtual class requires version >= 4.  The two upstream messages
       differ but the verdict does not.

       WHY IT WAS MISSED: h5policy only ever looks at the virtual class inside
       the v4/v5 branch, where it is a POLICY feature (VDS indirection) rather
       than corruption.  The v1/v2 and v3 branches dispatch on contiguous /
       chunked / compact and a class of 3 falls through all of them in silence,
       while the unknown-class check below cannot see it either, since 3 is a
       perfectly valid class value -- just not at these versions.  So the check
       belongs here, after the version dispatch, where the class is known for
       every version.

       MEASURED on a corpus specimen whose layout message is exactly
       `03 03 ffffffffffffffff ...` -- version 3, class 3, with an undefined VDS
       heap address.  libhdf5 refuses the open; h5policy accepted the file.  */
    if (layout_class == VIRTUAL as uint<64> && version < 4UL)
        h5policy_emit_error_ev(
            "H5_CORRUPT_LAYOUT_VIRTUAL_VERSION", "corrupt", payload_off, object,
            "virtual layout class requires layout version 4 or later",
            H5Evidence {
                field = "layout.virtual_version",
                actual = version,
                expected = 4UL,
                comparison = "at_least",
                has_loc1 = 1, loc1_role = "actual",
                loc1 = payload_off, loc1_len = 1UL,
            });

    /* Layout class values are shared across versions.  Unknown classes are
       structural corruption even when the version itself was recognized.  */
    if (layout_class > VIRTUAL as uint<64>)
        h5policy_emit_error("H5_CORRUPT_UNKNOWN_LAYOUT_CLASS",
                            "corrupt", payload_off, object,
                            "unknown data layout class");

    return h5policy_update_logical_dataset_size(ios, ctx, profile,
                                                payload_off, object);
}

/* Walk the n-bit filter's cd_values type tree, bounding it to the client-data
   array.  n-bit stores a self-describing type grammar after the 3-word header
   (total, flag, d_nelmts); libhdf5's decompressor walks it by indexing cd_values,
   so a tree that reaches past cd_nelmts is an out-of-bounds read of the parameter
   array (garbage read as precision/offset/size, then OOB on the data buffers).
   Node layouts (H5Znbit.c): ATOMIC(1)=class,size,order,precision,offset;
   NOOPTYPE(4)=class,size; ARRAY(2)=class,size,<base>; COMPOUND(3)=class,size,
   nmembers, then per member <byte-offset,<type>>.  This is metadata-only -- it
   bounds-checks parameter indices without decompressing.  Returns the index just
   past the node, or a poison value (> cd_nelmts, error already emitted) on
   overrun / unknown class / recursion limit; the while loop is bounded by
   cd_nelmts via the poison return even when nmembers is hostile.  */
fun h5policy_nbit_walk_params = (int ios, H5PolicyProfile profile,
                                 offset<uint<64>,B> cd_base, uint<64> cd_nelmts,
                                 uint<64> idx, uint<64> depth,
                                 offset<uint<64>,B> loc, string object) uint<64>:
{
    var poison = 0xffffffffffffffffUL;
    if (depth > profile.resources.max_filter_parameter_recursion_depth)
        {
            h5policy_emit_error("H5_RESOURCE_FILTER_PARAMETER_RECURSION_DEPTH",
                                "resource", loc, object,
                                "n-bit filter parameter tree nesting exceeds the profile limit");
            return poison;
        }
    if (idx >= cd_nelmts)
        {
            h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_OVERRUN", "corrupt", loc, object,
                                "n-bit filter parameter tree reads past the client-data array");
            return poison;
        }
    var cls = h5policy_msg_u64_at(ios, profile, cd_base + (idx * 4UL)#B, 4UL);
    if (cls == 1UL)          /* ATOMIC: class, size, order, precision, offset */
        {
            if (idx + 5UL > cd_nelmts)
                {
                    h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_OVERRUN", "corrupt", loc, object,
                                        "n-bit filter parameter tree reads past the client-data array");
                    return poison;
                }
            /* THE BOUND libhdf5 STATES AND CANNOT ENFORCE.  H5Znbit.c guards the
               unpacker with

                   if (p.precision > p.size * 8 || (p.precision + p.offset) > p.size * 8)

               and every field of parms_atomic is `unsigned`, so the SUM is
               evaluated in 32 bits and wraps.  An offset near 2**32 therefore
               passes a guard written to reject it.  Restated here without the
               wrap: subtract instead of adding, so nothing can carry.

               The same three lines appear in the COMPRESS path at H5Znbit.c
               with no guard at all, which is why this is checked on the
               parameters rather than on any one direction of travel.

               MEASURED on the 2.3.0 ASan build with precision 16, size 4 and
               offset 0xfffffff0 on a BIG-ENDIAN atomic node: heap-buffer-overflow
               WRITE of size 1 in H5Z__nbit_decompress_one_byte, reached from
               H5Z__nbit_decompress_one_atomic.  The little-endian arm of the same
               function computes `end_i = offset / 8` from the UNWRAPPED offset, so
               its loop never runs and the file merely decodes to zeros -- the
               byte order decides whether the identical parameters corrupt memory
               or only the data, which is why neither is treated as benign.  The
               stock build returns 0 either way.  */
            var a_size = h5policy_msg_u64_at(ios, profile, cd_base + ((idx + 1UL) * 4UL)#B, 4UL);
            var a_prec = h5policy_msg_u64_at(ios, profile, cd_base + ((idx + 3UL) * 4UL)#B, 4UL);
            var a_off = h5policy_msg_u64_at(ios, profile, cd_base + ((idx + 4UL) * 4UL)#B, 4UL);
            /* size is a 32-bit file field, so size * 8 cannot overflow 64 bits. */
            var a_bits = a_size * 8UL;
            if (a_prec > a_bits || a_off > a_bits - a_prec)
                {
                    h5policy_emit_error_ev("H5_CORRUPT_NBIT_ATOMIC_BOUNDS", "corrupt",
                                           loc, object,
                                           "n-bit atomic precision and offset exceed the element width",
                                           H5Evidence {
                                               field = "layout.nbit_atomic_bits",
                                               actual = a_prec > a_bits
                                                        ? a_prec : a_off,
                                               expected = a_prec > a_bits
                                                          ? a_bits : a_bits - a_prec,
                                               comparison = "at_most",
                                               has_loc1 = 1, loc1_role = "actual",
                                               loc1 = cd_base + ((a_prec > a_bits
                                                                  ? idx + 3UL
                                                                  : idx + 4UL) * 4UL)#B,
                                               loc1_len = 4UL,
                                           });
                    return poison;
                }
            return idx + 5UL;
        }
    if (cls == 4UL)          /* NOOPTYPE: class, size */
        {
            if (idx + 2UL > cd_nelmts)
                {
                    h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_OVERRUN", "corrupt", loc, object,
                                        "n-bit filter parameter tree reads past the client-data array");
                    return poison;
                }
            return idx + 2UL;
        }
    if (cls == 2UL)          /* ARRAY: class, size, then base type */
        {
            if (idx + 2UL > cd_nelmts)
                {
                    h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_OVERRUN", "corrupt", loc, object,
                                        "n-bit filter parameter tree reads past the client-data array");
                    return poison;
                }
            return h5policy_nbit_walk_params(ios, profile, cd_base, cd_nelmts,
                                             idx + 2UL, depth + 1UL, loc, object);
        }
    if (cls == 3UL)          /* COMPOUND: class, size, nmembers, then per member off+type */
        {
            if (idx + 3UL > cd_nelmts)
                {
                    h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_OVERRUN", "corrupt", loc, object,
                                        "n-bit filter parameter tree reads past the client-data array");
                    return poison;
                }
            var node_size = h5policy_msg_u64_at(ios, profile,
                                                cd_base + ((idx + 1UL) * 4UL)#B, 4UL);
            var nmembers = h5policy_msg_u64_at(ios, profile,
                                               cd_base + ((idx + 2UL) * 4UL)#B, 4UL);
            var cur = idx + 3UL;
            var j = 0UL;
            while (j < nmembers)
                {
                    if (cur >= cd_nelmts)     /* room for the member byte-offset word */
                        {
                            h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_OVERRUN", "corrupt", loc, object,
                                                "n-bit filter parameter tree reads past the client-data array");
                            return poison;
                        }
                    /* A member must fit inside the compound it belongs to.  Every
                       node class stores its size one word after its class word, so
                       the member's extent is offset + cd[cur+2].  libhdf5's
                       decompressor takes both on trust: it allocates the COMPOUND's
                       size and then writes each member at its own offset, so a
                       member at or past that size writes off the end of the buffer
                       -- heap-buffer-overflow WRITE in
                       H5Z__nbit_decompress_one_nooptype (corpus seed 43,
                       confirmed under ASAN: 1 byte past a 4294967280-byte region,
                       where 4294967280 is the compound size the parameters declare).
                       The surrounding walk only bounds parameter INDICES against
                       cd_nelmts, which this file satisfies -- the numbers it stores
                       are in range, they just describe an impossible type.  Both
                       reads are 4-byte fields, so the sum cannot overflow 64 bits. */
                    if (cur + 3UL <= cd_nelmts)
                        {
                            var member_off = h5policy_msg_u64_at(
                                ios, profile, cd_base + (cur * 4UL)#B, 4UL);
                            var member_size = h5policy_msg_u64_at(
                                ios, profile, cd_base + ((cur + 2UL) * 4UL)#B, 4UL);
                            if (member_off + member_size > node_size)
                                {
                                    h5policy_emit_error("H5_CORRUPT_NBIT_MEMBER_BOUNDS",
                                                        "corrupt", loc, object,
                                                        "n-bit compound member extends outside its parent type");
                                    return poison;
                                }
                        }
                    cur = cur + 1UL;          /* member byte offset */
                    cur = h5policy_nbit_walk_params(ios, profile, cd_base, cd_nelmts,
                                                    cur, depth + 1UL, loc, object);
                    if (cur > cd_nelmts)
                        return poison;         /* poison already reported downstream */
                    j = j + 1UL;
                }
            return cur;
        }
    h5policy_emit_error("H5_CORRUPT_NBIT_PARAMS_CLASS", "corrupt", loc, object,
                        "n-bit filter parameter tree has an unknown type class");
    return poison;
}

/* Validate the filter-pipeline message envelope.  Filter definitions are
   metadata; actual decode/decompression is intentionally outside h5policy's
   boundary and is reported as an advisory or policy finding.  */
/* `record_decode_nelmts` selects which capture the walk feeds, and the three
   modes must stay disjoint -- a heap pipeline seeding a DATASET's chunk
   consistency check was the original reason this parameter exists:
     0  record nothing (dense link/attr heaps: their pipelines are validated
        structurally, and nothing downstream consumes an extent from them)
     1  dataset dispatch path: record an n-bit/scale-offset filter's cd_values[2]
        (the chunk element count) and cd_values[4] into
        h5policy_pipeline_decode_nelmts / _decode_size for the finalize-time
        consistency check
     2  filtered fractal-heap path: record the pipeline's implied decoded extent
        into h5policy_heap_decode_extent, for the huge-object decoded-size check.
        Only the SOHM heap uses this, because only its huge-object index is
        walked.  */
/* Record what a FILTERED FRACTAL-HEAP pipeline's declared output extent would
   be, for the one filter class where that is a function of client data rather
   than of the data itself.  Never runs a transform.

   Both size-computable built-ins have the same shape -- output is
   cd_values[2] * cd_values[4], an element count times an element size:
     n-bit (5)        size_out = d_nelmts * cd_values[4]   (H5Znbit.c:949)
     scale-offset (6) size_out = d_nelmts * p.size         (H5Zscaleoffset.c:1217)
   and both have a PASS-THROUGH branch on which the output is instead the input
   length, which no metadata makes computable:
     n-bit        cd_values[1] nonzero            (H5Znbit.c:941)
     scale-offset scale_type is H5Z_SO_INT (2) and the scale factor equals
                  cd_values[4] * 8                (H5Zscaleoffset.c:1188)
   Scale-offset's H5Z_SO_FLOAT_ESCALE (1) is rejected outright by libhdf5
   (H5Zscaleoffset.c:1177), so it is not a decidable extent either.
   n-bit puts a self-describing type tree at cd_values[3..], so cd_values[4] is a
   flat element size ONLY when the root type is atomic (cd_values[3] == 1); on a
   compound or array root it is structural and the product means nothing.  The
   dataset-side capture makes the same distinction for the same reason.
   Deflate, szip and every dynamically registered filter are undecidable by
   construction: their output length is discovered by decompressing.  */
fun h5policy_pipeline_record_heap_extent = (int ios, H5PolicyProfile profile,
                                            uint<64> filter_id,
                                            offset<uint<64>,B> cd_base,
                                            uint<64> cd_nelmts) void:
{
    h5policy_heap_decode_filters = h5policy_heap_decode_filters + 1UL;
    if ((filter_id != 5UL && filter_id != 6UL) || cd_nelmts < 5UL)
        {
            h5policy_heap_decode_undecidable = 1UB;
            return;
        }
    var v1 = h5policy_msg_u64_at(ios, profile, cd_base + 4#B, 4UL);
    var v2 = h5policy_msg_u64_at(ios, profile, cd_base + 8#B, 4UL);
    var v3 = h5policy_msg_u64_at(ios, profile, cd_base + 12#B, 4UL);
    var v4 = h5policy_msg_u64_at(ios, profile, cd_base + 16#B, 4UL);
    var decidable = 1;
    if (filter_id == 5UL)
        {
            if (v1 != 0UL || v3 != 1UL)      /* pass-through, or structural size */
                decidable = 0;
        }
    else
        {
            var scale_type = h5policy_msg_u64_at(ios, profile, cd_base, 4UL);
            if (scale_type == 1UL)                       /* E-scale: libhdf5 errors */
                decidable = 0;
            else if (scale_type == 2UL && v1 == v4 * 8UL) /* full precision: verbatim */
                decidable = 0;
        }
    /* The product itself must not wrap the 64-bit accumulator; if it would, the
       extent is not a usable expectation and the record is left undecided.  */
    if (!decidable || v2 == 0UL || v4 == 0UL
        || v2 > 0xffffffffffffffffUL / v4)
        {
            h5policy_heap_decode_undecidable = 1UB;
            return;
        }
    h5policy_heap_decode_extent = v2 * v4;
    h5policy_heap_decode_extent_offset = (cd_base + 8#B)/#B;
}

/* A filter pipeline is encoded identically wherever it appears, so this one
   decoder serves four clients: a dataset's object-header PLINE message
   (h5_dispatch.pk) and the pipeline embedded in a filtered fractal heap header
   for dense LINK storage (h5_dense_links.pk), dense ATTRIBUTE storage
   (h5_dense_attrs.pk) and SOHM storage (h5_sohm.pk).  Those are four different
   record families.

   `role` names which one, exactly as h5policy_validate_link_payload does.
   Without it every pipeline finding was catalogued against
   dataset_layout_filter_fill -- so a filtered dense-link heap whose descriptor
   overruns its own header (corpus seed 60: heap-buffer-overflow in
   H5O__pline_decode off the END of the heap-header image, reached through
   H5HF__cache_hdr_deserialize, nothing to do with a dataset layout) named the
   dataset-layout family and would have been verified with its canary.

   The phrasing has to match the grouped rules in registry/findings/routes/, and
   it prefixes the WHOLE message, so every message below reads "<role> ...".  */
fun h5policy_validate_filter_pipeline_payload = (int ios,
                                                 H5PolicyProfile profile,
                                                 offset<uint<64>,B> payload_off,
                                                 uint<64> msg_size,
                                                 string object,
                                                 int record_decode_nelmts,
                                                 string role) int:
{
    if (!h5policy_payload_range_ok(msg_size, 0UL, 2UL,
                                   "H5_CORRUPT_FILTER_PIPELINE_MESSAGE_TOO_SMALL",
                                   payload_off, object,
                                   role + " filter pipeline message is too small"))
        return 0;

    var version = h5policy_msg_u64_at(ios, profile, payload_off, 1UL);
    var nfilters = h5policy_msg_u64_at(ios, profile, payload_off + 1#B, 1UL);
    var cur = 0UL;

    /* Record the count for the chunk filter-mask rule, but only for the
       DATASET's own pipeline: the dense-link and dense-attribute heaps call this
       same validator for their pipelines, and a chunk mask has nothing to do
       with those.  Recording theirs would compare a chunk's mask against a
       heap's filter count.  */
    if (role == "dataset")
        {
            h5policy_pipeline_nfilters = nfilters;
            h5policy_pipeline_has_nfilters = 1UB;
        }

    /* The filter count is both a structural loop bound and a resource budget.
       Even after reporting over-budget, continue parsing within the declared
       count so additional descriptor corruption can be surfaced.  */
    if (nfilters > profile.resources.max_filter_count)
        h5policy_emit_error("H5_RESOURCE_FILTER_COUNT", "resource",
                            payload_off, object,
                            role + " filter count exceeds the selected profile limit");

    if (version == 1UL)
        cur = 8UL;
    else if (version == 2UL)
        cur = 2UL;
    else
        {
            h5policy_emit_error("H5_CORRUPT_UNSUPPORTED_FILTER_PIPELINE_VERSION",
                                "corrupt", payload_off, object,
                                role + " unsupported filter pipeline version");
            return 0;
        }

    /* Distinct from the profile budget above: H5Z_MAX_NFILTERS is a
       format-defined ceiling libhdf5 enforces unconditionally
       (H5Opline.c, "filter pipeline message has too many filters"), so a
       profile permitting more filters must still refuse the file.  libhdf5
       validates the version first, so this follows the dispatch above.  */
    if (nfilters > 32UL)
        h5policy_emit_error_ev("H5_CORRUPT_FILTER_PIPELINE_TOO_MANY_FILTERS",
                               "corrupt", payload_off + 1#B, object,
                               role + " filter pipeline declares more than the "
                               + "32 filters the format permits",
                               H5Evidence {
                                   field = "filter_pipeline.nfilters",
                                   actual = nfilters,
                                   expected = 32UL,
                                   comparison = "at_most",
                                   has_loc1 = 1, loc1_role = "actual",
                                   loc1 = payload_off + 1#B, loc1_len = 1UL,
                               });

    var idx = 0UL;
    while (idx < nfilters)
        {
            /* The filter ID decides the descriptor shape, so it is read under
               its own bounds check before the rest of the header.  */
            if (!h5policy_payload_range_ok(msg_size, cur, 2UL,
                                           "H5_CORRUPT_FILTER_PIPELINE_OVERRUNS_MESSAGE",
                                           payload_off + cur#B, object,
                                           role + " filter descriptor overruns the pipeline message"))
                return 0;

            var filter_id = h5policy_msg_u64_at(ios, profile,
                                                payload_off + cur#B, 2UL);

            /* v1 always carries a name-length field and a padded name.  v2 only
               omits them for filter IDs below H5Z_FILTER_RESERVED (256): every
               dynamically registered filter -- blosc, zstd, lz4 and friends all
               live above it -- still stores its name, so the header is 8 bytes
               there too.  Assuming a flat 6 for v2 reads cd_nelmts out of the
               flags field and shifts the whole descriptor.  */
            var has_name = version == 1UL || filter_id >= 256UL;
            var desc_header = has_name ? 8UL : 6UL;

            if (!h5policy_payload_range_ok(msg_size, cur, desc_header,
                                           "H5_CORRUPT_FILTER_PIPELINE_OVERRUNS_MESSAGE",
                                           payload_off + cur#B, object,
                                           role + " filter descriptor overruns the pipeline message"))
                return 0;

            var name_len = 0UL;
            var cd_nelmts = 0UL;

            /* Descriptor headers give enough information to compute the full
               descriptor extent before reading client data.  */
            if (has_name)
                {
                    name_len = h5policy_msg_u64_at(ios, profile,
                                                   payload_off + (cur + 2UL)#B,
                                                   2UL);
                    cd_nelmts = h5policy_msg_u64_at(ios, profile,
                                                    payload_off + (cur + 6UL)#B,
                                                    2UL);

                    /* v1 pads the stored name to an 8-byte boundary, and
                       libhdf5 refuses any other length outright
                       (H5Opline.c, "filter name length is not a multiple of
                       eight").  v2 stores the exact length and has no such
                       constraint.  */
                    if (version == 1UL && (name_len % 8UL) != 0UL)
                        h5policy_emit_error_ev(
                            "H5_CORRUPT_FILTER_NAME_LENGTH_UNALIGNED",
                            "corrupt", payload_off + (cur + 2UL)#B, object,
                            role + " version 1 filter name length is not a "
                            + "multiple of eight",
                            H5Evidence {
                                field = "filter.name_length",
                                actual = name_len,
                                expected = 8UL,
                                comparison = "multiple_of",
                                has_loc1 = 1, loc1_role = "actual",
                                loc1 = payload_off + (cur + 2UL)#B,
                                loc1_len = 2UL,
                            });
                }
            else
                cd_nelmts = h5policy_msg_u64_at(ios, profile,
                                                payload_off + (cur + 4UL)#B,
                                                2UL);

            /* PARAMETER-COUNT SELF-CONSISTENCY, one rule per filter, both taken
               straight from libhdf5's own first line of argument checking.
               These are not bounds checks -- the descriptor extent is already
               confirmed in range above -- they are the counts the decoders
               require before they will look at cd_values at all, and libhdf5
               refuses the read when they disagree.  h5policy accepted both, so
               a file libhdf5 will certainly refuse was passing the preflight.

               scale-offset (6) needs EXACTLY H5Z_SCALEOFFSET_TOTAL_NPARMS == 20
               (H5Zscaleoffset.c:104, checked at :1122).  n-bit (5) is
               self-describing: cd_values[0] stores the actual parameter count
               and must equal the descriptor's own cd_nelmts (H5Znbit.c:897
               writes it, :935 checks it).  */
            if (filter_id == 6UL && cd_nelmts != 20UL)
                h5policy_emit_error_ev(
                    "H5_CORRUPT_FILTER_PARAM_COUNT", "corrupt",
                    payload_off + cur#B, object,
                    role + " scale-offset filter parameter count is not the required total",
                    H5Evidence {
                        field = "layout.filter_param_count",
                        actual = cd_nelmts,
                        expected = 20UL,
                        comparison = "equal",
                        has_loc1 = 1, loc1_role = "actual",
                        loc1 = payload_off + (cur + (has_name ? 6UL : 4UL))#B,
                        loc1_len = 2UL,
                    });
            if (filter_id == 5UL && cd_nelmts >= 1UL)
                {
                    var declared_off = payload_off
                        + (cur + desc_header + name_len)#B;
                    var declared = h5policy_msg_u64_at(ios, profile,
                                                       declared_off, 4UL);
                    if (declared != cd_nelmts)
                        h5policy_emit_error_ev(
                            "H5_CORRUPT_FILTER_PARAM_COUNT", "corrupt",
                            payload_off + cur#B, object,
                            role + " n-bit filter parameter count disagrees with its own cd_values[0]",
                            H5Evidence {
                                field = "layout.filter_param_count",
                                actual = declared,
                                expected = cd_nelmts,
                                comparison = "equal",
                                has_loc1 = 1, loc1_role = "actual",
                                loc1 = declared_off, loc1_len = 4UL,
                                has_loc2 = 1, loc2_role = "expected",
                                loc2 = payload_off + (cur + (has_name ? 6UL : 4UL))#B,
                                loc2_len = 2UL,
                            });
                }

            if (!h5policy_core_filter(filter_id))
                {
                    /* Non-core filters normally require plugin loading by a
                       consumer, so untrusted profiles can reject them without
                       inspecting the raw dataset data.  */
                    h5policy_note_dynamic_filter(filter_id);
                    if (profile.features.allow_dynamic_filters == 0UB)
                        h5policy_emit_error("H5_POLICY_DYNAMIC_FILTER", "policy",
                                            payload_off + cur#B, object,
                                            role + " non-core filter required; profile disables dynamic filters");
                }
            else if (h5policy_filter_decodes(filter_id))
                {
                    /* Structurally fine, but reading the data requires a consumer
                       to decode/decompress attacker-controlled bytes -- a surface
                       this metadata-only oracle deliberately does not enter.
                       Advisory only (accept_with_warnings), emitted once per
                       distinct filter so many datasets don't spam the report.  */
                    if (!h5policy_feature_seen_u64(h5policy_feature_decode_filters,
                                                   filter_id))
                        {
                            h5policy_feature_decode_filters += [filter_id];
                            h5policy_emit_warning("H5_ADVISORY_DECODE_FILTER",
                                                  payload_off + cur#B, object,
                                                  role + " declares the "
                                                  + h5policy_filter_name(filter_id)
                                                  + " filter; a consumer must decode/decompress "
                                                  + "untrusted data to read it");
                        }
                }

            var cd_bytes = h5policy_checked_mul_u64(cd_nelmts, 4UL,
                                                    0xffffffffffffffffUL,
                                                    "H5_CORRUPT_LENGTH_OVERFLOW",
                                                    "corrupt",
                                                    payload_off + cur#B,
                                                    object,
                                                    role + " filter client-data byte count overflow");
            var desc_size = h5policy_checked_add_u64(desc_header, name_len,
                                                     0xffffffffffffffffUL,
                                                     "H5_CORRUPT_LENGTH_OVERFLOW",
                                                     "corrupt",
                                                     payload_off + cur#B,
                                                     object,
                                                     role + " filter descriptor size overflow");
            desc_size = h5policy_checked_add_u64(desc_size, cd_bytes,
                                                 0xffffffffffffffffUL,
                                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                                 "corrupt",
                                                 payload_off + cur#B,
                                                 object,
                                                 role + " filter descriptor size overflow");
            if (version == 1UL && (cd_nelmts % 2UL) != 0UL)
                /* v1 pads an odd number of 32-bit client-data words by one
                   additional word.  */
                desc_size = h5policy_checked_add_u64(desc_size, 4UL,
                                                     0xffffffffffffffffUL,
                                                     "H5_CORRUPT_LENGTH_OVERFLOW",
                                                     "corrupt",
                                                     payload_off + cur#B,
                                                     object,
                                                     role + " filter descriptor padding overflow");

            if (!h5policy_payload_range_ok(msg_size, cur, desc_size,
                                           "H5_CORRUPT_FILTER_PIPELINE_OVERRUNS_MESSAGE",
                                           payload_off + cur#B, object,
                                           role + " filter descriptor overruns the pipeline message"))
                return 0;

            /* libhdf5 finds the name's terminator with a strnlen bounded by the
               rest of the *message*, not by name_len, and refuses the message
               only when no NUL appears before the payload ends (H5Opline.c,
               "filter name not null terminated").  Mirroring that bound exactly
               keeps this a reject-parity check: a name left unterminated inside
               its own name_len but terminated later in the message is something
               libhdf5 accepts, so h5policy must accept it too.  Tightening to
               name_len would be a stricter-than-libhdf5 rule and belongs in the
               A+ track with its own evidence, not here.  */
            if (name_len != 0UL)
                {
                    var scan_rel = cur + desc_header;
                    /* Read the declared name first and only fall back to the
                       rest of the payload if it holds no terminator.  The two
                       spans together are exactly libhdf5's bound, but a
                       well-formed name terminates inside the first one, so the
                       common case reads name_len bytes instead of the whole
                       message tail once per descriptor.  */
                    var terminated =
                        h5policy_span_has_nul(ios, profile,
                                              payload_off + scan_rel#B,
                                              name_len);
                    if (!terminated)
                        terminated =
                            h5policy_span_has_nul(ios, profile,
                                                  payload_off
                                                  + (scan_rel + name_len)#B,
                                                  msg_size - scan_rel - name_len);
                    if (!terminated)
                        h5policy_emit_error(
                            "H5_CORRUPT_FILTER_NAME_NOT_TERMINATED",
                            "corrupt", payload_off + scan_rel#B, object,
                            role + " filter name is not NUL-terminated before "
                            + "the end of the pipeline message");
                }

            /* fletcher32 (3) and szip (4) each consume a FIXED four bytes of the
               chunk's stored size before touching data, and each subtracts it
               without a floor -- H5Zfletcher32.c:73 and H5Zszip.c:298.  Record
               the framing so finalization can require every chunk record to be
               at least that large; comparing here is not possible, because the
               chunk index may already have been walked (message order is free).
               Same dataset-only gate as the element-count recording below: a
               filtered fractal heap has no chunk records and must not impose a
               floor on a dataset that happens to share the object.  */
            if (record_decode_nelmts != 0
                && (filter_id == 3UL || filter_id == 4UL))
                {
                    if (h5policy_pipeline_chunk_framing < 4UL)
                        {
                            h5policy_pipeline_chunk_framing = 4UL;
                            h5policy_pipeline_framing_offset = (payload_off + cur#B)/#B;
                        }
                    h5policy_pipeline_has_framing = 1UB;
                }

            /* n-bit (5) and scale-offset (6) both store the chunk element count
               that libhdf5 auto-derives from the chunk dataspace in cd_values[2]
               (H5Z_{NBIT,SCALEOFFSET}_PARM_NELMTS).  Their decompressors size the
               output buffer as cd_values[2] * element_size, so a hand-inflated
               value drives an out-of-bounds write -- and on a 32-bit size_t the
               product wraps and under-allocates.  Record the on-disk value (the
               whole descriptor, client data included, is confirmed in range
               above) for the chunk-consistency check at object finalization,
               where the chunk element count is known regardless of message order.  */
            /* Mode 2 is a heap pipeline: record the extent its client data
               implies, for EVERY filter, because an undecidable one has to latch
               the poison flag rather than be skipped.  */
            if (record_decode_nelmts == 2)
                h5policy_pipeline_record_heap_extent(
                    ios, profile, filter_id,
                    payload_off + (cur + desc_header + name_len)#B, cd_nelmts);
            if (record_decode_nelmts == 1
                && (filter_id == 5UL || filter_id == 6UL) && cd_nelmts >= 3UL)
                {
                    var d_nelmts_off = payload_off
                        + (cur + desc_header + name_len + 8UL)#B;
                    var d_nelmts =
                        h5policy_msg_u64_at(ios, profile, d_nelmts_off, 4UL);
                    if (h5policy_pipeline_has_decode_nelmts != 0UB
                        && h5policy_pipeline_decode_nelmts != d_nelmts)
                        /* Two decode filters on one dataset must agree on the
                           chunk element count; a divergence is already tampering
                           and cannot be reconciled with a single chunk shape.  */
                        h5policy_emit_error_ev(
                            "H5_CORRUPT_FILTER_NELMTS_MISMATCH", "corrupt",
                            payload_off + cur#B, object,
                            role + " decode filters disagree on the chunk element count",
                            H5Evidence {
                                field = "filter.decode_element_count",
                                actual = d_nelmts,
                                expected = h5policy_pipeline_decode_nelmts,
                                comparison = "equal",
                                has_loc1 = 1, loc1_role = "actual",
                                loc1 = d_nelmts_off, loc1_len = 4UL,
                                has_loc2 = 1, loc2_role = "expected",
                                loc2 = h5policy_pipeline_decode_nelmts_offset#B,
                                loc2_len = 4UL,
                            });
                    h5policy_pipeline_decode_nelmts = d_nelmts;
                    h5policy_pipeline_has_decode_nelmts = 1UB;
                    h5policy_pipeline_decode_nelmts_offset = d_nelmts_off/#B;

                    /* The second overflow factor is the per-element size the
                       decompressor multiplies by nelmts.  Scale-offset stores it
                       flatly in cd_values[4] (H5Z_SCALEOFFSET_PARM_SIZE).  n-bit
                       stores its element size in cd_values[4] too, but as the size
                       word of a self-describing type tree -- a flat element size
                       only when the root type is atomic (cd_values[3] == class 1);
                       a compound/array root makes it structural, so recording it
                       there would false-positive against the datatype size.  So
                       record it for scale-offset, and for n-bit only on an atomic
                       root.  Both encodings place the value at cd_values[4]
                       (base + 16); the n-bit root class is cd_values[3] (base + 12). */
                    if (cd_nelmts >= 5UL)
                        {
                            var record_decode_size = filter_id == 6UL;
                            if (filter_id == 5UL)
                                record_decode_size = h5policy_msg_u64_at(
                                    ios, profile,
                                    payload_off
                                    + (cur + desc_header + name_len + 12UL)#B,
                                    4UL) == 1UL;
                            if (record_decode_size)
                                {
                                    var decode_size_off = payload_off
                                        + (cur + desc_header + name_len + 16UL)#B;
                                    h5policy_pipeline_decode_size =
                                        h5policy_msg_u64_at(ios, profile,
                                                            decode_size_off, 4UL);
                                    h5policy_pipeline_has_decode_size = 1UB;
                                    h5policy_pipeline_decode_size_offset =
                                        decode_size_off/#B;
                                }
                        }

                    /* The REST of the parameters libhdf5 derives from the
                       object's own messages, and never checks again on read.
                       H5Z__set_local_scaleoffset takes the byte order from
                       H5T_get_order() and the fill-value availability from
                       H5P_fill_value_defined(); H5Z__set_parms_atomic takes
                       order, precision and bit offset from the same datatype.
                       Each is therefore a COPY of something a sibling message in
                       this object header already states, so a disagreement is
                       decidable here and cannot occur in a conforming file.
                       MEASURED, HDF5 2.3.0: editing any one of them leaves
                       libhdf5 reading the dataset with rc=0 and returning
                       different values -- flipping the recorded byte order alone
                       turns every element of a scale-offset dataset into
                       unrelated floating-point noise.  No memory-safety error
                       accompanies it; this is an integrity rule.

                       Layout, from the client-data base:
                         scale-offset  cd[6] order   (+24)  cd[7] filavail (+28)
                         n-bit atomic  cd[5] order   (+20)  cd[6] precision (+24)
                                       cd[7] offset  (+28)
                       n-bit's words describe its ROOT type, so they are recorded
                       only for an atomic root (cd[3] == 1) -- the same gate the
                       element size above uses, and for the same reason: a
                       compound or array root makes them per-member and there is
                       no single datatype word to compare against.  */
                    if (cd_nelmts >= 8UL)
                        {
                            var cd_base = payload_off
                                + (cur + desc_header + name_len)#B;
                            var atomic_root = filter_id == 6UL;
                            if (filter_id == 5UL)
                                atomic_root = h5policy_msg_u64_at(
                                    ios, profile, cd_base + 12#B, 4UL) == 1UL;
                            if (atomic_root)
                                {
                                    /* Byte order: cd[6] for scale-offset,
                                       cd[5] for n-bit.  Both encode LE as 0 and
                                       BE as 1.  Two decode filters on one
                                       dataset would overwrite each other here;
                                       that is harmless, because the survivor is
                                       still compared against the one datatype
                                       and a disagreeing pair cannot both pass. */
                                    var order_off = cd_base
                                        + (filter_id == 6UL ? 24UL : 20UL)#B;
                                    h5policy_pipeline_decode_order =
                                        h5policy_msg_u64_at(ios, profile,
                                                            order_off, 4UL);
                                    h5policy_pipeline_has_decode_order = 1UB;
                                    h5policy_pipeline_decode_order_offset =
                                        order_off/#B;
                                }
                            if (filter_id == 5UL && atomic_root)
                                {
                                    var prec_off = cd_base + 24#B;
                                    h5policy_pipeline_decode_precision =
                                        h5policy_msg_u64_at(ios, profile,
                                                            prec_off, 4UL);
                                    h5policy_pipeline_has_decode_precision = 1UB;
                                    h5policy_pipeline_decode_precision_offset =
                                        prec_off/#B;
                                    var bitoff_off = cd_base + 28#B;
                                    h5policy_pipeline_decode_bit_offset =
                                        h5policy_msg_u64_at(ios, profile,
                                                            bitoff_off, 4UL);
                                    h5policy_pipeline_has_decode_bit_offset = 1UB;
                                    h5policy_pipeline_decode_bit_offset_offset =
                                        bitoff_off/#B;
                                }
                            if (filter_id == 6UL)
                                {
                                    var filavail_off = cd_base + 28#B;
                                    h5policy_pipeline_decode_filavail =
                                        h5policy_msg_u64_at(ios, profile,
                                                            filavail_off, 4UL);
                                    h5policy_pipeline_has_decode_filavail = 1UB;
                                    h5policy_pipeline_decode_filavail_offset =
                                        filavail_off/#B;
                                }
                        }
                }

            /* n-bit stores a self-describing type tree in cd_values[3..]; verify it
               stays inside the client-data array so a consumer's decompressor
               cannot index past it.  Independent of record_decode_nelmts: it is a
               structural property of the descriptor, so it applies to any n-bit
               pipeline (a heap pipeline would never legitimately carry n-bit).  */
            if (filter_id == 5UL)
                h5policy_nbit_walk_params(ios, profile,
                                          payload_off + (cur + desc_header + name_len)#B,
                                          cd_nelmts, 3UL, 0UL,
                                          payload_off + cur#B, object);

            /* Advance by the computed descriptor size rather than by fields read
               so malformed names or client-data lengths cannot desynchronize
               the next descriptor silently.  */
            cur = cur + desc_size;
            idx = idx + 1UL;
        }
    return 1;
}
