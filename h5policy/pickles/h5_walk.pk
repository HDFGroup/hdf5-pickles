/* This file owns the mutable traversal state that threads through the split
   validators.  h5policy is metadata-only: it follows object headers, messages,
   group indexes, and chunk indexes far enough to classify risk, but it never
   opens external files, runs filters, or reads raw dataset payloads.  */

/* Accumulated facts about the reachable graph and the dataset currently being
   interpreted.  Message validators update these fields opportunistically; the
   cross-message checks at the bottom of the file compare dataspace, datatype,
   layout, and fill-value facts once enough of them are known.  */
type H5WalkContext = struct
{
    uint<64> metadata_seen;
    uint<64> object_count;
    uint<64> attribute_count;
    uint<64> object_header_chunk_count;
    uint<64> btree_depth;
    uint<64> link_depth;
    uint<64> dtype_depth;
    uint<64> max_rank_seen;
    uint<64> dataspace_rank;
    uint<64> dataset_element_count;
    uint<64> datatype_size;
    uint<64> datatype_size_offset;
    uint<64> datatype_logical_size;
    uint<64> fill_value_size;
    uint<64> compact_layout_size;
    uint<64> contiguous_layout_size;
    /* The contiguous data ADDRESS, kept so the finalize-time updater can bound
       addr + (nelmts * datatype_size) the way H5D__contig_check does.  Undefined
       (all ones) when there is no contiguous layout or no allocated data.  */
    uint<64> contiguous_layout_addr;
    /* Byte offset of the encoded address field, so the finalize-time finding
       cites the same bytes the layout-time one did.  Also used as the finding's
       location, which keeps it independent of the order the object header's
       messages happen to appear in.  */
    uint<64> contiguous_layout_addr_offset;
    uint<64> legacy_chunked_layout_ndims;
    uint<64> legacy_chunked_layout_ndims_offset;
    uint<64> chunk_dataset_element_count;
    uint<64> chunk_logical_bytes;
    uint<64> logical_dataset_bytes;
    uint<64> max_logical_dataset_bytes_seen;
    uint<64> accounted_chunk_count;
    /* Like chunk_count_exceeded below, preserve the proof hidden by the
       saturating public metadata counter so recursive validators can stop
       following new metadata edges once the byte refusal is established. */
    uint<8> metadata_count_exceeded;
    /* The public count saturates at the selected ceiling, so equality alone
       cannot say whether the walk observed exactly the limit or proved an
       additional chunk.  Keep that proof as internal traversal state. */
    uint<8> chunk_count_exceeded;
    uint<8> has_dataspace;
    uint<8> has_datatype;
    uint<8> has_dataset_layout;
    uint<8> has_fill_value;
    uint<8> has_compact_layout;
    uint<8> has_contiguous_layout;
    uint<8> has_legacy_chunked_layout;
    uint<8> has_chunked_layout;
    /* Group-shape message presence.  A group's link storage is declared by
       exactly one of two message classes -- a symbol-table message (old style)
       or a link-info message (new style) -- and the new style additionally
       carries a group-info message.  Which of them the header actually holds is
       a property of the whole header, not of any single message, so it is
       recorded here and judged once at finalization.  */
    uint<8> has_link_info;
    uint<8> has_group_info;
    uint<8> has_symbol_table;
    uint<8> has_link_message;
    uint<8> dataset_element_count_overflowed;
    uint<8> dataset_dim_exceeds_max;
    uint<8> dataspace_has_max_dims;
    uint<8> dataspace_has_unlimited_dim;
};

/* Visited sets are plain arrays because poke keeps this script portable and
   simple.  The walk budget charges linear membership tests so hostile graphs
   with many duplicate references still terminate under profile control.  */
var h5policy_visited_ohdrs = uint<64>[]();
var h5policy_visited_btrees = uint<64>[]();

/* Local-heap segment ownership: parallel arrays of (prefix address, declared
   data-segment address), one pair per local heap the walk has decoded.

   A PAIR, not a set of segment addresses, and that is the whole design.  The
   invariant is "no two DISTINCT prefixes claim one segment", so a repeat is a
   violation only when the segment matches and the prefix does not.  Keying on
   the segment alone would fire on every legitimate re-decode of the same heap
   -- and re-decode happens: a shared (SOHM) external-file-list message is
   decoded once per referencing object, and duplicate messages run their
   validator twice.  Those all arrive with the SAME prefix address and must stay
   silent.  Model shared here on datatype.member_name_unique, which is the same
   "two positions, one value" shape.

   Reset with the rest of the traversal state, which means the second reset (the
   one at the top of h5policy_walk_reachable_metadata) discards anything decoded
   before the reachable walk began.  That is deliberate and safe in one
   direction only: dropping earlier pairs can cost a DETECTION, never invent
   one, because a forgotten prefix simply re-registers.  The pre-walk window
   holds only the root object header, which is a group and carries no
   external-file-list heap, so nothing is lost today -- but a future caller that
   decodes an EFL before the walk would silently lose its heap from this set. */
var h5policy_lheap_prfx_addrs = uint<64>[]();
var h5policy_lheap_seg_addrs = uint<64>[]();

/* Ceiling on the ownership record, in the spirit of H5POLICY_MAX_REACHED: the
   scan below is linear, so an unbounded set would add an O(N^2) term to the
   walk budget and could push a large-but-valid file past max_walk_operations --
   turning a detection into a verdict change on files this check is not about.
   Past the cap, recording stops and aliases among later heaps go unreported.
   A file with more than this many local heaps is already far outside anything
   a conforming writer produces. */
var H5POLICY_MAX_LHEAP_OWNERS = 4096UL;

/* Continuation chunks are tracked as the [lo, hi) byte intervals they occupy,
   not as bare start addresses.  A start-address set can only reject a target
   that lands on a byte some earlier continuation started on; it cannot see a
   target that begins a few bytes inside an already-decoded chunk -- including
   the source chunk that referenced it.  That is exactly the object-header
   continuation family: a continuation pointing just past a chunk's leading
   bytes (OCHK signature, or the v2 header prefix) has a start address nobody
   has claimed, yet it overlaps live, already-decoded metadata.  Half-open
   intervals let the walk reject any overlap -- self, alias, or partial -- and
   still count one validated chunk per non-overlapping target. */
var h5policy_cont_lo = uint<64>[]();
var h5policy_cont_hi = uint<64>[]();

/* Reachability record: the structures the walk actually read, with the kind it
   read them as.  The visited sets above cannot answer this -- they exist to
   break cycles, so they only hold the kinds that need deduplicating, and a
   consumer asking "did the walk reach these bytes?" about a heap or an array
   block would get a false negative from them.

   Append-only, and deliberately NOT deduplicated.  h5policy_seen_u64 charges
   its linear scan to the walk's operation budget, so a deduplicated set here
   would add an O(N^2) term to that budget and could push a large file past
   max_walk_operations -- turning a reporting record into a decision change.
   Recording must never move a verdict, so h5policy_mark_reached does no
   membership test and never ticks: it is O(1) and walk-budget neutral.  The
   membership test belongs to the reader, at report time, outside the walk.

   Duplicates are therefore expected: a structure read twice is recorded twice.
   That is bounded, because the number of reads is already bounded by the walk
   budget, and capped again below.  */
var h5policy_reached_addrs = uint<64>[]();
var h5policy_reached_kinds = string[]();
var h5policy_reached_truncated = 0;

/* Ceiling on the reachability record.  Past it, recording stops and the flag
   above says so, exactly as H5POLICY_MAX_FINDINGS caps findings: a reader must
   be able to tell "not reached" from "we stopped writing this down".  */
var H5POLICY_MAX_REACHED = 65536UL;

/* Record that the walk read a structure of KIND at ADDR.  KIND is the on-disk
   signature tag ("OHDR", "FAHD", "HEAP", ...) or a logical name where the
   structure carries no signature ("OHDR" for version 1 headers, "SUPER").

   Deliberately does not call h5policy_walk_tick: see above.  Keeping this
   walk-budget neutral is what makes it provable that adding the record changes
   no decision -- the CLI report stays byte-identical.  */
fun h5policy_mark_reached = (uint<64> addr, string kind) void:
{
    if (h5policy_reached_truncated)
        return;
    if (h5policy_reached_addrs'length as uint<64> >= H5POLICY_MAX_REACHED)
        {
            h5policy_reached_truncated = 1;
            return;
        }
    h5policy_reached_addrs += [addr];
    h5policy_reached_kinds += [kind];
}

/* Report-time lookup: the kind the walk read at ADDR, or "" if it never read
   it.  Linear, and intentionally so -- this runs once per query after the walk
   has finished, so it is outside the operation budget and must not tick.  */
fun h5policy_reached_kind_at = (uint<64> addr) string:
{
    for (var i = 0UL; i < h5policy_reached_addrs'length as uint<64>; i = i + 1UL)
        if (h5policy_reached_addrs[i] == addr)
            return h5policy_reached_kinds[i];
    return "";
}

fun h5policy_was_reached = (uint<64> addr) int:
{
    return h5policy_reached_kind_at(addr) != "";
}

/* Clearing the record is deliberately NOT part of h5policy_reset_traversal_state.
   That runs twice per analysis -- once up front and again inside
   h5policy_walk_reachable_metadata, which restarts the BFS bookkeeping -- so
   folding the record into it would silently discard everything read before the
   reachable walk began: the superblock itself, and whatever superblock
   validation follows.  The record spans the whole analysis, so only
   h5policy_analyze resets it, exactly once.  */
fun h5policy_reset_reached = void:
{
    h5policy_reached_addrs = uint<64>[]();
    h5policy_reached_kinds = string[]();
    h5policy_reached_truncated = 0;
}

/* Object headers are walked breadth-first.  Link messages enqueue child object
   headers here; h5policy_walk_reachable_metadata drains the queue while
   enforcing max link depth and continue-after-rejection policy.  */
var h5policy_pending_ohdrs = uint<64>[]();
var h5policy_pending_depths = uint<64>[]();
var h5policy_pending_paths = string[]();
var h5policy_pending_index = 0UL;

/* Address of the superblock extension's object header, or the undef sentinel
   when the file has none.  Set by h5policy_walk_reachable_metadata just before
   the extension is enqueued -- which happens BEFORE the root, so a later
   enqueue landing on this address is an object-graph edge aliasing the
   extension rather than the extension itself.  See h5policy_enqueue_ohdr.  */
var h5policy_ext_ohdr_addr = 0xffffffffffffffffUL;

/* Current-object scratch state.  Message validators use these values for
   contextual checks that are cheaper to do while a single object header is
   being parsed, such as v1 message-count repair support and link-depth labels.
   The superblock K values are defaults until h5policy_validate_superblock reads
   the real values.  */
var h5policy_current_object_depth = 0UL;
var h5policy_current_object_msg_count = 0UL;
var h5policy_current_object_root_msg_count = 0UL;
/* Number of ERROR-class findings already recorded when the current object
   header's walk started.  The group-shape invariants at finalization are message-ABSENCE
   rules, and absence is only meaningful when the message walk actually
   finished: a header truncated by a short chunk, an overlapping continuation,
   or an oversized message can drop the very message being looked for.  A
   header that already produced an error is therefore left to that error
   rather than being accused of a second, derived defect.  Warnings do not
   count: an advisory about a link's target path is not evidence that the
   header's message walk came up short.  */
var h5policy_object_finding_mark = 0UL;
var h5policy_dense_handled = 0;
/* Chunk element count (cd_values[2]) recorded from a dataset's n-bit/scale-offset
   filter, checked against the real chunk shape at object finalization.  Only the
   dataset dispatch path records it; fractal-heap pipeline checks never do, so a
   filtered dense-storage heap cannot pollute a dataset's chunk-consistency check.  */
var h5policy_pipeline_decode_nelmts = 0UL;
var h5policy_pipeline_has_decode_nelmts = 0UB;
var h5policy_pipeline_decode_nelmts_offset = 0UL;
/* Scale-offset's per-element size (cd_values[4]), the other factor libhdf5
   multiplies into the decompressed chunk buffer.  Checked against the real
   datatype size at finalization so an inflated size can't overflow the product
   even when the element count is left consistent.  */
var h5policy_pipeline_decode_size = 0UL;
var h5policy_pipeline_has_decode_size = 0UB;
var h5policy_pipeline_decode_size_offset = 0UL;
/* The pipeline's FIXED framing overhead: bytes a filter consumes from the
   chunk's stored size before it looks at any data, and subtracts without a
   floor.  Two core filters have one, both 4 bytes:
     fletcher32 (3) -- `src_nbytes -= FLETCHER_LEN` (H5Zfletcher32.c:73), the
       trailing checksum;
     szip (4)       -- `nbytes - 4` (H5Zszip.c:298), after UINT32DECODE has
       already read the leading uncompressed-size header off the same buffer.
   A stored size below that framing wraps the subtraction to near SIZE_MAX.
   Recorded here rather than compared in place because the pipeline message and
   the chunk index arrive in either order; the comparison is at finalization,
   where both are known.  Dataset path only, like the two above -- a filtered
   fractal heap must not set a dataset's floor.  */
var h5policy_pipeline_chunk_framing = 0UL;
var h5policy_pipeline_has_framing = 0UB;
var h5policy_pipeline_framing_offset = 0UL;
/* The smallest stored size any chunk record in this object declared, and where.
   The MINIMUM is the right summary: one undersized record is enough to reach
   the wrap, so tracking the extreme keeps the state O(1) per object instead of
   one entry per chunk.  Zero is excluded -- it is reported immediately by
   h5policy_chunk_record_size_ok, which needs no pipeline context.  */
var h5policy_chunk_min_stored = 0UL;
var h5policy_chunk_min_stored_offset = 0UL;
var h5policy_chunk_has_stored = 0UB;
/* A fixed-array chunk index is pre-sized once, at creation, from the dataset's
   MAXIMUM extent: libhdf5 stores prod(ceil(max_dims[i] / chunk_dim[i])) in the
   FAHD header and never grows it.  Nothing on the read path checks the stored
   capacity against the dataspace it indexes, so the three facts are recorded
   here -- the effective maximum extent, the chunk grid, and the stored
   capacity -- and cross-checked once the whole object header has been walked
   (h5policy_finalize_ohdr_dataset).  Finalization, not the layout message,
   because object-header messages arrive in any order: a layout placed before
   its dataspace would otherwise evade an inline check.

   Only the object's own dataset messages record here.  An attribute carries a
   dataspace of its own and is validated against a throwaway context copy, so
   its shape must not seed a dataset's cross-check; the same holds for a
   duplicate dataspace message, which the dispatch parses for corruption but
   does not let replace the first one.  */
var h5policy_dataspace_max_dims = uint<64>[]();
var h5policy_dataspace_max_dim_offsets = uint<64>[]();
var h5policy_chunk_grid_dims = uint<64>[]();
var h5policy_fixed_array_nelmts = 0UL;
var h5policy_fixed_array_nelmts_offset = 0UL;
var h5policy_has_fixed_array_index = 0UB;
var h5policy_super_stab_leaf_k = 4UL;
var h5policy_super_stab_internal_k = 16UL;
var h5policy_super_indexed_internal_k = 32UL;
/* Reset per-walk state, including the wall-clock budget counters.  This is
   called by the top-level metadata walk and also by h5patch when it asks
   h5policy to recount a single object header.  */
fun h5policy_reset_traversal_state = void:
{
    h5policy_visited_ohdrs = uint<64>[]();
    h5policy_cont_lo = uint<64>[]();
    h5policy_cont_hi = uint<64>[]();
    h5policy_visited_btrees = uint<64>[]();
    h5policy_pending_ohdrs = uint<64>[]();
    h5policy_pending_depths = uint<64>[]();
    h5policy_pending_paths = string[]();
    h5policy_pending_index = 0UL;
    /* Load-bearing: left set from a previous analysis this would make an
       unrelated address in the next file look like an extension alias. */
    h5policy_ext_ohdr_addr = 0xffffffffffffffffUL;
    /* Same hazard, same reason: a segment address surviving from an earlier
       file would make the next file's first local heap look like an alias of
       it.  That is a false REJECT across the seam, which is worse than the
       missed detection the other direction costs. */
    h5policy_lheap_prfx_addrs = uint<64>[]();
    h5policy_lheap_seg_addrs = uint<64>[]();
    h5policy_current_object_depth = 0UL;
    h5policy_current_object_msg_count = 0UL;
    h5policy_current_object_root_msg_count = 0UL;
    h5policy_walk_ops = 0UL;
    h5policy_walk_next_check = 0UL;
}

/* Linear membership helper used by all visited sets.  The tick cost includes
   the array length because this is O(n), and the walk budget should reflect
   that cost on adversarial files with many metadata references.  */
fun h5policy_seen_u64 = (uint<64>[] values, uint<64> value) int:
{
    h5policy_walk_tick(values'length + 1UL);   /* this membership test costs O(len) */
    var i = 0UL;

    while (i < values'length)
        {
            if (values[i] == value)
                return 1;
            i = i + 1UL;
        }

    return 0;
}

/* Object headers are only marked when dequeued, not when enqueued.  That keeps
   duplicate pending references cheap to reject while preserving the BFS queue's
   single source of truth.  */
fun h5policy_mark_visited_ohdr = (uint<64> addr) int:
{
    h5policy_visited_ohdrs += [addr];
    return 1;
}

/* Raw chunk data and file metadata must occupy disjoint bytes.  libhdf5's
   allocator guarantees it on write -- raw data gets its own space -- but nothing
   RE-checks it on read, so a chunk record whose address points into metadata is
   served happily: the bytes come back as dataset values with no error at all.
   MEASURED on an unfiltered chunked dataset (no checksum filter to notice):
   pointing one chunk at offset 0 returns 0x46444889 and 0x0A1A0A0D as the first
   two int32 values -- the file's own "\x89HDF\r\n\x1a\n" signature -- and
   pointing it at a v1 B-tree node returns 0x45455254, "TREE".  h5dump exits 0.
   So this is an arbitrary in-file read: any offset, returned as data, silently.
   Not memory-unsafety and not a crash; wrong data always, and a read primitive
   across a boundary wherever a consumer exposes some datasets of a file but not
   all of its bytes.
   The existing bound is only `addr + size <= file_size`, which every in-file
   address satisfies -- which is why an address of 0 passed.

   TWO REGISTRIES, because either can be seen first: the object graph is walked
   breadth-first, so a chunk index may be read before or after the metadata its
   records point at.  Each side scans the other's recorded extents, so the pair
   is order-independent without a second pass over the file.

   BOTH ARE HARD-CAPPED, and that is a deliberate trade.  The scans are linear
   and charged to the walk budget, so an uncapped cross-product would scale with
   file size and could push a large VALID file past max_walk_operations --
   turning a detection into a verdict change on files this rule is not about.
   With these caps the added cost is bounded by 512 * 1024 comparisons no matter
   how big the file is: about 5% of the tightest profile's 10M budget.  Past a
   cap, checking stops and the flag says so, exactly as H5POLICY_MAX_REACHED
   does -- a reader must be able to tell "disjoint" from "we stopped looking".  */
var h5policy_meta_lo = uint<64>[]();
var h5policy_meta_hi = uint<64>[]();
var h5policy_chunk_extent_lo = uint<64>[]();
var h5policy_chunk_extent_hi = uint<64>[]();
/* The layout role each recorded data extent came from, so the reverse-direction
   report can name it.  Parallel to the two arrays above; without it a collision
   found from the metadata side could not say whether it hit a chunk or a
   contiguous extent, and the route shard would have nothing to split on.  */
var h5policy_chunk_extent_what = string[]();
/* The file offset of the RECORD that declared each extent.  It distinguishes
   two genuinely different records that happen to name identical bytes -- a real
   alias -- from the same record being decoded twice, which would otherwise
   report itself as overlapping itself.  Node-level dedup (visited_btrees,
   h5policy_ea_mark_block) and the once-per-analysis reset make a re-decode
   unlikely, but "unlikely" is not a basis for a check that can reject a VALID
   file, so the ambiguity is removed rather than argued away.  */
var h5policy_chunk_extent_loc = uint<64>[]();
/* h5policy_extents_truncated is declared in h5_findings.pk, not here: the JSON
   report is printed from that file and it LOADS FIRST, so a flag declared here
   would be invisible to the printer.  It lives with the other report-level
   truncation flags for that reason. */
var h5policy_chunk_extent_checks = 0UL;
var H5POLICY_MAX_METADATA_EXTENTS = 512UL;
var H5POLICY_MAX_CHUNK_EXTENT_CHECKS = 1024UL;

/* Saturating end-of-extent: a decoded length can be adversarial, and an extent
   that would wrap past the address space is clamped rather than wrapped so the
   overlap test still sees a plausible interval instead of an inverted one.  */
fun h5policy_extent_hi = (uint<64> lo, uint<64> bytes) uint<64>:
{
    if (bytes > 0xffffffffffffffffUL - lo)
        return 0xffffffffffffffffUL;
    return lo + bytes;
}

/* File-scoped, so reset ONCE per analysis from h5policy_analyze -- NOT from
   h5policy_reset_traversal_state, which runs again when the reachable walk
   starts and would discard the superblock's own extent, recorded before it.
   That extent is the one the measured specimen needs.  */
fun h5policy_reset_extents = void:
{
    h5policy_meta_lo = uint<64>[]();
    h5policy_meta_hi = uint<64>[]();
    h5policy_chunk_extent_lo = uint<64>[]();
    h5policy_chunk_extent_hi = uint<64>[]();
    h5policy_chunk_extent_what = string[]();
    h5policy_chunk_extent_loc = uint<64>[]();
    h5policy_extents_truncated = 0;
    h5policy_chunk_extent_checks = 0UL;
}

/* Half-open interval overlap: [a_lo, a_hi) and [b_lo, b_hi) share a byte iff
   each starts strictly before the other ends.  Callers guarantee hi > lo. */
fun h5policy_intervals_overlap = (uint<64> a_lo, uint<64> a_hi,
                                  uint<64> b_lo, uint<64> b_hi) int:
{
    return (a_lo < b_hi && b_lo < a_hi) ? 1 : 0;
}

/* Two raw-data extents overlapping each other.  Separate emitter for the same
   reason as the reverse-direction one: `what + suffix` with WHAT as parameter 0
   is the shape tools/message_routing.py can enumerate.  */
fun h5policy_report_data_over_data = (string what, off64 loc, string object,
                                      uint<64> this_lo, uint<64> other_lo) void:
{
    h5policy_emit_error_ev(
        "H5_CORRUPT_RAW_DATA_OVERLAPS_DATA", "corrupt", loc, object,
        what + " data extent overlaps another raw-data extent",
        H5Evidence {
            field = what + ".data_disjoint_from_data",
            actual = this_lo,
            expected = other_lo,
            comparison = "not_equal",
            has_loc1 = 1, loc1_role = "actual",
            loc1 = loc, loc1_len = 8UL,
        });
}

/* Raw-data side: does this data extent hit metadata already recorded?  Emits
   and returns 0 on overlap.  Also records the extent so metadata read LATER can
   catch the same collision from its own side.

   WHAT names the layout that declared the extent -- "chunk" or "contiguous" --
   and selects the record family through the finding's route shard, because the
   two live in different families (chunk_index and dataset_layout_filter_fill)
   while the invariant is one and the same.  COMPACT layout is deliberately
   absent: its data is embedded in the layout message payload and bounded
   against msg_size, so it has no independent extent to collide with anything.  */
fun h5policy_data_extent_disjoint = (uint<64> addr, uint<64> size,
                                     off64 loc, string object,
                                     string what) int:
{
    if (size == 0UL)
        return 1;
    if (h5policy_chunk_extent_checks >= H5POLICY_MAX_CHUNK_EXTENT_CHECKS)
        {
            h5policy_extents_truncated = 1;
            return 1;
        }
    h5policy_chunk_extent_checks = h5policy_chunk_extent_checks + 1UL;

    var lo = addr;
    var hi = h5policy_extent_hi(addr, size);
    var n = h5policy_meta_lo'length as uint<64>;
    h5policy_walk_tick(n + 1UL);
    var i = 0UL;
    while (i < n)
        {
            if (h5policy_intervals_overlap(lo, hi,
                                           h5policy_meta_lo[i],
                                           h5policy_meta_hi[i]))
                {
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_RAW_DATA_OVERLAPS_METADATA", "corrupt",
                        loc, object,
                        what + " data extent overlaps file metadata",
                        H5Evidence {
                            field = what + ".data_disjoint_from_metadata",
                            actual = lo,
                            expected = h5policy_meta_hi[i],
                            comparison = "at_least",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = loc, loc1_len = 8UL,
                        });
                    return 0;
                }
            i = i + 1UL;
        }

    /* Raw data must also be disjoint from OTHER raw data.  Two datasets sharing
       bytes is not a feature HDF5 has: the allocator gives every chunk and every
       contiguous extent its own space, so an overlap means one dataset serves
       another's bytes.  MEASURED on two 25-element datasets whose chunks were
       crossed -- /a's first chunk returned /b's values (222s where 111s belong)
       and h5dump exited 0.  Same silent-wrong-answer character as the metadata
       case, and a cross-DATASET read wherever a consumer exposes one dataset of
       a file without exposing another.
       Scanned against the extents recorded so far, which is the same list the
       metadata side already keeps, so this costs one more capped linear pass and
       nothing new is stored. */
    var dn = h5policy_chunk_extent_lo'length as uint<64>;
    h5policy_walk_tick(dn + 1UL);
    var d = 0UL;
    while (d < dn)
        {
            if (h5policy_intervals_overlap(lo, hi,
                                           h5policy_chunk_extent_lo[d],
                                           h5policy_chunk_extent_hi[d])
                && h5policy_chunk_extent_loc[d] != (loc/#B) as uint<64>)
                {
                    h5policy_report_data_over_data(
                        what, loc, object, lo, h5policy_chunk_extent_lo[d]);
                    return 0;
                }
            d = d + 1UL;
        }

    if (h5policy_chunk_extent_lo'length as uint<64> < H5POLICY_MAX_CHUNK_EXTENT_CHECKS)
        {
            h5policy_chunk_extent_lo += [lo];
            h5policy_chunk_extent_hi += [hi];
            h5policy_chunk_extent_what += [what];
            h5policy_chunk_extent_loc += [(loc/#B) as uint<64>];
        }
    else
        h5policy_extents_truncated = 1;
    return 1;
}

/* The reverse-direction report, extracted so its message is `what + suffix`
   with WHAT as parameter 0 -- the shape tools/message_routing.py can analyse.
   Composed inline it was UNANALYZABLE, and an unroutable message is invisible to
   check_registry rather than merely ugly.  The role leads both phrasings for the
   same reason.  */
fun h5policy_report_data_overlapped = (string what, off64 loc, string object,
                                       uint<64> data_lo, uint<64> meta_hi) void:
{
    h5policy_emit_error_ev(
        "H5_CORRUPT_RAW_DATA_OVERLAPS_METADATA", "corrupt", loc, object,
        what + " data extent is overlapped by file metadata read later",
        H5Evidence {
            field = what + ".data_disjoint_from_metadata",
            actual = data_lo,
            expected = meta_hi,
            comparison = "at_least",
            has_loc1 = 1, loc1_role = "actual",
            loc1 = loc, loc1_len = 8UL,
        });
}

/* Metadata side: record this structure's extent, and catch a chunk recorded
   EARLIER that lands inside it.  Called from h5policy_account_metadata, so
   every structure already charged against the metadata budget is covered --
   the superblock and both object-header versions among them.  */
fun h5policy_record_metadata_extent = (uint<64> lo, uint<64> bytes,
                                       off64 loc, string object) void:
{
    if (bytes == 0UL)
        return;
    var hi = h5policy_extent_hi(lo, bytes);

    var n = h5policy_chunk_extent_lo'length as uint<64>;
    h5policy_walk_tick(n + 1UL);
    var i = 0UL;
    while (i < n)
        {
            if (h5policy_intervals_overlap(lo, hi,
                                           h5policy_chunk_extent_lo[i],
                                           h5policy_chunk_extent_hi[i]))
                {
                    /* Reported at the METADATA, because that is what this call
                       site can name; the chunk that collides with it was read
                       earlier and its own record is already past.  */
                    /* The role is passed as a LITERAL from each branch rather
                       than as the array element, so tools/message_routing.py can
                       enumerate both messages: it resolves a composing helper's
                       `what` from the call site, and an array subscript is not
                       something it can evaluate.  Two branches for two roles is
                       the honest cost of keeping the message routable -- an
                       unroutable message names no record family at all.  */
                    if (h5policy_chunk_extent_what[i] == "contiguous")
                        h5policy_report_data_overlapped(
                            "contiguous", loc, object,
                            h5policy_chunk_extent_lo[i], hi);
                    else
                        h5policy_report_data_overlapped(
                            "chunk", loc, object,
                            h5policy_chunk_extent_lo[i], hi);
                    return;
                }
            i = i + 1UL;
        }

    if (h5policy_meta_lo'length as uint<64> >= H5POLICY_MAX_METADATA_EXTENTS)
        {
            h5policy_extents_truncated = 1;
            return;
        }
    h5policy_meta_lo += [lo];
    h5policy_meta_hi += [hi];
}

/* Classify a continuation target interval [tgt_lo, tgt_hi) against the source
   chunk that referenced it and the set of continuation chunks already decoded
   on this walk, then record it when it is genuinely new:

     0  unique -- disjoint from the source and every prior chunk; recorded.
     1  overlaps the source chunk (self-referential, generalized from the old
        exact cont_addr == chunk_off test to any shared byte).
     2  overlaps a previously decoded continuation chunk (alias / non-progress
        cycle), so following it would re-decode live metadata.

   The membership scan is O(len) and charged to the walk budget, matching the
   other visited-set helpers, so an adversarial fan-out of continuation
   messages still terminates under profile control.  Overlapping targets are
   deliberately NOT recorded: they are rejected, never counted or followed. */
fun h5policy_claim_cont_interval = (uint<64> src_lo, uint<64> src_hi,
                                    uint<64> tgt_lo, uint<64> tgt_hi) int:
{
    h5policy_walk_tick(h5policy_cont_lo'length + 1UL);

    if (h5policy_intervals_overlap(tgt_lo, tgt_hi, src_lo, src_hi))
        return 1;

    var i = 0UL;
    while (i < h5policy_cont_lo'length)
        {
            if (h5policy_intervals_overlap(tgt_lo, tgt_hi,
                                           h5policy_cont_lo[i],
                                           h5policy_cont_hi[i]))
                return 2;
            i = i + 1UL;
        }

    h5policy_cont_lo += [tgt_lo];
    h5policy_cont_hi += [tgt_hi];
    return 0;
}

fun h5policy_mark_visited_btree = (uint<64> addr) int:
{
    if (h5policy_seen_u64(h5policy_visited_btrees, addr))
        return 0;

    h5policy_visited_btrees += [addr];
    return 1;
}

fun h5policy_join_path = (string parent, string name) string:
{
    if (parent == "/")
        return "/" + name;
    return parent + "/" + name;
}

/* Enqueue one object header discovered through a hard link or old-style group
   record.  Depth is checked before enqueueing so a single deep branch cannot
   grow the pending list past the selected profile's link traversal limit.  */
fun h5policy_enqueue_ohdr = (H5PolicyProfile profile,
                             uint<64> addr,
                             uint<64> depth,
                             string path,
                             off64 loc,
                             string object) void:
{
    if (depth > profile.resources.max_link_traversal_depth)
        {
            h5policy_emit_error("H5_RESOURCE_LINK_TRAVERSAL_DEPTH",
                                "resource", loc, object,
                                "link traversal depth exceeds the selected profile limit");
            return;
        }

    if (h5policy_seen_u64(h5policy_visited_ohdrs, addr)
        || h5policy_seen_u64(h5policy_pending_ohdrs, addr))
        {
            /* Duplicate hard links to one object are normal and are exactly
               what this suppression is for.  The superblock extension is the
               one address that must never be reached twice: it is file-level
               metadata outside the object graph, and libhdf5 keeps it in its
               own cache ring and refuses to re-protect it as a group or
               dataset ("ring type mismatch occurred for cache entry",
               H5Centry.c).  Without this the alias is silently merged into a
               single walk and the file is accepted, with the object's findings
               attributed to the extension's path.  */
            if (h5policy_ext_ohdr_addr != 0xffffffffffffffffUL
                && addr == h5policy_ext_ohdr_addr)
                h5policy_emit_error("H5_CORRUPT_SUPERBLOCK_EXTENSION_ALIAS",
                                    "corrupt", loc, object,
                                    "superblock extension address aliases a reachable object header");
            return;
        }

    h5policy_pending_ohdrs += [addr];
    h5policy_pending_depths += [depth];
    h5policy_pending_paths += [path];
}

/* Build an empty context with all per-dataset flags cleared.  A fresh context
   is also used for attribute payloads so attribute datatype/dataspace messages
   do not pollute the parent dataset's cross-message checks.  */
fun h5policy_new_walk_context = H5WalkContext:
{
    return H5WalkContext
    {
        metadata_seen = 0UL,
        object_count = 0UL,
        attribute_count = 0UL,
        object_header_chunk_count = 0UL,
        btree_depth = 0UL,
        link_depth = 0UL,
        dtype_depth = 0UL,
        max_rank_seen = 0UL,
        dataspace_rank = 0UL,
        dataset_element_count = 0UL,
        datatype_size = 0UL,
        datatype_size_offset = 0UL,
        datatype_logical_size = 0UL,
        fill_value_size = 0UL,
        compact_layout_size = 0UL,
        contiguous_layout_size = 0UL,
        contiguous_layout_addr = 0xffffffffffffffffUL,
        contiguous_layout_addr_offset = 0UL,
        legacy_chunked_layout_ndims = 0UL,
        legacy_chunked_layout_ndims_offset = 0UL,
        chunk_dataset_element_count = 0UL,
        chunk_logical_bytes = 0UL,
        logical_dataset_bytes = 0UL,
        max_logical_dataset_bytes_seen = 0UL,
        accounted_chunk_count = 0UL,
        metadata_count_exceeded = 0UB,
        chunk_count_exceeded = 0UB,
        has_dataspace = 0UB,
        has_datatype = 0UB,
        has_dataset_layout = 0UB,
        has_fill_value = 0UB,
        has_compact_layout = 0UB,
        has_contiguous_layout = 0UB,
        has_legacy_chunked_layout = 0UB,
        has_chunked_layout = 0UB,
        has_link_info = 0UB,
        has_group_info = 0UB,
        has_symbol_table = 0UB,
        has_link_message = 0UB,
        dataset_element_count_overflowed = 0UB,
        dataset_dim_exceeds_max = 0UB,
        dataspace_has_max_dims = 0UB,
        dataspace_has_unlimited_dim = 0UB
    };
}

/* Resource counters are updated through checked arithmetic so over-budget and
   overflow cases become explicit findings instead of wrapping silently.  */
fun h5policy_count_object = (H5WalkContext ctx,
                             H5PolicyProfile profile,
                             off64 loc,
                             string object) H5WalkContext:
{
    var next = h5policy_checked_add_u64(ctx.object_count, 1UL,
                                        profile.resources.max_object_count,
                                        "H5_RESOURCE_OBJECT_COUNT",
                                        "resource",
                                        loc, object,
                                        "object count budget exceeded");
    ctx.object_count = next;
    return ctx;
}

fun h5policy_account_metadata = (H5WalkContext ctx,
                                 H5PolicyProfile profile,
                                 uint<64> bytes,
                                 off64 loc,
                                 string object) H5WalkContext:
{
    var limit = profile.resources.max_accounted_metadata_bytes;
    var exceeds = bytes > limit;
    if (!exceeds && ctx.metadata_seen > limit - bytes)
        exceeds = 1;
    var next = h5policy_checked_add_u64(ctx.metadata_seen, bytes,
                                        limit,
                                        "H5_RESOURCE_ACCOUNTED_METADATA_BYTES",
                                        "resource",
                                        loc, object,
                                        "accounted metadata byte budget exceeded");
    ctx.metadata_seen = next;
    if (exceeds)
        ctx.metadata_count_exceeded = 1UB;
    /* Every accounted structure is also a metadata EXTENT.  Recording it here
       rather than at 22 call sites is the whole reason this check was cheap:
       each caller already passes both the byte count and the location.  */
    h5policy_record_metadata_extent(loc/#B, bytes, loc, object);
    return ctx;
}

/* Claim one or more chunks against the file-wide resource ceiling.  The
   reported counter saturates at the ceiling, while chunk_count_exceeded keeps
   the otherwise-lost distinction between exact equality and proven overflow.
   Emit the resource finding only for the first proof of overflow. */
fun h5policy_count_chunks = (H5WalkContext ctx,
                             H5PolicyProfile profile,
                             uint<64> chunks,
                             off64 loc,
                             string object,
                             string message) H5WalkContext:
{
    var limit = profile.resources.max_chunk_count;
    var exceeds = chunks > limit;

    h5policy_walk_tick(1UL);
    if (!exceeds
        && ctx.accounted_chunk_count > limit - chunks)
        exceeds = 1;

    if (exceeds)
        {
            if (ctx.chunk_count_exceeded == 0UB)
                h5policy_emit_error("H5_RESOURCE_CHUNK_COUNT", "resource",
                                    loc, object, message);
            ctx.accounted_chunk_count = limit;
            ctx.chunk_count_exceeded = 1UB;
        }
    else
        ctx.accounted_chunk_count = ctx.accounted_chunk_count + chunks;

    return ctx;
}

/* These mapping wrappers centralize strict/non-strict behavior.  Strict mode
   uses ordinary mappings; non-strict mode uses @! so corrupt structures can be
   inspected long enough to collect nearby findings.  */
fun h5policy_map_msg_prefix = (int ios, H5PolicyProfile profile,
                               offset<uint<64>,B> off) msg_prefix:
{
    var size = global_version == 1 ? 5UL
               : (global_crt_tracked != 0 ? 6UL : 4UL);
    var source = h5policy_mdci_replay_source(off/#B, size);
    if (source != 0xffffffffffffffffUL)
        {
            if (h5policy_run_options.nonstrict_mapping != 0UB)
                return msg_prefix @! ios : source#B;
            return msg_prefix @ ios : source#B;
        }
    if (h5policy_run_options.nonstrict_mapping != 0UB)
        return msg_prefix @! ios : off;
    return msg_prefix @ ios : off;
}

fun h5policy_map_cont = (int ios, H5PolicyProfile profile,
                         offset<uint<64>,B> off) oh_msg_cont:
{
    var size = (global_sizeof_offsets as uint<64>)
               + (global_sizeof_lengths as uint<64>);
    var source = h5policy_mdci_replay_source(off/#B, size);

    /* The shared pickle rejects zero extents and targets past declared EOF.
       The continuation dispatcher must instead receive these raw fields so it
       can emit H5_CORRUPT_ZERO_CONTINUATION_CHUNK or
       H5_CORRUPT_OFFSET_OUT_OF_FILE before deciding whether to follow the
       target.  Keep this exception local to the payload: ordinary message
       prefixes and all other mappings retain the profile-selected strictness. */
    if (source != 0xffffffffffffffffUL)
        return oh_msg_cont @! ios : source#B;
    return oh_msg_cont @! ios : off;
}

fun h5policy_msg_bytes = (int ios, H5PolicyProfile profile,
                          offset<uint<64>,B> off,
                          uint<64> size) byte[]:
{
    h5policy_walk_tick(size + 1UL);   /* account the bytes touched, not just the call */
    var source = h5policy_mdci_replay_source(off/#B, size);
    if (source != 0xffffffffffffffffUL)
        {
            if (h5policy_run_options.nonstrict_mapping != 0UB)
                return byte[size] @! ios : source#B;
            return byte[size] @ ios : source#B;
        }
    if (h5policy_run_options.nonstrict_mapping != 0UB)
        return byte[size] @! ios : off;
    return byte[size] @ ios : off;
}

/* Decode an on-disk unsigned integer into h5policy's uint64 domain.  HDF5 can
   advertise 16-byte length fields even though all addresses and resource
   budgets in this validator are bounded by uint64.  Values with a nonzero
   upper limb cannot describe an extent in a file h5policy can represent, so
   report them instead of silently truncating or shifting by >= 64 bits. */
fun h5policy_decode_u64_raw = (byte[] raw, off64 loc,
                               string object) uint<64>:
{
    if (raw'length <= 8)
        return bytes_to_u64_le(raw);

    var all_ones = 1;
    var u = 0UL;
    while (u < raw'length)
        {
            if (raw[u] != 0xffUB) all_ones = 0;
            u = u + 1UL;
        }
    if (all_ones)
        return 0xffffffffffffffffUL;

    var i = 8UL;
    while (i < raw'length)
        {
            if (raw[i] != 0UB)
                {
                    h5policy_emit_error("H5_CORRUPT_LENGTH_EXCEEDS_U64",
                                        "corrupt", loc, object,
                                        "encoded metadata length exceeds the validator's 64-bit file domain");
                    return 0xffffffffffffffffUL;
                }
            i = i + 1UL;
        }
    return bytes_to_u64_le_at(raw, 0UL, 8UL);
}

fun h5policy_msg_u64_at = (int ios, H5PolicyProfile profile,
                           offset<uint<64>,B> off,
                           uint<64> size) uint<64>:
{
    var raw = h5policy_msg_bytes(ios, profile, off, size);
    return h5policy_decode_u64_raw(raw, off, "metadata");
}

/* Sentinel for "this node has no expected level": the root of a v1 B-tree has
   no parent to constrain it.  Mirrors libhdf5's H5B_UNKNOWN_NODELEVEL, which
   its cache-load udata carries for the same reason. */
var H5POLICY_BTREE_LEVEL_UNKNOWN = 0xffffffffffffffffUL;

/* Does a NUL byte appear anywhere in `size` bytes at `off`?

   The question every fixed-width on-disk string raises, because libhdf5 reaches
   for strnlen over a span and fails the decode when the terminator is missing.
   Callers must have bounds-checked the span first; a zero size answers no
   without reading.  Reading the span in one go keeps this a single accounted
   operation rather than one tick per byte, so callers should pass the span they
   expect to find the terminator in and widen only on a miss. */
fun h5policy_span_has_nul = (int ios, H5PolicyProfile profile,
                             offset<uint<64>,B> off,
                             uint<64> size) int:
{
    if (size == 0UL)
        return 0;
    var raw = h5policy_msg_bytes(ios, profile, off, size);
    var i = 0UL;
    while (i < size)
        {
            if (raw[i] == 0UB)
                return 1;
            i = i + 1UL;
        }
    return 0;
}

/* Decode an HDF5 file address and translate it through the superblock base.
   Keep this distinct from h5policy_msg_u64_at: most variable-width integers are
   lengths, counts, or logical offsets and must never receive base translation. */
fun h5policy_msg_addr_at = (int ios, H5PolicyProfile profile,
                            offset<uint<64>,B> off,
                            uint<64> size) uint<64>:
{
    return hdf5_addr_to_file_u64(h5policy_msg_u64_at(ios, profile, off, size));
}

/* All message validators use payload-relative bounds checks before reading
   variable-length fields.  That keeps malformed size fields from turning into
   poke map exceptions that would otherwise abort the surrounding analysis.  */
fun h5policy_payload_range_ok = (uint<64> msg_size,
                                 uint<64> rel,
                                 uint<64> size,
                                 string code,
                                 off64 loc,
                                 string object,
                                 string message) int:
{
    if (rel > msg_size || size > msg_size - rel)
        {
            h5policy_emit_error(code, "corrupt", loc, object, message);
            return 0;
        }

    return 1;
}

/* Version-1 object headers store message data in 8-byte-aligned slots and
   include that padding in msg_size.  Version-2 headers store the exact payload
   length.  Validators for fixed-size messages use this helper so valid v1
   padding is not mistaken for an extension or swallowed following message. */
fun h5policy_message_size_matches = (uint<64> msg_size,
                                     uint<64> payload_size) int:
{
    if (global_version == 1)
        return msg_size == ((payload_size + 7UL) / 8UL) * 8UL;
    return msg_size == payload_size;
}

/* HDF5 undefined addresses are all-ones at the file's configured offset width.
   Many optional metadata references use this sentinel, so callers pass the raw
   bytes rather than a widened integer to preserve width-specific semantics.  */
fun h5policy_msg_addr_is_undef = (byte[] raw) int:
{
    var n = 0UL;

    while (n < raw'length)
        {
            if (raw[n] != 0xffUB) return 0;
            n = n + 1UL;
        }

    return 1;
}

/* Decode bounded, NUL-terminated names out of metadata payloads.  The caller
   supplies a validated byte window; this routine never scans beyond it.  */
fun h5policy_string_from_payload = (int ios, H5PolicyProfile profile,
                                    offset<uint<64>,B> off,
                                    uint<64> size) string:
{
    var name = "";
    var i = 0UL;

    while (i < size)
        {
            var b = h5policy_msg_u64_at(ios, profile, off + i#B, 1UL) as uint<8>;
            if (b == 0UB)
                return name;
            name = name + ((b as char) as string);
            i = i + 1UL;
        }

    return name;
}

/* Policy treats core filters differently from plugin filters.  Some built-in
   filters are still advisory because consumers must decode attacker-controlled
   bytes to read data, but they do not require loading external code.  */
fun h5policy_core_filter = (uint<64> filter_id) int:
{
    return filter_id >= 1UL && filter_id <= 6UL;
}

/* Built-in filters that expand/decode data on read: deflate/gzip (1), szip (4),
   n-bit (5), scale-offset (6).  Shuffle (2) only permutes bytes and fletcher32
   (3) only verifies a checksum -- neither decompresses -- so neither is flagged.
   These are the paths where reading the data runs decode code over
   attacker-controlled bytes (the H5Z__filter_scaleoffset / deflate CVE class).  */
fun h5policy_filter_decodes = (uint<64> filter_id) int:
{
    return filter_id == 1UL || filter_id == 4UL
        || filter_id == 5UL || filter_id == 6UL;
}

fun h5policy_filter_name = (uint<64> filter_id) string:
{
    if (filter_id == 1UL) return "deflate/gzip";
    if (filter_id == 4UL) return "szip";
    if (filter_id == 5UL) return "n-bit";
    if (filter_id == 6UL) return "scale-offset";
    return "unknown";
}

/* An unrecognized index reference is still counted before the structural
   decision takes precedence. Record the address once as visited, emit a
   coverage-gap finding, and keep the caller's resource accounting in sync
   without recursively chasing the unknown structure. */
fun h5policy_note_btree_addr = (H5PolicyProfile profile,
                                uint<64> addr,
                                off64 loc,
                                string object,
                                string message) void:
{
    if (addr == 0UL || addr == 0xffffffffffffffffUL)
        return;

    if (h5policy_mark_visited_btree(addr))
        h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                            "unsupported", loc, object, message);
}

fun h5policy_note_chunk_index_addr = (H5WalkContext ctx,
                                      H5PolicyProfile profile,
                                      uint<64> addr,
                                      off64 loc,
                                      string object) H5WalkContext:
{
    if (addr == 0UL || addr == 0xffffffffffffffffUL)
        return ctx;

    ctx = h5policy_count_chunks(ctx, profile, 1UL, loc, object,
                                "chunk index budget exceeded");

    h5policy_note_btree_addr(profile, addr, loc, object,
                             "chunk index traversal is bounded but not decoded yet");
    return ctx;
}

fun h5policy_percent_exceeded = (uint<64> numer,
                                 uint<64> denom,
                                 uint<64> percent) int:
{
    if (denom == 0UL || percent == 0UL)
        return 0;

    var base = (denom / 100UL) * percent;
    var rem = ((denom % 100UL) * percent) / 100UL;
    return numer > base + rem;
}

fun h5policy_check_metadata_ratio = (H5WalkContext ctx,
                                     H5PolicyProfile profile,
                                     uint<64> file_size) void:
{
    if (profile.heuristics.metadata_ratio_reject_percent != 0UL
        && ctx.metadata_seen > profile.heuristics.metadata_ratio_reject_min_bytes
        && h5policy_percent_exceeded(ctx.metadata_seen, file_size,
                                     profile.heuristics.metadata_ratio_reject_percent))
        h5policy_emit_unlocated_error("H5_RESOURCE_METADATA_RATIO", "resource",
                                      "metadata",
                                      "reachable metadata exceeds the selected profile's file-size ratio");
    else if (profile.heuristics.metadata_ratio_warn_percent != 0UL
             && ctx.metadata_seen > profile.heuristics.metadata_ratio_warn_min_bytes
             && h5policy_percent_exceeded(ctx.metadata_seen, file_size,
                                          profile.heuristics.metadata_ratio_warn_percent))
        h5policy_emit_unlocated_warning("H5_ADVISORY_METADATA_RATIO",
                                        "metadata",
                                        "reachable metadata is a large fraction of the file size");
}

fun h5policy_update_chunk_resource_pressure = (H5WalkContext ctx,
                                               H5PolicyProfile profile,
                                               off64 loc,
                                               string object) H5WalkContext:
{
    if (ctx.has_chunked_layout == 0UB
        || ctx.has_dataspace == 0UB
        || ctx.has_datatype == 0UB
        || ctx.dataset_element_count_overflowed != 0UB
        || ctx.chunk_dataset_element_count == 0UL
        || ctx.datatype_logical_size == 0UL)
        return ctx;

    if (ctx.chunk_dataset_element_count
        > 0xffffffffffffffffUL / ctx.datatype_logical_size)
        ctx.chunk_logical_bytes = 0xffffffffffffffffUL;
    else
        ctx.chunk_logical_bytes =
            ctx.chunk_dataset_element_count * ctx.datatype_logical_size;

    if (profile.heuristics.min_logical_chunk_bytes != 0UL
        && ctx.chunk_logical_bytes < profile.heuristics.min_logical_chunk_bytes
        && ctx.dataset_element_count != 0UL)
        {
            var adjusted = ctx.dataset_element_count;
            if (ctx.dataset_element_count
                <= 0xffffffffffffffffUL - (ctx.chunk_dataset_element_count - 1UL))
                adjusted = ctx.dataset_element_count
                           + ctx.chunk_dataset_element_count - 1UL;
            else
                adjusted = 0xffffffffffffffffUL;

            var nchunks = adjusted / ctx.chunk_dataset_element_count;
            if (nchunks > profile.heuristics.max_chunks_below_min_logical_bytes)
                h5policy_emit_error("H5_RESOURCE_CHUNK_TOO_SMALL", "resource",
                                    loc, object,
                                    "logical chunk size is too small for the estimated chunk count");
        }

    return ctx;
}

/* Cross-message dataset check.  Dataspace, datatype, layout, and fill-value
   messages can arrive in any object-header order, so every validator calls back
   here after updating its part of ctx.  The function is idempotent and only
   emits checks whose prerequisites have been seen.  */
fun h5policy_update_logical_dataset_size = (int ios,
                                            H5WalkContext ctx,
                                            H5PolicyProfile profile,
                                            off64 loc,
                                            string object) H5WalkContext:
{
    if (ctx.has_dataspace != 0UB && ctx.has_datatype != 0UB)
        {
            if (ctx.has_dataset_layout != 0UB
                && ctx.dataset_dim_exceeds_max != 0UB)
                {
                    h5policy_emit_error("H5_CORRUPT_DATASPACE_DIMENSION_EXCEEDS_MAX",
                                        "corrupt", loc, object,
                                        "dataspace current dimension exceeds maximum dimension");
                    ctx.dataset_dim_exceeds_max = 0UB;
                }

            if (ctx.dataset_element_count_overflowed != 0UB)
                {
                    ctx.logical_dataset_bytes = 0xffffffffffffffffUL;
                    if (ctx.logical_dataset_bytes > ctx.max_logical_dataset_bytes_seen)
                        ctx.max_logical_dataset_bytes_seen = ctx.logical_dataset_bytes;
                    return ctx;
                }

            var storage_dataset_bytes = 0UL;
            if (ctx.has_dataset_layout != 0UB
                && ctx.dataset_element_count != 0UL
                && ctx.datatype_size > 0xffffffffffffffffUL / ctx.dataset_element_count)
                {
                    h5policy_emit_error("H5_CORRUPT_DATASET_STORAGE_OVERFLOW",
                                        "corrupt", loc, object,
                                        "size of dataset storage overflowed");
                    ctx.logical_dataset_bytes = 0xffffffffffffffffUL;
                    if (ctx.logical_dataset_bytes > ctx.max_logical_dataset_bytes_seen)
                        ctx.max_logical_dataset_bytes_seen = ctx.logical_dataset_bytes;
                    return ctx;
                }
            if (ctx.dataset_element_count != 0UL)
                storage_dataset_bytes = ctx.dataset_element_count * ctx.datatype_size;

            ctx.logical_dataset_bytes =
                h5policy_checked_mul_u64(ctx.dataset_element_count,
                                         ctx.datatype_logical_size,
                                         profile.resources.max_logical_dataset_bytes,
                                         "H5_RESOURCE_LOGICAL_DATASET_BYTES",
                                         "resource",
                                         loc, object,
                                         "logical dataset byte budget exceeded");
            if (ctx.logical_dataset_bytes > ctx.max_logical_dataset_bytes_seen)
                ctx.max_logical_dataset_bytes_seen = ctx.logical_dataset_bytes;

            ctx = h5policy_update_chunk_resource_pressure(ctx, profile,
                                                          loc, object);

            if (ctx.has_dataset_layout != 0UB
                && ctx.has_compact_layout != 0UB
                && ctx.compact_layout_size != storage_dataset_bytes)
                h5policy_emit_error("H5_CORRUPT_COMPACT_LAYOUT_SIZE_MISMATCH",
                                    "corrupt", loc, object,
                                    "compact layout data size does not match the dataspace and datatype");

            if (ctx.has_dataset_layout != 0UB
                && ctx.has_contiguous_layout != 0UB
                && ((storage_dataset_bytes == 0UL && ctx.contiguous_layout_size != 0UL)
                    || (storage_dataset_bytes != 0UL && ctx.contiguous_layout_size == 0UL)))
                h5policy_emit_error("H5_CORRUPT_CONTIGUOUS_LAYOUT_SIZE_MISMATCH",
                                    "corrupt", loc, object,
                                    "contiguous layout data size does not match the dataspace and datatype");

            /* THE EXTENT libhdf5 ENFORCES IS THE COMPUTED ONE, NOT THE STORED
               ONE.  H5D__contig_check recomputes data_size = nelmts * dt_size
               from the dataspace extent and the datatype and bounds THAT
               against the raw-data EOA (H5Dcontig.c:391-411); it never compares
               the size field the layout message carries.  So a layout whose
               stored size is perfectly in-file can still name an extent that
               runs off the end once the real element count is applied -- which
               is exactly the corpus specimen here: stored size 320 at address
               1016 in a 2072-byte file, while the dataspace says 65546 elements
               of a 32-byte datatype, so libhdf5 computes 2097472 and refuses
               the open.  h5policy bounded only the stored size and accepted it.

               dt_size IS THE RAW ON-DISK SIZE, hence ctx.datatype_size and not
               ctx.datatype_logical_size.  H5D__contig_init passes
               dset->shared->type (H5Dcontig.c:528), the FILE datatype at
               H5T_LOC_DISK, so the H5R_REF_BUF_SIZE (64) substitution in
               H5Tref.c has not been applied.  MEASURED against libhdf5 2.3.0 on
               a contiguous H5T_STD_REF dataset: on-disk element size 18,
               8 elements at address 2048 with EOA 2192, so the raw product fits
               exactly (2192) while the logical product would overrun (2560) --
               and the library opens the file.  Using the logical size here would
               reject a valid libhdf5-written file, and no h5py-built fixture
               could catch it, because h5py writes only old-style 8-byte object
               references where the two sizes coincide.

               Both bounds mirror the source: the wrap test is H5Dcontig.c:408
               and the ceiling test is :411, and both sit behind libhdf5's
               H5_addr_defined guard at :399 -- an unallocated dataset has no
               extent to check.  Same code and message as the stored-size bound
               in h5policy_check_contiguous_extent, because it is the same
               address-space invariant reached with the right quantity.  */
            /* Gated on the ADDRESS alone, deliberately not on
               has_contiguous_layout: that flag means "a v3+ contiguous message
               with a stored size", which is what the size-mismatch check above
               needs, whereas this bound needs only an allocated address and
               applies to v1/v2 as well -- where libhdf5 discards the stored size
               entirely (H5Dcontig.c:536-551) and the computed extent is the only
               one there is.  */
            if (ctx.has_dataset_layout != 0UB
                && ctx.contiguous_layout_addr != 0xffffffffffffffffUL
                && storage_dataset_bytes != 0UL)
                {
                    /* Reuses the shared range helper so the code, the message and
                       the evidence block are identical to the layout-time bound
                       this replaces -- only the SIZE differs, which is the whole
                       point.  It also gives libhdf5's two branches for free:
                       start-past-ceiling maps to H5Dcontig.c:409 and the range
                       overflow to :411, and `size > file_size - start` after the
                       start bound cannot itself wrap.  */
                    var ignored =
                        h5policy_checked_addr_range_at(ctx.contiguous_layout_addr,
                                                       storage_dataset_bytes,
                                                       h5policy_ceiling(ios),
                                                       "contiguous data range outside file",
                                                       ctx.contiguous_layout_addr_offset#B,
                                                       object,
                                                       ctx.contiguous_layout_addr_offset,
                                                       global_sizeof_offsets as uint<64>);
                }
        }

    return ctx;
}

/* Legacy chunked layouts encode one extra dimension for the chunk's element
   size field.  The rank check has to wait until both dataspace and layout are
   known, so it lives in this shared updater.  */
fun h5policy_update_legacy_chunked_layout_rank = (H5WalkContext ctx,
                                                 off64 loc,
                                                 string object) H5WalkContext:
{
    if (ctx.has_dataspace != 0UB && ctx.has_legacy_chunked_layout != 0UB
        && ctx.legacy_chunked_layout_ndims != ctx.dataspace_rank + 1UL)
        h5policy_emit_error_ev(
            "H5_CORRUPT_LAYOUT_RANK_MISMATCH", "corrupt", loc, object,
            "legacy chunked layout dimensionality does not match dataspace rank",
            H5Evidence {
                field = "layout.legacy_chunk_dimensions",
                actual = ctx.legacy_chunked_layout_ndims,
                expected = ctx.dataspace_rank + 1UL,
                comparison = "equal",
                has_loc1 = 1, loc1_role = "actual", loc1 = loc, loc1_len = 1UL,
            });

    return ctx;
}

/* Fill-value payloads should match the datatype storage size.  As with layout
   checks, this can fire when either message is parsed second.  */
fun h5policy_update_fill_value_size = (H5WalkContext ctx,
                                       off64 loc,
                                       string object) H5WalkContext:
{
    if (ctx.has_fill_value != 0UB && ctx.has_datatype != 0UB
        && ctx.fill_value_size != ctx.datatype_size)
        h5policy_emit_error("H5_CORRUPT_FILL_VALUE_SIZE_MISMATCH",
                            "corrupt", loc, object,
                            "fill value size does not match the dataset datatype size");

    return ctx;
}
