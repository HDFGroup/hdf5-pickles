/* h5_validate.pk connects raw HDF5 structures to the policy walk.  It locates
   the legal superblock root, establishes the file address ceiling, validates
   object-header containers, and hands message chunks to the dispatcher.  */

/* Superblock discovery state is global because the JSON report and h5patch both
   need to know whether a legal superblock offset was found.  */
var h5policy_super_found = 0;
var h5policy_super_off = 0UL#B;

/* Generic all-ones sentinel test for optional superblock addresses.  Message
   code has a width-aware twin in h5_walk.pk; this helper is used before the
   reachable metadata walk has fully started.  */
fun h5policy_addr_is_undef = (byte[] raw) int:
{
    var n = 0UL;

    while (n < raw'length)
        {
            if (raw[n] != 0xffUB) return 0;
            n = n + 1UL;
        }

    return 1;
}

/* Restrict offset and length sizes to widths the shared pickle definitions can
   safely interpret throughout the policy code.  */
fun h5policy_width_supported = (uint<8> width) int:
{
    return width == 2UB || width == 4UB || width == 8UB;
}

/* The on-disk format admits 16-byte lengths, and h5policy's unsigned-value
   decoder can represent their narrow subset.  Do not make that independent
   capability an acceptance promise: the selected libhdf5 target's shared
   H5_DECODE_LENGTH_LEN primitive has no 16-byte case.  Superblock preflight
   therefore refuses the width below as a target-specific compatibility guard,
   before any target decoder reaches such a field. */
fun h5policy_length_width_supported = (uint<8> width) int:
{
    return h5policy_width_supported(width) || width == 16UB;
}

/* Signature probes are strict byte reads.  If the eight-byte magic is not fully
   inside the file image, that candidate offset is not a superblock.  */
fun h5policy_signature_at = (int ios, offset<uint<64>,B> off) int:
{
    if ((off/#B + 8UL) > iosize(ios)/#B)
        return 0;
    return (byte[8] @ ios : off) == H5_FORMAT_FILE_SIGNATURE;
}

/* Legal superblock offsets are byte 0 or userblock offsets at powers of two
   starting at 512.  h5policy does not scan arbitrary offsets because false
   positives would change the trusted root of the metadata graph.  */
fun h5policy_locate_superblock = (int ios) void:
{
    h5policy_super_found = 0;
    h5policy_super_off = 0UL#B;

    /* Only a located superblock is recorded as reached.  A consumer must not be
       told the walk reached the superblock of a file whose signature was never
       found -- that is precisely the file where the question matters.  */
    if (h5policy_signature_at(ios, 0UL#B))
        {
            h5policy_super_found = 1;
            h5policy_super_off = 0UL#B;
            h5policy_mark_reached(0UL, "SUPER");
            return;
        }

    var pos = 512UL;
    var file_size = iosize(ios)/#B;
    while (pos + 8UL <= file_size)
        {
            if (h5policy_signature_at(ios, pos#B))
                {
                    h5policy_super_found = 1;
                    h5policy_super_off = pos#B;
                    h5policy_mark_reached(pos, "SUPER");
                    return;
                }
            pos = pos * 2UL;
        }
}

/* Superblock widths live in the fixed prefix, but the full superblock pickle
   uses those attacker-controlled bytes to size later fields.  Probe the prefix
   first so absurd widths are reported as bounded coverage gaps rather than
   reaching the dynamic-width mapping and throwing out-of-bounds.  Unsupported
   superblock versions still fall through to the ordinary full-map rejection. */
fun h5policy_preflight_super_widths = (int ios,
                                       offset<uint<64>,B> off) int:
{
    var prefix = byte[15] @ ios : off;
    var super_vers = prefix[8];
    var sizeof_offsets = 0UB;
    var sizeof_lengths = 0UB;
    var ok = 1;

    if (super_vers < 2UB)
        {
            sizeof_offsets = prefix[13];
            sizeof_lengths = prefix[14];
        }
    else if (super_vers < 4UB)
        {
            sizeof_offsets = prefix[9];
            sizeof_lengths = prefix[10];
        }
    else
        return 1;

    if (!h5policy_width_supported(sizeof_offsets))
        {
            h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                "unsupported", off, "superblock",
                                "unsupported superblock offset width");
            ok = 0;
        }

    if (!h5policy_length_width_supported(sizeof_lengths))
        {
            h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                "unsupported", off, "superblock",
                                "unsupported superblock length width");
            ok = 0;
        }
    else if (sizeof_lengths == 16UB)
        {
            /* This is deliberately a target-compatibility refusal, not a
               corruption classification.  H5Pset_sizes permits the width,
               but the current libhdf5 length decoder cannot consume it. */
            h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                "unsupported", off, "superblock",
                                "16-byte superblock length fields are conservatively refused for libhdf5 compatibility");
            ok = 0;
        }

    return ok;
}

/* A policy decision needs a stable finding code, not merely a constraint
 * exception.  The superblock is therefore always weak-mapped: its fixed
 * preflight constrains dynamic widths, and h5policy_validate_superblock()
 * classifies every semantic field before traversal.  Other metadata retains
 * the profile-selected strict/non-strict mapping behavior below. */
fun h5policy_map_super = (int ios, H5PolicyProfile profile,
                          offset<uint<64>,B> off) superblock:
{
    return superblock @! ios : off;
}

fun h5policy_map_bytes = (int ios, H5PolicyProfile profile,
                          offset<uint<64>,B> off,
                          uint<64> size) byte[]:
{
    var source = h5policy_mdci_replay_source(off/#B, size);
    if (source != 0xffffffffffffffffUL)
        {
            if (h5policy_run_options.nonstrict_mapping != 0UB)
                return byte[size] @! ios : source#B;
            return byte[size] @ ios : source#B;
        }
    if (h5policy_run_options.nonstrict_mapping != 0UB)
        return byte[size] @! ios : off;
    return byte[size] @ ios : off;
}

fun h5policy_read_u64_le_at = (int ios, H5PolicyProfile profile,
                               offset<uint<64>,B> off,
                               uint<64> size) uint<64>:
{
    return h5policy_decode_u64_raw(h5policy_map_bytes(ios, profile, off, size),
                                   off, "metadata");
}

/* Address checks use the current ceiling, not always the physical file size.
   h5policy_validate_superblock sets h5policy_eof from the declared EOA, and
   later walks reject metadata beyond that boundary.  */
fun h5policy_addr_in_file = (uint<64> addr, uint<64> file_size,
                             string code, off64 loc,
                             string object, string message) int:
{
    if (addr >= file_size)
        {
            h5policy_emit_error(code, "corrupt", loc, object, message);
            return 0;
        }

    return 1;
}

/* Optional addresses are valid when undefined or in range.  Defined but
   out-of-file values are findings even when the referenced structure is not
   otherwise decoded by this phase.  */
fun h5policy_validate_optional_addr = (byte[] raw, uint<64> file_size,
                                       off64 loc, string object,
                                       string message) void:
{
    if (!h5policy_addr_is_undef(raw))
        {
            var addr = hdf5_addr_to_file_u64(bytes_to_u64_le(raw));
            var ok = h5policy_addr_in_file(addr, file_size,
                                           "H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                           loc, object, message);
        }
}

/* v0/v1 superblocks carry driver information in a standalone block at the
   superblock's driver-info address; v2+ moved the same payload into a
   superblock-extension message (0x0014), which h5policy_validate_drvinfo_payload
   handles.  The encodings differ, and so do their failure modes.  A message is
   bounded by the object header that contains it, so its length can be checked
   against an enclosing extent.  This block has no container: its length is read
   straight out of the file and bounded by nothing.

   That is the live half of registry/cases/driver-info-block-fields-unbounded.yml.
   libhdf5 decodes the prefix in H5F__drvrinfo_prefix_decode
   (src/H5Fsuper_cache.c), which bounds every field against the 16-byte IMAGE
   BUFFER it was handed and no field against the FILE.  The decoded length then
   extends the EOA to cover itself and, in the same callback, becomes the cache
   entry's allocation size -- so it self-authorises, and every downstream
   EOA-relative check is satisfied by construction.  h5policy has no EOA to move,
   so it bounds the block against the ceiling the superblock already declared.

   Header layout is [version:1][reserved:3][len:4][driver id:8]; `len` counts
   only the driver-specific bytes that follow those 16.  */
fun h5policy_validate_drvinfo_block = (int ios, H5PolicyProfile profile,
                                       uint<64> addr) void:
{
    var object = "/<driver-info-block>";
    var ceiling = h5policy_ceiling(ios);
    var loc = addr#B;

    /* The header itself must lie in the file.  libhdf5 reads it speculatively
       and the sec2 driver zero-fills past EOF, so a header running off the end
       decodes as an all-zero block rather than failing -- the same zero-fill
       that made a wild driver-info ADDRESS silently acceptable before 2.3.0
       bounded it.  Written as subtraction because addr + 16 is attacker-reachable
       arithmetic.  */
    if (addr > ceiling || ceiling - addr < 16UL)
        {
            h5policy_emit_error_ev(
                "H5_CORRUPT_DRVINFO_BLOCK_EXTENT", "corrupt", loc, object,
                "driver-info block header does not fit in the file",
                H5Evidence {
                    field = "control.driver_info_extent",
                    actual = addr,
                    expected = (ceiling < 16UL) ? 0UL : ceiling - 16UL,
                    comparison = "at_most",
                    has_loc1 = 1, loc1_role = "actual",
                    loc1 = loc, loc1_len = 1UL
                });
            return;
        }

    var version = h5policy_read_u64_le_at(ios, profile, loc, 1UL);
    if (version != 0UL)
        {
            h5policy_emit_error_ev(
                "H5_CORRUPT_UNSUPPORTED_DRVINFO_VERSION", "corrupt", loc, object,
                "driver-info block has an unsupported version",
                H5Evidence {
                    field = "control.driver_info_encoding",
                    actual = version,
                    expected = 0UL,
                    comparison = "equal",
                    has_loc1 = 1, loc1_role = "actual",
                    loc1 = loc, loc1_len = 1UL
                });
            return;
        }

    /* The three reserved bytes are deliberately NOT checked.  libhdf5 skips them
       without inspection (`image += 3`), so rejecting a nonzero value would make
       h5policy refuse a file libhdf5 opens.  pickles/drv_info.pk constrains them
       to zero, but that is the descriptive model of a conforming writer, not the
       bound this oracle may enforce.  */

    var body_len = h5policy_read_u64_le_at(ios, profile, loc + 4#B, 4UL);
    if (body_len > ceiling - addr - 16UL)
        {
            h5policy_emit_error_ev(
                "H5_CORRUPT_DRVINFO_BLOCK_EXTENT", "corrupt", loc + 4#B, object,
                "driver-info block body extends past the end of the file",
                H5Evidence {
                    field = "control.driver_info_extent",
                    actual = body_len,
                    expected = ceiling - addr - 16UL,
                    comparison = "at_most",
                    has_loc1 = 1, loc1_role = "actual",
                    loc1 = loc + 4#B, loc1_len = 4UL
                });
            return;
        }

    /* The driver identification and the driver-specific bytes after it are
       consumed by a VFD and can name other files.  As on the message path, an
       opaque body that decodes cleanly is not a validated one, so a well-formed
       block stays an explicit coverage refusal rather than an accept.  */
    h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP", "unsupported",
                        loc + 8#B, object,
                        "driver-specific member files are not validated");
}

/* v0/v1 superblocks have no superblock-extension object header.  Return the
   undefined-address sentinel so the reachable walk can treat "none" uniformly. */
fun h5policy_super_ext_addr = (superblock sb) uint<64>:
{
    if (sb.super_vers < 2UB)
        return 0xffffffffffffffffUL;   /* v0/v1 use a driver-info block, not an ohdr */
    if (h5policy_addr_is_undef(sb.super.v2_v3.ext_addr_raw))
        return 0xffffffffffffffffUL;
    return hdf5_addr_to_file_u64(bytes_to_u64_le(sb.super.v2_v3.ext_addr_raw));
}

/* Root object headers live in different superblock fields across versions, but
   downstream traversal wants one byte offset.  */
fun h5policy_root_addr = (superblock sb) offset<uint<64>,B>:
{
    if (sb.super_vers < 2UB)
        return bytes_to_off(sb.super.v0_v1.root_stab_ent.ohdr_addr_raw);
    return bytes_to_off(sb.super.v2_v3.root_obj_addr_raw);
}

/* Validate the fields that define the rest of the address space: offset/length
   widths, K values for legacy indexes, declared EOA, root and optional metadata
   addresses, and v2/v3 checksum integrity.  */
fun h5policy_validate_superblock = (int ios, superblock sb,
                                    H5PolicyProfile profile,
                                    H5WalkContext ctx,
                                    offset<uint<64>,B> super_off) H5WalkContext:
{
    var file_size = iosize(ios)/#B;

    ctx = h5policy_account_metadata(ctx, profile,
                                    sb'size/#B, super_off, "superblock");

    if (sb.super_vers < 2UB)
        {
            if (!h5policy_width_supported(sb.super.v0_v1.sizeof_offsets))
                h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                    "unsupported", super_off, "superblock",
                                    "unsupported superblock offset width");

            if (!h5policy_length_width_supported(sb.super.v0_v1.sizeof_lengths))
                h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                    "unsupported", super_off, "superblock",
                                    "unsupported superblock length width");

            if (sb.super.v0_v1.fs_info_vers != 0UB
                || sb.super.v0_v1.root_stab_vers != 0UB
                || sb.super.v0_v1.shared_hdr_vers != 0UB)
                h5policy_emit_error("H5_CORRUPT_UNSUPPORTED_SUPERBLOCK_FIELD_VERSION",
                                    "corrupt", super_off, "superblock",
                                    "legacy superblock contains an unsupported format-version field");
            if (sb.super.v0_v1.res1 != 0UB || sb.super.v0_v1.res2 != 0UB)
                h5policy_emit_error("H5_CORRUPT_SUPERBLOCK_RESERVED",
                                    "corrupt", super_off, "superblock",
                                    "legacy superblock reserved field is nonzero");
            if (sb.super.v0_v1.stab_leaf_k == 0UH
                || sb.super.v0_v1.stab_internal_k == 0UH)
                h5policy_emit_error("H5_CORRUPT_SUPERBLOCK_K_VALUE",
                                    "corrupt", super_off, "superblock",
                                    "legacy superblock B-tree K value is zero");
            if (sb.super_vers == 1UB)
                {
                    if (sb.super.v0_v1.res3 != 0UH)
                        h5policy_emit_error("H5_CORRUPT_SUPERBLOCK_RESERVED",
                                            "corrupt", super_off, "superblock",
                                            "legacy superblock reserved field is nonzero");
                    if (sb.super.v0_v1.indexed_internal_k == 0UH)
                        h5policy_emit_error("H5_CORRUPT_SUPERBLOCK_K_VALUE",
                                            "corrupt", super_off, "superblock",
                                            "legacy superblock B-tree K value is zero");
                }

            var base = bytes_to_u64_le(sb.super.v0_v1.base_addr_raw);
            var eof = bytes_to_u64_le(sb.super.v0_v1.eof_addr_raw);
            var root = hdf5_addr_to_file_u64(bytes_to_u64_le(sb.super.v0_v1.root_stab_ent.ohdr_addr_raw));
            h5policy_super_stab_leaf_k =
                sb.super.v0_v1.stab_leaf_k as uint<64>;
            h5policy_super_stab_internal_k =
                sb.super.v0_v1.stab_internal_k as uint<64>;
            h5policy_super_indexed_internal_k =
                (sb.super_vers == 1UB)
                ? (sb.super.v0_v1.indexed_internal_k as uint<64>)
                : 32UL;

            /* The v0/v1 superblock stores the consistency flags in a 32-bit
               field even though only the low byte is ever meaningful, so it has
               two separate rules and libhdf5 enforces them as two tests.

               First the width: anything above 255 means the upper three bytes
               carry data the format never defines.  libhdf5 gained this one at
               2.0.0 (H5Fsuper_cache.c, "bad superblock status flags"), so the
               1.14.5 an h5py oracle links does not have it and h5policy is
               stricter than that build here.

               Then the flag bits themselves, which is the same rule the v2/v3
               path applies to its single byte: only write-access, file-ok and
               SWMR-write-access are defined (H5F_SUPER_ALL_FLAGS == 0x07).
               That test has been there since 1.14.1.  */
            var v01_status = sb.super.v0_v1.status_flags as uint<64>;
            if (v01_status > 255UL)
                h5policy_emit_error_ev("H5_CORRUPT_SUPERBLOCK_STATUS_FLAGS_HIGH_BYTES",
                                       "corrupt", super_off, "superblock",
                                       "superblock v0/v1 status flags set bits above the low byte",
                                       H5Evidence {
                                           field = "superblock.status_flags_width",
                                           actual = v01_status,
                                           expected = 255UL,
                                           comparison = "at_most",
                                           has_loc1 = 1, loc1_role = "actual",
                                           loc1 = super_off + 20#B,
                                           loc1_len = 4UL,
                                       });
            else if ((v01_status & 0xf8UL) != 0UL)
                h5policy_emit_error_ev("H5_CORRUPT_SUPERBLOCK_STATUS_FLAGS",
                                       "corrupt", super_off, "superblock",
                                       "superblock v0/v1 status flags use reserved bits",
                                       H5Evidence {
                                           field = "superblock.status_flags",
                                           actual = v01_status,
                                           expected = 0x07UL,
                                           comparison = "subset_of",
                                           has_loc1 = 1, loc1_role = "actual",
                                           loc1 = super_off + 20#B,
                                           loc1_len = 4UL,
                                       });

            /* Adopt the declared EOF as the address ceiling for the walk.  */
            h5policy_eof = eof;
            h5policy_has_eof = 1;

            /* The HDF5 spec constrains the base address to equal the address of
               the superblock itself (0 with no userblock).  libhdf5 measures the
               EOA relative to base, so a wrong base shifts every address and it
               rejects with "actual len exceeds EOA".  */
            if (base != super_off/#B)
                h5policy_emit_error("H5_CORRUPT_BASE_ADDRESS_MISMATCH",
                                    "corrupt", super_off, "superblock",
                                    "superblock base address does not match the superblock location");
            if (eof > file_size)
                h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                    "corrupt", super_off, "superblock",
                                    "end-of-file address is beyond the available file image");
            var ok_root = h5policy_addr_in_file(root, h5policy_ceiling(ios),
                                                "H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                                super_off, "/",
                                                "root object header address is at or beyond the declared end-of-file");
            h5policy_validate_optional_addr(sb.super.v0_v1.fs_info_addr_raw,
                                            file_size, super_off,
                                            "superblock",
                                            "free-space info address is outside the file");
            /* The address bound is the half libhdf5 gained at 2.3.0 (driver_addr
               against stored_eof, src/H5Fsuper_cache.c).  The block BEHIND that
               address is still unbounded upstream, so h5policy decodes it here
               rather than stopping at the pointer.  Only reached when the address
               is defined and in the file -- a wild address is already a finding,
               and reading a block at it would be decoding on top of a rejection.  */
            if (!h5policy_addr_is_undef(sb.super.v0_v1.drv_info_addr_raw))
                {
                    var drv_addr = hdf5_addr_to_file_u64(
                        bytes_to_u64_le(sb.super.v0_v1.drv_info_addr_raw));
                    if (h5policy_addr_in_file(drv_addr, file_size,
                                              "H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                              super_off, "superblock",
                                              "driver-info address is outside the file"))
                        h5policy_validate_drvinfo_block(ios, profile, drv_addr);
                }
        }
    else
        {
            if (!h5policy_width_supported(sb.super.v2_v3.sizeof_offsets))
                h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                    "unsupported", super_off, "superblock",
                                    "unsupported superblock offset width");

            if (!h5policy_length_width_supported(sb.super.v2_v3.sizeof_lengths))
                h5policy_emit_error("H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                    "unsupported", super_off, "superblock",
                                    "unsupported superblock length width");

            if (sb.super_vers == 3UB
                && ((sb.super.v2_v3.status_flags.v3_flags & 0xf8UB) != 0UB))
                h5policy_emit_error("H5_CORRUPT_SUPERBLOCK_STATUS_FLAGS",
                                    "corrupt", super_off, "superblock",
                                    "superblock version 3 status flags use reserved bits");

            /* libhdf5 applies one flag test to every version-2-and-later
               superblock, so version 2 is bound by the same 0x07 mask; only
               version 3 was covered here.  Kept as a separate branch rather
               than folded in because the two versions read the flags through
               different arms of the union.  */
            if (sb.super_vers == 2UB
                && ((sb.super.v2_v3.status_flags.v2_flags & 0xf8UB) != 0UB))
                h5policy_emit_error_ev("H5_CORRUPT_SUPERBLOCK_STATUS_FLAGS",
                                       "corrupt", super_off, "superblock",
                                       "superblock version 2 status flags use reserved bits",
                                       H5Evidence {
                                           field = "superblock.status_flags",
                                           actual = sb.super.v2_v3.status_flags.v2_flags as uint<64>,
                                           expected = 0x07UL,
                                           comparison = "subset_of",
                                           has_loc1 = 1, loc1_role = "actual",
                                           loc1 = super_off + 11#B,
                                           loc1_len = 1UL,
                                       });

            var base2 = bytes_to_u64_le(sb.super.v2_v3.base_addr_raw);
            var eof2 = bytes_to_u64_le(sb.super.v2_v3.eof_addr_raw);
            var root2 = hdf5_addr_to_file_u64(bytes_to_u64_le(sb.super.v2_v3.root_obj_addr_raw));

            /* Adopt the declared EOF as the address ceiling for the walk.  */
            h5policy_eof = eof2;
            h5policy_has_eof = 1;

            /* Base address must equal the superblock location (see v0/v1 note).  */
            if (base2 != super_off/#B)
                h5policy_emit_error("H5_CORRUPT_BASE_ADDRESS_MISMATCH",
                                    "corrupt", super_off, "superblock",
                                    "superblock base address does not match the superblock location");
            if (eof2 > file_size)
                h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                    "corrupt", super_off, "superblock",
                                    "end-of-file address is beyond the available file image");
            var ok_root2 = h5policy_addr_in_file(root2, h5policy_ceiling(ios),
                                                 "H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                                 super_off, "/",
                                                 "root object header address is at or beyond the declared end-of-file");
            h5policy_validate_optional_addr(sb.super.v2_v3.ext_addr_raw,
                                            file_size, super_off,
                                            "superblock",
                                            "superblock extension address is outside the file");

            var checksum_bytes = h5policy_map_bytes(ios, profile, super_off,
                                                     (sb'size/#B) - 4UL);
            var checksum = lookup3_hashlittle(checksum_bytes, 0);
            if (checksum != sb.super.v2_v3.chksum)
                h5policy_emit_error("H5_CORRUPT_BAD_CHECKSUM",
                                    "corrupt", super_off, "superblock",
                                    "superblock checksum mismatch");
        }

    return ctx;
}

/* Presence check run once, after every message of an object header has been
   walked.  A dataspace paired with a datatype is the signature of a dataset,
   and libhdf5 requires every dataset to carry exactly one Data Layout message:
   it is the only message that says where the raw data lives.  The library's own
   writer always appends one (H5D__layout_oh_create), and its reader hard-fails
   without it -- H5D__layout_oh_read aborts the open with "unable to read data
   layout message".  A header that omits the layout is therefore a dataset that
   libhdf5 refuses to open; accepting it would be an invariant-A' soundness
   violation, so reject it as corrupt.  Named datatypes (datatype, no dataspace)
   and groups (neither) do not trip this and are unaffected.  */
fun h5policy_finalize_ohdr_dataset = (H5WalkContext ctx,
                                      off64 loc,
                                      string object) void:
{
    if (ctx.has_dataspace != 0UB && ctx.has_datatype != 0UB
        && ctx.has_dataset_layout == 0UB)
        h5policy_emit_error("H5_CORRUPT_DATASET_MISSING_LAYOUT",
                            "corrupt", loc, object,
                            "dataset object header has no data layout message");

    /* n-bit / scale-offset carry the chunk element count libhdf5 derives from
       the chunk dataspace (cd_values[2]).  Their decompressors trust it to size
       the per-chunk output buffer, so it must match the real chunk shape; a
       larger value drives writes past the buffer (and wraps a 32-bit size_t when
       multiplied by the element size).  Filters require chunked storage, so the
       chunk element count is always available here once the layout is seen.  */
    if (h5policy_pipeline_has_decode_nelmts != 0UB
        && ctx.has_chunked_layout != 0UB
        && ctx.chunk_dataset_element_count != 0UL
        && h5policy_pipeline_decode_nelmts != ctx.chunk_dataset_element_count)
        h5policy_emit_error_ev(
            "H5_CORRUPT_FILTER_NELMTS_MISMATCH", "corrupt", loc, object,
            "n-bit/scale-offset filter element count does not match the chunk element count",
            H5Evidence {
                field = "filter.decode_element_count",
                actual = h5policy_pipeline_decode_nelmts,
                expected = ctx.chunk_dataset_element_count,
                comparison = "equal",
                has_loc1 = 1, loc1_role = "actual",
                loc1 = h5policy_pipeline_decode_nelmts_offset#B, loc1_len = 4UL,
            });

    /* A filtered chunk must be at least as large as the fixed framing its own
       pipeline consumes.  fletcher32 and szip each strip four bytes by plain
       subtraction on a size_t (H5Zfletcher32.c:73, H5Zszip.c:298), so a stored
       size of 1, 2 or 3 wraps the length to near SIZE_MAX exactly as 0 does --
       all four values were measured to SIGSEGV the shipped build.  The zero case
       is reported at the record itself, since it is invalid with or without
       filters; this is the rest of the rule, and it has to be here because the
       pipeline message and the chunk index arrive in either order.  */
    if (h5policy_pipeline_has_framing != 0UB
        && h5policy_chunk_has_stored != 0UB
        && h5policy_chunk_min_stored < h5policy_pipeline_chunk_framing)
        h5policy_emit_error_ev(
            "H5_CORRUPT_CHUNK_STORED_SIZE", "corrupt", loc, object,
            "filtered chunk record is smaller than the pipeline's fixed framing",
            H5Evidence {
                field = "chunk.stored_size",
                actual = h5policy_chunk_min_stored,
                expected = h5policy_pipeline_chunk_framing,
                comparison = "at_least",
                has_loc1 = 1, loc1_role = "actual",
                loc1 = h5policy_chunk_min_stored_offset#B, loc1_len = 4UL,
                has_loc2 = 1, loc2_role = "expected",
                loc2 = h5policy_pipeline_framing_offset#B, loc2_len = 1UL,
            });

    /* The other decompressed-buffer factor: the filter's cd_values[4] element
       size must be the real datatype element size.  Inflating it overflows
       nelmts * size just as an inflated element count does, even when the count is
       left consistent.  Recorded for scale-offset and for atomic-root n-bit.  */
    if (h5policy_pipeline_has_decode_size != 0UB
        && ctx.has_datatype != 0UB
        && ctx.datatype_size != 0UL
        && h5policy_pipeline_decode_size != ctx.datatype_size)
        h5policy_emit_error_ev(
            "H5_CORRUPT_FILTER_ELEMENT_SIZE_MISMATCH", "corrupt", loc, object,
            "n-bit/scale-offset filter element size does not match the datatype size",
            H5Evidence {
                field = "filter.decode_element_size",
                actual = h5policy_pipeline_decode_size,
                expected = ctx.datatype_size,
                comparison = "equal",
                has_loc1 = 1, loc1_role = "actual",
                loc1 = h5policy_pipeline_decode_size_offset#B, loc1_len = 4UL,
                has_loc2 = 1, loc2_role = "expected",
                loc2 = ctx.datatype_size_offset#B, loc2_len = 4UL,
            });

    /* A fixed-array chunk index has one, permanent capacity: libhdf5 computes
       prod(ceil(max_dims[i] / chunk_dim[i])) over the data dimensions
       (H5D__chunk_set_info_real, H5Dchunk.c) and stores it in the FAHD header
       at creation (H5D__farray_idx_create: cparam.nelmts = max_nchunks).  The
       array is pre-sized from it -- data-block image, page count, and
       page-initialization bitmask all follow from nelmts -- and it is never
       grown, which is what distinguishes this index type from the extensible
       array and the v2 B-tree.

       Nothing re-derives that agreement on the read path.  A dataset whose
       dataspace declares a maximum extent the index was not sized for makes
       libhdf5 recompute a capacity from the file's own bytes and build native
       state from it: H5Ocopy sizes a fresh destination data block that way and
       aborts the process inside the metadata cache
       (assert(entry_ptr->size < H5C_MAX_ENTRY_SIZE), H5Centry.c) once the
       recomputed bitmask alone exceeds the 32 MB per-entry ceiling.

       Note the invariant is the index CAPACITY, not curr_dims == max_dims: a
       bounded-but-growable dataset (maxshape (100,10), shape (10,10)) is
       legitimately fixed-array indexed, with a capacity sized from the 100.
       Only H5S_UNLIMITED sends libhdf5's writer to another index type, which
       is why an unlimited dimension here can never be reconciled and is
       reported through the same finding.  */
    if (h5policy_has_fixed_array_index != 0UB
        && ctx.has_dataspace != 0UB
        && h5policy_dataspace_max_dims'length != 0UL
        && h5policy_dataspace_max_dims'length
           == h5policy_chunk_grid_dims'length)
        {
            var expected_nelmts = 1UL;
            var expected_ok = 1UB;
            var d = 0UL;
            while (d < h5policy_dataspace_max_dims'length)
                {
                    var max_dim = h5policy_dataspace_max_dims[d];
                    var chunk_dim = h5policy_chunk_grid_dims[d];
                    if (max_dim == 0xffffffffffffffffUL)
                        /* H5S_UNLIMITED: no finite capacity can match it, and
                           libhdf5's own writer would never have chosen this
                           index type.  */
                        expected_ok = 0UB;
                    else if (expected_ok != 0UB)
                        {
                            /* Ceiling division without libhdf5's (max + dim - 1)
                               pre-addition, which wraps near the top of the
                               range; the quotient itself cannot overflow.  */
                            var chunks = max_dim / chunk_dim;
                            if (max_dim % chunk_dim != 0UL)
                                chunks = chunks + 1UL;
                            if (chunks != 0UL
                                && expected_nelmts > 0xffffffffffffffffUL / chunks)
                                /* The true capacity exceeds the 64-bit field the
                                   header stores, so no stored value can match. */
                                expected_ok = 0UB;
                            else
                                expected_nelmts = expected_nelmts * chunks;
                        }
                    d = d + 1UL;
                }
            if (expected_ok == 0UB || expected_nelmts != h5policy_fixed_array_nelmts)
                {
                    /* Every maximum-extent field is a source of `expected`;
                       they are all one length field wide.  */
                    var max_dim_lengths = uint<64>[]();
                    var s = 0UL;
                    while (s < h5policy_dataspace_max_dim_offsets'length)
                        {
                            max_dim_lengths += [global_sizeof_lengths as uint<64>];
                            s = s + 1UL;
                        }
                    h5policy_emit_error_ev(
                        "H5_CORRUPT_FIXED_ARRAY_EXTENT_MISMATCH", "corrupt",
                        h5policy_fixed_array_nelmts_offset#B, object,
                        "fixed-array chunk index capacity does not match the dataspace maximum extent",
                        H5Evidence {
                            field = "chunk_index.fixed_array_capacity",
                            actual = h5policy_fixed_array_nelmts,
                            expected = expected_ok != 0UB
                                       ? expected_nelmts : 0xffffffffffffffffUL,
                            comparison = "equal",
                            has_loc1 = 1, loc1_role = "actual",
                            loc1 = h5policy_fixed_array_nelmts_offset#B,
                            loc1_len = global_sizeof_lengths as uint<64>,
                            source_offsets = h5policy_dataspace_max_dim_offsets,
                            source_lengths = max_dim_lengths,
                        });
                }
        }

    /* The superblock's root object is semantically a group, not an arbitrary
       object header.  h5policy does not yet track a positive "group" type bit,
       so enforce the boundary through the message classes that make an object a
       dataset or a committed datatype: any dataspace, datatype, layout, or
       fill-value fact on "/" means the root decoded as something other than a
       group.  */
    if (object == "/"
        && (ctx.has_dataspace != 0UB
            || ctx.has_datatype != 0UB
            || ctx.has_dataset_layout != 0UB
            || ctx.has_fill_value != 0UB))
        h5policy_emit_error("H5_CORRUPT_ROOT_OBJECT_NOT_GROUP",
                            "corrupt", loc, object,
                            "superblock root object does not decode as a group");

    /* Group link storage.  A group declares where its links live with exactly
       one message: a symbol-table message for the old format, or a link-info
       message for the new one.  libhdf5 picks the branch by asking whether the
       link-info message exists (H5G__obj_get_linfo); when it does not, every
       lookup, iteration and info call falls into the old-format path and reads
       the symbol-table message, which then is not there either -- H5G__obj_lookup
       fails and the traversal aborts.  Measured on a header whose link-info
       message type byte was zeroed: h5dump reports an internal error, h5ls
       cannot resolve the name, and h5py's visit raises "unable to determine
       object type".  Accepting such a header would be an A' violation, so it is
       corrupt.

       The trigger needs positive evidence that the header IS a group, because
       h5policy has no group type bit.  Group-info and compact link messages
       occur in no other object class, and the superblock names the root object
       as a group outright.

       Both group rules are gated on the header having decoded without an
       error of its own.  They are message-ABSENCE rules, and absence only
       means something once the message walk finished: a truncated chunk, an
       overlapping continuation or an oversized message can swallow the very
       message being looked for, and a derived second accusation against an
       already-rejected object is noise, not evidence.  */
    var header_walked_clean =
        h5policy_error_finding_count == h5policy_object_finding_mark;

    if (header_walked_clean
        && (ctx.has_group_info != 0UB || ctx.has_link_message != 0UB
            || object == "/")
        && ctx.has_link_info == 0UB && ctx.has_symbol_table == 0UB)
        h5policy_emit_error("H5_CORRUPT_GROUP_MISSING_LINK_STORAGE",
                            "corrupt", loc, object,
                            "group object header has neither a link-info nor a symbol-table message");

    /* Group info in a new-style group.  libhdf5's writer emits the pair in one
       place -- H5G__obj_create_real creates the link-info and group-info
       messages together -- and H5G__obj_insert then reads the group-info
       message back unconditionally on the new-format branch (H5Gobj.c, "can't
       get group info") to decide between compact link messages and dense
       storage.  A new-style group without one is therefore a group no consumer
       can add a link to.

       This is deliberately NOT a corruption finding.  The read paths that would
       need the message -- H5G__obj_info, H5G__obj_iterate, H5Gtraverse -- all
       guard the read with H5O_msg_exists and fall back to the default group
       creation properties, so libhdf5 opens, traverses and dumps such a file
       without complaint (measured with h5dump, h5ls and h5py).  Calling it
       corrupt would refuse bytes the reference implementation accepts, which is
       an invariant-A failure.  The defect is real but its consequence is
       confined to the write direction, so it is reported as a warning and the
       decision is left alone.  */
    if (header_walked_clean
        && ctx.has_link_info != 0UB && ctx.has_group_info == 0UB)
        h5policy_emit_warning("H5_ADVISORY_GROUP_INFO_MISSING",
                              loc, object,
                              "new-style group has a link-info message but no group-info message");
}

/* Validate one object header at a known byte offset.  The per-object dataset
   scratch fields are cleared before parsing so messages from a previous object
   do not affect cross-message checks for this one.  */
fun h5policy_validate_ohdr_raw = (int ios,
                                  H5PolicyProfile profile,
                                  H5WalkContext ctx,
                                  offset<uint<64>,B> root_off,
                                  string object,
                                  uint<64> depth) H5WalkContext:
{
    var file_size = h5policy_ceiling(ios);
    var sig = h5policy_map_bytes(ios, profile, root_off, 4UL);

    h5policy_current_object_depth = depth;
    h5policy_current_object_msg_count = 0UL;
    h5policy_current_object_root_msg_count = 0UL;
    h5policy_object_finding_mark = h5policy_error_finding_count;
    ctx.has_dataspace = 0UB;
    ctx.has_datatype = 0UB;
    ctx.has_dataset_layout = 0UB;
    ctx.has_fill_value = 0UB;
    ctx.has_link_info = 0UB;
    ctx.has_group_info = 0UB;
    ctx.has_symbol_table = 0UB;
    ctx.has_link_message = 0UB;
    ctx.has_compact_layout = 0UB;
    ctx.has_contiguous_layout = 0UB;
    ctx.has_legacy_chunked_layout = 0UB;
    ctx.dataset_element_count_overflowed = 0UB;
    ctx.dataset_dim_exceeds_max = 0UB;
    ctx.dataspace_has_max_dims = 0UB;
    ctx.dataspace_has_unlimited_dim = 0UB;
    ctx.dataspace_rank = 0UL;
    ctx.dataset_element_count = 0UL;
    ctx.datatype_size = 0UL;
    ctx.datatype_size_offset = 0UL;
    ctx.datatype_logical_size = 0UL;
    ctx.fill_value_size = 0UL;
    ctx.compact_layout_size = 0UL;
    ctx.contiguous_layout_size = 0UL;
    ctx.contiguous_layout_addr = 0xffffffffffffffffUL;
    ctx.contiguous_layout_addr_offset = 0UL;
    ctx.legacy_chunked_layout_ndims = 0UL;
    ctx.legacy_chunked_layout_ndims_offset = 0UL;
    ctx.chunk_dataset_element_count = 0UL;
    ctx.chunk_logical_bytes = 0UL;
    ctx.logical_dataset_bytes = 0UL;
    ctx.has_chunked_layout = 0UB;
    h5policy_pipeline_decode_nelmts = 0UL;
    h5policy_pipeline_has_decode_nelmts = 0UB;
    h5policy_pipeline_decode_nelmts_offset = 0UL;
    h5policy_pipeline_decode_size = 0UL;
    h5policy_pipeline_has_decode_size = 0UB;
    h5policy_pipeline_decode_size_offset = 0UL;
    h5policy_pipeline_chunk_framing = 0UL;
    h5policy_pipeline_has_framing = 0UB;
    h5policy_pipeline_framing_offset = 0UL;
    h5policy_chunk_min_stored = 0UL;
    h5policy_chunk_min_stored_offset = 0UL;
    h5policy_chunk_has_stored = 0UB;
    /* Fresh arrays, not truncations: assigning an existing array would alias
       it, and the finalize cross-check must see only this object's shape.  */
    h5policy_dataspace_max_dims = uint<64>[]();
    h5policy_dataspace_max_dim_offsets = uint<64>[]();
    h5policy_chunk_grid_dims = uint<64>[]();
    h5policy_fixed_array_nelmts = 0UL;
    h5policy_fixed_array_nelmts_offset = 0UL;
    h5policy_has_fixed_array_index = 0UB;

    ctx = h5policy_count_object(ctx, profile, root_off, object);

    /* Record the header before splitting on version: version 1 headers carry no
       signature and take the else branch below, so marking inside the v2 branch
       would leave every old-style header looking unreached.  The walk has read
       an object header here either way, whatever validation then concludes.  */
    h5policy_mark_reached(root_off/#B, "OHDR");

    /* Version-2 object headers are self-describing: optional creation/access
       metadata, chunk-0 size width, message data, and a trailing checksum.  */
    if (sig == H5_FORMAT_OHDR_SIGNATURE)
        {
            var version = h5policy_read_u64_le_at(ios, profile,
                                                  root_off + 4#B, 1UL) as uint<8>;
            var flags = h5policy_read_u64_le_at(ios, profile,
                                                root_off + 5#B, 1UL) as uint<8>;

            if (version != 2UB)
                {
                    h5policy_emit_error("H5_CORRUPT_UNSUPPORTED_OBJECT_HEADER_VERSION",
                                        "corrupt", root_off, object,
                                        "v2 object-header signature has an unsupported version byte");
                    return ctx;
                }

            var cursor = root_off + 6#B;
            if ((flags & (1U <<. 5)) != 0U)
                cursor = cursor + 16#B;
            if ((flags & (1U <<. 4)) != 0U)
                cursor = cursor + 4#B;

            var size_width = 1UL <<. (flags & 3U);
            var chunk_size = h5policy_read_u64_le_at(ios, profile,
                                                     cursor, size_width);
            var chunk_off = cursor + size_width#B;
            var header_bytes = ((chunk_off - root_off)/#B) as uint<64>;
            var total_without_checksum =
                h5policy_checked_add_u64(header_bytes, chunk_size,
                                         0xffffffffffffffffUL,
                                         "H5_CORRUPT_LENGTH_OVERFLOW",
                                         "corrupt", root_off, object,
                                         "object-header size overflow");
            var total_size =
                h5policy_checked_add_u64(total_without_checksum, 4UL,
                                         0xffffffffffffffffUL,
                                         "H5_CORRUPT_LENGTH_OVERFLOW",
                                         "corrupt", root_off, object,
                                         "object-header checksum size overflow");

            var ok = h5policy_checked_addr_range(root_off/#B, total_size,
                                                 file_size,
                                                 "object header outside file",
                                                 root_off, object);
            if (!ok)
                return ctx;

            ctx = h5policy_account_metadata(ctx, profile,
                                            total_size, root_off, object);

            var pre_crt_tracked = ((flags & 4U) != 0U);
            var pre_prefix_bytes = pre_crt_tracked
                                   ? (V2_PREFIX_BYTES + 2)
                                   : V2_PREFIX_BYTES;
            if (!h5policy_preflight_dtype_chunk(ios, profile, version,
                                                 pre_prefix_bytes,
                                                 chunk_off, chunk_size, object))
                return ctx;

            var checksum_bytes = h5policy_map_bytes(ios, profile,
                                                    root_off,
                                                    total_size - 4UL);
            var stored_checksum = lookup3_u32_le(h5policy_map_bytes(ios, profile,
                                                                    root_off + (total_size - 4UL)#B,
                                                                    4UL));
            var checksum = lookup3_hashlittle(checksum_bytes, 0);
            if (checksum != stored_checksum)
                h5policy_emit_error("H5_CORRUPT_BAD_CHECKSUM",
                                    "corrupt", root_off, object,
                                    "object-header checksum mismatch");

            var crt_order_tracked = ((flags & 4U) != 0U);
            var prefix_bytes = crt_order_tracked ? (V2_PREFIX_BYTES + 2) : V2_PREFIX_BYTES;

            global_crt_tracked = crt_order_tracked;
            ctx = h5policy_validate_msg_chunk(ios, profile, ctx,
                                              version, prefix_bytes,
                                              0,
                                              chunk_off, chunk_size,
                                              (root_off/#B) as uint<64>,
                                              (root_off/#B) as uint<64> + total_size,
                                              object);

            h5policy_finalize_ohdr_dataset(ctx, root_off, object);
            return ctx;
        }

    /* Version-1 headers have a fixed 16-byte prefix and no checksum.  libhdf5
       validates the declared message count only after loading chunk 0; unless
       built with H5_STRICT_FORMAT_CHECKS, later continuation messages may make
       the total differ from the prefix.  */
    var version1 = h5policy_read_u64_le_at(ios, profile, root_off, 1UL) as uint<8>;
    if (version1 != 1UB)
        {
            h5policy_emit_error("H5_CORRUPT_UNSUPPORTED_OBJECT_HEADER_VERSION",
                                "corrupt", root_off, object,
                                "root object header is neither v1 nor v2");
            return ctx;
        }

    var nmessages1 = h5policy_read_u64_le_at(ios, profile,
                                             root_off + 2#B, 2UL);
    var chunk_size1 = h5policy_read_u64_le_at(ios, profile,
                                             root_off + 8#B, 4UL);
    var total_size1 =
        h5policy_checked_add_u64(16UL, chunk_size1,
                                 0xffffffffffffffffUL,
                                 "H5_CORRUPT_LENGTH_OVERFLOW",
                                 "corrupt", root_off, object,
                                 "object-header size overflow");
    var ok1 = h5policy_checked_addr_range(root_off/#B, total_size1,
                                          file_size,
                                          "object header outside file",
                                          root_off, object);
    if (!ok1)
        return ctx;

    if ((nmessages1 > 0UL && chunk_size1 < (V1_PREFIX_BYTES as uint<64>))
        || (nmessages1 == 0UL && chunk_size1 > 0UL))
        h5policy_emit_error("H5_CORRUPT_OBJECT_HEADER_MESSAGE_COUNT",
                            "corrupt", root_off, object,
                            "v1 object-header message count is inconsistent with first chunk size");

    ctx = h5policy_account_metadata(ctx, profile,
                                    total_size1, root_off, object);

    global_crt_tracked = 0;
    ctx = h5policy_validate_msg_chunk(ios, profile, ctx,
                                      version1, V1_PREFIX_BYTES,
                                      1,
                                      root_off + 16#B, chunk_size1,
                                      (root_off/#B) as uint<64>,
                                      (root_off/#B) as uint<64> + total_size1,
                                      object);

    if (h5policy_current_object_root_msg_count > nmessages1)
        h5policy_emit_error_ev(
            "H5_CORRUPT_OBJECT_HEADER_MESSAGE_COUNT", "corrupt",
            root_off, object,
            "v1 object header first chunk contains more messages than declared",
            H5Evidence {
                field = "envelope.message_count",
                actual = h5policy_current_object_root_msg_count,
                expected = nmessages1,
                comparison = "at_most",
                has_loc1 = 1, loc1_role = "expected",
                loc1 = root_off + 2#B, loc1_len = 2UL,
            });

    h5policy_finalize_ohdr_dataset(ctx, root_off, object);
    return ctx;
}

/* Walk every reachable object header from the root graph.  A bounded BFS keeps
   link traversal deterministic, allows duplicate hard links to be deduplicated,
   and gives continue-after-rejection mode a single place to decide whether to
   keep draining queued objects.  */
fun h5policy_walk_reachable_metadata = (int ios,
                                        H5PolicyProfile profile,
                                        H5WalkContext ctx,
                                        offset<uint<64>,B> root_off,
                                        uint<64> ext_addr) H5WalkContext:
{
    h5policy_walk_started = 1;
    h5policy_walk_completed = 0;
    h5policy_walk_stop_reason = "walking";
    h5policy_cache_image_boundary = 0;
    h5policy_reset_traversal_state;
    h5policy_reset_sohm;

    /* The superblock extension is an object header carrying file-level messages
       (driver info, file-space info, metadata cache image, ...).  libhdf5 reads
       it at open, so validate it too -- otherwise out-of-file addresses hidden
       there (e.g. a bogus cache-image address) are missed.  Only HADDR_UNDEF
       (all-ones) means "no extension"; a defined address of 0 points at the
       superblock itself, which libhdf5 rejects -- so validate it rather than
       treating 0 as absent (the walk finds the superblock magic and rejects).  */
    if (ext_addr != 0xffffffffffffffffUL
        && ext_addr < h5policy_ceiling(ios))
        {
            /* Record it before enqueuing: the extension goes in first, so from
               here on any enqueue of this address comes from the object graph
               and is an alias (h5policy_enqueue_ohdr). */
            h5policy_ext_ohdr_addr = ext_addr;
            h5policy_enqueue_ohdr(profile, ext_addr, 0UL, "/<superblock-extension>",
                                  ext_addr#B, "/<superblock-extension>");
        }

    /* SOHM is file-global and is advertised by the extension.  Queue the root
       after it so root messages can resolve shared heap IDs immediately. */
    h5policy_enqueue_ohdr(profile, root_off/#B, 0UL, "/",
                          root_off, "/");

    /* A cache image is not merely a shortcut for the root graph: every cached
       object-header client is serialized as a body that libhdf5 can later
       protect.  Seed those headers too, including entries not otherwise
       reachable from the current root, so replay cannot accidentally approve
       an opaque cached OHDR. Other client types are accounted for below by the
       normal walk's reached-kind record. */
    if (h5policy_mdci_replay_mode != 0)
        {
            var image_entry = 0UL;
            while (image_entry < h5policy_mdci_body_addrs'length as uint<64>)
                {
                    if (h5policy_mdci_body_types[image_entry] == 5UL)
                        h5policy_enqueue_ohdr(
                            profile, h5policy_mdci_body_addrs[image_entry], 0UL,
                            "/<cache-image-entry>",
                            h5policy_mdci_body_addrs[image_entry]#B,
                            "/<cache-image-entry>");
                    image_entry = image_entry + 1UL;
                }
        }

    /* pending_index advances monotonically through the queue.  New hard links
       discovered while validating an object are appended and picked up later,
       which gives breadth-first traversal without mutating already visited
       entries.  */
    while (h5policy_pending_index < h5policy_pending_ohdrs'length)
        {
            var addr = h5policy_pending_ohdrs[h5policy_pending_index];
            var depth = h5policy_pending_depths[h5policy_pending_index];
            var path = h5policy_pending_paths[h5policy_pending_index];
            h5policy_pending_index = h5policy_pending_index + 1UL;

            if (h5policy_run_options.continue_after_corruption == 0UB
                && h5policy_exit_code != H5POLICY_EXIT_ACCEPT
                && h5policy_exit_code != H5POLICY_EXIT_WARN)
                {
                    h5policy_walk_stop_reason = "rejection";
                    return ctx;
                }

            if (!h5policy_mark_visited_ohdr(addr))
                continue;

            if (depth > profile.resources.max_link_traversal_depth)
                {
                    h5policy_emit_error("H5_RESOURCE_LINK_TRAVERSAL_DEPTH",
                                        "resource", addr#B, path,
                                        "link traversal depth exceeds the selected profile limit");
                    continue;
                }

            if (addr >= h5policy_ceiling(ios))
                {
                    h5policy_emit_error("H5_CORRUPT_OFFSET_OUT_OF_FILE",
                                        "corrupt", addr#B, path,
                                        "object header address is at or beyond the declared end-of-file");
                    continue;
                }

            /* A metadata cache image (carried by the superblock extension,
               which is walked before the root) shadows the on-disk bytes at the
               addresses it caches.  Decoding a shadowed header would interpret
               stale backing bytes as live metadata -- that is how forensic once
               manufactured H5_CORRUPT_UNSUPPORTED_OBJECT_HEADER_VERSION on
               valid/cache_image.h5.

               Skip precisely the shadowed objects rather than abandoning the
               walk.  The image lists which addresses it caches and h5policy
               already decodes that index, so "we cannot vet this object" does
               not have to mean "we cannot vet anything after it": a file whose
               image covers one B-tree leaf still gets its headers, heaps and
               remaining trees checked.  Stopping outright reported
               unsupported_coverage_gap on corpus seed 62, whose
               over-capacity record count -- a live libhdf5 SIGSEGV -- sits in an
               UNSHADOWED header the walk never reached.

               The walk is still not complete: shadowed objects were skipped, so
               stop_reason/walk_completed keep reporting the coverage gap. */
            if (h5policy_cache_image_boundary
                && h5policy_addr_is_shadowed(addr))
                {
                    h5policy_walk_stop_reason = "cache_image_coverage_gap";
                    continue;
                }

            ctx = h5policy_validate_ohdr_raw(ios, profile, ctx,
                                             addr#B, path, depth);
        }

    /* A cache image leaves the walk incomplete even when every reachable
       unshadowed object was vetted: the cached bodies were never decoded. */
    if (h5policy_cache_image_boundary)
        {
            h5policy_walk_stop_reason = "cache_image_coverage_gap";
            return ctx;
        }

    /* Do not claim a completed MDCI analysis unless every serialized client
       body was reached by a type-aware normal decoder.  This keeps unusual
       internal cache-client IDs a safe coverage refusal rather than silently
       treating the read overlay itself as validation. */
    if (h5policy_mdci_replay_mode != 0)
        {
            var image_entry = 0UL;
            while (image_entry < h5policy_mdci_body_addrs'length as uint<64>)
                {
                    if (!h5policy_was_reached(h5policy_mdci_body_addrs[image_entry]))
                        {
                            h5policy_emit_error(
                                "H5_UNSUPPORTED_PICKLE_COVERAGE_GAP",
                                "unsupported",
                                h5policy_mdci_body_addrs[image_entry]#B,
                                "/<cache-image-entry>",
                                "metadata cache image entry body was not reached by a type-aware decoder");
                            h5policy_walk_stop_reason = "cache_image_coverage_gap";
                            return ctx;
                        }
                    image_entry = image_entry + 1UL;
                }
        }

    h5policy_walk_completed = 1;
    h5policy_walk_stop_reason = "";
    return ctx;
}

/* ---- Forensic global-heap sweep -------------------------------------------
   Global heap collections (GCOL) are reached through global-heap IDs held in
   vlen/reference values.  Where that value is DATASET raw data the ID is
   outside this metadata-only oracle's boundary, so such a collection is not on
   the reachable graph and only this sweep can see it.

   Two kinds of ID are NOT in that category, and this comment used to claim
   otherwise: a VDS layout message names a collection (h5_vds.pk), and so does an
   ATTRIBUTE value, because an attribute's value is stored inside its
   object-header message (h5policy_validate_attr_heap_ids in h5_messages.pk).
   Both are metadata and both are validated on the reachable graph.  The sweep
   remains the only route to a collection reached from dataset data, or to an
   orphaned one no reference names at all.  An object that
   does not advance the parse cursor makes libhdf5's
   H5HG__cache_heap_deserialize loop forever, and there are TWO ways in:

     * index 0, the free-space object, whose advance is `need = obj size` raw
       (H5HGcache.c:358) -- a declared zero never moves the cursor;
     * any other index, whose advance is
       `need = H5HG_SIZEOF_OBJHDR(f) + H5HG_ALIGN(size)` (H5HGcache.c:353) in
       UNCHECKED size_t arithmetic -- eight declared lengths per size_t width,
       the interval [SIZE_MAX-22, SIZE_MAX-15], wrap that sum to zero.

   The second entrance was measured, not deduced: rewriting one object length to
   2^64-16 in an otherwise clean file makes both a release and an
   AddressSanitizer build of libhdf5 2.3.0 fail to terminate on an ordinary
   H5Aread, with no sanitizer report -- it is a liveness failure, nothing is read
   out of bounds.  libhdf5's own bounds check cannot catch it:
   H5_IS_BUFFER_OVERFLOW short-circuits on `(size) != 0`, so a `need` of zero is
   exactly the value it is defined to ignore.

   The reachability walk cannot see any of this, so the forensic profile --
   whose job is to report anomalies, not to follow references -- sweeps the raw
   bytes for GCOL signatures and walks each collection's object list, flagging
   any entry whose size advances the parser by zero bytes AT ANY SUPPORTED
   size_t WIDTH.  The width qualifier matters: this validator's own arithmetic
   is uint<64>, which reproduces an LP64 reader exactly, and a length of
   2^32-16 therefore looks like a harmless overrun here while a 32-bit reader
   computes zero from it and hangs.  h5policy_gcol_advance models both.  */

fun h5policy_align8 = (uint<64> n) uint<64>:
{
    return ((n + 7UL) / 8UL) * 8UL;
}

/* H5HG_ALIGN(X) evaluated in a size_t as wide as `mask`, so the wraparound is
   the target's and not this validator's.  `mask` truncates the decoded length
   the way the assignment to the size_t field `H5HG_obj_t.size` does
   (UINT64DECODE: "WE DON'T CHECK FOR OVERFLOW!"), and again after each unchecked
   operation.  Pass 0xFFFFFFFFFFFFFFFF for LP64 and 0xFFFFFFFF for ILP32.  */
fun h5policy_align8_at_width = (uint<64> n, uint<64> mask) uint<64>:
{
    return (((((n & mask) + 7UL) & mask) / 8UL) * 8UL) & mask;
}

/* The parse advance H5HG__cache_heap_deserialize computes for one object, in a
   size_t of the given width.  Index 0 uses its declared size raw; every other
   index adds the object-header size to the aligned payload.  Both are unchecked
   in libhdf5, so both are masked here.  */
fun h5policy_gcol_advance = (uint<64> idx, uint<64> osize, uint<64> objhdr,
                             uint<64> mask) uint<64>:
{
    if (idx == 0UL)
        return osize & mask;
    return (objhdr + h5policy_align8_at_width(osize, mask)) & mask;
}

/* Inspect one candidate GCOL at file offset `g`.  Returns without a finding
   unless the collection is well-formed enough to be a real global heap AND
   contains an object that does not advance the parse cursor -- the libhdf5
   infinite-loop shape.  The header/size/alignment gates also reject the four
   signature bytes occurring incidentally in data.  */
fun h5policy_check_gcol = (int ios, H5PolicyProfile profile,
                           uint<64> g, uint<64> file_size) void:
{
    var len_size = global_sizeof_lengths as uint<64>;
    var hdr_size = h5policy_align8(8UL + len_size);   /* magic+version+resv+size */
    var objhdr = h5policy_align8(8UL + len_size);     /* id+refs+resv+size */

    if (g + hdr_size > file_size)
        return;
    if (h5policy_read_u64_le_at(ios, profile, (g + 4UL)#B, 1UL) != 1UL)
        return;                                       /* version must be 1 */

    h5policy_mark_reached(g, "GCOL");

    var csize = h5policy_read_u64_le_at(ios, profile, (g + 8UL)#B, len_size);
    if (csize < hdr_size || csize != h5policy_align8(csize))
        return;                                       /* size absent or misaligned */
    if (csize > file_size - g)
        return;                                       /* collection overruns the file */

    var p = g + hdr_size;
    var end = g + csize;
    var guard = 0UL;
    var max_iter = (csize / objhdr) + 4UL;

    while (p < end)
        {
            guard = guard + 1UL;
            if (guard > max_iter)
                return;                               /* defensive: cannot loop below */
            if (end - p < objhdr)
                return;                               /* trailing free space: well-formed */

            var idx = h5policy_read_u64_le_at(ios, profile, p#B, 2UL);
            var osize = h5policy_read_u64_le_at(ios, profile, (p + 8UL)#B, len_size);
            /* index 0 is the free-space object, sized to its whole extent;
               every other object is a header plus its aligned payload.  */
            var need = h5policy_gcol_advance(idx, osize, objhdr, 0xFFFFFFFFFFFFFFFFUL);

            if (need == 0UL)
                {
                    /* A zero-advance object is a denial-of-service shape, not a
                       corrupt-as-opened verdict: the collection is typically
                       orphaned (libhdf5's normal open never loads it), so this
                       is classed as a resource hazard -- a consumer that does
                       load the collection spins forever.  */
                    h5policy_emit_error("H5_RESOURCE_GLOBAL_HEAP_INFINITE_LOOP",
                                        "resource", p#B, "global-heap",
                                        "global heap collection object advances the parser by zero bytes; a reader loops indefinitely");
                    return;
                }
            /* The same object in a 32-bit size_t.  Only reported when the 64-bit
               advance is fine, so this clause adds the width-dependent shape and
               never restates the one above.  It is gated on a collection a
               32-bit reader could actually hold: above 4 GiB the chunk
               allocation fails first, and without the gate a genuinely huge
               collection whose index-0 extent happened to be a multiple of 2^32
               would be flagged for a reader that could never load it.  */
            if (csize <= 0xFFFFFFFFUL
                && h5policy_gcol_advance(idx, osize, objhdr, 0xFFFFFFFFUL) == 0UL)
                {
                    h5policy_emit_error("H5_RESOURCE_GLOBAL_HEAP_INFINITE_LOOP",
                                        "resource", p#B, "global-heap",
                                        "global heap collection object advances the parser by zero bytes in a 32-bit size_t; a 32-bit reader loops indefinitely");
                    return;
                }
            if (need > end - p)
                return;                               /* overruns collection: libhdf5 errors, not loops */
            p = p + need;
        }
}

/* Scan the whole file for GCOL signatures when the profile selects the
   unreachable-metadata sweep.  poke maps
   arrays lazily and re-reads IO on every random index, so the scan iterates
   sequentially with `for (b in ...)` -- which streams the bytes -- and matches
   the four-byte signature through a rolling window.  The rolling bytes and the
   absolute position carry across map windows, so a signature straddling a
   window boundary is still seen while memory stays bounded to one window.  */
fun h5policy_unreachable_gcol_sweep = (int ios, H5PolicyProfile profile) void:
{
    var file_size = h5policy_ceiling(ios);
    if (file_size < 16UL)
        return;

    var window = 1UL <<. 20;   /* 1 MiB */
    var start = 0UL;
    var b0 = 0UB; var b1 = 0UB; var b2 = 0UB; var b3 = 0UB;
    var pos = 0UL;
    while (start < file_size)
        {
            var span = (file_size - start) < window ? (file_size - start) : window;
            var mem = h5policy_map_bytes(ios, profile, start#B, span);
            h5policy_walk_tick(span);
            for (b in mem)
                {
                    b0 = b1; b1 = b2; b2 = b3; b3 = b;
                    if (pos >= 3UL
                        && b0 == H5_FORMAT_GCOL_SIGNATURE[0] && b1 == H5_FORMAT_GCOL_SIGNATURE[1]
                        && b2 == H5_FORMAT_GCOL_SIGNATURE[2] && b3 == H5_FORMAT_GCOL_SIGNATURE[3])
                        h5policy_check_gcol(ios, profile, pos - 3UL, file_size);
                    pos = pos + 1UL;
                }
            start = start + span;
        }
}
